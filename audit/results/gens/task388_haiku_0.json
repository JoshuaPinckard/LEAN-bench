  "cleaned_code": "import backtrader as bt\n\nclass TradingStrategy(bt.Strategy):\n    params = (\n        ('rsi_period', 14),\n        ('atr_period', 14),\n        ('atr_mult', 2.0),\n        ('trailing_stop', False),\n    )\n    \n    def __init__(self):\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.params.rsi_period)\n        self.atr = bt.indicators.ATR(self.data, period=self.params.atr_period)\n        self.order = None\n        self.entry_price = None\n        self.stop_price = None\n        \n    def next(self):\n        if self.order:\n            return\n        \n        if not self.position:\n            if (self.rsi[-1] <= 30 and self.rsi[0] > 30 \n                and self.data.close[0] > self.data.close[-1]):\n                self.entry_price = self.data.close[0]\n                self.stop_price = self.entry_price - self.params.atr_mult * self.atr[0]\n                self.order = self.buy()\n                \n            elif (self.rsi[-1] >= 70 and self.rsi[0] < 70 \n                  and self.data.close[0] < self.data.close[-1]):\n                self.entry_price = self.data.close[0]\n                self.stop_price = self.entry_price + self.params.atr_mult * self.atr[0]\n                self.order = self.sell()\n        else:\n            if self.position.size > 0:\n                if self.data.low[0] <= self.stop_price:\n                    self.order = self.sell()\n                elif (self.rsi[-1] >= 70 and self.rsi[0] < 70 \n                      and self.data.close[0] < self.data.close[-1]):\n                    self.order = self.sell()\n                \n                if self.params.trailing_stop:\n                    new_stop = self.entry_price - self.params.atr_mult * self.atr[0]\n                    if new_stop > self.stop_price:\n                        self.stop_price = new_stop\n                        \n            elif self.position.size < 0:\n                if self.data.high[0] >= self.stop_price:\n                    self.order = self.buy()\n                elif (self.rsi[-1] <= 30 and self.rsi[0] > 30 \n                      and self.data.close[0] > self.data.close[-1]):\n                    self.order = self.buy()\n                \n                if self.params.trailing_stop:\n                    new_stop = self.entry_price + self.params.atr_mult * self.atr[0]\n                    if new_stop < self.stop_price:\n                        self.stop_price = new_stop\n    \n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None",

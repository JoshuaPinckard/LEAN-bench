  "cleaned_code": "import backtrader as bt\n\nclass TradingStrategy(bt.Strategy):\n    params = (\n        ('stoch_period', 14),\n        ('rsi_period', 14),\n        ('atr_period', 14),\n        ('atr_mult', 2.0),\n        ('trailing_stop', False),\n    )\n    \n    def __init__(self):\n        self.stoch = bt.indicators.Stochastic(self.data, period=self.params.stoch_period)\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.params.rsi_period)\n        self.atr = bt.indicators.ATR(self.data, period=self.params.atr_period)\n        \n        self.order = None\n        self.entry_price = None\n        self.stop_price = None\n    \n    def next(self):\n        if self.order:\n            return\n        \n        stoch_cross_up = self.stoch[-1] <= 20 and self.stoch[0] > 20\n        stoch_cross_down = self.stoch[-1] >= 80 and self.stoch[0] < 80\n        \n        if not self.position:\n            if stoch_cross_up and self.rsi[0] > 50:\n                self.entry_price = self.data.close[0]\n                self.stop_price = self.entry_price - self.params.atr_mult * self.atr[0]\n                self.order = self.buy()\n            elif stoch_cross_down and self.rsi[0] < 50:\n                self.entry_price = self.data.close[0]\n                self.stop_price = self.entry_price + self.params.atr_mult * self.atr[0]\n                self.order = self.sell()\n        else:\n            if self.position.size > 0:\n                if stoch_cross_down or self.data.close[0] <= self.stop_price:\n                    self.order = self.sell()\n                elif self.params.trailing_stop:\n                    new_stop = self.data.close[0] - self.params.atr_mult * self.atr[0]\n                    if new_stop > self.stop_price:\n                        self.stop_price = new_stop\n            elif self.position.size < 0:\n                if stoch_cross_up or self.data.close[0] >= self.stop_price:\n                    self.order = self.buy()\n                elif self.params.trailing_stop:\n                    new_stop = self.data.close[0] + self.params.atr_mult * self.atr[0]\n                    if new_stop < self.stop_price:\n                        self.stop_price = new_stop\n    \n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None",

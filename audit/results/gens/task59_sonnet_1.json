  "cleaned_code": "import backtrader as bt\n\nclass TradingStrategy(bt.Strategy):\n    params = (\n        ('fast_period', 13),\n        ('slow_period', 40),\n        ('rsi_period', 14),\n        ('agg_bars', 6),\n        ('hold_bars', 36),\n        ('stop_loss_pct', 0.015),\n        ('take_profit_pct', 0.030),\n        ('rsi_threshold', 70.0),\n    )\n\n    def __init__(self):\n        self.fast_sma = bt.indicators.SMA(self.data.close, period=self.params.fast_period)\n        self.slow_sma = bt.indicators.SMA(self.data.close, period=self.params.slow_period)\n        self.crossover = bt.indicators.CrossOver(self.fast_sma, self.slow_sma)\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.params.rsi_period)\n        self.macd = bt.indicators.MACD(self.data.close)\n        self.order = None\n        self.entry_price = 0.0\n        self.bars_held = 0\n\n    def next(self):\n        if self.order:\n            return\n\n        if self.position:\n            self.bars_held += 1\n            price = self.data.close[0]\n\n            if price <= self.entry_price * (1.0 - self.params.stop_loss_pct):\n                self.order = self.sell()\n                return\n\n            if price >= self.entry_price * (1.0 + self.params.take_profit_pct):\n                self.order = self.sell()\n                return\n\n            if self.bars_held >= self.params.hold_bars:\n                self.order = self.sell()\n\n        else:\n            if len(self) % self.params.agg_bars != 0:\n                return\n\n            agg = self.params.agg_bars\n\n            ma_crosses = 0\n            for i in range(agg):\n                if self.crossover[-i] > 0:\n                    ma_crosses += 1\n\n            rsi_sum = 0.0\n            for i in range(agg):\n                rsi_sum += self.rsi[-i]\n            avg_rsi = rsi_sum / agg\n\n            if ma_crosses == 1 and avg_rsi > self.params.rsi_threshold:\n                cash = self.broker.getcash()\n                price = self.data.close[0]\n                size = int(cash / price)\n                if size > 0:\n                    self.order = self.buy(size=size)\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            if order.status == order.Completed and order.isbuy():\n                self.entry_price = order.executed.price\n                self.bars_held = 0\n            self.order = None",

  "cleaned_code": "import backtrader as bt\n\nclass TradingStrategy(bt.Strategy):\n    params = (\n        ('fast_period', 9),\n        ('mid_period', 26),\n        ('slow_period', 52),\n    )\n\n    def __init__(self):\n        self.sma9 = bt.indicators.SMA(self.data.close, period=self.params.fast_period)\n        self.sma26 = bt.indicators.SMA(self.data.close, period=self.params.mid_period)\n        self.sma52 = bt.indicators.SMA(self.data.close, period=self.params.slow_period)\n        self.crossover = bt.indicators.CrossOver(self.sma9, self.sma26)\n        self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        close = self.data.close[0]\n        sma26 = self.sma26[0]\n        sma52 = self.sma52[0]\n\n        if not self.position:\n            if (self.crossover > 0 and\n                    close > sma26 and\n                    close > sma52 and\n                    sma26 > sma52):\n                size = int(self.broker.getcash() / close)\n                if size > 0:\n                    self.order = self.buy(size=size)\n\n            elif (self.crossover < 0 and\n                    close < sma26 and\n                    close < sma52 and\n                    sma26 < sma52):\n                size = int(self.broker.getcash() / close)\n                if size > 0:\n                    self.order = self.sell(size=size)\n\n        else:\n            if self.position.size > 0:\n                lower_cloud = min(sma26, sma52)\n                if self.crossover < 0 or close < lower_cloud:\n                    self.order = self.sell()\n\n            elif self.position.size < 0:\n                upper_cloud = max(sma26, sma52)\n                if self.crossover > 0 or close > upper_cloud:\n                    self.order = self.buy()\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None",

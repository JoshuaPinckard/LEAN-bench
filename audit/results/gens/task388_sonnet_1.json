  "cleaned_code": "import backtrader as bt\n\n\nclass TradingStrategy(bt.Strategy):\n    params = (\n        ('willr_period', 14),\n        ('rsi_period', 14),\n        ('atr_period', 14),\n        ('atr_mult', 2.0),\n        ('trailing_stop', False),\n    )\n\n    def __init__(self):\n        stoch = bt.indicators.Stochastic(\n            self.data,\n            period=self.params.willr_period,\n            period_dfast=1,\n            period_dslow=1,\n            safediv=True,\n        )\n        self.willr = stoch.percK - 100.0\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.params.rsi_period)\n        self.atr = bt.indicators.ATR(self.data, period=self.params.atr_period)\n        self.order = None\n        self.stop_price = None\n        self.trade_dir = 0\n\n    def next(self):\n        if self.order:\n            return\n\n        willr_curr = self.willr[0]\n        willr_prev = self.willr[-1]\n        long_signal = willr_prev <= -80.0 and willr_curr > -80.0 and self.rsi[0] > 50.0\n        short_signal = willr_prev >= -20.0 and willr_curr < -20.0 and self.rsi[0] < 50.0\n\n        if self.position:\n            if self.params.trailing_stop and self.stop_price is not None:\n                if self.trade_dir == 1:\n                    candidate = self.data.close[0] - self.params.atr_mult * self.atr[0]\n                    if candidate > self.stop_price:\n                        self.stop_price = candidate\n                elif self.trade_dir == -1:\n                    candidate = self.data.close[0] + self.params.atr_mult * self.atr[0]\n                    if candidate < self.stop_price:\n                        self.stop_price = candidate\n\n            if self.stop_price is not None:\n                if self.trade_dir == 1 and self.data.low[0] <= self.stop_price:\n                    self.order = self.sell()\n                    self.trade_dir = 0\n                    return\n                if self.trade_dir == -1 and self.data.high[0] >= self.stop_price:\n                    self.order = self.buy()\n                    self.trade_dir = 0\n                    return\n\n            if self.trade_dir == 1 and short_signal:\n                self.order = self.sell()\n                self.trade_dir = 0\n            elif self.trade_dir == -1 and long_signal:\n                self.order = self.buy()\n                self.trade_dir = 0\n        else:\n            if long_signal:\n                self.trade_dir = 1\n                self.stop_price = self.data.close[0] - self.params.atr_mult * self.atr[0]\n                self.order = self.buy()\n            elif short_signal:\n                self.trade_dir = -1\n                self.stop_price = self.data.close[0] + self.params.atr_mult * self.atr[0]\n                self.order = self.sell()\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            fill = order.executed.price\n            if order.isbuy() and self.trade_dir == 1:\n                self.stop_price = fill - self.params.atr_mult * self.atr[0]\n            elif order.issell() and self.trade_dir == -1:\n                self.stop_price = fill + self.params.atr_mult * self.atr[0]\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None",

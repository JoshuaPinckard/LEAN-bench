  "cleaned_code": "import backtrader as bt\n\nclass TradingStrategy(bt.Strategy):\n    params = (\n        ('willr_period', 14),\n        ('mom_period', 14),\n        ('atr_period', 14),\n        ('atr_mult', 2.0),\n        ('trailing_stop', False),\n    )\n\n    def __init__(self):\n        self.stoch = bt.indicators.Stochastic(\n            self.data,\n            period=self.params.willr_period,\n            period_dfast=1,\n        )\n        self.atr = bt.indicators.ATR(self.data, period=self.params.atr_period)\n        self.order = None\n        self.stop_price = None\n        self.trade_direction = 0\n\n    def next(self):\n        if self.order:\n            return\n\n        willr_curr = self.stoch.percK[0] - 100.0\n        willr_prev = self.stoch.percK[-1] - 100.0\n        momentum = self.data.close[0] - self.data.close[-self.params.mom_period]\n\n        long_signal = willr_prev <= -80.0 and willr_curr > -80.0 and momentum > 0.0\n        short_signal = willr_prev >= -20.0 and willr_curr < -20.0 and momentum < 0.0\n\n        if not self.position:\n            if long_signal:\n                self.order = self.buy()\n                self.trade_direction = 1\n            elif short_signal:\n                self.order = self.sell()\n                self.trade_direction = -1\n        else:\n            if self.trade_direction == 1:\n                if self.params.trailing_stop and self.stop_price is not None:\n                    new_stop = self.data.close[0] - self.params.atr_mult * self.atr[0]\n                    if new_stop > self.stop_price:\n                        self.stop_price = new_stop\n                if self.stop_price is not None:\n                    if self.data.close[0] <= self.stop_price or short_signal:\n                        self.order = self.close()\n                        self.trade_direction = 0\n            elif self.trade_direction == -1:\n                if self.params.trailing_stop and self.stop_price is not None:\n                    new_stop = self.data.close[0] + self.params.atr_mult * self.atr[0]\n                    if new_stop < self.stop_price:\n                        self.stop_price = new_stop\n                if self.stop_price is not None:\n                    if self.data.close[0] >= self.stop_price or long_signal:\n                        self.order = self.close()\n                        self.trade_direction = 0\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            if order.status == order.Completed:\n                ep = order.executed.price\n                if order.isbuy() and self.trade_direction == 1:\n                    self.stop_price = ep - self.params.atr_mult * self.atr[0]\n                elif order.issell() and self.trade_direction == -1:\n                    self.stop_price = ep + self.params.atr_mult * self.atr[0]\n                else:\n                    self.stop_price = None\n            self.order = None",

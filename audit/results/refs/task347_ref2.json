  "code": "import backtrader as bt\n\n\nclass StochKeltnerStrategy(bt.Strategy):\n    params = (\n        ('stoch_period', 14),\n        ('stoch_dfast', 3),\n        ('stoch_dslow', 3),\n        ('ema_period', 20),\n        ('atr_period', 14),\n        ('keltner_mult', 2.0),\n        ('stop_atr_mult', 2.0),\n    )\n\n    def __init__(self):\n        # Stochastic %K/%D (14,3,3)\n        self.stoch = bt.indicators.Stochastic(\n            self.data,\n            period=self.p.stoch_period,\n            period_dfast=self.p.stoch_dfast,\n            period_dslow=self.p.stoch_dslow\n        )\n        \n        # Keltner Channel (20-period EMA, ATR(14) with 2x multiplier)\n        self.ema = bt.indicators.EMA(self.data.close, period=self.p.ema_period)\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.upper_band = self.ema + self.p.keltner_mult * self.atr\n        self.lower_band = self.ema - self.p.keltner_mult * self.atr\n\n        # Order tracking attributes\n        self.order = None\n        self.stop_order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order == self.order:\n                self.order = None\n                # Set protective stop order upon position entry completion\n                if self.position.size > 0:\n                    stop_price = order.executed.price - (self.p.stop_atr_mult * self.atr[0])\n                    self.stop_order = self.sell(exectype=bt.Order.Stop, price=stop_price)\n                elif self.position.size < 0:\n                    stop_price = order.executed.price + (self.p.stop_atr_mult * self.atr[0])\n                    self.stop_order = self.buy(exectype=bt.Order.Stop, price=stop_price)\n            elif order == self.stop_order:\n                self.stop_order = None\n\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order == self.order:\n                self.order = None\n            elif order == self.stop_order:\n                self.stop_order = None\n\n    def next(self):\n        # Guard against duplicate orders while an entry/exit order is pending\n        if self.order:\n            return\n\n        if self.position.size > 0:\n            # Long Exit: price reverts to middle band (EMA)\n            if self.data.close[0] >= self.ema[0]:\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                self.order = self.close()\n        elif self.position.size < 0:\n            # Short Exit: price reverts to middle band (EMA)\n            if self.data.close[0] <= self.ema[0]:\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                self.order = self.close()\n        else:\n            # Entry conditions\n            long_cond = (self.stoch.percK[0] < 20) and (self.data.close[0] < self.lower_band[0])\n            short_cond = (self.stoch.percK[0] > 80) and (self.data.close[0] > self.upper_band[0])\n\n            if long_cond:\n                self.order = self.buy()\n            elif short_cond:\n                self.order = self.sell()",
  "assumptions": [

  "code": "import backtrader as bt\n\n\nclass PremarketGapStrategy(bt.Strategy):\n    def __init__(self):\n        self.sma = bt.ind.SMA(self.data.close, period=20)\n        self.atr = bt.ind.ATR(self.data, period=14)\n        self.atr_highest_5 = bt.ind.Highest(self.atr, period=5)\n        self.atr_sma_20 = bt.ind.SMA(self.atr, period=20)\n        self.crossover = bt.ind.CrossOver(self.data.close, self.sma)\n\n        self.order = None\n        self.entry_price = 0.0\n        self.entry_atr = 0.0\n        self.sl_price = 0.0\n        self.trailing_active = False\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if self.position:\n                self.entry_price = order.executed.price\n                self.entry_atr = self.atr[0]\n                self.trailing_active = False\n                if self.position.size > 0:\n                    self.sl_price = self.entry_price - 1.5 * self.entry_atr\n                else:\n                    self.sl_price = self.entry_price + 1.5 * self.entry_atr\n\n        self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if self.position:\n            if self.position.size > 0:\n                if not self.trailing_active:\n                    if self.data.high[0] - self.entry_price >= 1.0 * self.entry_atr:\n                        self.trailing_active = True\n\n                if self.trailing_active:\n                    trail_sl = self.data.high[0] - 1.0 * self.atr[0]\n                    self.sl_price = max(self.sl_price, trail_sl)\n\n                if self.data.low[0] <= self.sl_price:\n                    self.order = self.close()\n\n            elif self.position.size < 0:\n                if not self.trailing_active:\n                    if self.entry_price - self.data.low[0] >= 1.0 * self.entry_atr:\n                        self.trailing_active = True\n\n                if self.trailing_active:\n                    trail_sl = self.data.low[0] + 1.0 * self.atr[0]\n                    self.sl_price = min(self.sl_price, trail_sl)\n\n                if self.data.high[0] >= self.sl_price:\n                    self.order = self.close()\n        else:\n            vol_ok = self.atr_highest_5[0] <= 1.5 * self.atr_sma_20[0]\n            gap = (self.data.open[0] - self.data.close[-1]) / self.data.close[-1]\n\n            if self.crossover[0] > 0:\n                if vol_ok and gap > -0.02 and self.data.close[0] > self.sma[0]:\n                    risk_amount = self.broker.getvalue() * 0.015\n                    risk_per_share = 1.5 * self.atr[0]\n                    if risk_per_share > 0:\n                        size = int(risk_amount / risk_per_share)\n                        max_size = int(self.broker.getcash() / self.data.close[0])\n                        size = min(size, max_size)\n                        if size > 0:\n                            self.order = self.buy(size=size)\n\n            elif self.crossover[0] < 0:\n                if vol_ok and gap < 0.02 and self.data.close[0] < self.sma[0]:\n                    risk_amount = self.broker.getvalue() * 0.015\n                    risk_per_share = 1.5 * self.atr[0]\n                    if risk_per_share > 0:\n                        size = int(risk_amount / risk_per_share)\n                        max_size = int(self.broker.getcash() / self.data.close[0])\n                        size = min(size, max_size)\n                        if size > 0:\n                            self.order = self.sell(size=size)",

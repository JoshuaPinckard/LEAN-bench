  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass ConvertibleBondConversionStrategy(bt.Strategy):\n    params = (\n        (\"sma_period\", 50),\n        (\"rsi_period\", 14),\n        (\"tp_price\", 160.0),\n        (\"min_prev_close\", 200.0),\n        (\"rsi_threshold\", 50.0),\n        (\"stop_loss_pct\", 0.05),\n        (\"position_pct\", 0.02),\n        (\"max_hold_days\", 5),\n    )\n\n    def __init__(self):\n        self.sma = bt.indicators.SMA(self.data.close, period=self.p.sma_period)\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.p.rsi_period)\n\n        self.order = None\n        self.stop_order = None\n        self.entry_bar = None\n        self.entry_price = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order.issell():\n                # Short entry order completed\n                self.entry_bar = len(self)\n                self.entry_price = order.executed.price\n                stop_price = self.entry_price * (1.0 + self.p.stop_loss_pct)\n                self.stop_order = self.buy(\n                    exectype=bt.Order.Stop,\n                    price=stop_price,\n                    size=abs(order.executed.size),\n                )\n\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            if order == self.order:\n                self.order = None\n            if self.stop_order and order == self.stop_order:\n                self.stop_order = None\n\n    def next(self):\n        # Do not submit new orders if an entry/exit order is pending\n        if self.order:\n            return\n\n        if self.position:\n            # Check exit conditions for open short position\n            close_price = self.data.close[0]\n            bars_held = (\n                len(self) - self.entry_bar if self.entry_bar is not None else 0\n            )\n\n            # Exit Condition 1: Closing price reaches target level ($160.00)\n            tp_signal = close_price <= self.p.tp_price\n\n            # Exit Condition 2: Closing price rises above SMA(50)\n            sma_signal = close_price > self.sma[0]\n\n            # Exit Condition 3: After 5 trading days from entry\n            time_signal = bars_held >= self.p.max_hold_days\n\n            if tp_signal or sma_signal or time_signal:\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                    self.stop_order = None\n                self.order = self.close()\n        else:\n            dt = self.data.datetime.date(0)\n\n            # Entry Filter 1 & Additional Rule: Strategy inactive before October 1\n            if dt.month < 10:\n                return\n\n            # Additional Rule: Skip signal if asset price at entry time is below $160.00\n            if self.data.open[0] < self.p.tp_price:\n                return\n\n            # Entry Condition 2: Previous day closing price > $200.00\n            cond2 = self.data.close[-1] > self.p.min_prev_close\n\n            # Entry Condition 3: Previous day RSI > 50\n            cond3 = self.rsi[-1] > self.p.rsi_threshold\n\n            # Entry Condition 4: Current day open < previous day close\n            cond4 = self.data.open[0] < self.data.close[-1]\n\n            if cond2 and cond3 and cond4:\n                # Position sizing: 2% of total trading capital per trade\n                capital = self.broker.getvalue()\n                target_value = capital * self.p.position_pct\n                size = int(target_value / self.data.open[0])\n                if size < 1:\n                    size = 1\n\n                self.order = self.sell(size=size)",
  "assumptions": [
    {
      "topic": "date_filter",
      "choice": "Check month >= 10 (October 1 through December 31) for active signal generation period",
      "reason": "Specification mandates that current date is equal to or later than October 1 and strategy is inactive before October 1."
    },
    {
      "topic": "position_sizing",
      "choice": "Calculate position size as int(0.02 * broker.getvalue() / open_price), defaulted to minimum 1 share",
      "reason": "Specification mandates position size equal to 2% of total trading capital per trade; integer shares are required for stock order placement."
    },
    {
      "topic": "stop_loss",
      "choice": "Placed as a stop-market buy order at 105% of executed short entry price upon entry execution",
      "reason": "Standard stop-loss execution pattern in Backtrader for short positions."
    },
    {
      "topic": "time_exit",
      "choice": "Exit when len(self) - entry_bar >= 5",
      "reason": "Measures 5 trading days elapsed since position entry was completed."
    }
  ],

  "code": "import backtrader as bt\n\n\nclass RSIDivergenceStrategy(bt.Strategy):\n    params = (\n        (\"rsi_period\", 14),\n        (\"pivot_n\", 5),\n        (\"stop_loss_pct\", 0.02),\n    )\n\n    def __init__(self):\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.p.rsi_period)\n        self.order = None\n        self.prev_pivot_low = None\n        self.prev_pivot_high = None\n\n    def notify_order(self, order):\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        # Handle exits for existing positions\n        if self.position:\n            if self.position.size > 0:  # Long\n                rsi_exit = self.rsi[-1] <= 70 and self.rsi[0] > 70\n                sl_exit = self.data.low[0] <= self.position.price * (\n                    1.0 - self.p.stop_loss_pct\n                )\n                if rsi_exit or sl_exit:\n                    self.order = self.close()\n            elif self.position.size < 0:  # Short\n                rsi_exit = self.rsi[-1] >= 30 and self.rsi[0] < 30\n                sl_exit = self.data.high[0] >= self.position.price * (\n                    1.0 + self.p.stop_loss_pct\n                )\n                if rsi_exit or sl_exit:\n                    self.order = self.close()\n\n        # Pivot Detection Logic\n        n = self.p.pivot_n\n        window_size = 2 * n + 1\n        if len(self) < window_size:\n            return\n\n        lows = [self.data.low[-i] for i in range(window_size)]\n        highs = [self.data.high[-i] for i in range(window_size)]\n\n        pivot_low_val = self.data.low[-n]\n        pivot_high_val = self.data.high[-n]\n\n        is_pivot_low = pivot_low_val == min(lows)\n        is_pivot_high = pivot_high_val == max(highs)\n\n        bullish_divergence = False\n        bearish_divergence = False\n\n        if is_pivot_low:\n            curr_low_rsi = self.rsi[-n]\n            if self.prev_pivot_low is not None:\n                prev_low_val, prev_low_rsi = self.prev_pivot_low\n                if pivot_low_val < prev_low_val and curr_low_rsi > prev_low_rsi:\n                    bullish_divergence = True\n            self.prev_pivot_low = (pivot_low_val, curr_low_rsi)\n\n        if is_pivot_high:\n            curr_high_rsi = self.rsi[-n]\n            if self.prev_pivot_high is not None:\n                prev_high_val, prev_high_rsi = self.prev_pivot_high\n                if (\n                    pivot_high_val > prev_high_val\n                    and curr_high_rsi < prev_high_rsi\n                ):\n                    bearish_divergence = True\n            self.prev_pivot_high = (pivot_high_val, curr_high_rsi)\n\n        # Signal Execution for New Entries\n        if not self.position:\n            cash = self.broker.getcash()\n            size = int(cash / self.data.close[0])\n            if size > 0:\n                if bullish_divergence:\n                    self.order = self.buy(size=size)\n                elif bearish_divergence:\n                    self.order = self.sell(size=size)",
  "assumptions": [
    {
      "topic": "position_sizing",
      "choice": "Truncate integer shares using available cash divided by current bar close price",
      "reason": "The specification states 'size = cash / close for long; size = cash / close for short', which requires converting available cash into discrete share units via floor/int division."
    },
    {
      "topic": "stop_loss_evaluation",
      "choice": "Evaluate stop-loss intra-bar in next() against bar low (for long) and bar high (for short)",
      "reason": "The spec states 'if price hits a 2% stop-loss', which is evaluated against current bar extremes relative to entry price."
    },
    {
      "topic": "pivot_history_tracking",
      "choice": "Continuously update prior pivot state regardless of open position status",
      "reason": "Pivots reflect market price structure and must be tracked continuously so that divergence comparison always uses the true prior pivot."
    }

  "code": "import backtrader as bt\n\n\nclass BullishDivergenceTSI(bt.Strategy):\n    def __init__(self):\n        momentum = self.data.close - self.data.close(-1)\n        abs_momentum = abs(momentum)\n\n        fast_momentum = bt.indicators.EMA(momentum, period=25)\n        slow_momentum = bt.indicators.EMA(fast_momentum, period=13)\n        fast_abs_momentum = bt.indicators.EMA(abs_momentum, period=25)\n        slow_abs_momentum = bt.indicators.EMA(fast_abs_momentum, period=13)\n\n        raw_tsi = bt.DivByZero(slow_momentum, slow_abs_momentum, zero=0.0) * 100.0\n        self.tsi = bt.indicators.EMA(raw_tsi, period=2)\n\n        self._pending_orders = []\n\n    def next(self):\n        if self.position or self._pending_orders:\n            return\n\n        if self.data.low[0] < self.data.low[-1] and self.tsi[0] > self.tsi[-1]:\n            stop_level = self.data.low[0]\n\n            entry = self.buy(transmit=False)\n            size = entry.created.size\n\n            stop_loss = self.sell(\n                size=size,\n                exectype=bt.Order.Stop,\n                price=stop_level,\n                parent=entry,\n                transmit=False,\n            )\n            end_of_day_exit = self.sell(\n                size=size,\n                exectype=bt.Order.Close,\n                parent=entry,\n                transmit=True,\n            )\n\n            self._pending_orders = [entry, stop_loss, end_of_day_exit]\n\n    def notify_order(self, order):\n        if order.status in (\n            bt.Order.Completed,\n            bt.Order.Canceled,\n            bt.Order.Margin,\n            bt.Order.Rejected,\n            bt.Order.Expired,\n        ):\n            if order in self._pending_orders:\n                self._pending_orders.remove(order)",
  "assumptions": [
    {
      "topic": "divergence low comparison",
      "choice": "Treat the current bar low as the new price low and compare it with the immediately preceding bar low; compare the smoothed current TSI value with the immediately preceding smoothed TSI value.",
      "reason": "The specification does not define a swing-low lookback or pivot-confirmation rule."
    },
    {
      "topic": "TSI construction",
      "choice": "Compute TSI as double-smoothed close momentum divided by double-smoothed absolute momentum, using EMA periods 25 then 13, and apply the stated EMA(2) smoothing to the resulting TSI line.",
      "reason": "This uses all three stated TSI EMA parameters."
    },
    {
      "topic": "entry and end-of-day exit execution",
      "choice": "Submit a parent market entry with attached stop-loss and Close-order exit children when divergence is observed.",
      "reason": "The parent fills on the next bar, while the attached Close order exits at that same bar's close; this is the closest literal implementation of next-bar entry and end-of-day exit on daily OHLCV data."
    },
    {
      "topic": "stop-loss wick",
      "choice": "Use the divergence candle's low as the stop-loss price.",
      "reason": "That candle immediately precedes the next-bar entry."
    }

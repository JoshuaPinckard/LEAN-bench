  "model": "opus",
  "code": "import backtrader as bt\n\n\nclass TrendPullbackScaleIn(bt.Strategy):\n    params = (\n        ('atr_period', 14),\n        ('ema_period', 50),\n        ('high_lookback', 20),      # window used for the initial \"recent high\"\n        ('pullback_mult', 1.5),     # pullback / stop distance in ATR\n        ('tp_mult', 2.5),           # take-profit distance in ATR\n        ('max_entries', 4),         # max consecutive entries in one direction\n        ('risk_per_entry', 0.01),   # 1% of capital per individual position\n    )\n\n    def __init__(self):\n        # --- Indicators (exactly as specified) ---\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.ema = bt.indicators.ExponentialMovingAverage(\n            self.data.close, period=self.p.ema_period)\n        # rolling \"recent high\" used for the initial pullback trigger\n        self.recent_high = bt.indicators.Highest(\n            self.data.high, period=self.p.high_lookback)\n\n        # --- State ---\n        self.order = None            # pending-order guard\n        self._action = None          # what the pending order is doing\n        self.entries = []            # open scaled entries: {size, price, atr, stop}\n        self.entry_count = 0         # consecutive entries made this sequence\n        self.pivot = None            # highest high since last entry (\"next high\")\n        self.tp_level = None         # take-profit from the initial entry point\n\n    def notify_order(self, order):\n        if order.status in (order.Submitted, order.Accepted):\n            return\n\n        if order.status == order.Completed:\n            action = self._action\n            if action is not None and action[0] == 'buy':\n                atr = action[1]\n                price = order.executed.price\n                size = order.executed.size\n                # per-position stop-loss: 1.5 ATR below this entry point\n                stop = price - self.p.pullback_mult * atr\n                self.entries.append(\n                    {'size': size, 'price': price, 'atr': atr, 'stop': stop})\n                self.entry_count += 1\n                if self.entry_count == 1:\n                    # take-profit measured from the initial entry point\n                    self.tp_level = price + self.p.tp_mult * atr\n                # start tracking a fresh \"next high\" for the following scale-in\n                self.pivot = None\n            elif action is not None and action[0] == 'stop':\n                e = action[1]\n                if e in self.entries:\n                    self.entries.remove(e)\n            elif action is not None and action[0] == 'exit':\n                self.entries = []\n\n        if order.status in (order.Completed, order.Canceled,\n                            order.Margin, order.Rejected):\n            self.order = None\n            self._action = None\n\n    def next(self):\n        if self.order:\n            return\n\n        price = self.data.close[0]\n        atr = self.atr[0]\n        ema = self.ema[0]\n\n        if self.position:\n            # track the highest high since the last entry (the \"next high\")\n            if self.pivot is None:\n                self.pivot = self.data.high[0]\n            else:\n                self.pivot = max(self.pivot, self.data.high[0])\n\n            # Exit 1: take-profit of 2.5 ATR from the entry point -> close all\n            if self.tp_level is not None and price >= self.tp_level:\n                self.order = self.close()\n                self._action = ('exit',)\n                return\n\n            # Exit 2: price closes below EMA(50) -> close the entire position\n            if price < ema:\n                self.order = self.close()\n                self._action = ('exit',)\n                return\n\n            # Risk mgmt: per-position stop-loss 1.5 ATR below its entry point\n            for e in self.entries:\n                if price <= e['stop']:\n                    self.order = self.sell(size=e['size'])\n                    self._action = ('stop', e)\n                    return\n\n            # Entry 3: scale in on a further 1.5 ATR pullback from the next high\n            # Entry 4: cap consecutive entries at 4 (also caps risk at 4%)\n            if (self.entry_count < self.p.max_entries\n                    and price > ema\n                    and price <= self.pivot - self.p.pullback_mult * atr):\n                size = self.p.risk_per_entry * self.broker.getvalue() / price\n                self.order = self.buy(size=size)\n                self._action = ('buy', atr)\n            return\n\n        # Flat -> start of a new sequence; reset all sequence state\n        self.entry_count = 0\n        self.entries = []\n        self.pivot = None\n        self.tp_level = None\n\n        # Entry 1 & 2: bullish trend + 1.5 ATR pullback from a recent high\n        if price > ema and price <= self.recent_high[0] - self.p.pullback_mult * atr:\n            size = self.p.risk_per_entry * self.broker.getvalue() / price\n            self.order = self.buy(size=size)\n            self._action = ('buy', atr)",
  "assumptions": [
    {

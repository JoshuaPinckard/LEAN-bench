  "code": "import backtrader as bt\nimport math\nfrom collections import deque\n\n\nclass GapRiskStrategy(bt.Strategy):\n    params = (\n        (\"atr_period\", 14),\n        (\"sma_period\", 20),\n    )\n\n    def __init__(self):\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.sma = bt.indicators.SMA(self.data.close, period=self.p.sma_period)\n\n        self.order = None\n        self._entry_order = False\n        self._atr_history = deque(maxlen=20)\n\n        self.entry_price = None\n        self.entry_atr = None\n        self.stop_price = None\n        self.trailing_active = False\n        self.best_price = None\n\n    def notify_order(self, order):\n        if order.status in (bt.Order.Completed, bt.Order.Canceled,\n                            bt.Order.Margin, bt.Order.Rejected):\n            if order.status == bt.Order.Completed and self._entry_order:\n                self.entry_price = order.executed.price\n                self.entry_atr = float(self.atr[0])\n                self.trailing_active = False\n                self.best_price = self.entry_price\n\n                if order.isbuy():\n                    self.stop_price = self.entry_price - 1.5 * self.entry_atr\n                else:\n                    self.stop_price = self.entry_price + 1.5 * self.entry_atr\n\n            self.order = None\n            self._entry_order = False\n\n    def _volatility_allowed(self):\n        if len(self._atr_history) < 20:\n            return False\n\n        prior_five_average = sum(list(self._atr_history)[-5:]) / 5.0\n        prior_twenty_average = sum(self._atr_history) / 20.0\n        return prior_five_average <= 1.5 * prior_twenty_average\n\n    def _submit_entry(self, is_long):\n        atr_value = float(self.atr[0])\n        if atr_value <= 0.0:\n            return\n\n        capital = self.broker.getvalue()\n        risk_per_share = 1.5 * atr_value\n        size = math.floor((capital * 0.015) / risk_per_share)\n\n        if size < 1:\n            return\n\n        self._entry_order = True\n        self.order = self.buy(size=size) if is_long else self.sell(size=size)\n\n    def _manage_stops(self):\n        if not self.position or self.order is not None:\n            return\n\n        atr_value = float(self.atr[0])\n\n        if self.position.size > 0:\n            self.best_price = max(self.best_price, float(self.data.high[0]))\n\n            if (not self.trailing_active and\n                    self.best_price >= self.entry_price + atr_value):\n                self.trailing_active = True\n\n            if self.trailing_active:\n                self.stop_price = max(\n                    self.stop_price,\n                    self.best_price - atr_value\n                )\n\n            if float(self.data.low[0]) <= self.stop_price:\n                self.order = self.close()\n                return\n\n        else:\n            self.best_price = min(self.best_price, float(self.data.low[0]))\n\n            if (not self.trailing_active and\n                    self.best_price <= self.entry_price - atr_value):\n                self.trailing_active = True\n\n            if self.trailing_active:\n                self.stop_price = min(\n                    self.stop_price,\n                    self.best_price + atr_value\n                )\n\n            if float(self.data.high[0]) >= self.stop_price:\n                self.order = self.close()\n\n    def next(self):\n        self._manage_stops()\n\n        if self.position and self.order is None:\n            self.order = self.close()\n\n        if not self.position and self.order is None and self._volatility_allowed():\n            close_now = float(self.data.close[0])\n            close_previous = float(self.data.close[-1])\n            open_now = float(self.data.open[0])\n\n            crossed_above_sma = (\n                close_now > float(self.sma[0]) and\n                close_previous <= float(self.sma[-1])\n            )\n            crossed_below_sma = (\n                close_now < float(self.sma[0]) and\n                close_previous >= float(self.sma[-1])\n            )\n\n            long_gap_prohibited = open_now <= close_previous * 0.98\n            short_gap_prohibited = open_now >= close_previous * 1.02\n\n            if crossed_above_sma and not long_gap_prohibited:\n                self._submit_entry(is_long=True)\n            elif crossed_below_sma and not short_gap_prohibited:\n                self._submit_entry(is_long=False)\n\n        self._atr_history.append(float(self.atr[0]))",

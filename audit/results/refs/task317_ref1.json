  "code": "import backtrader as bt\n\n\nclass MonthlySmaStopStrategy(bt.Strategy):\n    def __init__(self):\n        self.sma = bt.indicators.SimpleMovingAverage(self.data.close, period=20)\n        self.order = None\n        self.stop_order = None\n        self.current_month = None\n        self.trading_day_of_month = 0\n\n    def next(self):\n        current_date = self.data.datetime.date(0)\n        month_key = (current_date.year, current_date.month)\n\n        if month_key != self.current_month:\n            self.current_month = month_key\n            self.trading_day_of_month = 1\n        else:\n            self.trading_day_of_month += 1\n\n        if self.trading_day_of_month == 1:\n            if not self.position and self.order is None and self.stop_order is None:\n                if self.data.close[0] > self.sma[0]:\n                    self.order = self.buy()\n\n        if self.trading_day_of_month == 5 and self.position:\n            if self.stop_order is not None:\n                self.cancel(self.stop_order)\n            if self.order is None:\n                self.order = self.close()\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            if order == self.stop_order:\n                self.stop_order = None\n                return\n\n            if order == self.order:\n                self.order = None\n\n            if order.status == order.Completed and order.isbuy():\n                self.stop_order = self.sell(\n                    exectype=bt.Order.Stop,\n                    price=order.executed.price * 0.98,\n                )",

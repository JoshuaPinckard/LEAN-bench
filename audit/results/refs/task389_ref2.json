  "code": "import backtrader as bt\n\n\nclass VolumePriceSMAStrategy(bt.Strategy):\n    params = (\n        (\"vol_fast_period\", 10),\n        (\"vol_slow_period\", 50),\n        (\"price_sma_period\", 200),\n        (\"stop_pct\", 0.01),\n        (\"tp_pct\", 0.02),\n        (\"risk_pct\", 0.01),\n    )\n\n    def __init__(self):\n        self.vol_sma_fast = bt.indicators.SMA(\n            self.data.volume, period=self.p.vol_fast_period\n        )\n        self.vol_sma_slow = bt.indicators.SMA(\n            self.data.volume, period=self.p.vol_slow_period\n        )\n        self.vol_cross = bt.indicators.CrossOver(\n            self.vol_sma_fast, self.vol_sma_slow\n        )\n\n        self.price_sma = bt.indicators.SMA(\n            self.data.close, period=self.p.price_sma_period\n        )\n        self.price_cross = bt.indicators.CrossOver(\n            self.data.close, self.price_sma\n        )\n\n        self.entry_order = None\n        self.stop_order = None\n        self.tp_order = None\n\n    def _cancel_pending_exit_orders(self):\n        if self.stop_order:\n            self.cancel(self.stop_order)\n            self.stop_order = None\n        if self.tp_order:\n            self.cancel(self.tp_order)\n            self.tp_order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order == self.entry_order:\n                self.entry_order = None\n                exec_price = order.executed.price\n                size = abs(order.executed.size)\n\n                if order.isbuy():\n                    stop_price = exec_price * (1.0 - self.p.stop_pct)\n                    self.stop_order = self.sell(\n                        size=size, exectype=bt.Order.Stop, price=stop_price\n                    )\n                    if self.p.tp_pct and self.p.tp_pct > 0:\n                        tp_price = exec_price * (1.0 + self.p.tp_pct)\n                        self.tp_order = self.sell(\n                            size=size,\n                            exectype=bt.Order.Limit,\n                            price=tp_price,\n                            oco=self.stop_order,\n                        )\n                else:\n                    stop_price = exec_price * (1.0 + self.p.stop_pct)\n                    self.stop_order = self.buy(\n                        size=size, exectype=bt.Order.Stop, price=stop_price\n                    )\n                    if self.p.tp_pct and self.p.tp_pct > 0:\n                        tp_price = exec_price * (1.0 - self.p.tp_pct)\n                        self.tp_order = self.buy(\n                            size=size,\n                            exectype=bt.Order.Limit,\n                            price=tp_price,\n                            oco=self.stop_order,\n                        )\n\n            elif order in [self.stop_order, self.tp_order]:\n                if order == self.stop_order:\n                    self.stop_order = None\n                if order == self.tp_order:\n                    self.tp_order = None\n                if not self.position:\n                    self._cancel_pending_exit_orders()\n\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order == self.entry_order:\n                self.entry_order = None\n            if order == self.stop_order:\n                self.stop_order = None\n            if order == self.tp_order:\n                self.tp_order = None\n\n    def next(self):\n        if self.position.size > 0:\n            if self.vol_cross[0] < 0 or self.price_cross[0] < 0:\n                self._cancel_pending_exit_orders()\n                self.close()\n            return\n\n        if self.position.size < 0:\n            if self.vol_cross[0] > 0 or self.price_cross[0] > 0:\n                self._cancel_pending_exit_orders()\n                self.close()\n            return\n\n        if self.entry_order:\n            return\n\n        risk_amount = self.broker.getvalue() * self.p.risk_pct\n        stop_dist = self.data.close[0] * self.p.stop_pct\n\n        if stop_dist <= 0:\n            return\n\n        size = int(risk_amount / stop_dist)\n        if size <= 0:\n            return\n\n        if self.vol_cross[0] > 0 and self.data.close[0] > self.price_sma[0]:\n            self.entry_order = self.buy(size=size)\n        elif self.vol_cross[0] < 0 and self.data.close[0] < self.price_sma[0]:\n            self.entry_order = self.sell(size=size)",
  "assumptions": [
    {
      "topic": "stop_and_take_profit_placement",
      "choice": "Submit stop-loss and take-profit orders upon entry completion in notify_order using executed entry price.",
      "reason": "The specification states to place stop-loss immediately after entry as a stop order at 1.0% from entry price; using the actual executed entry price from notify_order provides exact distance calculations."
    },
    {
      "topic": "crossover_definition",
      "choice": "Use Backtrader CrossOver indicator for price SMA exits (price_cross < 0 for long exit, price_cross > 0 for short exit).",
      "reason": "The specification explicitly requires closing long when close crosses below price_sma and short when close crosses above price_sma, indicating a discrete crossover event."
    }
  ],

  "code": "import backtrader as bt\nimport math\n\n\nclass DynamicTrailingStopStrategy(bt.Strategy):\n    params = (\n        (\"size\", 0.1),\n        (\"stop_distance\", 10.0),\n        (\"take_profit_distance\", 50.0),\n    )\n\n    def __init__(self):\n        self.entry_order = None\n        self.stop_order = None\n        self.take_profit_order = None\n        self.entry_price = None\n        self.stop_price = None\n\n    def next(self):\n        if self.entry_order:\n            return\n\n        if not self.position:\n            self.entry_order = self.buy(size=self.p.size)\n            return\n\n        if not self.entry_price or self.stop_order:\n            if self.entry_price:\n                profit_points = self.data.close[0] - self.entry_price\n                reached_steps = math.floor(profit_points / self.p.stop_distance)\n                if reached_steps > 0:\n                    new_stop = self.entry_price + (\n                        reached_steps * self.p.stop_distance\n                    )\n                    if new_stop > self.stop_price and new_stop < self.data.close[0]:\n                        self.stop_order = self.sell(\n                            size=self.position.size,\n                            exectype=bt.Order.Stop,\n                            price=new_stop,\n                            oco=self.take_profit_order,\n                        )\n                        self.stop_price = new_stop\n\n    def notify_order(self, order):\n        if order.status in (order.Submitted, order.Accepted):\n            return\n\n        if order.status == order.Completed:\n            if order == self.entry_order:\n                self.entry_price = order.executed.price\n                self.stop_price = self.entry_price - self.p.stop_distance\n                self.stop_order = self.sell(\n                    size=self.position.size,\n                    exectype=bt.Order.Stop,\n                    price=self.stop_price,\n                )\n                self.take_profit_order = self.sell(\n                    size=self.position.size,\n                    exectype=bt.Order.Limit,\n                    price=self.entry_price + self.p.take_profit_distance,\n                    oco=self.stop_order,\n                )\n                self.entry_order = None\n                return\n\n            if order == self.stop_order or order == self.take_profit_order:\n                self.stop_order = None\n                self.take_profit_order = None\n                self.entry_price = None\n                self.stop_price = None\n                return\n\n        if order.status in (\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ):\n            if order == self.entry_order:\n                self.entry_order = None\n            elif order == self.stop_order:\n                self.stop_order = None\n            elif order == self.take_profit_order:\n                self.take_profit_order = None",
  "assumptions": [

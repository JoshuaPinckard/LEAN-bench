  "task_id": 391,
  "ref_idx": 0,
  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass MacdCrossStopStrategy(bt.Strategy):\n    params = dict(\n        macd_fast=12,\n        macd_slow=26,\n        macd_signal=9,\n        stop_pct=0.02,\n    )\n\n    def __init__(self):\n        self.macd = bt.indicators.MACD(\n            self.data.close,\n            period_me1=self.p.macd_fast,\n            period_me2=self.p.macd_slow,\n            period_signal=self.p.macd_signal,\n        )\n        self.crossover = bt.indicators.CrossOver(self.macd.macd, self.macd.signal)\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in (order.Completed, order.Canceled, order.Margin, order.Rejected):\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            if self.crossover[0] > 0:\n                self.order = self.buy()\n            elif self.crossover[0] < 0:\n                self.order = self.sell()\n        elif self.position.size > 0:\n            stop_price = self.position.price * (1 - self.p.stop_pct)\n            if self.crossover[0] < 0 or self.data.close[0] <= stop_price:\n                self.order = self.close()\n        elif self.position.size < 0:\n            stop_price = self.position.price * (1 + self.p.stop_pct)\n            if self.crossover[0] > 0 or self.data.close[0] >= stop_price:\n                self.order = self.close()",
  "assumptions": [
    {
      "topic": "exit-then-reverse",
      "choice": "On the opposite MACD crossover, the existing position is only closed (self.close()); it does not immediately reverse into a new position on the same bar. A fresh entry requires a later crossover event while flat.",
      "reason": "Spec states 'Exit position on the opposite crossover' but never says to simultaneously open the opposite side; treating exit and entry as the same order-tracking action would conflict with the single-pending-order guard, so exit and entry are kept as distinct, sequential events."
    },
    {
      "topic": "stop-loss reference price",
      "choice": "Stop loss is evaluated against the current bar's Close (self.data.close[0]) compared to entry price (self.position.price) times (1 +/- 2%), not against intrabar High/Low.",
      "reason": "Spec gives no intrabar trigger mechanism and the only decision price used elsewhere in the strategy (crossover detection) is also bar-close-based, so Close is the consistent literal choice given OHLCV-only data."
    },
    {
      "topic": "order sizing and pending-order guard",
      "choice": "Plain self.buy()/self.sell()/self.close() with no size argument, and a single self.order attribute reset in notify_order on Completed/Canceled/Margin/Rejected.",
      "reason": "Spec is silent on position sizing and on how to prevent duplicate orders; canonical bench defaults apply directly."
    }
  ],

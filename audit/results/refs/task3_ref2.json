  "code": "import backtrader as bt\n\n\nclass SwingRSIFilter(bt.Strategy):\n    def __init__(self):\n        self.sma = bt.indicators.SMA(self.data.close, period=50)\n        self.rsi = bt.indicators.RSI(self.data.close, period=14)\n\n        self.order = None\n        self.target_high = None\n\n    def notify_order(self, order):\n        if order.status in [order.Completed]:\n            if order.isbuy():\n                self.order = self.close(\n                    exectype=bt.Order.Limit, price=self.target_high\n                )\n            else:\n                self.order = None\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        if self.order or self.position:\n            return\n\n        if self.data.close[0] > self.sma[0] and self.rsi[0] < 50:\n            self.target_high = max(self.data.high.get(size=20))\n            capital = self.broker.getvalue()\n            size = (capital * 0.01) / self.data.close[0]\n            self.order = self.buy(size=size)",

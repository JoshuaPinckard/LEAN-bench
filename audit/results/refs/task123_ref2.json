  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass BollingerMATrendSystem(bt.Strategy):\n    \"\"\"\n    Bollinger Bands & MA Trend-Following System\n    \n    A trend-following strategy combining Bollinger Bands for entry timing\n    with a 44-period SMA for trend direction and a consolidation filter.\n    \"\"\"\n    params = (\n        ('bb_period', 20),\n        ('bb_dev', 2.0),\n        ('sma_period', 44),\n        ('risk_pct', 0.02),\n        ('consolidation_threshold', 0.20),\n    )\n\n    def __init__(self):\n        self.order = None\n\n        # Indicators\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close,\n            period=self.p.bb_period,\n            devfactor=self.p.bb_dev\n        )\n        self.sma = bt.indicators.SMA(\n            self.data.close,\n            period=self.p.sma_period\n        )\n\n        # Consolidation filter line: BB Width and its 20-period average\n        self.bb_width = self.bb.lines.top - self.bb.lines.bot\n        self.bb_width_sma = bt.indicators.SMA(self.bb_width, period=self.p.bb_period)\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        # Consolidation filter: BB width < 20% of its 20-period average\n        in_consolidation = self.bb_width[0] < (self.p.consolidation_threshold * self.bb_width_sma[0])\n\n        if not self.position:\n            # Long Entry\n            if (self.data.close[0] > self.sma[0] and\n                    self.data.close[0] > self.bb.lines.top[0] and\n                    not in_consolidation):\n                \n                capital = self.broker.getvalue()\n                risk_amount = capital * self.p.risk_pct\n                entry_price = self.data.close[0]\n                stop_price = self.bb.lines.bot[0]\n                risk_per_share = entry_price - stop_price\n\n                if risk_per_share > 0:\n                    size = int(risk_amount / risk_per_share)\n                else:\n                    size = int(capital / entry_price)\n\n                cash = self.broker.getcash()\n                max_size = int(cash / entry_price)\n                size = min(size, max_size)\n\n                if size > 0:\n                    self.order = self.buy(size=size)\n\n            # Short Entry\n            elif (self.data.close[0] < self.sma[0] and\n                  self.data.close[0] < self.bb.lines.bot[0] and\n                  not in_consolidation):\n\n                capital = self.broker.getvalue()\n                risk_amount = capital * self.p.risk_pct\n                entry_price = self.data.close[0]\n                stop_price = self.bb.lines.top[0]\n                risk_per_share = stop_price - entry_price\n\n                if risk_per_share > 0:\n                    size = int(risk_amount / risk_per_share)\n                else:\n                    size = int(capital / entry_price)\n\n                cash = self.broker.getcash()\n                max_size = int(cash / entry_price)\n                size = min(size, max_size)\n\n                if size > 0:\n                    self.order = self.sell(size=size)\n\n        elif self.position.size > 0:\n            # Long Exit:\n            # 1. Close back below upper BB\n            # 2. Cross below MA-44\n            # 3. Stop loss: price reaches or crosses lower BB\n            if (self.data.close[0] < self.bb.lines.top[0] or\n                    self.data.close[0] < self.sma[0] or\n                    self.data.low[0] <= self.bb.lines.bot[0]):\n                self.order = self.close()\n\n        elif self.position.size < 0:\n            # Short Exit:\n            # 1. Close back above lower BB\n            # 2. Cross above MA-44\n            # 3. Stop loss: price reaches or crosses upper BB\n            if (self.data.close[0] > self.bb.lines.bot[0] or\n                    self.data.close[0] > self.sma[0] or\n                    self.data.high[0] >= self.bb.lines.top[0]):\n                self.order = self.close()",
  "assumptions": [
    {
      "topic": "position_sizing",
      "choice": "Calculate share size as 2% of portfolio equity divided by the per-share risk (close price minus opposite Bollinger Band price at signal time), capped by available cash.",
      "reason": "The specification states '2% risk per trade' under position sizing; evaluating risk per share against opposite band provides explicit size."
    },
    {
      "topic": "stop_loss_execution",
      "choice": "Evaluate stop loss dynamically in next() by checking if bar low reaches/crosses lower BB for long positions or bar high reaches/crosses upper BB for short positions, issuing a market order close.",
      "reason": "The specification states to place a stop loss at the opposite Bollinger Band, which dynamically updates every bar."
    },
    {
      "topic": "breakout_definition",
      "choice": "Breakout is defined as close price exceeding the upper BB line (for long) or falling below the lower BB line (for short).",
      "reason": "Standard end-of-bar evaluation in Backtrader for daily bars."
    },
    {
      "topic": "consolidation_filter",
      "choice": "Bollinger Band width is calculated as (top - bot), and tight consolidation is active when width < 0.20 * SMA(width, 20).",
      "reason": "Matches literal wording 'Bollinger Band width < 20% of its 20-period average'."
    }
  ],

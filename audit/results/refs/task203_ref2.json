  "code": "import backtrader as bt\n\n\nclass MeanReversionZScore(bt.Strategy):\n    params = (\n        (\"lookback\", 20),\n        (\"half_life\", 10),\n        (\"entry_threshold\", 2.0),\n        (\"stoploss_factor\", 1.5),\n    )\n\n    def __init__(self):\n        self.order = None\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close, period=self.p.lookback, devfactor=2\n        )\n        band_width = self.bb.top - self.bb.mid\n        self.z = 2.0 * (self.data.close - self.bb.mid) / band_width\n        self.z_ema = bt.indicators.EMA(self.z, period=self.p.half_life)\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        stoploss_threshold = self.p.entry_threshold * self.p.stoploss_factor\n        z_val = self.z[0]\n        z_ema_now = self.z_ema[0]\n        z_ema_prev = self.z_ema[-1]\n        band_width_val = self.bb.top[0] - self.bb.bot[0]\n\n        if self.position:\n            if self.position.size > 0:\n                cross_mean = z_ema_prev <= 0 and z_ema_now > 0\n                stop_loss = z_val >= stoploss_threshold\n                if cross_mean or stop_loss:\n                    self.order = self.close()\n            elif self.position.size < 0:\n                cross_mean = z_ema_prev >= 0 and z_ema_now < 0\n                stop_loss = z_val <= -stoploss_threshold\n                if cross_mean or stop_loss:\n                    self.order = self.close()\n        else:\n            if band_width_val < 1e-5:\n                return\n\n            if z_val < -self.p.entry_threshold:\n                self.order = self.buy()\n            elif z_val > self.p.entry_threshold:\n                self.order = self.sell()",
  "assumptions": [

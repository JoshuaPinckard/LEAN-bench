  "code": "import backtrader as bt\n\n\nclass MeanReversionDynamicThreshold(bt.Strategy):\n    params = (\n        ('bb_period', 30),\n        ('bb_dev', 2.0),\n        ('atr_period', 14),\n        ('ema_atr_period', 50),\n        ('base_threshold', 2.0),\n        ('vr_min', 0.7),\n        ('vr_max', 1.6),\n        ('rsi_period', 14),\n        ('rsi_low', 45.0),\n        ('rsi_high', 55.0),\n        ('vol_sma_period', 20),\n        ('risk_pct', 0.01),\n        ('stop_mult', 1.5),\n        ('time_stop_bars', 7),\n        ('use_optional_filters', True),\n    )\n\n    def __init__(self):\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close,\n            period=self.p.bb_period,\n            devfactor=self.p.bb_dev\n        )\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.ema_atr = bt.indicators.EMA(self.atr, period=self.p.ema_atr_period)\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.p.rsi_period)\n        self.vol_sma = bt.indicators.SMA(self.data.volume, period=self.p.vol_sma_period)\n\n        self.order = None\n        self.entry_price = 0.0\n        self.entry_bar = 0\n        self.stop_dist = 0.0\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if self.position:\n                self.entry_price = order.executed.price\n                self.entry_bar = len(self)\n\n        self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        mid = self.bb.mid[0]\n        top = self.bb.top[0]\n        std = (top - mid) / 2.0\n        if std == 0:\n            return\n\n        z = (self.data.close[0] - mid) / std\n\n        atr_val = self.atr[0]\n        ema_atr_val = self.ema_atr[0]\n        if ema_atr_val == 0:\n            return\n\n        vr = atr_val / ema_atr_val\n        vr_clipped = min(max(vr, self.p.vr_min), self.p.vr_max)\n        threshold = self.p.base_threshold * vr_clipped\n\n        if not self.position:\n            rsi_val = self.rsi[0]\n            vol_sma_val = self.vol_sma[0]\n\n            long_cond = z < -threshold\n            short_cond = z > threshold\n\n            if self.p.use_optional_filters:\n                long_cond = long_cond and (rsi_val < self.p.rsi_low) and (self.data.volume[0] > vol_sma_val)\n                short_cond = short_cond and (rsi_val > self.p.rsi_high) and (self.data.volume[0] > vol_sma_val)\n\n            if long_cond:\n                risk_amount = self.broker.getvalue() * self.p.risk_pct\n                risk_per_share = self.p.stop_mult * atr_val\n                if risk_per_share > 0:\n                    size = int(risk_amount / risk_per_share)\n                    if size > 0:\n                        self.stop_dist = risk_per_share\n                        self.order = self.buy(size=size)\n\n            elif short_cond:\n                risk_amount = self.broker.getvalue() * self.p.risk_pct\n                risk_per_share = self.p.stop_mult * atr_val\n                if risk_per_share > 0:\n                    size = int(risk_amount / risk_per_share)\n                    if size > 0:\n                        self.stop_dist = risk_per_share\n                        self.order = self.sell(size=size)\n\n        else:\n            bars_held = len(self) - self.entry_bar\n            time_exit = bars_held >= self.p.time_stop_bars\n\n            if self.position.size > 0:\n                stop_loss = self.data.close[0] <= (self.entry_price - self.stop_dist)\n                mean_reversion = z >= 0\n                if mean_reversion or stop_loss or time_exit:\n                    self.order = self.close()\n\n            elif self.position.size < 0:\n                stop_loss = self.data.close[0] >= (self.entry_price + self.stop_dist)\n                mean_reversion = z <= 0\n                if mean_reversion or stop_loss or time_exit:\n                    self.order = self.close()",

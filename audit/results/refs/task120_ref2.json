  "code": "import backtrader as bt\n\n\nclass MartingaleRSIBB(bt.Strategy):\n    params = (\n        (\"rsi_period\", 14),\n        (\"rsi_oversold\", 30),\n        (\"rsi_overbought\", 70),\n        (\"rsi_exit_long\", 50),\n        (\"rsi_exit_short\", 50),\n        (\"bb_period\", 20),\n        (\"bb_dev\", 2.0),\n        (\"initial_lot\", 0.01),\n        (\"lot_exp\", 1.2345),\n        (\"max_levels\", 6),\n        (\"max_dd\", 350.0),\n    )\n\n    def __init__(self):\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.p.rsi_period)\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close, period=self.p.bb_period, devfactor=self.p.bb_dev\n        )\n\n        self.order = None\n        self.trades_count = 0\n        self.peak_value = None\n\n    def notify_order(self, order):\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            if order.status in [order.Canceled, order.Margin, order.Rejected]:\n                if self.position.size == 0:\n                    self.trades_count = 0\n                elif self.trades_count > 0:\n                    self.trades_count -= 1\n            self.order = None\n\n        if self.position.size == 0:\n            self.trades_count = 0\n\n    def next(self):\n        current_value = self.broker.getvalue()\n        if self.peak_value is None or current_value > self.peak_value:\n            self.peak_value = current_value\n\n        drawdown = self.peak_value - current_value\n\n        # Maximum Drawdown Rule ($350 total account drawdown limit)\n        if drawdown >= self.p.max_dd:\n            if self.position.size != 0:\n                if not self.order:\n                    self.order = self.close()\n                    self.peak_value = current_value\n            return\n\n        # Guard pending orders\n        if self.order:\n            return\n\n        close = self.data.close[0]\n        rsi = self.rsi[0]\n        bb_top = self.bb.lines.top[0]\n        bb_bot = self.bb.lines.bot[0]\n\n        pos_size = self.position.size\n\n        if pos_size > 0:\n            # Exit Long: Close > Upper BB or RSI > 50\n            if close > bb_top or rsi > self.p.rsi_exit_long:\n                self.order = self.close()\n                return\n\n            # Long Averaging (Martingale) Entry\n            if self.trades_count < self.p.max_levels:\n                if close < bb_bot and rsi < self.p.rsi_oversold:\n                    size = self.p.initial_lot * (self.p.lot_exp**self.trades_count)\n                    self.order = self.buy(size=size)\n                    self.trades_count += 1\n\n        elif pos_size < 0:\n            # Exit Short: Close < Lower BB or RSI < 50\n            if close < bb_bot or rsi < self.p.rsi_exit_short:\n                self.order = self.close()\n                return\n\n            # Short Averaging (Martingale) Entry\n            if self.trades_count < self.p.max_levels:\n                if close > bb_top and rsi > self.p.rsi_overbought:\n                    size = self.p.initial_lot * (self.p.lot_exp**self.trades_count)\n                    self.order = self.sell(size=size)\n                    self.trades_count += 1\n\n        else:\n            # Initial Entry\n            if close < bb_bot and rsi < self.p.rsi_oversold:\n                size = self.p.initial_lot\n                self.order = self.buy(size=size)\n                self.trades_count = 1\n            elif close > bb_top and rsi > self.p.rsi_overbought:\n                size = self.p.initial_lot\n                self.order = self.sell(size=size)\n                self.trades_count = 1",
  "assumptions": [

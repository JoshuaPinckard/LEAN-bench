  "code": "import backtrader as bt\n\n\nclass RegimeTradingStrategy(bt.Strategy):\n    def __init__(self):\n        self.order = None\n        self.entry_type = None\n\n        self.bband = bt.indicators.BollingerBands(\n            self.data.close, period=20, devfactor=2.0\n        )\n        self.width = self.bband.top - self.bband.bot\n        self.width_sma = bt.indicators.SMA(self.width, period=200)\n\n        self.ema50 = bt.indicators.EMA(self.data.close, period=50)\n        self.ema200 = bt.indicators.EMA(self.data.close, period=200)\n\n        self.cross_top = bt.indicators.CrossOver(self.data.close, self.bband.top)\n        self.cross_bot = bt.indicators.CrossOver(self.data.close, self.bband.bot)\n        self.cross_mid = bt.indicators.CrossOver(self.data.close, self.bband.mid)\n\n    def notify_order(self, order):\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n            if not self.position:\n                self.entry_type = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            is_mr = self.width[0] <= self.width_sma[0]\n            is_trend = self.width[0] > self.width_sma[0]\n\n            if is_mr:\n                if self.data.close[0] <= self.bband.bot[0]:\n                    size = int((self.broker.getcash() * 0.99) / self.data.close[0])\n                    if size > 0:\n                        self.entry_type = \"mr_long\"\n                        self.order = self.buy(size=size)\n                elif self.data.close[0] >= self.bband.top[0]:\n                    size = int((self.broker.getcash() * 0.99) / self.data.close[0])\n                    if size > 0:\n                        self.entry_type = \"mr_short\"\n                        self.order = self.sell(size=size)\n            elif is_trend:\n                if self.ema50[0] > self.ema200[0] and self.cross_top[0] > 0:\n                    size = int((self.broker.getcash() * 0.99) / self.data.close[0])\n                    if size > 0:\n                        self.entry_type = \"trend_long\"\n                        self.order = self.buy(size=size)\n                elif self.ema50[0] < self.ema200[0] and self.cross_bot[0] < 0:\n                    size = int((self.broker.getcash() * 0.99) / self.data.close[0])\n                    if size > 0:\n                        self.entry_type = \"trend_short\"\n                        self.order = self.sell(size=size)\n        else:\n            if self.position.size > 0:\n                if self.entry_type == \"mr_long\":\n                    if self.cross_mid[0] != 0:\n                        self.order = self.close()\n                elif self.entry_type == \"trend_long\":\n                    if self.cross_mid[0] < 0:\n                        self.order = self.close()\n            elif self.position.size < 0:\n                if self.entry_type == \"mr_short\":\n                    if self.cross_mid[0] != 0:\n                        self.order = self.close()\n                elif self.entry_type == \"trend_short\":\n                    if self.cross_mid[0] > 0:\n                        self.order = self.close()",

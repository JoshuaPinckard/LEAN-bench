  "code": "import backtrader as bt\n\n\nclass MeanReversionZScoreStrategy(bt.Strategy):\n    params = ((\"k\", 3),)\n\n    def __init__(self):\n        self.sma = bt.indicators.SMA(self.data.close, period=100)\n        self.bbands = bt.indicators.BollingerBands(\n            self.data.close, period=100, devfactor=2\n        )\n        self.atr = bt.indicators.ATR(self.data, period=14)\n        self.crossover = bt.indicators.CrossOver(self.data.close, self.sma)\n\n        self.order = None\n        self.entry_z = None\n        self.entry_atr = None\n        self.entry_price = None\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            if order.isbuy() or order.issell():\n                if self.position.size != 0 and self.entry_price is None:\n                    self.entry_price = order.executed.price\n                    self.entry_z = self.zscore()\n                    self.entry_atr = float(self.atr[0])\n\n        if order.status in (\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ):\n            self.order = None\n\n    def zscore(self):\n        mid = float(self.sma[0])\n        top = float(self.bbands.top[0])\n        denominator = (top - mid) / 2.0\n        return (float(self.data.close[0]) - mid) / denominator\n\n    def next(self):\n        if self.order:\n            return\n\n        z = self.zscore()\n\n        if not self.position:\n            if z <= -2 or z >= 2:\n                atr = float(self.atr[0])\n                size = int((self.broker.getvalue() * 0.01) / atr)\n\n                if size <= 0:\n                    return\n\n                if z <= -2:\n                    self.order = self.buy(size=size)\n                else:\n                    self.order = self.sell(size=size)\n            return\n\n        half_life = abs(z) <= 0.5 * abs(self.entry_z)\n\n        if self.position.size > 0:\n            price_stop = self.entry_price - self.p.k * self.entry_atr\n            if (\n                z <= -3\n                or float(self.data.close[0]) <= price_stop\n                or self.crossover[0] > 0\n                or half_life\n            ):\n                self.order = self.close()\n        else:\n            price_stop = self.entry_price + self.p.k * self.entry_atr\n            if (\n                z >= 3\n                or float(self.data.close[0]) >= price_stop\n                or self.crossover[0] < 0\n                or half_life\n            ):\n                self.order = self.close()",
  "assumptions": [

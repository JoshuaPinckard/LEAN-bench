  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass EmaVwapProxyStrategy(bt.Strategy):\n    params = dict(\n        ema_period=20,\n        vol_period=20,\n        stop_loss_pct=0.015,\n        take_profit_pct=0.03,\n    )\n\n    def __init__(self):\n        self.ema = bt.indicators.EMA(self.data.close, period=self.p.ema_period)\n        self.vol_sma = bt.indicators.SMA(self.data.volume, period=self.p.vol_period)\n        self.crossover = bt.indicators.CrossOver(self.data.close, self.ema)\n        self.order = None\n        self.entry_price = None\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            if self.position.size != 0:\n                self.entry_price = order.executed.price\n            self.order = None\n        elif order.status in (order.Canceled, order.Margin, order.Rejected):\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        volume_filter = self.data.volume[0] > self.vol_sma[0]\n\n        if not self.position:\n            if (self.crossover[0] > 0 and volume_filter) or (self.crossover[0] < 0 and volume_filter):\n                price = self.data.close[0]\n                comminfo = self.broker.getcommissioninfo(self.data)\n                size = int(self.broker.getcash() / (price * (1 + comminfo.p.commission)))\n                if size <= 0:\n                    return\n                if self.crossover[0] > 0:\n                    self.order = self.buy(size=size)\n                else:\n                    self.order = self.sell(size=size)\n        elif self.position.size > 0:\n            price = self.data.close[0]\n            stop_price = self.entry_price * (1 - self.p.stop_loss_pct)\n            target_price = self.entry_price * (1 + self.p.take_profit_pct)\n            if self.crossover[0] < 0 or price <= stop_price or price >= target_price:\n                self.order = self.close()\n        elif self.position.size < 0:\n            price = self.data.close[0]\n            stop_price = self.entry_price * (1 + self.p.stop_loss_pct)\n            target_price = self.entry_price * (1 - self.p.take_profit_pct)\n            if self.crossover[0] > 0 or price >= stop_price or price <= target_price:\n                self.order = self.close()",
  "assumptions": [
    {
      "topic": "position_sizing",
      "choice": "Size = floor(available_cash / (close_price * (1 + commission_rate))), computed from the broker's actual CommInfo for the data, using whole shares.",
      "reason": "Spec states '100% of capital per trade' but does not specify a sizing formula; commission must be accounted for so the full-cash order does not get margin-rejected."
    },
    {
      "topic": "entry_price_reference",
      "choice": "entry_price used for the 1.5%/3% stop/target thresholds is taken from order.executed.price (the actual fill) rather than the close on the signal bar.",
      "reason": "Orders submitted in next() fill on the following bar by default, so the true entry price can differ from the signal-bar close; stop/target must be measured from the real fill."
    },
    {
      "topic": "exit_price_reference",
      "choice": "Stop-loss/take-profit levels are evaluated against the daily Close each bar (not intrabar High/Low, and not via separate stop/limit broker orders).",
      "reason": "Spec does not specify intrabar triggering; a close-based check is consistent with the crossover signal (also close vs EMA) and with the single order-tracking-attribute pattern implied by the canonical defaults."
    }

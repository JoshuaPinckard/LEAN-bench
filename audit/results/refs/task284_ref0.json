{
  "task_id": 284,
  "ref_idx": 0,
  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass BBBreakoutTrailingStop(bt.Strategy):\n    params = dict(\n        bb_period=20,\n        bb_devfactor=2,\n        rsi_period=14,\n        rsi_threshold=55,\n        trail_fraction=0.01 / 100,\n    )\n\n    def __init__(self):\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close, period=self.p.bb_period, devfactor=self.p.bb_devfactor\n        )\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.p.rsi_period)\n        self.crossover = bt.indicators.CrossOver(self.data.close, self.bb.top)\n\n        self.order = None\n        self.highest_price = None\n        self.trailing_stop_loss = None\n        self.exit_signal = 0\n\n    def notify_order(self, order):\n        if order.status in (order.Completed, order.Canceled, order.Margin, order.Rejected):\n            self.order = None\n\n    def next(self):\n        self.exit_signal = 0\n\n        if self.order:\n            return\n\n        if not self.position:\n            self.trailing_stop_loss = None\n            self.highest_price = None\n            if self.crossover[0] > 0 and self.rsi[0] > self.p.rsi_threshold:\n                self.order = self.buy(size=1)\n            return\n\n        if self.highest_price is None:\n            entry_price = self.position.price\n            self.highest_price = entry_price\n            self.trailing_stop_loss = entry_price * (1 - self.p.trail_fraction)\n\n        self.highest_price = max(self.highest_price, self.data.high[0])\n        self.trailing_stop_loss = max(\n            self.trailing_stop_loss,\n            self.highest_price * (1 - self.p.trail_fraction),\n        )\n\n        if self.data.close[0] <= self.trailing_stop_loss:\n            self.exit_signal = 1\n            self.order = self.close()",
  "assumptions": [
    {
      "topic": "trailing_stop_formula",
      "choice": "Interpreted '1%/100' literally as a 0.0001 (0.01%) per-bar fraction (entry_price*(1-0.0001), highest_price*(1-0.0001)) rather than simplifying to a 1% stop",
      "reason": "The spec states this exact formula in both rule 2 and rule 3; fidelity requires implementing what is written, not the plain-language '1% trailing stop' label."
    },
    {
      "topic": "entry_price_source",
      "choice": "entry_price is read from self.position.price (the actual order fill price)",
      "reason": "Spec references 'entry_price' without defining its source; the filled order price is the only value backtrader guarantees as the true transaction price."
    },
    {
      "topic": "highest_price_initialization",
      "choice": "On the first bar the position is open, highest_price and trailing_stop_loss are seeded from entry_price, then the rule-3 max() update is applied using that same bar's high",
      "reason": "Rule 3 requires a 'previous_highest_price'/'previous_trailing_stop_loss' that has no defined value on the entry day; entry_price is the only reference established at that point."
    },
    {
      "topic": "same_day_entry_exit",
      "choice": "The exit condition (close <= trailing_stop_loss) is allowed to fire on the same bar the position opens",
      "reason": "Rule 4 places no restriction excluding the entry day from the exit check."
    },
    {
      "topic": "indicator_variant",
      "choice": "Used backtrader's built-in RSI and BollingerBands indicators with default smoothing, no custom formula overrides",
      "reason": "Spec names RSI(14) and Bollinger Bands(period=20, deviation=2) without specifying an alternate calculation method."
    }
  ],

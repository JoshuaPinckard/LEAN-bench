  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass ImpulseStrategy(bt.Strategy):\n    def __init__(self):\n        self.sma252 = bt.indicators.SimpleMovingAverage(self.data.close, period=252)\n        self.atr14 = bt.indicators.ATR(self.data, period=14)\n        self.sma_atr = bt.indicators.SimpleMovingAverage(self.atr14, period=252)\n        self.atr_pct = self.sma_atr / self.data.close\n\n        self.entry_order = None\n        self.stop_order = None\n        self.limit_order = None\n        self.close_order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order == self.entry_order:\n                self.entry_order = None\n                entry_price = order.executed.price\n                stop_price = entry_price * 0.98\n                limit_price = entry_price * 1.05\n                self.stop_order = self.sell(\n                    size=order.executed.size,\n                    exectype=bt.Order.Stop,\n                    price=stop_price,\n                )\n                self.limit_order = self.sell(\n                    size=order.executed.size,\n                    exectype=bt.Order.Limit,\n                    price=limit_price,\n                    oco=self.stop_order,\n                )\n            elif order in [self.stop_order, self.limit_order]:\n                self.stop_order = None\n                self.limit_order = None\n            elif order == self.close_order:\n                self.close_order = None\n\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order == self.entry_order:\n                self.entry_order = None\n            if order == self.stop_order:\n                self.stop_order = None\n            if order == self.limit_order:\n                self.limit_order = None\n            if order == self.close_order:\n                self.close_order = None\n\n    def next(self):\n        if self.entry_order:\n            return\n\n        if not self.position:\n            if self.data.close[0] > self.sma252[0] and self.atr_pct[0] <= 0.05:\n                capital = self.broker.getvalue()\n                size = int((capital * 0.10) / self.data.close[0])\n                if size > 0:\n                    self.entry_order = self.buy(size=size)\n        else:\n            if self.close_order:\n                return\n\n            if self.data.close[0] < self.sma252[0]:\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                if self.limit_order:\n                    self.cancel(self.limit_order)\n                self.close_order = self.close()",
  "assumptions": [

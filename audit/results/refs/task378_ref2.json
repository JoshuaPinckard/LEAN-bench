  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass IntradayVWAPBreakout(bt.Strategy):\n    params = (\n        ('period', 20),\n        ('stop_pct', 0.005),\n    )\n\n    def __init__(self):\n        self.order = None\n        self.stop_order = None\n\n        pv = self.data.close * self.data.volume\n        sum_pv = bt.indicators.SumN(pv, period=self.p.period)\n        sum_vol = bt.indicators.SumN(self.data.volume, period=self.p.period)\n        self.vwap20 = sum_pv / sum_vol\n        self.vwap_slope = self.vwap20 - self.vwap20(-1)\n        self.sma20 = bt.indicators.SMA(self.data.close, period=self.p.period)\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order == self.order:\n                self.order = None\n            elif order == self.stop_order:\n                self.stop_order = None\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order == self.order:\n                self.order = None\n            elif order == self.stop_order:\n                self.stop_order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            if self.stop_order:\n                self.cancel(self.stop_order)\n                self.stop_order = None\n\n            cross_above_vwap = (self.data.close[0] > self.vwap20[0]) and (self.data.close[-1] <= self.vwap20[-1])\n            cross_below_vwap = (self.data.close[0] < self.vwap20[0]) and (self.data.close[-1] >= self.vwap20[-1])\n\n            if cross_above_vwap and (self.vwap_slope[0] > 0) and (self.data.close[0] > self.sma20[0]):\n                stop_price = self.data.close[0] * (1.0 - self.p.stop_pct)\n                orders = self.buy_bracket(stopprice=stop_price)\n                self.order = orders[0]\n                self.stop_order = orders[-1]\n\n            elif cross_below_vwap and (self.vwap_slope[0] < 0) and (self.data.close[0] < self.sma20[0]):\n                stop_price = self.data.close[0] * (1.0 + self.p.stop_pct)\n                orders = self.sell_bracket(stopprice=stop_price)\n                self.order = orders[0]\n                self.stop_order = orders[-1]\n\n        else:\n            if self.position.size > 0:\n                cross_below_sma = (self.data.close[0] < self.sma20[0]) and (self.data.close[-1] >= self.sma20[-1])\n                if cross_below_sma:\n                    if self.stop_order:\n                        self.cancel(self.stop_order)\n                        self.stop_order = None\n                    self.order = self.close()\n\n            elif self.position.size < 0:\n                cross_above_sma = (self.data.close[0] > self.sma20[0]) and (self.data.close[-1] <= self.sma20[-1])\n                if cross_above_sma:\n                    if self.stop_order:\n                        self.cancel(self.stop_order)\n                        self.stop_order = None\n                    self.order = self.close()",
  "assumptions": [
    {

  "code": "import backtrader as bt\n\n\nclass KeltnerMeanReversionStrategy(bt.Strategy):\n    params = (\n        (\"ema_period\", 20),\n        (\"atr_period\", 14),\n        (\"atr_multiplier\", 2.0),\n    )\n\n    def __init__(self):\n        self.middle = bt.indicators.EMA(self.data.close, period=self.p.ema_period)\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.upper = self.middle + (self.atr * self.p.atr_multiplier)\n        self.lower = self.middle - (self.atr * self.p.atr_multiplier)\n        self.middle_cross = bt.indicators.CrossOver(self.data.close, self.middle)\n\n        self.entry_order = None\n        self.exit_order = None\n        self.stop_order = None\n        self.entry_atr = None\n\n    def next(self):\n        if self.entry_order or self.exit_order:\n            return\n\n        if not self.position:\n            if self.data.close[0] > self.data.open[0] and self.data.close[0] < self.lower[0]:\n                self.entry_order = self.buy()\n            elif self.data.close[0] < self.data.open[0] and self.data.close[0] > self.upper[0]:\n                self.entry_order = self.sell()\n            return\n\n        if self.position.size > 0 and self.middle_cross[0] > 0:\n            if self.stop_order:\n                self.cancel(self.stop_order)\n            self.exit_order = self.close()\n        elif self.position.size < 0 and self.middle_cross[0] < 0:\n            if self.stop_order:\n                self.cancel(self.stop_order)\n            self.exit_order = self.close()\n\n    def notify_order(self, order):\n        if order.status in (order.Submitted, order.Accepted):\n            return\n\n        if order.status == order.Completed:\n            if order == self.entry_order:\n                self.entry_atr = self.atr[0]\n                if order.isbuy():\n                    self.stop_order = self.sell(\n                        exectype=bt.Order.Stop,\n                        price=order.executed.price - (2.0 * self.entry_atr),\n                    )\n                else:\n                    self.stop_order = self.buy(\n                        exectype=bt.Order.Stop,\n                        price=order.executed.price + (2.0 * self.entry_atr),\n                    )\n                self.entry_order = None\n            elif order == self.exit_order:\n                self.exit_order = None\n                self.entry_atr = None\n            elif order == self.stop_order:\n                self.stop_order = None\n                self.entry_atr = None\n\n        elif order.status in (order.Canceled, order.Margin, order.Rejected):\n            if order == self.entry_order:\n                self.entry_order = None\n            elif order == self.exit_order:\n                self.exit_order = None\n            elif order == self.stop_order:\n                self.stop_order = None",

  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass OptionIncomeStrategy(bt.Strategy):\n    params = ((\"strategy_type\", 1),)\n\n    def __init__(self):\n        self.order = None\n        self.last_exit_date = None\n        self.entry_bar = 0\n        self.bought_bnh = False\n\n        st = self.p.strategy_type\n        if isinstance(st, str):\n            st_lower = st.lower()\n            if st_lower in [\"1\", \"cc\", \"covered_call\", \"covered call\"]:\n                self.st_type = 1\n            elif st_lower in [\n                \"2\",\n                \"csp\",\n                \"cash_secured_put\",\n                \"cash secured put\",\n            ]:\n                self.st_type = 2\n            elif st_lower in [\"3\", \"wheel\"]:\n                self.st_type = 3\n            elif st_lower in [\"4\", \"bnh\", \"buy_and_hold\", \"buy & hold\"]:\n                self.st_type = 4\n            else:\n                self.st_type = 1\n        else:\n            self.st_type = int(st)\n\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close, period=20, devfactor=2\n        )\n        self.sma = bt.indicators.SMA(self.data.close, period=50)\n        self.rsi = bt.indicators.RSI(self.data.close, period=14)\n        self.atr = bt.indicators.ATR(self.data, period=14)\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n        if order.status == order.Completed:\n            if order.isbuy():\n                self.entry_bar = len(self)\n            elif order.issell():\n                self.last_exit_date = self.data.datetime.date(0)\n\n    def next(self):\n        if self.order is not None:\n            return\n\n        current_date = self.data.datetime.date(0)\n        is_monday = current_date.weekday() == 0\n\n        close = self.data.close[0]\n        sma = self.sma[0]\n        rsi = self.rsi[0]\n        atr = self.atr[0]\n        bb_top = self.bb.top[0]\n        bb_bot = self.bb.bot[0]\n        bb_mid = self.bb.mid[0]\n\n        if self.st_type == 4:\n            if not self.position and not self.bought_bnh:\n                self.order = self.buy()\n                self.bought_bnh = True\n            return\n\n        if not self.position:\n            if not is_monday:\n                return\n\n            if self.st_type == 1:\n                cooldown_ok = (\n                    self.last_exit_date is None\n                    or (current_date - self.last_exit_date).days >= 7\n                )\n                if cooldown_ok and close > sma and rsi > 50:\n                    self.order = self.buy()\n\n            elif self.st_type == 2:\n                if close <= bb_bot or rsi <= 35:\n                    self.order = self.buy()\n\n            elif self.st_type == 3:\n                if close <= bb_bot or rsi <= 35:\n                    self.order = self.buy()\n\n        else:\n            if self.st_type == 1:\n                if (\n                    close >= bb_top\n                    or rsi >= 70\n                    or close <= (bb_mid - 1.0 * atr)\n                ):\n                    self.order = self.close()\n\n            elif self.st_type == 2:\n                bars_held = len(self) - self.entry_bar\n                if (\n                    close >= bb_mid\n                    or bars_held >= 20\n                    or close <= (bb_bot - 1.0 * atr)\n                ):\n                    self.order = self.close()\n\n            elif self.st_type == 3:\n                if (\n                    close >= bb_top\n                    or rsi >= 70\n                    or close <= (bb_mid - 1.0 * atr)\n                ):\n                    self.order = self.close()",
  "assumptions": [

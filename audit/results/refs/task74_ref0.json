  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass DynamicStepTrailStrategy(bt.Strategy):\n    params = (\n        ('lot_size', 0.1),\n        ('initial_stop_points', 10.0),\n        ('take_profit_points', 50.0),\n        ('trail_step_points', 10.0),\n    )\n\n    def __init__(self):\n        self.order = None\n        self.entering = False\n        self.entry_price = None\n        self.stop_price = None\n        self.take_price = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status == order.Completed:\n            if self.entering:\n                self.entry_price = order.executed.price\n                if order.isbuy():\n                    self.stop_price = self.entry_price - self.p.initial_stop_points\n                    self.take_price = self.entry_price + self.p.take_profit_points\n                else:\n                    self.stop_price = self.entry_price + self.p.initial_stop_points\n                    self.take_price = self.entry_price - self.p.take_profit_points\n                self.entering = False\n            else:\n                self.entry_price = None\n                self.stop_price = None\n                self.take_price = None\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            self.entering = False\n\n        self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            self.entering = True\n            self.order = self.buy(size=self.p.lot_size)\n            return\n\n        step = self.p.trail_step_points\n        max_tier = self.p.take_profit_points - step\n\n        if self.position.size > 0:\n            if self.data.low[0] <= self.stop_price:\n                self.order = self.close()\n            elif self.data.high[0] >= self.take_price:\n                self.order = self.close()\n            else:\n                profit_points = self.data.high[0] - self.entry_price\n                if profit_points >= step:\n                    tier = min(int(profit_points // step) * step, max_tier)\n                    candidate_stop = self.entry_price + tier\n                    if candidate_stop > self.stop_price:\n                        self.stop_price = candidate_stop\n        else:\n            if self.data.high[0] >= self.stop_price:\n                self.order = self.close()\n            elif self.data.low[0] <= self.take_price:\n                self.order = self.close()\n            else:\n                profit_points = self.entry_price - self.data.low[0]\n                if profit_points >= step:\n                    tier = min(int(profit_points // step) * step, max_tier)\n                    candidate_stop = self.entry_price - tier\n                    if candidate_stop < self.stop_price:\n                        self.stop_price = candidate_stop",
  "assumptions": [

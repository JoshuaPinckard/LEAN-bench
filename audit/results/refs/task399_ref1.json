  "code": "import backtrader as bt\nimport math\n\n\nclass SupertrendIntradayStrategy(bt.Strategy):\n    params = (\n        (\"atr_period\", 10),\n        (\"multiplier\", 3.0),\n        (\"volume_sma_period\", 20),\n        (\"equity_percent\", 0.25),\n    )\n\n    def __init__(self):\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.volume_sma = bt.indicators.SMA(\n            self.data.volume, period=self.p.volume_sma_period\n        )\n\n        self.order = None\n        self.final_upper = None\n        self.final_lower = None\n        self.trend = None\n\n    def notify_order(self, order):\n        if order == self.order and order.status in (\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ):\n            self.order = None\n\n    def _size(self):\n        return math.floor(\n            (self.broker.getvalue() * self.p.equity_percent) / self.data.close[0]\n        )\n\n    def next(self):\n        if self.order:\n            return\n\n        hl2 = (self.data.high[0] + self.data.low[0]) / 2.0\n        basic_upper = hl2 + (self.p.multiplier * self.atr[0])\n        basic_lower = hl2 - (self.p.multiplier * self.atr[0])\n\n        if self.final_upper is None:\n            self.final_upper = basic_upper\n            self.final_lower = basic_lower\n            self.trend = \"up\"\n            return\n\n        prior_final_upper = self.final_upper\n        prior_final_lower = self.final_lower\n        prior_trend = self.trend\n        prior_close = self.data.close[-1]\n\n        self.final_upper = (\n            basic_upper\n            if basic_upper < prior_final_upper or prior_close > prior_final_upper\n            else prior_final_upper\n        )\n        self.final_lower = (\n            basic_lower\n            if basic_lower > prior_final_lower or prior_close < prior_final_lower\n            else prior_final_lower\n        )\n\n        if self.data.close[0] > prior_final_upper:\n            self.trend = \"up\"\n        elif self.data.close[0] < prior_final_lower:\n            self.trend = \"down\"\n        else:\n            self.trend = prior_trend\n\n        flipped_up = prior_trend == \"down\" and self.trend == \"up\"\n        flipped_down = prior_trend == \"up\" and self.trend == \"down\"\n\n        if self.position.size > 0 and flipped_down:\n            self.order = self.close()\n        elif self.position.size < 0 and flipped_up:\n            self.order = self.close()\n        elif self.position.size == 0 and self.data.volume[0] > self.volume_sma[0]:\n            size = self._size()\n            if size > 0:\n                if flipped_up:\n                    self.order = self.buy(size=size)\n                elif flipped_down:\n                    self.order = self.sell(size=size)",

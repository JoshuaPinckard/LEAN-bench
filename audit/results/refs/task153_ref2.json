      "choice": "ATR-based sizing where 1 ATR equals 1% of total portfolio equity",
      "reason": "Spec specifies ATR-based sizing such that 1 ATR corresponds to 1% of capital."
    },
    {
      "topic": "half_life_exit_condition",
      "choice": "|Z| <= 0.5 * |Z_entry|",
      "reason": "Direct literal implementation of the half-life retracement condition stated in the specification."
    }
  ],

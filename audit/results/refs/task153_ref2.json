  "code": "import math\nimport backtrader as bt\n\n\nclass MeanReversionZScore(bt.Strategy):\n    params = (\n        (\"bb_period\", 100),\n        (\"bb_devfactor\", 2.0),\n        (\"sma_period\", 100),\n        (\"atr_period\", 14),\n        (\"k_atr\", 3.0),\n        (\"risk_pct\", 0.01),\n    )\n\n    def __init__(self):\n        self.order = None\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close,\n            period=self.p.bb_period,\n            devfactor=self.p.bb_devfactor,\n        )\n        self.sma = bt.indicators.SMA(self.data.close, period=self.p.sma_period)\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.crossover = bt.indicators.CrossOver(self.data.close, self.sma)\n\n        self.entry_z = None\n        self.entry_price = None\n        self.entry_atr = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if self.position:\n                self.entry_price = order.executed.price\n            else:\n                self.entry_z = None\n                self.entry_price = None\n                self.entry_atr = None\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if not self.position:\n                self.entry_z = None\n                self.entry_price = None\n                self.entry_atr = None\n\n        self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        close = self.data.close[0]\n        mid = self.sma[0]\n        top = self.bb.top[0]\n\n        half_width = (top - mid) / 2.0\n        if half_width == 0:\n            return\n\n        z = (close - mid) / half_width\n\n        if not self.position:\n            atr_val = self.atr[0]\n            if atr_val <= 0:\n                return\n\n            size = int((self.broker.getvalue() * self.p.risk_pct) / atr_val)\n            if size <= 0:\n                return\n\n            if z <= -2.0:\n                self.entry_z = z\n                self.entry_price = close\n                self.entry_atr = atr_val\n                self.order = self.buy(size=size)\n            elif z >= 2.0:\n                self.entry_z = z\n                self.entry_price = close\n                self.entry_atr = atr_val\n                self.order = self.sell(size=size)\n        else:\n            if self.entry_z is None:\n                return\n\n            half_life_met = abs(z) <= 0.5 * abs(self.entry_z)\n            entry_p = (\n                self.entry_price if self.entry_price is not None else close\n            )\n            entry_a = (\n                self.entry_atr if self.entry_atr is not None else self.atr[0]\n            )\n\n            if self.position.size > 0:\n                z_cross_up = self.crossover[0] > 0\n                z_stop = z <= -3.0\n                price_stop = close <= (entry_p - self.p.k_atr * entry_a)\n\n                if z_cross_up or half_life_met or z_stop or price_stop:\n                    self.order = self.close()\n\n            elif self.position.size < 0:\n                z_cross_dn = self.crossover[0] < 0\n                z_stop = z >= 3.0\n                price_stop = close >= (entry_p + self.p.k_atr * entry_a)\n\n                if z_cross_dn or half_life_met or z_stop or price_stop:\n                    self.order = self.close()",
  "assumptions": [
    {
      "topic": "atr_stop_k_multiplier",
      "choice": "k = 3.0",

  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass IntraRangeMomentumTripleBarriers(bt.Strategy):\n    params = (\n        (\"sma_period\", 20),\n        (\"stoch_period\", 14),\n        (\"stoch_dfast\", 3),\n        (\"stoch_dslow\", 3),\n        (\"bb_period\", 20),\n        (\"bb_dev\", 2.0),\n        (\"atr_period\", 14),\n        (\"time_stop\", 20),\n        (\"pos_size_pct\", 0.01),\n        (\"min_daily_range_pct\", 0.002),\n        (\"min_atr_pct\", 0.0015),\n    )\n\n    def __init__(self):\n        self.sma = bt.ind.SMA(self.data.close, period=self.params.sma_period)\n        self.stoch = bt.ind.Stochastic(\n            self.data,\n            period=self.params.stoch_period,\n            period_dfast=self.params.stoch_dfast,\n            period_dslow=self.params.stoch_dslow,\n        )\n        self.bb = bt.ind.BollingerBands(\n            self.data.close,\n            period=self.params.bb_period,\n            devfactor=self.params.bb_dev,\n        )\n        self.atr = bt.ind.ATR(self.data, period=self.params.atr_period)\n        self.crossover = bt.ind.CrossOver(self.stoch.percK, self.stoch.percD)\n\n        self.order = None\n        self.entry_bar = 0\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if self.position:\n                self.entry_bar = len(self)\n            self.order = None\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        close = self.data.close[0]\n        high = self.data.high[0]\n        low = self.data.low[0]\n\n        daily_range_pct = (high - low) / close\n        atr_pct = self.atr[0] / close\n\n        if not self.position:\n            long_cond = (\n                close > self.sma[0]\n                and self.stoch.percK[0] > 66\n                and self.crossover[0] > 0\n                and daily_range_pct >= self.params.min_daily_range_pct\n                and atr_pct > self.params.min_atr_pct\n            )\n\n            short_cond = (\n                close < self.sma[0]\n                and self.stoch.percK[0] < 33\n                and self.crossover[0] < 0\n                and daily_range_pct >= self.params.min_daily_range_pct\n                and atr_pct > self.params.min_atr_pct\n            )\n\n            if long_cond:\n                size = (self.broker.getvalue() * self.params.pos_size_pct) / close\n                self.order = self.buy(size=size)\n            elif short_cond:\n                size = (self.broker.getvalue() * self.params.pos_size_pct) / close\n                self.order = self.sell(size=size)\n\n        else:\n            bars_in_trade = len(self) - self.entry_bar\n\n            if self.position.size > 0:\n                tp_cond = high >= self.bb.lines.top[0]\n                sl_cond = low <= self.bb.lines.bot[0]\n                alt_cond = (close < self.sma[0]) or (bars_in_trade >= self.params.time_stop)\n\n                if tp_cond or sl_cond or alt_cond:\n                    self.order = self.close()\n\n            elif self.position.size < 0:\n                tp_cond = low <= self.bb.lines.bot[0]\n                sl_cond = high >= self.bb.lines.top[0]\n                alt_cond = (close > self.sma[0]) or (bars_in_trade >= self.params.time_stop)\n\n                if tp_cond or sl_cond or alt_cond:\n                    self.order = self.close()",
  "assumptions": [
    {
      "topic": "position_sizing",
      "choice": "Size calculated as (portfolio_value * 0.01) / close price",
      "reason": "Literal interpretation of 'position size 1% of capital'."
    },

  "model": "gemini-3.6-flash(vertex)",
  "code": "import math\nimport backtrader as bt\n\n\nclass FairValueArbitrage(bt.Strategy):\n    def __init__(self):\n        self.order = None\n\n        # Indicators specified in the strategy\n        self.ema = bt.ind.EMA(self.data.close, period=50)\n        self.rsi = bt.ind.RSI(self.data.close, period=14)\n        self.atr = bt.ind.ATR(self.data, period=14)\n        self.bb = bt.ind.BollingerBands(self.data.close, period=20, devfactor=2)\n        self.crossover = bt.ind.CrossOver(self.data.close, self.ema)\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        close = self.data.close[0]\n        ema_val = self.ema[0]\n        spread = (close - ema_val) / ema_val\n\n        # Volatility Filter\n        annual_vol = (self.atr[0] / close) * math.sqrt(252)\n        bb_width = (self.bb.lines.top[0] - self.bb.lines.bot[0]) / self.bb.lines.mid[0]\n        vol_filter_passed = (annual_vol <= 0.80) and (bb_width < 0.30)\n\n        if self.position:\n            entry_price = self.position.price\n            basic_exit = self.crossover[0] != 0\n\n            if self.position.size > 0:  # Long\n                pnl_pct = (close - entry_price) / entry_price\n                stop_loss = pnl_pct <= -0.05\n                take_profit = pnl_pct >= 0.02\n                if basic_exit or stop_loss or take_profit:\n                    self.order = self.close()\n\n            elif self.position.size < 0:  # Short\n                pnl_pct = (entry_price - close) / entry_price\n                stop_loss = pnl_pct <= -0.05\n                take_profit = pnl_pct >= 0.02\n                if basic_exit or stop_loss or take_profit:\n                    self.order = self.close()\n        else:\n            if not vol_filter_passed:\n                return\n\n            rsi_val = self.rsi[0]\n\n            # Long Entry: Spread <= -1% and RSI(14) < 45\n            if spread <= -0.01 and rsi_val < 45:\n                multiplier = min(1.5, 1.0 + abs(spread) / 0.02)\n                base_amount = self.broker.getvalue() * 0.02\n                target_amount = base_amount * multiplier\n                size = int(target_amount / close)\n                if size < 1:\n                    size = 1\n                self.order = self.buy(size=size)\n\n            # Short Entry: Spread >= +1% and RSI(14) > 55\n            elif spread >= 0.01 and rsi_val > 55:\n                multiplier = min(1.5, 1.0 + abs(spread) / 0.02)\n                base_amount = self.broker.getvalue() * 0.02\n                target_amount = base_amount * multiplier\n                size = int(target_amount / close)\n                if size < 1:\n                    size = 1\n                self.order = self.sell(size=size)",
  "assumptions": [
    {
      "topic": "volatility_filter",
      "choice": "Combined both ATR annual volatility (<= 80%) and Bollinger Bandwidth (< 30%) filters for entry qualification.",
      "reason": "The specification states ATR annual volatility must not exceed 80% and additionally allows requiring Bollinger Bandwidth < 30%."
    },
    {
      "topic": "position_sizing",
      "choice": "Used a base capital fraction of 2% of total portfolio equity scaled by the specified formula multiplier = min(1.5, 1 + |Spread|/0.02), enforced to a minimum of 1 integer share.",
      "reason": "The specification provides 2% per trade as an example fixed fraction of capital alongside the explicit scaling formula."
    },
    {
      "topic": "basic_exit",
      "choice": "Triggered basic exit whenever CrossOver(Close, EMA50) != 0 while in a position.",
      "reason": "The specification defines the basic exit as price crossing the 50-period EMA fair value via the CrossOver indicator."
    }
  ],

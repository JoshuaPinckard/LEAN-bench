  "model": "gpt-5.6-terra(medium)",
  "code": "import backtrader as bt\nimport math\nfrom collections import namedtuple\n\n\nclass DonchianADXATRStrategy(bt.Strategy):\n    params = (\n        ('donchian_period', 20),\n        ('adx_period', 14),\n        ('atr_period', 14),\n    )\n\n    def __init__(self):\n        DonchianChannel = namedtuple('DonchianChannel', ['top', 'bottom'])\n        self.donchian = DonchianChannel(\n            top=bt.indicators.Highest(self.data.high(-1), period=self.p.donchian_period),\n            bottom=bt.indicators.Lowest(self.data.low(-1), period=self.p.donchian_period),\n        )\n        self.adx = bt.indicators.ADX(self.data, period=self.p.adx_period)\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n\n        self.order = None\n        self.stop_order = None\n\n    def _stop_distance(self, entry_price):\n        return max(2 * self.atr[0], 0.02 * entry_price)\n\n    def _cancel_stop(self):\n        if self.stop_order is not None:\n            self.cancel(self.stop_order)\n\n    def next(self):\n        if self.order is not None:\n            return\n\n        if self.position:\n            if (self.position.size > 0 and\n                    self.data.close[0] < self.donchian.bottom[0]):\n                self._cancel_stop()\n                self.order = self.close()\n            elif (self.position.size < 0 and\n                    self.data.close[0] > self.donchian.top[0]):\n                self._cancel_stop()\n                self.order = self.close()\n            return\n\n        if self.stop_order is not None:\n            return\n\n        entry_price = self.data.close[0]\n        stop_dist = self._stop_distance(entry_price)\n        size = math.floor((self.broker.getvalue() * 0.01) / stop_dist)\n\n        if size <= 0:\n            return\n\n        if self.data.close[0] > self.donchian.top[0] and self.adx[0] > 25:\n            self.order = self.buy(size=size)\n        elif self.data.close[0] < self.donchian.bottom[0] and self.adx[0] > 25:\n            self.order = self.sell(size=size)\n\n    def notify_order(self, order):\n        if order.status in (order.Submitted, order.Accepted):\n            return\n\n        if order.status == order.Completed:\n            if order == self.order:\n                self.order = None\n\n                if order.isbuy() and self.position.size > 0:\n                    stop_price = order.executed.price - self._stop_distance(order.executed.price)\n                    self.stop_order = self.sell(\n                        size=order.executed.size,\n                        exectype=bt.Order.Stop,\n                        price=stop_price,\n                    )\n                elif order.issell() and self.position.size < 0:\n                    stop_price = order.executed.price + self._stop_distance(order.executed.price)\n                    self.stop_order = self.buy(\n                        size=abs(order.executed.size),\n                        exectype=bt.Order.Stop,\n                        price=stop_price,\n                    )\n\n            if order == self.stop_order:\n                self.stop_order = None\n\n        elif order.status in (order.Canceled, order.Margin, order.Rejected):\n            if order == self.order:\n                self.order = None\n            if order == self.stop_order:\n                self.stop_order = None",
  "assumptions": [
    {
      "topic": "DonchianChannel definition",
      "choice": "top and bottom use the prior 20 bars' highs and lows, excluding the current bar.",
      "reason": "Including the current bar would make close > top and close < bottom impossible with standard OHLC bars."
    },
    {
      "topic": "Market-entry fill timing",
      "choice": "Risk size is calculated from the signal bar close; the protective stop is submitted after the market entry completes, using its actual executed price and ATR on that entry bar.",
      "reason": "A standard Backtrader market order's executed price is unavailable when the entry signal is issued."
    },
    {
      "topic": "Bracket implementation",
      "choice": "A standalone protective stop is submitted after entry completion and canceled before a Donchian-based close.",
      "reason": "This preserves the specified stop distance from the actual entry price while ensuring only one open position."
    }
  ],

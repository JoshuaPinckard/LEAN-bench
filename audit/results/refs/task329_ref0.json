  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass ATRVolatilityFadeStrategy(bt.Strategy):\n    params = (\n        ('atr_period', 14),\n        ('atr_sma_period', 20),\n        ('atr_std_period', 20),\n        ('close_sma_period', 20),\n        ('stop_loss_pct', 0.02),\n    )\n\n    def __init__(self):\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.atr_sma = bt.indicators.SMA(self.atr, period=self.p.atr_sma_period)\n        self.atr_std = bt.indicators.StandardDeviation(self.atr, period=self.p.atr_std_period)\n        self.close_sma = bt.indicators.SMA(self.data.close, period=self.p.close_sma_period)\n        self.atr_cross = bt.indicators.CrossOver(self.atr, self.atr_sma)\n\n        self.order = None\n        self.stop_order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order == self.stop_order:\n            if order.status == order.Completed:\n                self.stop_order = None\n                self.order = None\n            elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n                self.stop_order = None\n            return\n\n        if order.status == order.Completed:\n            if self.position:\n                price = order.executed.price\n                if order.isbuy():\n                    stop_price = price * (1 - self.p.stop_loss_pct)\n                    self.stop_order = self.sell(exectype=bt.Order.Stop, price=stop_price)\n                else:\n                    stop_price = price * (1 + self.p.stop_loss_pct)\n                    self.stop_order = self.buy(exectype=bt.Order.Stop, price=stop_price)\n            else:\n                if self.stop_order is not None:\n                    self.cancel(self.stop_order)\n            self.order = None\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            upper_band = self.atr_sma[0] + 2 * self.atr_std[0]\n            lower_band = self.atr_sma[0] - 2 * self.atr_std[0]\n\n            if self.atr[0] < lower_band and self.data.close[0] < self.close_sma[0]:\n                self.order = self.buy()\n            elif self.atr[0] > upper_band and self.data.close[0] > self.close_sma[0]:\n                self.order = self.sell()\n        else:\n            if self.position.size > 0 and self.atr_cross[0] > 0:\n                self.order = self.close()\n            elif self.position.size < 0 and self.atr_cross[0] < 0:\n                self.order = self.close()",
  "assumptions": [
    {
      "topic": "stop-loss percentage",
      "choice": "2% (0.02) percent-based stop-loss applied via a stop order placed immediately after entry fills, at entry_price * (1 - 0.02) for longs and entry_price * (1 + 0.02) for shorts",
      "reason": "Spec requires a percent-based stop-loss on all positions but does not state the percentage; 2% is a reasonable medium-risk default for an intraday 5m mean-reversion strategy and is declared explicitly as required."
    },
    {
      "topic": "stop-loss order mechanics",
      "choice": "Implemented as a bt.Order.Stop (stop-market) order submitted right after entry order completion, canceled if the position is closed first via the ATR-cross exit signal",
      "reason": "Backtrader has no native built-in percent-stop primitive callable from spec text alone; a stop order tied to the fill price is the standard literal implementation of a percent-based stop-loss in this environment."
    }

  "code": "import backtrader as bt\n\n\nclass MeanReversionStrategy(bt.Strategy):\n    params = (\n        ('rsi_period', 14),\n        ('band_period', 20),\n    )\n\n    def __init__(self):\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.p.rsi_period)\n        self.rsi_sma = bt.indicators.SMA(self.rsi, period=self.p.band_period)\n        self.rsi_std = bt.indicators.StandardDeviation(\n            self.rsi, period=self.p.band_period\n        )\n        self.upper_band = self.rsi_sma + 2 * self.rsi_std\n        self.lower_band = self.rsi_sma - 2 * self.rsi_std\n\n        self.order = None\n        self.stop_order = None\n        self.entry_direction = None\n        self.was_below_lower = False\n        self.was_above_upper = False\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled,\n                            order.Margin, order.Rejected]:\n            if order == self.order:\n                self.order = None\n\n            if order == self.stop_order:\n                self.stop_order = None\n\n            if order.status == order.Completed:\n                if order.isbuy() and self.entry_direction == 'long':\n                    self.stop_order = self.sell(\n                        exectype=bt.Order.Stop,\n                        price=order.executed.price * 0.98,\n                    )\n                elif order.issell() and self.entry_direction == 'short':\n                    self.stop_order = self.buy(\n                        exectype=bt.Order.Stop,\n                        price=order.executed.price * 1.02,\n                    )\n\n            if not self.position and order == self.stop_order:\n                self.entry_direction = None\n\n    def next(self):\n        if self.order:\n            return\n\n        rsi = self.rsi[0]\n        rsi_sma = self.rsi_sma[0]\n\n        crosses_up_sma = self.rsi[-1] <= self.rsi_sma[-1] and rsi > rsi_sma\n        crosses_down_sma = self.rsi[-1] >= self.rsi_sma[-1] and rsi < rsi_sma\n\n        if self.position:\n            if ((self.position.size > 0 and crosses_down_sma) or\n                    (self.position.size < 0 and crosses_up_sma)):\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                self.order = self.close()\n                self.entry_direction = None\n            return\n\n        if rsi < self.lower_band[0]:\n            self.was_below_lower = True\n\n        if rsi > self.upper_band[0]:\n            self.was_above_upper = True\n\n        if self.was_below_lower and crosses_up_sma:\n            self.order = self.buy()\n            self.entry_direction = 'long'\n            self.was_below_lower = False\n            self.was_above_upper = False\n        elif self.was_above_upper and crosses_down_sma:\n            self.order = self.sell()\n            self.entry_direction = 'short'\n            self.was_below_lower = False\n            self.was_above_upper = False",

  "code": "import backtrader as bt\n\n\nclass IntradayMeanReversionStrategy(bt.Strategy):\n    params = (\n        ('bb_period', 20),\n        ('bb_devfactor', 2.0),\n        ('stoch_period', 14),\n        ('stoch_period_dfast', 3),\n        ('stoch_period_dslow', 3),\n    )\n\n    def __init__(self):\n        self.bbands = bt.indicators.BollingerBands(\n            self.data.close,\n            period=self.p.bb_period,\n            devfactor=self.p.bb_devfactor,\n        )\n        self.stochastic = bt.indicators.Stochastic(\n            self.data,\n            period=self.p.stoch_period,\n            period_dfast=self.p.stoch_period_dfast,\n            period_dslow=self.p.stoch_period_dslow,\n        )\n        self.order = None\n        self.entry_price = None\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            if order.isbuy() and self.position.size > 0:\n                self.entry_price = order.executed.price\n            elif order.issell() and self.position.size < 0:\n                self.entry_price = order.executed.price\n            elif self.position.size == 0:\n                self.entry_price = None\n\n        if order.status in (order.Completed, order.Canceled,\n                            order.Margin, order.Rejected):\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        long_signal = (\n            self.data.low[0] <= self.bbands.bot[0]\n            and self.stochastic.percK[0] < 20\n        )\n        short_signal = (\n            self.data.high[0] >= self.bbands.top[0]\n            and self.stochastic.percK[0] > 80\n        )\n\n        if not self.position:\n            if long_signal:\n                self.order = self.buy()\n            elif short_signal:\n                self.order = self.sell()\n            return\n\n        if self.position.size > 0:\n            stop_loss = (\n                self.entry_price is not None\n                and self.data.low[0] <= self.entry_price * 0.98\n            )\n            if short_signal or stop_loss:\n                self.order = self.close()\n\n        elif self.position.size < 0:\n            stop_loss = (\n                self.entry_price is not None\n                and self.data.high[0] >= self.entry_price * 1.02\n            )\n            if long_signal or stop_loss:\n                self.order = self.close()",

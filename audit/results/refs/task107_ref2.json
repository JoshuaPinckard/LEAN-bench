  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass CombinedMomentumStrategy(bt.Strategy):\n    params = (\n        (\"rsi_period\", 14),\n        (\"rsi_lower_entry\", 40.0),\n        (\"rsi_upper_entry\", 60.0),\n        (\"rsi_long_exit\", 70.0),\n        (\"rsi_short_exit\", 30.0),\n        (\"macd_fast\", 12),\n        (\"macd_slow\", 26),\n        (\"macd_signal\", 9),\n        (\"sma_period\", 20),\n        (\"atr_period\", 14),\n        (\"atr_threshold\", 0.02),\n        (\"stop_loss\", 0.01),\n        (\"take_profit\", 0.02),\n        (\"capital_risk_pct\", 0.01),\n    )\n\n    def __init__(self):\n        self.rsi = bt.indicators.RSI(\n            self.data.close, period=self.p.rsi_period\n        )\n        self.macd = bt.indicators.MACD(\n            self.data.close,\n            period_me1=self.p.macd_fast,\n            period_me2=self.p.macd_slow,\n            period_signal=self.p.macd_signal,\n        )\n        self.macd_cross = bt.indicators.CrossOver(\n            self.macd.macd, self.macd.signal\n        )\n        self.sma = bt.indicators.SMA(\n            self.data.close, period=self.p.sma_period\n        )\n        self.momentum = self.data.close - self.sma\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n\n        self.order = None\n        self.sl_order = None\n        self.tp_order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order == self.order:\n                self.order = None\n                entry_price = order.executed.price\n                size = abs(order.executed.size)\n                if self.position.size > 0:\n                    sl_price = entry_price * (1.0 - self.p.stop_loss)\n                    tp_price = entry_price * (1.0 + self.p.take_profit)\n                    self.sl_order = self.sell(\n                        size=size, exectype=bt.Order.Stop, price=sl_price\n                    )\n                    self.tp_order = self.sell(\n                        size=size, exectype=bt.Order.Limit, price=tp_price\n                    )\n                elif self.position.size < 0:\n                    sl_price = entry_price * (1.0 + self.p.stop_loss)\n                    tp_price = entry_price * (1.0 - self.p.take_profit)\n                    self.sl_order = self.buy(\n                        size=size, exectype=bt.Order.Stop, price=sl_price\n                    )\n                    self.tp_order = self.buy(\n                        size=size, exectype=bt.Order.Limit, price=tp_price\n                    )\n            elif order in [self.sl_order, self.tp_order]:\n                if order == self.sl_order and self.tp_order:\n                    self.cancel(self.tp_order)\n                elif order == self.tp_order and self.sl_order:\n                    self.cancel(self.sl_order)\n                self.sl_order = None\n                self.tp_order = None\n\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order == self.order:\n                self.order = None\n            if order == self.sl_order:\n                self.sl_order = None\n            if order == self.tp_order:\n                self.tp_order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            if self.atr[0] > self.p.atr_threshold * self.data.close[0]:\n                return\n\n            rsi_val = self.rsi[0]\n            in_neutral_rsi = (\n                self.p.rsi_lower_entry <= rsi_val <= self.p.rsi_upper_entry\n            )\n\n            if (\n                in_neutral_rsi\n                and self.macd_cross[0] > 0\n                and self.momentum[0] > 0\n            ):\n                size = (\n                    self.broker.getvalue() * self.p.capital_risk_pct\n                ) / self.data.close[0]\n                if size > 0:\n                    self.order = self.buy(size=size)\n\n            elif (\n                in_neutral_rsi\n                and self.macd_cross[0] < 0\n                and self.momentum[0] < 0\n            ):\n                size = (\n                    self.broker.getvalue() * self.p.capital_risk_pct\n                ) / self.data.close[0]\n                if size > 0:\n                    self.order = self.sell(size=size)\n\n        else:\n            if self.position.size > 0:\n                if (\n                    self.rsi[0] > self.p.rsi_long_exit\n                    or self.macd_cross[0] < 0\n                ):\n                    if self.sl_order:\n                        self.cancel(self.sl_order)\n                        self.sl_order = None\n                    if self.tp_order:\n                        self.cancel(self.tp_order)\n                        self.tp_order = None\n                    self.order = self.close()\n            elif self.position.size < 0:\n                if (\n                    self.rsi[0] < self.p.rsi_short_exit\n                    or self.macd_cross[0] > 0\n                ):\n                    if self.sl_order:\n                        self.cancel(self.sl_order)\n                        self.sl_order = None\n                    if self.tp_order:\n                        self.cancel(self.tp_order)\n                        self.tp_order = None\n                    self.order = self.close()",
  "assumptions": [
    {
      "topic": "momentum_indicator",
      "choice": "Close minus 20-period SMA",
      "reason": "The specification defined momentum as the difference between the current price and a moving average; a 20-period SMA was selected as the moving average baseline."
    },
    {
      "topic": "atr_period",
      "choice": "14-period ATR",
      "reason": "The specification mentioned using ATR for volatility filtering without giving a period, so standard 14-period ATR was chosen."
    },
    {
      "topic": "rsi_range_bounds",
      "choice": "Inclusive bounds 40 <= RSI <= 60",
      "reason": "The range 40 to 60 for entry is implemented as inclusive bounds."
    },
    {
      "topic": "position_limit",
      "choice": "Max 1 open position due to single data feed",
      "reason": "The single-asset execution environment naturally restricts open positions to at most 1, which inherently fulfills the 'no new positions if open positions reached 3' rule."
    },
    {
      "topic": "position_sizing",
      "choice": "Position size = (0.01 * total capital) / entry bar close price",
      "reason": "The spec states position size must be 1% of total capital per trade."
    }
  ],

  "code": "import backtrader as bt\n\n\nclass IntradayTrendStrategy(bt.Strategy):\n    def __init__(self):\n        self.sma = bt.indicators.SimpleMovingAverage(self.data.close, period=20)\n        self.atr = bt.indicators.AverageTrueRange(self.data, period=14)\n        self.upper_band = self.sma + (2 * self.atr)\n        self.lower_band = self.sma - (2 * self.atr)\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        close = self.data.close[0]\n\n        if not self.position:\n            if close > self.upper_band[0]:\n                self.order = self.buy()\n            elif close < self.lower_band[0]:\n                self.order = self.sell()\n            return\n\n        if self.position.size > 0:\n            crossed_baseline = (\n                self.data.close[-1] >= self.sma[-1] and close < self.sma[0]\n            )\n            stop_hit = self.data.low[0] <= self.lower_band[0]\n\n            if crossed_baseline or stop_hit:\n                self.order = self.close()\n\n        elif self.position.size < 0:\n            crossed_baseline = (\n                self.data.close[-1] <= self.sma[-1] and close > self.sma[0]\n            )\n            stop_hit = self.data.high[0] >= self.upper_band[0]\n\n            if crossed_baseline or stop_hit:\n                self.order = self.close()",
  "assumptions": [
    {
      "topic": "stop-loss placement and adaptation",
      "choice": "For long positions, the stop-loss threshold is the current lower ATR-adjusted band; for short positions, it is the current upper ATR-adjusted band. The threshold is evaluated on every bar using the bar low/high, respectively.",
      "reason": "The specification requires stops to adapt to the ATR-adjusted bands and widen as volatility increases, but does not specify a separate stop distance or order type."
    },
    {
      "topic": "stop-loss execution",
      "choice": "When a bar reaches the applicable adaptive band, submit self.close() on that bar.",
      "reason": "The canonical convention defines an unspecified exit as self.close(); the specification does not define intrabar stop-order fill behavior."
    },
    {
      "topic": "baseline exit crossing",
      "choice": "A long exits when close crosses from at-or-above the SMA to below it; a short exits when close crosses from at-or-below the SMA to above it.",
      "reason": "The specification says price crosses back through the baseline but does not define equality handling."
    }

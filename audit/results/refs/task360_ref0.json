  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass BollingerAtrTrailStrategy(bt.Strategy):\n    params = (\n        ('boll_period', 20),\n        ('boll_devfactor', 2.0),\n        ('atr_period', 14),\n        ('atr_avg_period', 20),\n        ('atr_stop_mult', 2.0),\n    )\n\n    def __init__(self):\n        self.boll = bt.indicators.BollingerBands(\n            self.data, period=self.p.boll_period, devfactor=self.p.boll_devfactor)\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.atr_sma = bt.indicators.SMA(self.atr, period=self.p.atr_avg_period)\n\n        self.cross_top = bt.indicators.CrossOver(self.data.close, self.boll.lines.top)\n        self.cross_bot = bt.indicators.CrossOver(self.data.close, self.boll.lines.bot)\n\n        self.order = None\n        self.entry_price = None\n        self.stop_price = None\n        self.highest_close = None\n        self.lowest_close = None\n\n    def notify_order(self, order):\n        if order.status in (order.Submitted, order.Accepted):\n            return\n        if order.status == order.Completed:\n            if self.position.size != 0:\n                self.entry_price = order.executed.price\n                self.highest_close = self.data.close[0]\n                self.lowest_close = self.data.close[0]\n                if self.position.size > 0:\n                    self.stop_price = self.entry_price - self.p.atr_stop_mult * self.atr[0]\n                else:\n                    self.stop_price = self.entry_price + self.p.atr_stop_mult * self.atr[0]\n            else:\n                self.entry_price = None\n                self.stop_price = None\n                self.highest_close = None\n                self.lowest_close = None\n        self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        vol_filter = self.atr[0] > self.atr_sma[0]\n        long_signal = self.cross_top[0] == 1 and vol_filter\n        short_signal = self.cross_bot[0] == -1 and vol_filter\n\n        if not self.position:\n            if long_signal:\n                self.order = self.buy()\n            elif short_signal:\n                self.order = self.sell()\n            return\n\n        if self.position.size > 0:\n            self.highest_close = max(self.highest_close, self.data.close[0])\n            self.stop_price = max(\n                self.stop_price, self.highest_close - self.p.atr_stop_mult * self.atr[0])\n            if self.data.close[0] <= self.stop_price or short_signal:\n                self.order = self.close()\n        elif self.position.size < 0:\n            self.lowest_close = min(self.lowest_close, self.data.close[0])\n            self.stop_price = min(\n                self.stop_price, self.lowest_close + self.p.atr_stop_mult * self.atr[0])\n            if self.data.close[0] >= self.stop_price or long_signal:\n                self.order = self.close()",
  "assumptions": [
    {
      "topic": "crossover_detection",
      "choice": "Use backtrader's CrossOver indicator on close vs. the Bollinger top/bottom lines (previous bar on one side, current bar on the other) to detect 'crosses above/below', for both entry signals and the opposite-band exit signal.",
      "reason": "Spec says 'crosses above/below' but does not define the crossing test explicitly; CrossOver is the standard backtrader primitive for this and is applied identically everywhere the spec uses the phrase."
    },
    {
      "topic": "stop_hit_price_reference",
      "choice": "Test whether the trailing stop is hit using the bar's close price (not intrabar high/low).",
      "reason": "The spec defines the trailing stop itself in terms of highest/lowest close since entry, so the exit test uses the same close-based reference for consistency; the spec never mentions high/low for stop evaluation."
    },
    {
      "topic": "trailing_stop_initialization_timing",
      "choice": "Initialize entry_price, highest/lowest-close-since-entry, and the trailing stop in notify_order at the bar the entry order fills, using that bar's ATR and close; trailing updates then proceed in next() each subsequent bar (including the fill bar itself if notify_order and next() coincide for that bar).",
      "reason": "Spec states the stop 'starts at entry' and trails 'each bar' but does not specify bar-alignment relative to order-fill timing, which is otherwise fixed by backtrader's standard next-bar-open execution model."
    }
  ],

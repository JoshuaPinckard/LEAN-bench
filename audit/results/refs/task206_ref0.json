  "code": "import backtrader as bt\n\n\nclass VolAdaptiveMeanReversionStrategy(bt.Strategy):\n    params = (\n        ('bb_period', 30),\n        ('bb_devfactor', 2.0),\n        ('atr_period', 14),\n        ('atr_ema_period', 50),\n        ('base_threshold', 2.0),\n        ('vr_low', 0.7),\n        ('vr_high', 1.6),\n        ('rsi_period', 14),\n        ('rsi_long_max', 45),\n        ('rsi_short_min', 55),\n        ('vol_sma_period', 20),\n        ('use_filters', True),\n        ('stop_atr_mult', 1.5),\n        ('time_stop_bars', 7),\n        ('risk_pct', 0.015),\n    )\n\n    def __init__(self):\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close, period=self.p.bb_period, devfactor=self.p.bb_devfactor)\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.atr_ema = bt.indicators.EMA(self.atr, period=self.p.atr_ema_period)\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.p.rsi_period)\n        self.vol_sma = bt.indicators.SMA(self.data.volume, period=self.p.vol_sma_period)\n\n        self.order = None\n        self.entry_bar = None\n        self.entry_price = None\n        self.stop_price = None\n        self.prev_z = None\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            if self.position.size != 0:\n                self.entry_price = order.executed.price\n                self.entry_bar = len(self)\n                if self.position.size > 0:\n                    self.stop_price = self.entry_price - self.p.stop_atr_mult * self.atr[0]\n                else:\n                    self.stop_price = self.entry_price + self.p.stop_atr_mult * self.atr[0]\n            else:\n                self.entry_price = None\n                self.entry_bar = None\n                self.stop_price = None\n\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        mid = self.bb.mid[0]\n        upper = self.bb.top[0]\n        std = (upper - mid) / 2.0\n        if std == 0:\n            self.prev_z = None\n            return\n        z = (self.data.close[0] - mid) / std\n\n        atr_val = self.atr[0]\n        atr_ema_val = self.atr_ema[0]\n        vr = atr_val / atr_ema_val if atr_ema_val != 0 else 1.0\n        clipped_vr = max(self.p.vr_low, min(self.p.vr_high, vr))\n        T = self.p.base_threshold * clipped_vr\n\n        if self.position:\n            exit_signal = False\n            if self.prev_z is not None and (\n                    (self.prev_z < 0 and z >= 0) or (self.prev_z > 0 and z <= 0)):\n                exit_signal = True\n            if self.stop_price is not None:\n                if self.position.size > 0 and self.data.close[0] <= self.stop_price:\n                    exit_signal = True\n                elif self.position.size < 0 and self.data.close[0] >= self.stop_price:\n                    exit_signal = True\n            if self.entry_bar is not None and (len(self) - self.entry_bar) >= self.p.time_stop_bars:\n                exit_signal = True\n\n            if exit_signal:\n                self.order = self.close()\n        else:\n            long_signal = z < -T\n            short_signal = z > T\n            if self.p.use_filters:\n                long_signal = long_signal and (self.rsi[0] < self.p.rsi_long_max) and \\\n                    (self.data.volume[0] > self.vol_sma[0])\n                short_signal = short_signal and (self.rsi[0] > self.p.rsi_short_min) and \\\n                    (self.data.volume[0] > self.vol_sma[0])\n\n            per_share_risk = self.p.stop_atr_mult * atr_val\n            size = int((self.p.risk_pct * self.broker.getvalue()) / per_share_risk) if per_share_risk > 0 else 0\n\n            if long_signal and size > 0:\n                self.order = self.buy(size=size)\n            elif short_signal and size > 0:\n                self.order = self.sell(size=size)\n\n        self.prev_z = z",

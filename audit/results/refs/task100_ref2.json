  "code": "import backtrader as bt\n\n\nclass DcaRsiStrategy(bt.Strategy):\n    params = (\n        ('rsi_period', 14),\n        ('rsi_oversold', 30.0),\n        ('rsi_overbought', 70.0),\n        ('rsi_neutral', 50.0),\n        ('dca_pct', 0.017),\n        ('position_pct', 0.01),\n    )\n\n    def __init__(self):\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.p.rsi_period)\n        self.order = None\n        self.primary_price = None\n        self.dca_done = False\n        self.initial_cash = None\n\n    def start(self):\n        self.initial_cash = self.broker.getvalue()\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status == order.Completed:\n            if self.position.size == 0:\n                self.primary_price = None\n                self.dca_done = False\n            else:\n                if self.primary_price is None:\n                    self.primary_price = order.executed.price\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if self.position.size == 0:\n                self.primary_price = None\n                self.dca_done = False\n            else:\n                self.dca_done = False\n\n        self.order = None\n\n    def next(self):\n        if self.order is not None:\n            return\n\n        if self.initial_cash is None:\n            self.initial_cash = self.broker.getvalue()\n\n        size = (self.initial_cash * self.p.position_pct) / self.data.close[0]\n\n        if not self.position:\n            if self.rsi[0] < self.p.rsi_oversold:\n                self.order = self.buy(size=size)\n            elif self.rsi[0] > self.p.rsi_overbought:\n                self.order = self.sell(size=size)\n        else:\n            if self.position.size > 0:\n                if self.rsi[0] > self.p.rsi_neutral:\n                    self.order = self.close()\n                elif not self.dca_done and self.primary_price is not None:\n                    if self.data.close[0] <= self.primary_price * (1.0 - self.p.dca_pct):\n                        self.order = self.buy(size=size)\n                        self.dca_done = True\n            elif self.position.size < 0:\n                if self.rsi[0] < self.p.rsi_neutral:\n                    self.order = self.close()\n                elif not self.dca_done and self.primary_price is not None:\n                    if self.data.close[0] >= self.primary_price * (1.0 + self.p.dca_pct):\n                        self.order = self.sell(size=size)\n                        self.dca_done = True",
  "assumptions": [

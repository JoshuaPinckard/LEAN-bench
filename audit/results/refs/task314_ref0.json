  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass MACDATRStrategy(bt.Strategy):\n    params = dict(\n        macd_fast=12,\n        macd_slow=26,\n        macd_signal=9,\n        atr_period=14,\n        risk_fraction=0.01,\n        stop_pct=0.02,\n    )\n\n    def __init__(self):\n        self.macd = bt.indicators.MACD(\n            self.data.close,\n            period_me1=self.p.macd_fast,\n            period_me2=self.p.macd_slow,\n            period_signal=self.p.macd_signal,\n        )\n        self.crossover = bt.indicators.CrossOver(self.macd.macd, self.macd.signal)\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.order = None\n        self.entry_price = None\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            if self.position:\n                self.entry_price = order.executed.price\n            else:\n                self.entry_price = None\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if self.position:\n            if self.position.size > 0:\n                stop_price = self.entry_price * (1 - self.p.stop_pct)\n                stop_triggered = self.data.low[0] <= stop_price\n                signal_exit = self.crossover[0] < 0\n            else:\n                stop_price = self.entry_price * (1 + self.p.stop_pct)\n                stop_triggered = self.data.high[0] >= stop_price\n                signal_exit = self.crossover[0] > 0\n\n            if stop_triggered or signal_exit:\n                self.order = self.close()\n            return\n\n        if self.atr[0] <= 0:\n            return\n\n        size = int((self.broker.getvalue() * self.p.risk_fraction) / self.atr[0])\n        if size < 1:\n            size = 1\n\n        if self.crossover[0] > 0:\n            self.order = self.buy(size=size)\n        elif self.crossover[0] < 0:\n            self.order = self.sell(size=size)",
  "assumptions": [
    {
      "topic": "MACD parameters",
      "choice": "Used standard MACD(12, 26, 9) periods.",
      "reason": "Spec names the MACD/signal-line crossover but states no fast/slow/signal periods; 12/26/9 is the universal default convention, so no other parameterization is implied."
    },
    {
      "topic": "ATR period",
      "choice": "Used ATR with period=14.",
      "reason": "Spec requires ATR-based sizing but states no lookback period; 14 is the standard default for ATR."
    },
    {
      "topic": "ATR-based position sizing formula",
      "choice": "size = floor(portfolio_value * 1% / ATR), minimum 1 share, recomputed at each new entry using the ATR value on the entry bar.",
      "reason": "Spec only states the qualitative relationship (higher ATR -> smaller size, to keep risk consistent) without a formula or risk percentage; equity_fraction / ATR is the standard volatility-normalized sizing approach and 1% is a conventional risk fraction."
    },
    {
      "topic": "Stop-loss vs opposite-signal precedence",
      "choice": "Each bar, the 2% stop is checked first using intrabar Low (for longs) / High (for shorts) against the stop level; the opposite MACD crossover is checked only if the stop was not hit.",
      "reason": "Spec requires exiting on 'whichever comes first' between the stop and the opposite signal; since the stop can be breached intrabar while the crossover is only confirmed at bar close, checking the stop first using High/Low is the closest literal reading of temporal precedence given only OHLCV data."
    },
    {
      "topic": "No same-bar reversal",
      "choice": "After a position is closed (via opposite crossover or stop-loss), a new position is opened only on a subsequent MACD crossover signal, not forced within the same bar as the exit.",
      "reason": "The spec states separate entry and exit rules without describing an instantaneous flip/reversal mechanic; instantly reopening the opposite side on the same bar would be an invented addition, so entries and exits are evaluated independently, one position at a time."
    }
  ],

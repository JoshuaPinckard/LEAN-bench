  "code": "import backtrader as bt\n\n\nclass KeltnerMeanReversion(bt.Strategy):\n    params = (\n        (\"ema_period\", 20),\n        (\"atr_period\", 14),\n        (\"atr_mult\", 2.0),\n        (\"sl_atr_mult\", 2.0),\n    )\n\n    def __init__(self):\n        self.order = None\n        self.entry_price = None\n        self.stop_price = None\n\n        self.middle = bt.indicators.EMA(self.data.close, period=self.p.ema_period)\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.upper = self.middle + self.p.atr_mult * self.atr\n        self.lower = self.middle - self.p.atr_mult * self.atr\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if self.position.size > 0:\n                self.entry_price = order.executed.price\n                self.stop_price = self.entry_price - (self.p.sl_atr_mult * self.atr[0])\n            elif self.position.size < 0:\n                self.entry_price = order.executed.price\n                self.stop_price = self.entry_price + (self.p.sl_atr_mult * self.atr[0])\n            else:\n                self.entry_price = None\n                self.stop_price = None\n\n        self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            bullish = self.data.close[0] > self.data.open[0]\n            bearish = self.data.close[0] < self.data.open[0]\n\n            if bullish and self.data.close[0] < self.lower[0]:\n                self.order = self.buy()\n            elif bearish and self.data.close[0] > self.upper[0]:\n                self.order = self.sell()\n        else:\n            if self.position.size > 0:\n                crossed_middle = self.data.close[0] >= self.middle[0]\n                hit_sl = (\n                    self.stop_price is not None\n                    and self.data.low[0] <= self.stop_price\n                )\n                if crossed_middle or hit_sl:\n                    self.order = self.close()\n            elif self.position.size < 0:\n                crossed_middle = self.data.close[0] <= self.middle[0]\n                hit_sl = (\n                    self.stop_price is not None\n                    and self.data.high[0] >= self.stop_price\n                )\n                if crossed_middle or hit_sl:\n                    self.order = self.close()",
  "assumptions": [
    {

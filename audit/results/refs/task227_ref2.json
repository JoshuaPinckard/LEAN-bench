  "code": "import backtrader as bt\n\n\nclass UniversalPortfolio(bt.Strategy):\n    def __init__(self):\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def next(self):\n        # Need 252 daily returns, which require 253 close prices\n        if len(self) < 253:\n            return\n\n        # Guard against pending orders\n        if self.order is not None:\n            return\n\n        # Extract close prices for the 252-day window (253 bars)\n        closes = [self.data.close[-i] for i in range(252, -1, -1)]\n        returns = [\n            closes[i] / closes[i - 1] - 1.0 for i in range(1, len(closes))\n        ]\n\n        # Candidate constant fractions w in {0.0, 0.1, ..., 1.0}\n        weights = [i / 10.0 for i in range(11)]\n        wealths = []\n\n        for w in weights:\n            wealth = 1.0\n            for r in returns:\n                wealth *= 1.0 + w * r\n            wealths.append(wealth)\n\n        total_wealth = sum(wealths)\n        if total_wealth > 0:\n            w_next = (\n                sum(w * wealth for w, wealth in zip(weights, wealths))\n                / total_wealth\n            )\n        else:\n            w_next = 0.0\n\n        # Rebalance target weight in asset\n        self.order = self.order_target_percent(target=w_next)",
  "assumptions": [
    {
      "topic": "data_requirement",
      "choice": "Require 253 consecutive close prices (len(self) >= 253) to compute 252 daily returns.",

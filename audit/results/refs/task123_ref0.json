{
  "task_id": 123,
  "ref_idx": 0,
  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass BBMATrendStrategy(bt.Strategy):\n    params = (\n        ('bb_period', 20),\n        ('bb_dev', 2),\n        ('ma_period', 44),\n        ('risk_pct', 0.02),\n        ('consolidation_pct', 0.2),\n    )\n\n    def __init__(self):\n        self.bb = bt.indicators.BollingerBands(\n            self.data, period=self.p.bb_period, devfactor=self.p.bb_dev)\n        self.sma44 = bt.indicators.SimpleMovingAverage(\n            self.data.close, period=self.p.ma_period)\n        self.bb_width = self.bb.top - self.bb.bot\n        self.bb_width_avg = bt.indicators.SimpleMovingAverage(\n            self.bb_width, period=self.p.bb_period)\n        self.crossover_ma = bt.indicators.CrossOver(self.data.close, self.sma44)\n\n        self.order = None\n        self.stop_order = None\n        self.pending_stop_price = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order is self.stop_order:\n            if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n                self.stop_order = None\n                if order.status == order.Completed:\n                    self.pending_stop_price = None\n            return\n\n        if order.status == order.Completed:\n            if self.position and self.pending_stop_price is not None:\n                size = abs(self.position.size)\n                stop_price = self.pending_stop_price\n                self.pending_stop_price = None\n                if self.position.size > 0:\n                    self.stop_order = self.sell(\n                        exectype=bt.Order.Stop, price=stop_price, size=size)\n                else:\n                    self.stop_order = self.buy(\n                        exectype=bt.Order.Stop, price=stop_price, size=size)\n            elif self.stop_order is not None:\n                self.cancel(self.stop_order)\n        else:\n            self.pending_stop_price = None\n\n        self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if self.position:\n            if self.position.size > 0:\n                if self.data.close[0] < self.bb.top[0] or self.crossover_ma[0] < 0:\n                    if self.stop_order is not None:\n                        self.cancel(self.stop_order)\n                    self.order = self.close()\n            elif self.position.size < 0:\n                if self.data.close[0] > self.bb.bot[0] or self.crossover_ma[0] > 0:\n                    if self.stop_order is not None:\n                        self.cancel(self.stop_order)\n                    self.order = self.close()\n            return\n\n        if self.bb_width[0] < self.p.consolidation_pct * self.bb_width_avg[0]:\n            return\n\n        if self.data.close[0] > self.sma44[0] and self.data.close[0] > self.bb.top[0]:\n            stop_price = self.bb.bot[0]\n            risk_per_share = self.data.close[0] - stop_price\n            if risk_per_share > 0:\n                risk_amount = self.p.risk_pct * self.broker.getvalue()\n                size = risk_amount / risk_per_share\n                self.pending_stop_price = stop_price\n                self.order = self.buy(size=size)\n        elif self.data.close[0] < self.sma44[0] and self.data.close[0] < self.bb.bot[0]:\n            stop_price = self.bb.top[0]\n            risk_per_share = stop_price - self.data.close[0]\n            if risk_per_share > 0:\n                risk_amount = self.p.risk_pct * self.broker.getvalue()\n                size = risk_amount / risk_per_share\n                self.pending_stop_price = stop_price\n                self.order = self.sell(size=size)",
  "assumptions": [
    {
      "topic": "position sizing formula",
      "choice": "size = (2% of current broker equity) / (entry-signal close price - opposite Bollinger Band price at signal time)",
      "reason": "Spec states 'fixed percentage of capital per trade (e.g., 2% risk per trade)' without giving the exact formula; risk-based sizing using distance to the stated stop-loss level (opposite band) is the standard interpretation that ties position size directly to the spec's own risk-management stop."
    },
    {
      "topic": "stop-loss price fixing",
      "choice": "Stop-loss price is computed once from the opposite Bollinger Band value at the moment the breakout signal fires, then held fixed (not re-anchored to the band on later bars) for the life of the trade",
      "reason": "The Bollinger Bands recompute every bar, so a literal 'stop at the opposite band' would require continuously replacing the stop order; the spec describes a single placement action ('place a stop loss'), not a trailing mechanism, so freezing at signal time is the closest literal reading."
    },
    {
      "topic": "stop-loss order mechanics",
      "choice": "Implemented as a broker-side bt.Order.Stop (intrabar trigger via High/Low) submitted immediately after the entry order fills, sized to match the position and canceled whenever the position is closed via the close-based exit rules",
      "reason": "A stop loss conventionally triggers intrabar on price touching the stop level, distinct from the close-based exit conditions (which are checked once per bar in next()); using a real stop order is the closest literal reading of 'place a stop loss.'"
    },
    {
      "topic": "price reference for trend/breakout/consolidation checks",
      "choice": "Use the daily close for all 'price above/below MA', 'breakout above/below band', and consolidation-width comparisons",
      "reason": "Spec uses unqualified 'price' and its own exit language explicitly references 'closes back below/above,' so close is the consistent field to use across all comparisons; feed provides no other unambiguous 'price' series."
    },
    {
      "topic": "risk capital base",
      "choice": "'Capital' for the 2% risk calculation is taken as total broker equity (self.broker.getvalue()) at signal time, not just free cash",
      "reason": "Spec says 'percentage of capital,' which is standard shorthand for account equity in risk-based position sizing; no other capital definition is available in this environment."
    }
  ],

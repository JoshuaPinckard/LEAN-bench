  "code": "import backtrader as bt\n\n\nclass SupertrendStrategy(bt.Strategy):\n    params = (\n        (\"atr_period\", 10),\n        (\"multiplier\", 3.0),\n    )\n\n    def __init__(self):\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.order = None\n        self.prev_final_upper = None\n        self.prev_final_lower = None\n        self.prev_trend = None\n        self.prev_close = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        close_val = self.data.close[0]\n        high_val = self.data.high[0]\n        low_val = self.data.low[0]\n        atr_val = self.atr[0]\n\n        hl2 = (high_val + low_val) / 2.0\n        basic_upper = hl2 + self.p.multiplier * atr_val\n        basic_lower = hl2 - self.p.multiplier * atr_val\n\n        if self.prev_final_upper is None:\n            final_upper = basic_upper\n            final_lower = basic_lower\n            if close_val <= final_upper:\n                trend = -1\n            else:\n                trend = 1\n        else:\n            if basic_upper < self.prev_final_upper or self.prev_close > self.prev_final_upper:\n                final_upper = basic_upper\n            else:\n                final_upper = self.prev_final_upper\n\n            if basic_lower > self.prev_final_lower or self.prev_close < self.prev_final_lower:\n                final_lower = basic_lower\n            else:\n                final_lower = self.prev_final_lower\n\n            if self.prev_trend == 1:\n                if close_val < final_lower:\n                    trend = -1\n                else:\n                    trend = 1\n            else:\n                if close_val > final_upper:\n                    trend = 1\n                else:\n                    trend = -1\n\n        if not self.order and self.prev_trend is not None:\n            if self.prev_trend == -1 and trend == 1:\n                if self.position.size < 0:\n                    self.close()\n                    self.order = self.buy()\n                elif self.position.size == 0:\n                    self.order = self.buy()\n            elif self.prev_trend == 1 and trend == -1:\n                if self.position.size > 0:\n                    self.close()\n                    self.order = self.sell()\n                elif self.position.size == 0:\n                    self.order = self.sell()\n\n        self.prev_final_upper = final_upper\n        self.prev_final_lower = final_lower\n        self.prev_trend = trend\n        self.prev_close = close_val",
  "assumptions": [
    {
      "topic": "initial_supertrend_state",
      "choice": "Set initial trend to bearish (-1) if close <= final_upper, else bullish (1), on the first bar where ATR becomes valid.",
      "reason": "Standard Supertrend initialization logic requires establishing a baseline trend direction on the first bar of calculated ATR."
    },
    {

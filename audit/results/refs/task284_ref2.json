  "code": "import backtrader as bt\n\n\nclass MomentumBollingerRSI(bt.Strategy):\n    def __init__(self):\n        self.boll = bt.indicators.BollingerBands(\n            self.data.close, period=20, devfactor=2\n        )\n        self.rsi = bt.indicators.RSI(self.data.close, period=14)\n\n        self.order = None\n        self.entry_price = None\n        self.highest_price = None\n        self.trailing_stop_loss = None\n        self.exit_signal = 0\n        self.is_entry_day = False\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order.isbuy():\n                self.entry_price = order.executed.price\n                self.trailing_stop_loss = self.entry_price * 0.99\n                self.highest_price = self.entry_price\n                self.is_entry_day = True\n            elif order.issell():\n                self.trailing_stop_loss = None\n                self.highest_price = None\n                self.entry_price = None\n\n        self.order = None\n\n    def next(self):\n        self.exit_signal = 0\n\n        if self.position:\n            if self.is_entry_day:\n                self.highest_price = max(self.highest_price, self.data.high[0])\n                self.trailing_stop_loss = max(\n                    self.trailing_stop_loss, self.highest_price * 0.99\n                )\n                self.is_entry_day = False\n            else:\n                self.highest_price = max(self.highest_price, self.data.high[0])\n                self.trailing_stop_loss = max(\n                    self.trailing_stop_loss, self.highest_price * 0.99\n                )\n\n            if self.data.close[0] <= self.trailing_stop_loss:\n                self.exit_signal = 1\n                if self.order is None:\n                    self.order = self.close()\n        else:\n            self.trailing_stop_loss = None\n            self.highest_price = None\n\n            if self.order is None:\n                cross_above = (self.data.close[0] > self.boll.top[0]) and (\n                    self.data.close[-1] <= self.boll.top[-1]\n                )\n                rsi_valid = self.rsi[0] > 55\n\n                if cross_above and rsi_valid:\n                    self.order = self.buy(size=1)",
  "assumptions": [
    {
      "topic": "entry_price",
      "choice": "Used order.executed.price on the execution bar as the entry price for initial trailing stop calculation.",
      "reason": "Market orders in Backtrader fill on the bar following the signal generation, making order.executed.price the actual trade entry price."
    },
    {
      "topic": "crossover_definition",
      "choice": "Implemented 'closing price crosses above the upper Bollinger Band' as close[0] > top[0] and close[-1] <= top[-1].",
      "reason": "This precisely defines an upward line crossing event on daily bars."
    },
    {
      "topic": "exit_execution",
      "choice": "Issued self.close() on the bar where close <= trailing_stop_loss, executing at next bar open.",
      "reason": "Standard Backtrader market order execution process when exit conditions based on bar close prices are met."
    }
  ],

  "code": "import backtrader as bt\n\n\nclass MonthlySMAStrategy(bt.Strategy):\n    params = (\n        ('sma_period', 20),\n        ('holding_days', 5),\n        ('stop_loss_pct', 0.02),\n    )\n\n    def __init__(self):\n        self.sma = bt.indicators.SimpleMovingAverage(\n            self.data.close, period=self.p.sma_period\n        )\n        self.order = None\n        self.stop_order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order.isbuy():\n                entry_price = order.executed.price\n                stop_price = entry_price * (1.0 - self.p.stop_loss_pct)\n                self.stop_order = self.sell(\n                    size=order.executed.size,\n                    exectype=bt.Order.Stop,\n                    price=stop_price\n                )\n            elif order == self.stop_order:\n                self.stop_order = None\n\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            if order == self.order:\n                self.order = None\n            if order == self.stop_order and order.status != order.Completed:\n                self.stop_order = None\n\n    def next(self):\n        # Determine the trading day index within the current month\n        current_date = self.data.datetime.date(0)\n        day_count = 1\n        i = -1\n        while True:\n            try:\n                past_date = self.data.datetime.date(i)\n                if past_date.month == current_date.month and past_date.year == current_date.year:\n                    day_count += 1\n                    i -= 1\n                else:\n                    break\n            except (IndexError, ValueError):\n                break\n\n        if self.order:\n            return\n\n        # On the 1st trading day of the month, evaluate entry signal\n        if day_count == 1:\n            if not self.position and self.data.close[0] > self.sma[0]:\n                cash = self.broker.getcash()\n                size = int(cash / (self.data.close[0] * 1.001))\n                if size > 0:\n                    self.order = self.buy(size=size)\n\n        # On or after the 5th trading day of the month, close position\n        elif day_count >= self.p.holding_days:\n            if self.position:\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                    self.stop_order = None\n                self.order = self.close()",
  "assumptions": [
    {
      "topic": "execution_timing",
      "choice": "Signal evaluated on the close of trading day 1 executes on the open of trading day 2; exit evaluated on the close of trading day 5 executes on the open of trading day 6",
      "reason": "Standard Backtrader market order execution logic evaluates strategy signals at bar close and executes on the subsequent bar open."
    },
    {
      "topic": "position_sizing",
      "choice": "Position size calculated as integer shares using total cash divided by current close price plus 0.1% commission buffer",
      "reason": "Specification dictates entering with 'all capital', requiring commission-aware share calculation to prevent margin rejections."
    },
    {
      "topic": "stop_loss_implementation",
      "choice": "Stop loss order placed at 98% of actual execution fill price upon buy order completion, and cancelled when the scheduled exit on the 5th trading day triggers",
      "reason": "Ensures exact 2% risk limit relative to actual entry fill price and prevents orphan stop orders after exit."
    }
  ],

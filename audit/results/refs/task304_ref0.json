  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass TweezerBottomStrategy(bt.Strategy):\n    def __init__(self):\n        self.sma20 = bt.indicators.SMA(self.data.close, period=20)\n        self.order = None\n        self.stop_order = None\n        self.pending_stop_price = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status == order.Completed:\n            if order == self.order:\n                self.order = None\n                if order.isbuy():\n                    self.stop_order = self.sell(\n                        exectype=bt.Order.Stop,\n                        price=self.pending_stop_price,\n                    )\n            elif order == self.stop_order:\n                self.stop_order = None\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order == self.order:\n                self.order = None\n            elif order == self.stop_order:\n                self.stop_order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            decline = (self.data.close[0] < self.sma20[0]) and \\\n                      (self.data.close[0] < self.data.close[-5])\n\n            tweezer = (\n                abs(self.data.low[-2] - self.data.low[-1]) <= 0.001 * self.data.close[-1]\n                and self.data.close[-2] < self.data.open[-2]\n                and self.data.close[-1] > self.data.open[-1]\n            )\n\n            confirmation = self.data.close[0] > self.data.high[-1]\n\n            if decline and tweezer and confirmation:\n                self.pending_stop_price = min(self.data.low[-2], self.data.low[-1]) * 0.98\n                self.order = self.buy()\n        else:\n            bearish_engulfing = (\n                self.data.close[0] < self.data.open[0]\n                and self.data.open[0] >= self.data.close[-1]\n                and self.data.close[0] <= self.data.open[-1]\n            )\n\n            if bearish_engulfing:\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                    self.stop_order = None\n                self.order = self.close()",
  "assumptions": [
    {

  "code": "import backtrader as bt\n\n\nclass ProxyOptionIncomeStrategy(bt.Strategy):\n    params = (\n        (\"strategy_mode\", \"covered_call\"),  # covered_call, cash_secured_put, wheel, buy_and_hold\n    )\n\n    def __init__(self):\n        self.bb = bt.indicators.BollingerBands(self.data.close, period=20, devfactor=2)\n        self.sma = bt.indicators.SMA(self.data.close, period=50)\n        self.rsi = bt.indicators.RSI(self.data.close, period=14)\n        self.atr = bt.indicators.ATR(self.data, period=14)\n\n        self.order = None\n        self.cooldown_weeks = 0\n        self.position_days = 0\n\n    def notify_order(self, order):\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        mode = self.p.strategy_mode\n\n        if mode == \"buy_and_hold\":\n            if not self.position:\n                self.order = self.buy()\n            return\n\n        if self.position:\n            self.position_days += 1\n\n        if self.data.datetime.date(0).weekday() != 0:\n            return\n\n        close = self.data.close[0]\n        upper = self.bb.top[0]\n        middle = self.bb.mid[0]\n        lower = self.bb.bot[0]\n        rsi = self.rsi[0]\n        atr = self.atr[0]\n\n        if self.position:\n            if mode == \"cash_secured_put\":\n                if (\n                    close >= middle\n                    or self.position_days >= 20\n                    or close <= lower - atr\n                ):\n                    self.order = self.close()\n                    self.position_days = 0\n                return\n\n            if mode in (\"covered_call\", \"wheel\"):\n                if (\n                    close >= upper\n                    or rsi >= 70\n                    or close <= middle - atr\n                ):\n                    self.order = self.close()\n                    self.position_days = 0\n                    if mode == \"covered_call\":\n                        self.cooldown_weeks = 1\n                return\n\n        if mode == \"covered_call\":\n            if self.cooldown_weeks:\n                self.cooldown_weeks -= 1\n                return\n\n            if close > self.sma[0] and rsi > 50:\n                self.order = self.buy()\n\n        elif mode in (\"cash_secured_put\", \"wheel\"):\n            if close <= lower or rsi <= 35:\n                self.order = self.buy()",

  "ref_idx": 0,
  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass BreakoutBBStrategy(bt.Strategy):\n    params = dict(\n        bb_period=10,\n        bb_devfactor=0.674,\n    )\n\n    def __init__(self):\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close, period=self.p.bb_period, devfactor=self.p.bb_devfactor\n        )\n        self.crossover = bt.indicators.CrossOver(self.data.close, self.bb.lines.top)\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            if self.crossover[0] > 0:\n                cash = self.broker.getcash()\n                price = self.data.close[0]\n                size = int((cash * 0.999) / price)\n                if size > 0:\n                    self.order = self.buy(size=size)\n        else:\n            if self.crossover[0] < 0 or self.data.close[0] < self.bb.lines.top[0]:\n                self.order = self.close()",
  "assumptions": [
    {
      "topic": "position sizing",
      "choice": "size = floor(cash * 0.999 / close) computed each entry to invest ~100% of available cash",
      "reason": "spec states '100% of capital' but the environment's default sizer buys a fixed unit; a 0.999 cash buffer avoids order rejection due to the 0.001 commission"
    },
    {
      "topic": "order guard",
      "choice": "track a single self.order attribute, reset on Completed/Canceled/Margin/Rejected in notify_order, and skip next() logic while an order is pending",
      "reason": "canonical default for guarding pending orders; spec is silent on this"
    },
    {
      "topic": "one position at a time",
      "choice": "only evaluate entries when not self.position, and exits only when in a position",
      "reason": "canonical default; spec does not mention pyramiding or re-entry while a position is open"
    },
    {
      "topic": "indicator warm-up",
      "choice": "rely on backtrader's automatic minperiod from BollingerBands(period=10); no manual bar-skipping",
      "reason": "canonical default; spec states the indicator starts working from the 10th bar, which matches automatic minperiod behavior"
    }
  ],

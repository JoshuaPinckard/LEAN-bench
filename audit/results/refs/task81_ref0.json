  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\nimport collections\n\n\nclass PredictiveImbalanceStrategy(bt.Strategy):\n    params = (\n        ('event_driven', False),      # False = continuous model (default), True = event-driven model\n        ('cont_threshold', 0.2),\n        ('event_threshold', 0.5),\n        ('event_oi_threshold', 0.6),\n        ('atr_period', 14),\n        ('atr_pct_filter', 0.001),    # 0.1% of price\n        ('trade_imb_period', 20),\n        ('vol_sma_period', 20),\n        ('session_start_hour', 10),\n        ('session_end_hour', 16),\n        ('w_oi', 0.5),\n        ('w_ti', 0.3),\n        ('w_vol', 0.1),\n        ('w_atr', 0.1),\n    )\n\n    def __init__(self):\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.atr_sma = bt.indicators.SMA(self.atr, period=self.p.atr_period)\n        self.vol_sma = bt.indicators.SMA(self.data.volume, period=self.p.vol_sma_period)\n\n        self.trade_signed_vol = collections.deque(maxlen=self.p.trade_imb_period)\n\n        self.setsizer(bt.sizers.PercentSizer(percents=100))\n\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in (order.Completed, order.Canceled, order.Margin, order.Rejected):\n            self.order = None\n\n    def next(self):\n        high = self.data.high[0]\n        low = self.data.low[0]\n        close = self.data.close[0]\n        open_ = self.data.open[0]\n        volume = self.data.volume[0]\n\n        rng = high - low\n        order_imbalance = (2.0 * close - high - low) / rng if rng != 0 else 0.0\n\n        signed_vol = volume if close >= open_ else -volume\n        self.trade_signed_vol.append(signed_vol)\n        total_vol = sum(abs(v) for v in self.trade_signed_vol)\n        trade_imbalance = (sum(self.trade_signed_vol) / total_vol) if total_vol != 0 else 0.0\n\n        vol_sma = self.vol_sma[0]\n        vol_signal = max(-1.0, min(1.0, (volume - vol_sma) / vol_sma)) if vol_sma != 0 else 0.0\n\n        atr_sma = self.atr_sma[0]\n        if atr_sma != 0:\n            direction = 1.0 if close >= open_ else -1.0\n            atr_signal = direction * max(-1.0, min(1.0, (self.atr[0] - atr_sma) / atr_sma))\n        else:\n            atr_signal = 0.0\n\n        raw_forecast = (self.p.w_oi * order_imbalance +\n                         self.p.w_ti * trade_imbalance +\n                         self.p.w_vol * vol_signal +\n                         self.p.w_atr * atr_signal)\n        forecast = max(-1.0, min(1.0, raw_forecast))\n\n        atr_ok = self.atr[0] >= self.p.atr_pct_filter * close\n\n        bar_time = self.data.datetime.time(0)\n        in_session = self.p.session_start_hour <= bar_time.hour < self.p.session_end_hour\n\n        if self.p.event_driven:\n            active = abs(order_imbalance) > self.p.event_oi_threshold\n            buy_th = self.p.event_threshold\n            sell_th = -self.p.event_threshold\n        else:\n            active = True\n            buy_th = self.p.cont_threshold\n            sell_th = -self.p.cont_threshold\n\n        pos = self.position.size\n\n        if self.order is None:\n            if pos > 0 and forecast < 0:\n                self.order = self.close()\n            elif pos < 0 and forecast > 0:\n                self.order = self.close()\n            elif pos == 0 and active and atr_ok and in_session:\n                if forecast > buy_th:\n                    self.order = self.buy()\n                elif forecast < sell_th:\n                    self.order = self.sell()",
  "assumptions": [

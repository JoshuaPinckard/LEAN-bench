    {
      "topic": "stop_loss_order_timing",
      "choice": "Submit the protective stop sell order in notify_order immediately after the buy market order completes.",
      "reason": "Backtrader requires a buy order to fill before creating an active stop-loss order against the open long position."
    }
  ],

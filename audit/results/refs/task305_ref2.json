  "code": "import datetime\nimport backtrader as bt\n\n\nclass BullishEngulfingStrategy(bt.Strategy):\n    def __init__(self):\n        self.order = None\n        self.stop_order = None\n        self.stop_price = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order.isbuy():\n                self.order = None\n                if self.stop_price is not None:\n                    self.stop_order = self.sell(\n                        exectype=bt.Order.Stop, price=self.stop_price\n                    )\n            elif order.issell():\n                if order == self.stop_order:\n                    self.stop_order = None\n                if order == self.order:\n                    self.order = None\n\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order == self.order:\n                self.order = None\n            if order == self.stop_order:\n                self.stop_order = None\n\n    def next(self):\n        if len(self) < 5:\n            return\n\n        current_time = self.data.datetime.time(0)\n        is_session_end = current_time >= datetime.time(15, 45)\n\n        if is_session_end and self.position:\n            if self.stop_order:\n                self.cancel(self.stop_order)\n                self.stop_order = None\n            self.order = self.close()\n            return\n\n        if not self.position and self.order is None:\n            bar_m1_bearish = self.data.close[-1] < self.data.open[-1]\n            bar_0_bullish = self.data.close[0] > self.data.open[0]\n            engulfs = (self.data.open[0] <= self.data.close[-1]) and (\n                self.data.close[0] >= self.data.open[-1]\n            )\n\n            filter_bearish = (\n                (self.data.close[-2] < self.data.open[-2])\n                and (self.data.close[-3] < self.data.open[-3])\n                and (self.data.close[-4] < self.data.open[-4])\n            )\n\n            if bar_m1_bearish and bar_0_bullish and engulfs and filter_bearish:\n                pattern_low = min(self.data.low[0], self.data.low[-1])\n                self.stop_price = pattern_low * 0.99\n                self.order = self.buy()",
  "assumptions": [
    {
      "topic": "session_end_identification",
      "choice": "Identify end of session as bars with timestamp >= 15:45:00.",
      "reason": "15:45:00 is the start time of the final 15-minute bar during standard US equity regular trading hours (09:30-16:00 ET)."

  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass DonchianBreakoutStrategy(bt.Strategy):\n    def __init__(self):\n        self.order = None\n\n        highest = bt.indicators.Highest(self.data.high, period=20)\n        lowest = bt.indicators.Lowest(self.data.low, period=20)\n\n        self.upper = highest(-1)\n        self.lower = lowest(-1)\n        self.mid = (self.upper + self.lower) / 2.0\n\n    def notify_order(self, order):\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            if self.data.close[0] > self.upper[0]:\n                self.order = self.buy()\n            elif self.data.close[0] < self.lower[0]:\n                self.order = self.sell()\n        elif self.position.size > 0:\n            if self.data.close[0] <= self.mid[0]:\n                self.order = self.close()\n        elif self.position.size < 0:\n            if self.data.close[0] >= self.mid[0]:\n                self.order = self.close()",
  "assumptions": [
    {
      "topic": "donchian_channel_definition",
      "choice": "Computed upper and lower bands over the prior 20 bars (excluding the current bar) by shifting highest high and lowest low by 1 period.",
      "reason": "Comparing current bar close to an unshifted 20-period highest high would make close > upper_band impossible because close is always <= current bar high."
    },
    {
      "topic": "midpoint_exit_evaluation",
      "choice": "Evaluated on bar close (close <= midpoint to exit long, close >= midpoint to exit short).",
      "reason": "The specification evaluates breakout entries on candle close, so candle close is used consistently for channel midpoint exit evaluation."
    },
    {
      "topic": "overnight_holding",
      "choice": "Positions are held across trading sessions until midpoint return or exit signal occurs, without end-of-day forced closure.",
      "reason": "The spec describes an intraday timeframe (5-minute historical data) but does not state a time-based or end-of-day exit rule."
    }
  ],

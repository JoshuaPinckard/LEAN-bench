  "code": "import backtrader as bt\nimport statistics\n\n\nclass BollingerMeanReversion(bt.Strategy):\n    params = (\n        (\"bb_period\", 20),\n        (\"bb_dev\", 1.5),\n        (\"sma_period\", 200),\n        (\"atr_period\", 14),\n        (\"atr_lookback\", 252),\n        (\"time_stop_bars\", 5),\n        (\"trade_value\", 1000.0),\n        (\"max_loss_pct\", 0.02),\n    )\n\n    def __init__(self):\n        self.boll = bt.indicators.BollingerBands(\n            self.data.close, period=self.p.bb_period, devfactor=self.p.bb_dev\n        )\n        self.sma200 = bt.indicators.SMA(self.data.close, period=self.p.sma_period)\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n\n        self.crossover_bot = bt.indicators.CrossOver(\n            self.data.close, self.boll.lines.bot\n        )\n        self.crossover_top = bt.indicators.CrossOver(\n            self.data.close, self.boll.lines.top\n        )\n        self.crossover_mid = bt.indicators.CrossOver(\n            self.data.close, self.boll.lines.mid\n        )\n\n        self.order = None\n        self.bar_entered = 0\n\n    def notify_order(self, order):\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n            if order.status == order.Completed:\n                self.bar_entered = len(self)\n\n    def next(self):\n        if self.order:\n            return\n\n        if self.position:\n            capital = self.broker.getvalue()\n            pnl = self.position.size * (self.data.close[0] - self.position.price)\n            if pnl < -self.p.max_loss_pct * capital:\n                self.order = self.close()\n                return\n\n            bars_in_trade = len(self) - self.bar_entered\n            if self.crossover_mid[0] != 0 or bars_in_trade >= self.p.time_stop_bars:\n                self.order = self.close()\n                return\n        else:\n            if len(self.atr) < self.p.atr_lookback:\n                return\n\n            atr_vals = self.atr.get(size=self.p.atr_lookback)\n            p20 = statistics.quantiles(atr_vals, n=5)[0]\n            atr_ok = self.atr[0] >= p20\n\n            if (\n                self.crossover_bot[0] == -1.0\n                and atr_ok\n                and self.data.close[0] <= self.sma200[0]\n            ):\n                size = int(self.p.trade_value / self.data.close[0])\n                if size > 0:\n                    self.order = self.buy(size=size)\n\n            elif (\n                self.crossover_top[0] == 1.0\n                and atr_ok\n                and self.data.close[0] >= self.sma200[0]\n            ):\n                size = int(self.p.trade_value / self.data.close[0])\n                if size > 0:\n                    self.order = self.sell(size=size)",
  "assumptions": [

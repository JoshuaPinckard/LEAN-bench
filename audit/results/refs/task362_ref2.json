  "code": "import math\nimport backtrader as bt\n\n\nclass ChandelierADXStrategy(bt.Strategy):\n    params = (\n        ('lookback_n', 22),\n        ('atr_mult', 3.0),\n        ('adx_threshold', 25.0),\n    )\n\n    lines = ('long_stop_raw', 'short_stop_raw', 'long_stop', 'short_stop')\n\n    def __init__(self):\n        self.order = None\n        self.atr = bt.indicators.ATR(self.data, period=14)\n        self.adx = bt.indicators.ADX(self.data, period=14)\n        self.highest = bt.indicators.Highest(self.data.high, period=self.p.lookback_n)\n        self.lowest = bt.indicators.Lowest(self.data.low, period=self.p.lookback_n)\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            if self.order == order:\n                self.order = None\n\n    def next(self):\n        atr_val = self.atr[0]\n        highest_val = self.highest[0]\n        lowest_val = self.lowest[0]\n\n        long_stop_raw = highest_val - self.p.atr_mult * atr_val\n        short_stop_raw = lowest_val + self.p.atr_mult * atr_val\n\n        self.lines.long_stop_raw[0] = long_stop_raw\n        self.lines.short_stop_raw[0] = short_stop_raw\n\n        try:\n            prev_long = self.lines.long_stop[-1]\n        except (IndexError, TypeError):\n            prev_long = float('nan')\n\n        try:\n            prev_short = self.lines.short_stop[-1]\n        except (IndexError, TypeError):\n            prev_short = float('nan')\n\n        if self.position.size > 0:\n            if not math.isnan(prev_long):\n                long_stop = max(prev_long, long_stop_raw)\n            else:\n                long_stop = long_stop_raw\n            short_stop = short_stop_raw\n        elif self.position.size < 0:\n            long_stop = long_stop_raw\n            if not math.isnan(prev_short):\n                short_stop = min(prev_short, short_stop_raw)\n            else:\n                short_stop = short_stop_raw\n        else:\n            long_stop = long_stop_raw\n            short_stop = short_stop_raw\n\n        self.lines.long_stop[0] = long_stop\n        self.lines.short_stop[0] = short_stop\n\n        if math.isnan(prev_long) or math.isnan(prev_short):\n            return\n\n        if self.order:\n            return\n\n        close_curr = self.data.close[0]\n        close_prev = self.data.close[-1]\n\n        long_stop_curr = self.lines.long_stop[0]\n        long_stop_prev = self.lines.long_stop[-1]\n\n        short_stop_curr = self.lines.short_stop[0]\n        short_stop_prev = self.lines.short_stop[-1]\n\n        close_cross_above_long = (close_prev <= long_stop_prev) and (close_curr > long_stop_curr)\n        close_cross_below_long = (close_prev >= long_stop_prev) and (close_curr < long_stop_curr)\n\n        close_cross_below_short = (close_prev >= short_stop_prev) and (close_curr < short_stop_curr)\n        close_cross_above_short = (close_prev <= short_stop_prev) and (close_curr > short_stop_curr)\n\n        adx_valid = self.adx[0] > self.p.adx_threshold\n\n        if self.position.size == 0:\n            if adx_valid and close_cross_above_long:\n                self.order = self.buy()\n            elif adx_valid and close_cross_below_short:\n                self.order = self.sell()\n\n        elif self.position.size > 0:\n            if adx_valid and close_cross_below_short:\n                self.close()\n                self.order = self.sell()\n            elif close_cross_below_long:\n                self.order = self.close()\n\n        elif self.position.size < 0:\n            if adx_valid and close_cross_above_long:\n                self.close()\n                self.order = self.buy()\n            elif close_cross_above_short:\n                self.order = self.close()",
  "assumptions": [
    {
      "topic": "ratchet_condition",
      "choice": "Ratchet LongStop when position.size > 0 and ShortStop when position.size < 0; otherwise reset/initialize to raw stop levels",
      "reason": "The specification states 'when in/eligible for long/short; otherwise initialize to LongStopRaw/ShortStopRaw'. Standard Chandelier Exit trailing stops ratchet while in position and reset to the raw value when flat or in the opposite position."
    },

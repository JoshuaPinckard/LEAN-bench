    },
    {
      "topic": "position_reversals",
      "choice": "Execute self.close() followed by self.sell()/self.buy() on opposite entry signals",
      "reason": "Spec mandates allowing position reversals on opposite signals; submitting a close and opposite entry order achieves full position flip under default sizer."
    }
  ],

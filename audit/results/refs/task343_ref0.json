  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass MeanReversionBBStrategy(bt.Strategy):\n    params = dict(\n        bb_period=20,\n        bb_dev=2,\n        rsi_period=14,\n        rsi_upper=70,\n        rsi_lower=30,\n        atr_period=14,\n        atr_mult=2,\n    )\n\n    def __init__(self):\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close, period=self.p.bb_period, devfactor=self.p.bb_dev\n        )\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.p.rsi_period)\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n\n        self.order = None\n        self.stop_price = None\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            if self.position:\n                entry_price = order.executed.price\n                offset = self.p.atr_mult * self.atr[0]\n                if self.position.size > 0:\n                    self.stop_price = entry_price - offset\n                else:\n                    self.stop_price = entry_price + offset\n            else:\n                self.stop_price = None\n            self.order = None\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        close = self.data.close[0]\n\n        if self.position:\n            in_channel = self.bb.bot[0] <= close <= self.bb.top[0]\n            if self.position.size > 0:\n                stop_hit = close <= self.stop_price\n                opposing_signal = close > self.bb.top[0] and self.rsi[0] > self.p.rsi_upper\n                if stop_hit or in_channel or opposing_signal:\n                    self.order = self.close()\n            else:\n                stop_hit = close >= self.stop_price\n                opposing_signal = close < self.bb.bot[0] and self.rsi[0] < self.p.rsi_lower\n                if stop_hit or in_channel or opposing_signal:\n                    self.order = self.close()\n            return\n\n        if close > self.bb.top[0] and self.rsi[0] > self.p.rsi_upper:\n            self.order = self.sell()\n        elif close < self.bb.bot[0] and self.rsi[0] < self.p.rsi_lower:\n            self.order = self.buy()",
  "assumptions": [
    {
      "topic": "RSI period",
      "choice": "RSI period set to 14 (standard default)",
      "reason": "Spec names RSI with entry thresholds (70/30) but never states its period; 14 is the conventional default and no canonical default covers this parameter."
    },
    {
      "topic": "stop-loss/take-profit trigger basis",
      "choice": "Stop-loss and band re-entry take-profit are evaluated against each bar's close price",
      "reason": "Spec states entry signals in terms of 'price closes' but is silent on whether stop/take-profit checks are intrabar (high/low) or close-based; close-based evaluation keeps all conditions on a consistent basis."
    },
    {
      "topic": "entry price for ATR stop calculation",
      "choice": "Stop price is computed in notify_order using the order's actual executed fill price and the ATR value at the fill bar, not the signal bar's close",
      "reason": "Backtrader fills market orders on the next bar's open by default, so 'from entry price' is most literally the realized fill price rather than the price observed when the signal was generated."
    },
    {
      "topic": "post-exit re-entry timing",
      "choice": "When a position is closed via an opposing signal, no new position is opened in the same bar; a fresh entry is only taken on a later bar if entry conditions are met then",
      "reason": "Canonical default prohibits pyramiding/re-entry while a position is open; spec describes the opposing signal only as an exit trigger, not as an instruction to reverse immediately into a new position."
    }
  ],

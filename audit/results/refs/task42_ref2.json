  "code": "import backtrader as bt\n\n\nclass Sma200ExitStrategy(bt.Strategy):\n    params = (\n        (\"sma_period\", 200),\n        (\"capital_pct\", 0.01),\n    )\n\n    def __init__(self):\n        self.sma = bt.indicators.SimpleMovingAverage(\n            self.data.close, period=self.params.sma_period\n        )\n        self.crossover = bt.indicators.CrossOver(self.data.close, self.sma)\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            if self.crossover > 0:\n                capital = self.broker.getvalue() * self.params.capital_pct\n                size = capital / self.data.close[0]\n                self.order = self.buy(size=size)\n        else:\n            if self.crossover < 0:\n                self.order = self.close()",
  "assumptions": [
    {
      "topic": "position_sizing",
      "choice": "Position size is calculated as 1% of total portfolio value divided by current closing price",

  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass SuperTrend(bt.Indicator):\n    lines = ('supertrend', 'direction')\n    params = (\n        ('period', 10),\n        ('multiplier', 3.0),\n    )\n\n    def __init__(self):\n        self.addminperiod(self.p.period + 1)\n        self.atr = bt.indicators.ATR(self.data, period=self.p.period)\n\n    def next(self):\n        hl2 = (self.data.high[0] + self.data.low[0]) / 2.0\n        basic_ub = hl2 + self.p.multiplier * self.atr[0]\n        basic_lb = hl2 - self.p.multiplier * self.atr[0]\n\n        if not hasattr(self, '_final_ub'):\n            self._final_ub = basic_ub\n            self._final_lb = basic_lb\n            if self.data.close[0] > basic_ub:\n                self.lines.supertrend[0] = basic_lb\n                self.lines.direction[0] = 1\n            else:\n                self.lines.supertrend[0] = basic_ub\n                self.lines.direction[0] = -1\n            return\n\n        prev_final_ub = self._final_ub\n        prev_final_lb = self._final_lb\n        prev_close = self.data.close[-1]\n        prev_dir = self.lines.direction[-1]\n\n        if basic_ub < prev_final_ub or prev_close > prev_final_ub:\n            final_ub = basic_ub\n        else:\n            final_ub = prev_final_ub\n\n        if basic_lb > prev_final_lb or prev_close < prev_final_lb:\n            final_lb = basic_lb\n        else:\n            final_lb = prev_final_lb\n\n        self._final_ub = final_ub\n        self._final_lb = final_lb\n\n        if prev_dir == 1:\n            if self.data.close[0] < final_lb:\n                curr_dir = -1\n                st = final_ub\n            else:\n                curr_dir = 1\n                st = final_lb\n        else:\n            if self.data.close[0] > final_ub:\n                curr_dir = 1\n                st = final_lb\n            else:\n                curr_dir = -1\n                st = final_ub\n\n        self.lines.supertrend[0] = st\n        self.lines.direction[0] = curr_dir\n\n\nclass SupertrendStrategy(bt.Strategy):\n    params = (\n        ('period', 10),\n        ('multiplier', 3.0),\n    )\n\n    def __init__(self):\n        self.st = SuperTrend(self.data, period=self.p.period, multiplier=self.p.multiplier)\n        self.pending_orders = []\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            if order in self.pending_orders:\n                self.pending_orders.remove(order)\n\n    def next(self):\n        if self.pending_orders:\n            return\n\n        if len(self.st.direction) < 2:\n            return\n\n        prev_dir = self.st.direction[-1]\n        curr_dir = self.st.direction[0]\n\n        if prev_dir == -1 and curr_dir == 1:\n            if self.position.size < 0:\n                o1 = self.close()\n                self.pending_orders.append(o1)\n            if self.position.size <= 0:\n                cash_or_val = self.broker.getcash() if self.position.size == 0 else self.broker.getvalue()\n                size = int((cash_or_val * 0.98) / self.data.close[0])\n                if size > 0:\n                    o2 = self.buy(size=size)\n                    self.pending_orders.append(o2)\n\n        elif prev_dir == 1 and curr_dir == -1:\n            if self.position.size > 0:\n                o1 = self.close()\n                self.pending_orders.append(o1)\n            if self.position.size >= 0:\n                cash_or_val = self.broker.getcash() if self.position.size == 0 else self.broker.getvalue()\n                size = int((cash_or_val * 0.98) / self.data.close[0])\n                if size > 0:\n                    o2 = self.sell(size=size)\n                    self.pending_orders.append(o2)",
  "assumptions": [

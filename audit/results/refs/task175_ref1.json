  "code": "import backtrader as bt\n\n\nclass CPSReference(bt.Strategy):\n    def __init__(self):\n        self.ema = bt.indicators.EMA(self.data.close, period=20)\n        self.rsi = bt.indicators.RSI(self.data.close, period=14)\n        self.atr = bt.indicators.ATR(self.data, period=14)\n\n        self.order = None\n        self.entry_price = None\n        self.entry_bar = None\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            if order.status == order.Completed and order.isbuy():\n                self.entry_price = order.executed.price\n                self.entry_bar = len(self)\n\n            if order.status == order.Completed and order.issell():\n                self.entry_price = None\n                self.entry_bar = None\n\n            if order == self.order:\n                self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        close = self.data.close[0]\n        atr = self.atr[0]\n\n        if self.position:\n            profit_exit = (\n                close >= self.entry_price + 0.5 * atr\n                or close >= self.ema[0]\n            )\n            stop_exit = (\n                close <= self.entry_price - min(atr, 0.02 * self.entry_price)\n            )\n            time_exit = len(self) - self.entry_bar >= 5\n\n            if profit_exit or stop_exit or time_exit:\n                self.order = self.close()\n            return\n\n        entry_condition = (\n            close < self.ema[0]\n            and self.rsi[0] < 40\n            and atr / close < 0.04\n            and close >= self.data.close[-1] * 0.99\n        )\n\n        if entry_condition:\n            risk_per_share = min(atr, 0.02 * close)\n            size = int((0.01 * self.broker.getvalue()) / risk_per_share)\n\n            if size > 0:\n                self.order = self.buy(size=size)",

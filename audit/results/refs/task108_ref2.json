    {
      "topic": "anchor_bar_detection",
      "choice": "Search lookback history for a bar whose low was followed by a 6%+ price surge",
      "reason": "The specification defines the anchor bar level as the low of a bar after which a ~6% rebound occurred."
    },
    {
      "topic": "position_sizing",
      "choice": "size = max(1, int((account_value * 0.02) / close))",
      "reason": "The specification requests position size as a fixed percentage of capital per trade (2%)."
    },
    {

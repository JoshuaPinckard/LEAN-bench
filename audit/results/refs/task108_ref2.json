  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass CorrectionReversalStrategy(bt.Strategy):\n    params = (\n        (\"sma_period\", 50),\n        (\"consolidation_period\", 20),\n        (\"rebound_pct\", 0.06),\n        (\"key_level_short\", 175.0),\n        (\"target_long\", 250.0),\n        (\"target_short_1\", 3350.0),\n        (\"target_short_2\", 2700.0),\n        (\"risk_pct\", 0.02),\n    )\n\n    def __init__(self):\n        self.sma = bt.indicators.SimpleMovingAverage(\n            self.data.close, period=self.params.sma_period\n        )\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def _get_anchor_level(self):\n        lookback = min(len(self), 50)\n        for i in range(2, lookback):\n            bar_low = self.data.low[-i]\n            sub_highs = [self.data.high[-j] for j in range(0, i)]\n            if sub_highs and max(sub_highs) >= bar_low * (\n                1.0 + self.params.rebound_pct\n            ):\n                return bar_low\n        return self.data.low[-1]\n\n    def next(self):\n        if len(self) < self.params.sma_period:\n            return\n\n        if self.order:\n            return\n\n        close = self.data.close[0]\n        open_p = self.data.open[0]\n        high = self.data.high[0]\n        low = self.data.low[0]\n        volume = self.data.volume[0]\n\n        prev_close = self.data.close[-1]\n        prev_open = self.data.open[-1]\n        prev_low = self.data.low[-1]\n        prev_vol = self.data.volume[-1]\n\n        cons_period = min(len(self), self.params.consolidation_period)\n        range_high = max([self.data.high[-i] for i in range(cons_period)])\n        range_low = min([self.data.low[-i] for i in range(cons_period)])\n\n        anchor_level = self._get_anchor_level()\n\n        if not self.position:\n            # Long Entry Conditions\n            in_consolidation = range_low <= close <= range_high\n            false_breakdown = (\n                (low < range_low or prev_low < range_low)\n                and close > range_low\n                and volume > prev_vol\n            )\n            sma_not_broken = close >= self.sma[0]\n            anchor_bounce = low <= anchor_level * 1.01 and close > open_p\n            buying_vol_rising = volume > prev_vol and close > prev_close\n            weak_selling = (prev_close >= prev_open) or (\n                len(self) >= 3 and prev_vol < self.data.volume[-2]\n            )\n\n            if (\n                in_consolidation\n                and false_breakdown\n                and sma_not_broken\n                and anchor_bounce\n                and buying_vol_rising\n                and weak_selling\n            ):\n                cash_alloc = self.broker.getvalue() * self.params.risk_pct\n                size = max(1, int(cash_alloc / close))\n                self.order = self.buy(size=size)\n                return\n\n            # Short Entry Conditions\n            strong_selling = volume > prev_vol and close < open_p\n            dynamic_supp_broken = close < prev_low\n            below_key_level = (\n                close < self.params.key_level_short\n                and prev_close < self.params.key_level_short\n            )\n\n            if (\n                in_consolidation\n                and strong_selling\n                and dynamic_supp_broken\n                and below_key_level\n            ):\n                cash_alloc = self.broker.getvalue() * self.params.risk_pct\n                size = max(1, int(cash_alloc / close))\n                self.order = self.sell(size=size)\n                return\n\n        elif self.position.size > 0:\n            # Exit Long Conditions\n            recent_low = min([self.data.low[-i] for i in range(5)])\n            stop_loss = min(prev_low, recent_low) * 0.99\n\n            if (\n                high >= self.params.target_long\n                or close < self.sma[0]\n                or close < prev_low\n                or low <= stop_loss\n            ):\n                self.order = self.close()\n\n        elif self.position.size < 0:\n            # Exit Short Conditions\n            stop_loss = max(self.params.key_level_short, range_high) * 1.01\n\n            if (\n                low <= self.params.target_short_1\n                or low <= self.params.target_short_2\n                or close > range_high\n                or high >= stop_loss\n            ):\n                self.order = self.close()",
  "assumptions": [
    {
      "topic": "consolidation_range",
      "choice": "20-period highest high and lowest low rolling window",
      "reason": "The specification references a consolidation range and its boundaries without defining a period length; 20 bars is the standard daily rolling range."

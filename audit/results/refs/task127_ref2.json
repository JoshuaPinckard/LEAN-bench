  "code": "import backtrader as bt\nimport math\n\n\nclass MSTRSignalConflict(bt.Strategy):\n    def __init__(self):\n        self.sma365 = bt.ind.SMA(self.data.close, period=365)\n        self.sma200 = bt.ind.SMA(self.data.close, period=200)\n        self.sma10 = bt.ind.SMA(self.data.close, period=10)\n        self.crossover365 = bt.ind.CrossOver(self.data.close, self.sma365)\n\n        self.order = None\n        self.sma365_history = []\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def _get_44th_percentile(self):\n        data = sorted(self.sma365_history)\n        n = len(data)\n        if n == 0:\n            return 0.0\n        if n == 1:\n            return data[0]\n        k = (n - 1) * 0.44\n        i = int(k)\n        f = k - i\n        if i + 1 < n:\n            return data[i] + f * (data[i + 1] - data[i])\n        return data[i]\n\n    def next(self):\n        self.sma365_history.append(self.sma365[0])\n\n        if self.order:\n            return\n\n        p44 = self._get_44th_percentile()\n\n        if not self.position:\n            if self.crossover365[0] > 0 and self.sma365[0] > p44:\n                self.order = self.buy()\n        else:\n            if self.crossover365[0] < 0 or self.data.close[0] < self.sma200[0]:\n                self.order = self.close()",

  "code": "import backtrader as bt\n\n\nclass SMASlopeReversalStrategy(bt.Strategy):\n    params = (\n        (\"sma_period\", 20),\n        (\"slope_lag\", 20),\n        (\"std_lookback\", 100),\n        (\"extreme_mult\", 2.0),\n        (\"stop_pct\", 0.02),\n        (\"neutral_mult\", 0.2),\n    )\n\n    def __init__(self):\n        self.order = None\n        self.stop_order = None\n\n        self.sma20 = bt.indicators.SMA(\n            self.data.close, period=self.p.sma_period\n        )\n        self.slope = (\n            self.sma20 - self.sma20(-self.p.slope_lag)\n        ) / self.p.slope_lag\n        self.slope_std = bt.indicators.StdDev(\n            self.slope, period=self.p.std_lookback\n        )\n\n        self.pos_th = self.p.extreme_mult * self.slope_std\n        self.neg_th = -self.p.extreme_mult * self.slope_std\n        self.neutral_band = self.p.neutral_mult * self.slope_std\n\n    def notify_order(self, order):\n        if order.status in (\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ):\n            if order == self.order:\n                self.order = None\n\n            if order == self.stop_order:\n                self.stop_order = None\n\n            if order.status == order.Completed and order.isbuy():\n                self.stop_order = self.sell(\n                    exectype=bt.Order.Stop,\n                    price=order.executed.price * (1.0 - self.p.stop_pct),\n                )\n\n    def next(self):\n        if self.order:\n            return\n\n        slope_crosses_zero = (\n            (self.slope[-1] <= 0 and self.slope[0] > 0)\n            or (self.slope[-1] >= 0 and self.slope[0] < 0)\n        )\n\n        if self.position:\n            if (\n                slope_crosses_zero\n                or abs(self.slope[0]) < self.neutral_band[0]\n            ):\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                self.order = self.close()\n            return\n\n        long_signal = (\n            self.slope[-1] <= self.neg_th[-1]\n            and self.slope[0] > self.neg_th[0]\n        )\n        short_signal = (\n            self.slope[-1] >= self.pos_th[-1]\n            and self.slope[0] < self.pos_th[0]\n        )\n\n        if long_signal:\n            self.order = self.buy()\n        elif short_signal:\n            self.order = self.sell()",
  "assumptions": [

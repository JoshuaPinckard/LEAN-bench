  "model": "opus",
  "code": "import backtrader as bt\n\n\nclass CostAwarePortfolioOptimization(bt.Strategy):\n    # Cost-aware portfolio optimization: at each step maximize\n    #   (r - I(t))'w - lambda * w'Sigma w - Theta * |w - w0|^(3/2)\n    # For this single-asset feed all vectors/matrices collapse to scalars,\n    # so w is the AAPL portfolio weight, r a scalar expected return and\n    # Sigma a scalar variance.\n    params = (\n        ('lambda_risk', 1.0),   # lambda: risk aversion coefficient\n        ('theta', 0.01),        # Theta: market-impact scaling coefficient\n        ('period', 252),        # T = 1 year lookback for r and Sigma\n        ('ann_factor', 252),    # bars per year, to annualize r and Sigma\n        ('min_weight', 0.0),    # lower bound l_b on the asset weight\n        ('max_weight', 1.0),    # upper bound u_b on the asset weight\n        ('grid', 200),          # grid resolution for the 1-D optimization\n    )\n\n    def __init__(self):\n        # daily simple returns\n        ret = self.data.close / self.data.close(-1) - 1.0\n        # expected return r and risk Sigma from historical returns over T = 1 year\n        self.mean_ret = bt.indicators.SMA(ret, period=self.p.period)\n        self.std_ret = bt.indicators.StandardDeviation(ret, period=self.p.period)\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in (order.Submitted, order.Accepted):\n            return\n        if order.status in (order.Completed, order.Canceled,\n                             order.Margin, order.Rejected):\n            self.order = None\n\n    def _objective(self, w, w0, r, sigma2):\n        # trading volume t = |w - w0| and impact cost I(t) ~ Theta * t^(3/2)\n        t = abs(w - w0)\n        impact = self.p.theta * (t ** 1.5)\n        # (r - I(t)) w - lambda w Sigma w - Theta |w - w0|^(3/2)\n        return (r - impact) * w - self.p.lambda_risk * sigma2 * w * w - impact\n\n    def next(self):\n        # guard against overlapping orders\n        if self.order is not None:\n            return\n\n        # expected return r and variance Sigma over the reinvestment period\n        r = self.mean_ret[0] * self.p.ann_factor\n        sigma2 = (self.std_ret[0] ** 2) * self.p.ann_factor\n\n        # current portfolio weight w0 of the asset\n        value = self.broker.getvalue()\n        w0 = 0.0\n        if value > 0:\n            w0 = (self.position.size * self.data.close[0]) / value\n\n        # solve  max_w  (r - I(t))w - lambda w Sigma w - Theta |w - w0|^(3/2)\n        # subject to the linear box constraint  min_weight <= w <= max_weight,\n        # by grid search (no external optimizers available in this environment).\n        lb, ub = self.p.min_weight, self.p.max_weight\n        # candidate \"do nothing\" weight (staying at w0) is the incumbent, so the\n        # optimizer only trades when moving beats staying net of impact cost.\n        best_w = min(max(w0, lb), ub)\n        best_f = self._objective(best_w, w0, r, sigma2)\n        n = self.p.grid\n        for i in range(n + 1):\n            w = lb + (ub - lb) * i / n\n            f = self._objective(w, w0, r, sigma2)\n            if f > best_f:\n                best_f = f\n                best_w = w\n\n        # rebalance to the new target weight w* (dynamic rebalancing: the impact\n        # term already suppressed trades whose benefit did not exceed their cost)\n        if abs(best_w - w0) > 1e-9:\n            self.order = self.order_target_percent(target=best_w)",
  "assumptions": [
    {
      "topic": "single-asset collapse",
      "choice": "Implemented the portfolio optimizer over the one available asset (AAPL): w, r, w0 are scalars, Sigma is the scalar return variance, and the constraint matrix A is the identity so l_b <= w <= u_b.",
      "reason": "The harness supplies exactly one PandasData feed, so the vector/matrix objects r, w, Sigma, Theta, A in the spec each reduce to a single element."
    },
    {
      "topic": "expected return r",
      "choice": "r = mean of trailing 252 daily simple returns x 252 (annualized), via SMA over the return line.",
      "reason": "Spec says compute expected return from historical returns over the reinvestment period T=1 year; a factor model needs cross-sectional assets that do not exist here."
    },
    {
      "topic": "risk Sigma",
      "choice": "Sigma = variance of trailing 252 daily returns x 252 (annualized), via StandardDeviation squared.",
      "reason": "Spec: covariance matrix from historical returns over the same period; the factor form Sigma = X'FX + D requires factor data unavailable here, so the plain historical variance is used."
    },
    {
      "topic": "objective term |w|^(3/2)",
      "choice": "Read the objective's last term as Theta*|w - w0|^(3/2).",
      "reason": "The 'Dynamic rebalancing' clause explicitly states the trade-governing term is |w - w0|^(3/2); |w| in the formula is treated as shorthand for the same turnover quantity."
    },
    {
      "topic": "impact cost I(t)",
      "choice": "I(t) = Theta * t^(3/2) with t = |w - w0|, entering the objective as (r - I(t))*w.",
      "reason": "Spec defines impact costs as proportional to trading volume raised to the power 3/2 and t = |w - w0|; kept the (r - I(t))w term literal in addition to the Theta|w - w0|^(3/2) term."
    },
    {
      "topic": "constraints l_b<=Aw<=u_b",
      "choice": "Box constraint 0 <= w <= 1 (long-only, no leverage).",
      "reason": "The listed constraints are 'examples'; full-investment l_b=u_b=w0 would freeze a single-asset book and a 10% cap is only illustrative, so a long-only unleveraged bound is used and short selling is not enabled."
    },
    {
      "topic": "risk coefficient lambda / Theta",
      "choice": "lambda=1.0 and Theta=0.01 as declared parameter defaults.",
      "reason": "Spec leaves numeric values of lambda and Theta unspecified; moderate values that yield meaningful, non-degenerate weights on this data were chosen."
    },
    {
      "topic": "optimization method",
      "choice": "1-D grid search over [0,1] with 201 points, keeping w0 as the incumbent.",
      "reason": "Only backtrader/math/collections/statistics imports are allowed (no scipy); grid search is a deterministic, faithful solver for the scalar concave-plus-penalty objective."
    },
    {

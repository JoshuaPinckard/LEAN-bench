  "code": "# complete strategy class\nimport backtrader as bt\nimport math\n\n\nclass PortfolioOptimizationWithCosts(bt.Strategy):\n    params = (\n        (\"lookback\", 252),\n        (\"risk_aversion\", 1.0),\n        (\"impact_coefficient\", 0.001),\n        (\"optimization_steps\", 10000),\n    )\n\n    def __init__(self):\n        self.pending_order = None\n        self.addminperiod(self.p.lookback + 1)\n\n    def notify_order(self, order):\n        if order.status in (\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ):\n            self.pending_order = None\n\n    def _current_weight(self):\n        value = self.broker.getvalue()\n        if value <= 0:\n            return 0.0\n        return max(0.0, self.position.size * self.data.close[0] / value)\n\n    def _objective(self, weight, current_weight, expected_return, covariance):\n        impact_cost = self.p.impact_coefficient * abs(weight - current_weight) ** 1.5\n        return (\n            (expected_return - impact_cost) * weight\n            - self.p.risk_aversion * covariance * weight * weight\n            - self.p.impact_coefficient * abs(weight) ** 1.5\n        )\n\n    def next(self):\n        if self.pending_order is not None:\n            return\n\n        volume = self.data.volume[0]\n        if not math.isfinite(volume) or volume <= 0:\n            target_weight = 0.0\n        else:\n            returns = []\n            for offset in range(self.p.lookback):\n                previous_close = self.data.close[-offset - 1]\n                current_close = self.data.close[-offset]\n                if previous_close > 0:\n                    returns.append(current_close / previous_close - 1.0)\n\n            if len(returns) < 2:\n                return\n\n            mean_daily_return = sum(returns) / len(returns)\n            expected_return = mean_daily_return * self.p.lookback\n            covariance = (\n                sum((item - mean_daily_return) ** 2 for item in returns)\n                / (len(returns) - 1)\n                * self.p.lookback\n            )\n\n            current_weight = min(1.0, self._current_weight())\n            target_weight = current_weight\n            best_value = self._objective(\n                target_weight, current_weight, expected_return, covariance\n            )\n\n            for step in range(self.p.optimization_steps + 1):\n                weight = step / self.p.optimization_steps\n                value = self._objective(\n                    weight, current_weight, expected_return, covariance\n                )\n                if value > best_value:\n                    best_value = value\n                    target_weight = weight\n\n        if abs(target_weight - self._current_weight()) > 0:\n            self.pending_order = self.order_target_percent(\n                target=target_weight\n            )",

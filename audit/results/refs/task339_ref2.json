  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass ADXROCBreakoutStrategy(bt.Strategy):\n    params = (\n        (\"adx_period\", 14),\n        (\"roc_period\", 20),\n        (\"sma_period\", 20),\n        (\"std_period\", 20),\n        (\"stop_loss_pct\", 0.02),\n    )\n\n    def __init__(self):\n        self.adx = bt.indicators.ADX(self.data, period=self.p.adx_period)\n        self.roc = bt.indicators.ROC(self.adx, period=self.p.roc_period)\n        self.sma_roc = bt.indicators.SMA(self.roc, period=self.p.sma_period)\n        self.std_roc = bt.indicators.StdDev(self.roc, period=self.p.std_period)\n\n        self.upper = self.sma_roc + 2.0 * self.std_roc\n        self.lower = self.sma_roc - 2.0 * self.std_roc\n\n        self.order = None\n        self.stop_order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order == self.order:\n                self.order = None\n                if self.position.size > 0:\n                    stop_price = order.executed.price * (\n                        1.0 - self.p.stop_loss_pct\n                    )\n                    self.stop_order = self.sell(\n                        exectype=bt.Order.Stop, price=stop_price\n                    )\n                elif self.position.size < 0:\n                    stop_price = order.executed.price * (\n                        1.0 + self.p.stop_loss_pct\n                    )\n                    self.stop_order = self.buy(\n                        exectype=bt.Order.Stop, price=stop_price\n                    )\n            elif order == self.stop_order:\n                self.stop_order = None\n\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order == self.order:\n                self.order = None\n            if order == self.stop_order:\n                self.stop_order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            if self.roc[0] > self.upper[0]:\n                self.order = self.buy()\n            elif self.roc[0] < self.lower[0]:\n                self.order = self.sell()\n        else:\n            if self.position.size > 0:\n                if self.roc[0] <= self.sma_roc[0]:\n                    if self.stop_order:\n                        self.cancel(self.stop_order)\n                        self.stop_order = None\n                    self.order = self.close()\n            elif self.position.size < 0:\n                if self.roc[0] >= self.sma_roc[0]:\n                    if self.stop_order:\n                        self.cancel(self.stop_order)\n                        self.stop_order = None\n                    self.order = self.close()",
  "assumptions": [
    {
      "topic": "roc_calculation",
      "choice": "Used standard bt.indicators.ROC on ADX with a period of 20 bars",
      "reason": "The specification requires the rate of change of ADX over 20 bars."
    },
    {
      "topic": "cross_back_exit_condition",
      "choice": "Exit long position when ROC drops to or below SMA (ROC <= SMA); exit short position when ROC rises to or above SMA (ROC >= SMA)",
      "reason": "Crossing back to the 20-bar SMA from an overbought entry condition implies returning to or below the mean for longs, and returning to or above the mean for shorts."
    },
    {
      "topic": "stop_loss_order_management",
      "choice": "Submitted a stop loss order at 2% offset upon primary entry execution and cancelled it when exiting via indicator signal",
      "reason": "Ensures adherence to the 2% stop loss requirement without lingering active stop orders after an indicator exit."
    }
  ],

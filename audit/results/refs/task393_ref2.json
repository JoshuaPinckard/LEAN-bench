  "code": "import backtrader as bt\n\n\nclass DonchianChannel(bt.Indicator):\n    lines = ('hi', 'lo')\n    params = (('period', 20),)\n\n    def __init__(self):\n        self.lines.hi = bt.ind.Highest(self.data.high, period=self.p.period)\n        self.lines.lo = bt.ind.Lowest(self.data.low, period=self.p.period)\n\n\nbt.ind.DonchianChannel = DonchianChannel\n\n\nclass DonchianWidthMeanReversion(bt.Strategy):\n    params = (\n        ('period', 20),\n        ('deviation_multiplier', 2.0),\n        ('stop_pct', 0.02),\n    )\n\n    def __init__(self):\n        self.donchian = bt.ind.DonchianChannel(period=self.p.period)\n        self.width = self.donchian.hi - self.donchian.lo\n        self.width_sma = bt.ind.SMA(self.width, period=self.p.period)\n        self.upper_extreme = self.width_sma * self.p.deviation_multiplier\n        self.lower_extreme = self.width_sma / self.p.deviation_multiplier\n\n        self.cross_upper = bt.ind.CrossOver(self.width, self.upper_extreme)\n        self.cross_lower = bt.ind.CrossOver(self.width, self.lower_extreme)\n        self.cross_sma = bt.ind.CrossOver(self.width, self.width_sma)\n\n        self.upper_regime = False\n        self.lower_regime = False\n\n        self.order = None\n        self.stop_order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order == self.order:\n                self.order = None\n                if self.position:\n                    if self.position.size > 0:\n                        stop_price = order.executed.price * (\n                            1.0 - self.p.stop_pct\n                        )\n                        self.stop_order = self.sell(\n                            exectype=bt.Order.Stop, price=stop_price\n                        )\n                    elif self.position.size < 0:\n                        stop_price = order.executed.price * (\n                            1.0 + self.p.stop_pct\n                        )\n                        self.stop_order = self.buy(\n                            exectype=bt.Order.Stop, price=stop_price\n                        )\n            elif order == self.stop_order:\n                self.stop_order = None\n\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order == self.order:\n                self.order = None\n            if order == self.stop_order:\n                self.stop_order = None\n\n    def next(self):\n        if self.cross_upper[0] > 0:\n            self.upper_regime = True\n            self.lower_regime = False\n        elif self.cross_lower[0] < 0:\n            self.lower_regime = True\n            self.upper_regime = False\n\n        if self.order is not None:\n            return\n\n        if self.position:\n            if self.position.size > 0:\n                if self.cross_sma[0] > 0:\n                    if self.stop_order:\n                        self.cancel(self.stop_order)\n                        self.stop_order = None\n                    self.order = self.close()\n            elif self.position.size < 0:\n                if self.cross_sma[0] < 0:\n                    if self.stop_order:\n                        self.cancel(self.stop_order)\n                        self.stop_order = None\n                    self.order = self.close()\n        else:\n            if self.upper_regime and self.cross_upper[0] < 0:\n                self.order = self.sell()\n            elif self.lower_regime and self.cross_lower[0] > 0:\n                self.order = self.buy()",

  "code": "import math\nimport backtrader as bt\n\n\nclass LogReturn(bt.Indicator):\n    lines = ('log_ret',)\n\n    def __init__(self):\n        self.addminperiod(2)\n\n    def next(self):\n        self.lines.log_ret[0] = math.log(self.data[0] / self.data[-1])\n\n\nclass MeanVarianceStrategy(bt.Strategy):\n    params = (\n        ('lambda_param', 2.5),\n        ('sma_period', 252),\n        ('atr_period', 63),\n        ('vol_threshold', 0.005),\n        ('wmin', 0.0),\n        ('wmax', 1.0),\n    )\n\n    def __init__(self):\n        self.order = None\n        log_ret = LogReturn(self.data.close)\n        self.mu_hat = bt.ind.SMA(log_ret, period=self.p.sma_period)\n        self.atr = bt.ind.ATR(self.data, period=self.p.atr_period)\n        self.sigma_hat = self.atr / self.data.close\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if self.data.datetime.date(0).month != self.data.datetime.date(-1).month:\n            sigma = self.sigma_hat[0]\n            if sigma < self.p.vol_threshold:\n                w = 0.0\n            else:\n                mu = self.mu_hat[0]\n                raw_w = mu / (self.p.lambda_param * (sigma ** 2))\n                w = max(self.p.wmin, min(self.p.wmax, raw_w))\n\n            self.order = self.order_target_percent(target=w)",

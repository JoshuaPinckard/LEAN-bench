  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\nfrom collections import deque\n\n\nclass VWAPBreakoutStrategy(bt.Strategy):\n    params = dict(\n        n=3,\n        stop_pct=0.005,\n    )\n\n    def __init__(self):\n        self.order = None\n        self.entry_price = None\n        self.cum_pv = 0.0\n        self.cum_vol = 0.0\n        self.current_date = None\n        self.hist = deque(maxlen=self.p.n)\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n        if order.status == order.Completed:\n            if self.entry_price is None:\n                self.entry_price = order.executed.price\n            else:\n                self.entry_price = None\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        bar_date = self.data.datetime.datetime(0).date()\n        if self.current_date != bar_date:\n            self.current_date = bar_date\n            self.cum_pv = 0.0\n            self.cum_vol = 0.0\n            self.hist.clear()\n\n        typical_price = (self.data.high[0] + self.data.low[0] + self.data.close[0]) / 3.0\n        vol = self.data.volume[0]\n        self.cum_pv += typical_price * vol\n        self.cum_vol += vol\n        vwap = self.cum_pv / self.cum_vol if self.cum_vol else typical_price\n\n        close = self.data.close[0]\n\n        if self.position:\n            if not self.order:\n                if self.position.size > 0:\n                    stop_price = self.entry_price * (1.0 - self.p.stop_pct)\n                    if self.data.low[0] <= stop_price:\n                        self.order = self.close()\n                    elif close < vwap:\n                        self.order = self.close()\n                elif self.position.size < 0:\n                    stop_price = self.entry_price * (1.0 + self.p.stop_pct)\n                    if self.data.high[0] >= stop_price:\n                        self.order = self.close()\n                    elif close > vwap:\n                        self.order = self.close()\n        elif not self.order:\n            if len(self.hist) == self.p.n:\n                if close > vwap and all(c < v for c, v in self.hist):\n                    self.order = self.buy()\n                elif close < vwap and all(c > v for c, v in self.hist):\n                    self.order = self.sell()\n\n        self.hist.append((close, vwap))",
  "assumptions": [

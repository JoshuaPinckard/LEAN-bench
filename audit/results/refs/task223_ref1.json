  "code": "import backtrader as bt\n\n\nclass TrendFollowingPseudoForecast(bt.Strategy):\n    def __init__(self):\n        self.order = None\n\n        self.macd = bt.indicators.MACDHisto(\n            self.data.close,\n            period_me1=12,\n            period_me2=26,\n            period_signal=9,\n        )\n        self.sma20 = bt.indicators.SMA(self.data.close, period=20)\n        self.sma50 = bt.indicators.SMA(self.data.close, period=50)\n        self.ema10 = bt.indicators.EMA(self.data.close, period=10)\n        self.rsi = bt.indicators.RSI(self.data.close, period=14)\n        self.stochastic = bt.indicators.Stochastic(\n            self.data,\n            period=14,\n            period_dfast=3,\n            period_dslow=3,\n        )\n        self.bollinger = bt.indicators.BollingerBands(\n            self.data.close,\n            period=20,\n            devfactor=2,\n        )\n        self.stochastic_cross = bt.indicators.CrossOver(\n            self.stochastic.percK,\n            self.stochastic.percD,\n        )\n\n    def notify_order(self, order):\n        if order.status in (\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ):\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        score = 0\n\n        if self.macd.histo[0] > 0:\n            score += 1\n        elif self.macd.histo[0] < 0:\n            score -= 1\n\n        if (\n            self.sma20[0] > self.sma50[0]\n            and self.ema10[0] > self.ema10[-1]\n            and self.sma20[0] > self.sma20[-1]\n        ):\n            score += 1\n        elif (\n            self.sma20[0] < self.sma50[0]\n            and self.ema10[0] < self.ema10[-1]\n            and self.sma20[0] < self.sma20[-1]\n        ):\n            score -= 1\n\n        if self.rsi[0] > 55:\n            score += 1\n        elif self.rsi[0] < 45:\n            score -= 1\n\n        band_width = self.bollinger.top[0] - self.bollinger.bot[0]\n        previous_band_width = self.bollinger.top[-1] - self.bollinger.bot[-1]\n        if self.data.close[0] > self.bollinger.mid[0] and band_width > previous_band_width:\n            score += 1\n        elif self.data.close[0] < self.bollinger.mid[0] and band_width > previous_band_width:\n            score -= 1\n\n        if self.stochastic_cross[0] > 0 and self.stochastic.percK[0] > 20:\n            score += 1\n        elif self.stochastic_cross[0] < 0 and self.stochastic.percK[0] < 80:\n            score -= 1\n\n        if score >= 2 and self.position.size <= 0:\n            self.order = self.order_target_percent(target=1.0)\n        elif score <= -2 and self.position.size >= 0:\n            self.order = self.order_target_percent(target=-1.0)",

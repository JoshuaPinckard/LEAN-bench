  "model": "gpt-5.6-terra(medium)",
  "code": "import backtrader as bt\nimport math\n\n\nclass MomentumStrategy(bt.Strategy):\n    params = (\n        ('fastperiod', 12),\n        ('slowperiod', 26),\n        ('signalperiod', 9),\n    )\n\n    def __init__(self):\n        macd = bt.indicators.MACD(\n            self.data,\n            period_me1=self.p.fastperiod,\n            period_me2=self.p.slowperiod,\n            period_signal=self.p.signalperiod,\n        )\n        self.crossover = bt.indicators.CrossOver(macd.macd, macd.signal)\n\n        self.capital = 100.0\n        self.capital_dynamics = []\n        self.pending_orders = []\n        self.entry_order = None\n        self.exit_order = None\n\n    def next(self):\n        if self.pending_orders or self.position:\n            return\n\n        if self.crossover[0] > 0:\n            try:\n                next_open = self.data.open[1]\n            except IndexError:\n                return\n\n            if not math.isfinite(next_open) or next_open <= 0:\n                return\n\n            size = self.capital / next_open\n\n            self.entry_order = self.buy(size=size)\n            self.exit_order = self.sell(size=size, exectype=bt.Order.Close)\n            self.pending_orders = [self.entry_order, self.exit_order]\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            if order is self.exit_order and self.entry_order is not None:\n                entry_price = self.entry_order.executed.price\n                exit_price = order.executed.price\n                self.capital *= 1.0 + (exit_price - entry_price) / entry_price\n                self.capital_dynamics.append(self.capital)\n\n        if order.status in (\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ):\n            if order in self.pending_orders:\n                self.pending_orders.remove(order)\n\n            if not self.pending_orders:\n                self.entry_order = None\n                self.exit_order = None",
  "assumptions": [
    {
      "topic": "capital",
      "choice": "Maintain an internal capital balance initialized to $100 and update it only with the specified open-to-close return formula.",
      "reason": "The harness broker starts with $10,000 and applies commission, while the specification explicitly defines $100 initial capital and a commission-free capital-update formula."
    },
    {
      "topic": "next-day opening sizing",
      "choice": "Use the next bar's opening value to calculate the order quantity when the crossover is observed.",
      "reason": "Exact 100%-of-capital sizing at the next day's opening requires that opening price before the market order is submitted; this is otherwise infeasible with standard backtrader next()-time market-order timing."
    },
    {
      "topic": "same-day close exit",
      "choice": "Submit a Close execution sell order together with the next-session market buy order.",
      "reason": "self.close() cannot be submitted while no position exists on the signal day; the paired Close order produces the required next-day close exit after the opening buy is processed."
    },
    {
      "topic": "final-bar signals",
      "choice": "Ignore a crossover when no following bar exists.",
      "reason": "The required t+1 entry and exit cannot occur without a next trading bar."
    }
  ],

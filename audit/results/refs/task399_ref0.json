  "code": "import backtrader as bt\n\n\nclass Supertrend(bt.Indicator):\n    lines = ('supertrend', 'trend', 'final_upper', 'final_lower')\n    params = (('period', 10), ('multiplier', 3.0))\n\n    def __init__(self):\n        self.atr = bt.indicators.ATR(self.data, period=self.p.period)\n        self._seeded = False\n\n    def next(self):\n        hl2 = (self.data.high[0] + self.data.low[0]) / 2.0\n        basic_upper = hl2 + self.p.multiplier * self.atr[0]\n        basic_lower = hl2 - self.p.multiplier * self.atr[0]\n\n        if not self._seeded:\n            final_upper = basic_upper\n            final_lower = basic_lower\n            trend = 1\n            self._seeded = True\n        else:\n            prior_final_upper = self.l.final_upper[-1]\n            prior_final_lower = self.l.final_lower[-1]\n            prior_close = self.data.close[-1]\n            current_close = self.data.close[0]\n            prior_trend = self.l.trend[-1]\n\n            final_upper = (basic_upper if (basic_upper < prior_final_upper\n                                            or prior_close > prior_final_upper)\n                           else prior_final_upper)\n            final_lower = (basic_lower if (basic_lower > prior_final_lower\n                                            or prior_close < prior_final_lower)\n                           else prior_final_lower)\n\n            if current_close > prior_final_upper:\n                trend = 1\n            elif current_close < prior_final_lower:\n                trend = -1\n            else:\n                trend = prior_trend\n\n        self.l.final_upper[0] = final_upper\n        self.l.final_lower[0] = final_lower\n        self.l.trend[0] = trend\n        self.l.supertrend[0] = final_lower if trend == 1 else final_upper\n\n\nclass SupertrendIntradayStrategy(bt.Strategy):\n    params = (\n        ('atr_period', 10),\n        ('multiplier', 3.0),\n        ('volume_period', 20),\n        ('percent_equity', 0.25),\n    )\n\n    def __init__(self):\n        self.st = Supertrend(self.data, period=self.p.atr_period, multiplier=self.p.multiplier)\n        self.volume_sma = bt.indicators.SMA(self.data.volume, period=self.p.volume_period)\n        self.orders = []\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            if order in self.orders:\n                self.orders.remove(order)\n\n    def _target_size(self):\n        equity = self.broker.getvalue()\n        price = self.data.close[0]\n        return int((equity * self.p.percent_equity) / price)\n\n    def next(self):\n        if self.orders:\n            return\n        if len(self.st) < 2:\n            return\n\n        trend = self.st.trend[0]\n        prior_trend = self.st.trend[-1]\n        flip_up = prior_trend == -1 and trend == 1\n        flip_down = prior_trend == 1 and trend == -1\n\n        if not (flip_up or flip_down):\n            return\n\n        is_long = self.position.size > 0\n        is_short = self.position.size < 0\n\n        if (is_long and flip_down) or (is_short and flip_up):\n            self.orders.append(self.close())\n\n        volume_filter = self.data.volume[0] > self.volume_sma[0]\n        if volume_filter:\n            if flip_up and not is_long:\n                size = self._target_size()\n                if size > 0:\n                    self.orders.append(self.buy(size=size))\n            elif flip_down and not is_short:\n                size = self._target_size()\n                if size > 0:\n                    self.orders.append(self.sell(size=size))",
  "assumptions": [
    {
      "topic": "initial trend state",
      "choice": "On the first bar the Supertrend indicator can compute (ATR warm-up satisfied), there is no prior final_upper/final_lower to reference, so final bands are seeded directly from basic_upper/basic_lower and trend is initialized to up (1).",
      "reason": "The spec's recursive definition requires prior values that do not exist on the indicator's first valid bar; spec is silent on initialization."
    },
    {
      "topic": "flip evaluation warm-up",
      "choice": "The strategy does not evaluate entry/exit logic until the Supertrend indicator has produced at least 2 valid bars (needed to detect a trend flip via trend[-1] vs trend[0]).",
      "reason": "Flip detection is inherently a two-bar comparison; the indicator's own automatic minperiod only guarantees one valid bar, so no manual bar-skipping beyond this minimal look-back is used."
    },
    {
      "topic": "position sizing",
      "choice": "Fixed 25% of current broker equity (self.broker.getvalue()) per entry, computed as int(equity*0.25/close) shares.",
      "reason": "Spec explicitly calls for percent-of-equity sizing in the 20-30% range for a medium risk profile but gives no exact figure; 25% chosen as the midpoint."
    },
    {
      "topic": "position transition on opposite flip",
      "choice": "On an opposite trend flip, an open position is closed unconditionally (no volume filter), and independently a new position in the flip direction is opened if the volume filter passes, i.e. the strategy stops-and-reverses on confirmed flips.",
      "reason": "The spec states both a flip-triggered exit rule (unconditional) and flip-triggered long/short entry rules (volume-gated); since entries are exclusively flip-triggered, the only reading under which the spec's stated short and long trading both actually occur over time is treating exit and reversal-entry as co-occurring on the same flip event."
    },
    {

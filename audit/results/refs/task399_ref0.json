    {
      "topic": "ATR smoothing method",
      "choice": "Used backtrader's default ATR implementation (Wilder/RMA-style smoothing) with period=10.",
      "reason": "Spec specifies only the ATR period and multiplier, not the smoothing method, so the standard backtrader default is used."
    },
    {
      "topic": "order guarding with reversal",
      "choice": "Used a list of pending order references (self.orders) instead of a single order flag, since a stop-and-reverse bar submits two orders (close + new entry) in the same next() call.",
      "reason": "Canonical default #5 requires guarding pending orders; a single-order flag would be insufficient when two orders can be pending simultaneously from one flip event."
    }

  "code": "import backtrader as bt\n\n\nclass RSIDivergenceStrategy(bt.Strategy):\n    params = (\n        ('rsi_period', 14),\n        ('pivot_window', 5),\n        ('stop_loss_pct', 0.02),\n    )\n\n    def __init__(self):\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.p.rsi_period)\n        self.rsi_at_pivot = self.rsi(-self.p.pivot_window)\n        self.order = None\n        self.entry_price = None\n        self.pivot_lows = []\n        self.pivot_highs = []\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            if order.isbuy() or order.issell():\n                if not self.position:\n                    self.entry_price = None\n                elif self.entry_price is None:\n                    self.entry_price = order.executed.price\n\n            self.order = None\n\n        elif order.status in (order.Canceled, order.Margin, order.Rejected):\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if self.position:\n            if self.position.size > 0:\n                if ((self.rsi[-1] <= 70 and self.rsi[0] > 70) or\n                        self.data.low[0] <= self.entry_price * (1.0 - self.p.stop_loss_pct)):\n                    self.order = self.close()\n            else:\n                if ((self.rsi[-1] >= 30 and self.rsi[0] < 30) or\n                        self.data.high[0] >= self.entry_price * (1.0 + self.p.stop_loss_pct)):\n                    self.order = self.close()\n            return\n\n        n = self.p.pivot_window\n        pivot_low_price = self.data.low[-n]\n        pivot_high_price = self.data.high[-n]\n        pivot_rsi = self.rsi_at_pivot[0]\n\n        is_pivot_low = pivot_low_price == min(self.data.low[-i] for i in range(2 * n + 1))\n        is_pivot_high = pivot_high_price == max(self.data.high[-i] for i in range(2 * n + 1))\n\n        bullish_divergence = False\n        bearish_divergence = False\n\n        if is_pivot_low:\n            self.pivot_lows.append((pivot_low_price, pivot_rsi))\n            if len(self.pivot_lows) >= 2:\n                prior_price, prior_rsi = self.pivot_lows[-2]\n                recent_price, recent_rsi = self.pivot_lows[-1]\n                bullish_divergence = recent_price < prior_price and recent_rsi > prior_rsi\n\n        if is_pivot_high:\n            self.pivot_highs.append((pivot_high_price, pivot_rsi))\n            if len(self.pivot_highs) >= 2:\n                prior_price, prior_rsi = self.pivot_highs[-2]\n                recent_price, recent_rsi = self.pivot_highs[-1]\n                bearish_divergence = recent_price > prior_price and recent_rsi < prior_rsi\n\n        size = self.broker.getcash() / self.data.close[0]\n\n        if bullish_divergence:\n            self.order = self.buy(size=size)\n        elif bearish_divergence:\n            self.order = self.sell(size=size)",

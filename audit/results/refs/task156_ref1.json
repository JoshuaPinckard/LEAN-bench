  "code": "import backtrader as bt\nimport math\n\n\nclass MomentumStrategy(bt.Strategy):\n    params = (\n        (\"risk_fraction\", 0.01),\n    )\n\n    def __init__(self):\n        self.order = None\n        self.entry_price = None\n        self.entry_direction = 0\n\n        self.ema = bt.indicators.EMA(self.data.close, period=50)\n        self.atr = bt.indicators.ATR(self.data, period=14)\n        self.macd = bt.indicators.MACD(\n            self.data.close,\n            period_me1=12,\n            period_me2=26,\n            period_signal=9,\n        )\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close,\n            period=20,\n            devfactor=2,\n        )\n        self.bbwidth = self.bb.top - self.bb.bot\n        self.bbwidth_sma = bt.indicators.SMA(self.bbwidth, period=100)\n        self.squeeze = self.bbwidth <= (self.bbwidth_sma * 0.85)\n\n    def _size_for_risk(self, direction, half_size):\n        capital = self.broker.getvalue()\n        risk_amount = capital * self.p.risk_fraction\n        close = self.data.close[0]\n\n        if direction > 0:\n            per_share_risk = close - (self.ema[0] - 0.5 * self.atr[0])\n        else:\n            per_share_risk = (self.ema[0] + 0.5 * self.atr[0]) - close\n\n        if per_share_risk <= 0:\n            return 0\n\n        risk_size = math.floor(risk_amount / per_share_risk)\n        cash_size = math.floor(self.broker.getcash() / (close * 1.001))\n        size = min(risk_size, cash_size)\n\n        if half_size:\n            size = math.floor(size / 2)\n\n        return max(size, 0)\n\n    def next(self):\n        if self.order:\n            return\n\n        if self.position:\n            if (\n                self.data.datetime.time(0).hour == 15\n                and self.data.datetime.time(0).minute >= 30\n            ):\n                self.order = self.close()\n                return\n\n            if self.entry_direction > 0:\n                stop_hit = self.data.close[0] < (self.ema[0] - 0.5 * self.atr[0])\n                target_hit = self.data.close[0] >= (\n                    self.entry_price + 1.5 * self.atr[0]\n                )\n            else:\n                stop_hit = self.data.close[0] > (self.ema[0] + 0.5 * self.atr[0])\n                target_hit = self.data.close[0] <= (\n                    self.entry_price - 1.5 * self.atr[0]\n                )\n\n            if stop_hit or target_hit:\n                self.order = self.close()\n            return\n\n        squeeze_recent = any(self.squeeze[-i] for i in range(5))\n        expansion = self.bbwidth[0] > self.bbwidth[-1]\n\n        histogram = self.macd.macd[0] - self.macd.signal[0]\n        previous_histogram = self.macd.macd[-1] - self.macd.signal[-1]\n\n        long_trend = (\n            self.data.close[0] > self.ema[0]\n            and (self.data.close[0] - self.ema[0]) > 0.5 * self.atr[0]\n        )\n        short_trend = (\n            self.data.close[0] < self.ema[0]\n            and (self.ema[0] - self.data.close[0]) > 0.5 * self.atr[0]\n        )\n\n        long_confirmation = (\n            squeeze_recent\n            and expansion\n            and histogram > 0\n            and histogram > previous_histogram\n        )\n        short_confirmation = (\n            squeeze_recent\n            and expansion\n            and histogram < 0\n            and histogram < previous_histogram\n        )\n\n        if long_trend:\n            size = self._size_for_risk(1, not long_confirmation)\n            if size > 0:\n                self.order = self.buy(size=size)\n                self.order.addinfo(kind=\"entry\", direction=1)\n\n        elif short_trend:\n            size = self._size_for_risk(-1, not short_confirmation)\n            if size > 0:\n                self.order = self.sell(size=size)\n                self.order.addinfo(kind=\"entry\", direction=-1)\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            if getattr(order.info, \"kind\", None) == \"entry\":\n                self.entry_price = order.executed.price\n                self.entry_direction = order.info.direction\n            elif not self.position:\n                self.entry_price = None\n                self.entry_direction = 0\n\n        if order.status in (\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ):\n            self.order = None",

  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass BearishWeeklyShortStrategy(bt.Strategy):\n    params = (\n        ('risk_per_trade', 0.01),\n        ('k', 2.0),\n        ('atr_period', 14),\n        ('hold_days', 20),\n        ('interval', 7),\n    )\n\n    def __init__(self):\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.entry_order = None\n        self.tp_order = None\n        self.sl_order = None\n        self.close_order = None\n        self.entry_bar = None\n        self.entry_price = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status == order.Completed:\n            if order == self.entry_order:\n                self.entry_price = order.executed.price\n                self.entry_bar = len(self)\n                size = abs(order.executed.size)\n                atr_val = self.atr[0]\n\n                tp_price = self.entry_price - (0.5 * self.p.k * atr_val)\n                sl_price = self.entry_price + (self.p.k * atr_val)\n\n                self.tp_order = self.buy(\n                    size=size,\n                    price=tp_price,\n                    exectype=bt.Order.Limit\n                )\n                self.sl_order = self.buy(\n                    size=size,\n                    price=sl_price,\n                    exectype=bt.Order.Stop,\n                    oco=self.tp_order\n                )\n                self.entry_order = None\n\n            elif order in [self.tp_order, self.sl_order]:\n                self.tp_order = None\n                self.sl_order = None\n\n            elif order == self.close_order:\n                self.close_order = None\n\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order == self.entry_order:\n                self.entry_order = None\n            if order == self.tp_order:\n                self.tp_order = None\n            if order == self.sl_order:\n                self.sl_order = None\n            if order == self.close_order:\n                self.close_order = None\n\n    def next(self):\n        if self.position:\n            if self.entry_bar is not None and (len(self) - self.entry_bar >= self.p.hold_days):\n                if self.tp_order:\n                    self.cancel(self.tp_order)\n                if self.sl_order:\n                    self.cancel(self.sl_order)\n                self.close_order = self.close()\n            return\n\n        has_pending_order = (\n            self.entry_order is not None or\n            self.close_order is not None\n        )\n\n        if not has_pending_order and (len(self) % self.p.interval == 0):\n            atr_val = self.atr[0]\n            if atr_val > 0:\n                capital = self.broker.getvalue()\n                risk_amt = capital * self.p.risk_per_trade\n                risk_per_share = self.p.k * atr_val\n                if risk_per_share > 0:\n                    size = int(risk_amt / risk_per_share)\n                    if size > 0:\n                        self.entry_order = self.sell(size=size)",
  "assumptions": [
    {
      "topic": "entry_interval_tracking",

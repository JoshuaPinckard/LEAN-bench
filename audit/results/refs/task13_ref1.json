  "code": "import backtrader as bt\n\n\nclass PyramidingInTrend(bt.Strategy):\n    params = (\n        ('ema_period', 50),\n        ('rsi_period', 14),\n    )\n\n    def __init__(self):\n        self.ema = bt.indicators.ExponentialMovingAverage(\n            self.data.close, period=self.p.ema_period\n        )\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.p.rsi_period)\n\n        self.order = None\n        self.initial_capital = None\n        self.fixed_volume = None\n\n        self.entries_completed = 0\n        self.rsi_below_50_seen = False\n        self.rsi_70_seen = False\n        self.rsi_above_60_seen = False\n        self.break_even_taken = False\n        self.take_profit_taken = False\n\n    def start(self):\n        self.initial_capital = self.broker.getcash()\n\n    def notify_order(self, order):\n        if order.status in (\n            order.Completed, order.Canceled, order.Margin, order.Rejected\n        ):\n            if order.status == order.Completed and order.isbuy():\n                self.entries_completed += 1\n\n            if order.status == order.Completed and order.issell():\n                if not self.position.size:\n                    self.entries_completed = 0\n                    self.rsi_below_50_seen = False\n                    self.rsi_70_seen = False\n                    self.rsi_above_60_seen = False\n                    self.break_even_taken = False\n                    self.take_profit_taken = False\n\n            self.order = None\n\n    def next(self):\n        close = self.data.close[0]\n        rsi = self.rsi[0]\n\n        if not self.position.size:\n            if rsi < 50:\n                self.rsi_below_50_seen = True\n\n            if self.order is None:\n                if (\n                    self.rsi_below_50_seen\n                    and rsi > 50\n                    and close > self.ema[0]\n                ):\n                    self.fixed_volume = (self.initial_capital * 0.01) / close\n                    self.order = self.buy(\n                        size=self.fixed_volume, exectype=bt.Order.Close\n                    )\n                    self.rsi_below_50_seen = False\n            return\n\n        if rsi > 60:\n            self.rsi_above_60_seen = True\n\n        if self.entries_completed >= 1 and rsi >= 70:\n            self.rsi_70_seen = True\n\n        if self.order is not None:\n            return\n\n        if close < self.ema[0]:\n            self.order = self.close(exectype=bt.Order.Close)\n            return\n\n        if self.rsi_above_60_seen and rsi < 40:\n            self.order = self.close(exectype=bt.Order.Close)\n            return\n\n        total_profit = (close - self.position.price) * self.position.size\n        total_entry_value = self.position.price * self.position.size\n\n        if not self.break_even_taken and total_profit >= 0:\n            self.order = self.close(\n                size=self.position.size * 0.25, exectype=bt.Order.Close\n            )\n            self.break_even_taken = True\n            return\n\n        if (\n            not self.take_profit_taken\n            and total_entry_value > 0\n            and total_profit >= total_entry_value * 0.05\n        ):\n            self.order = self.close(\n                size=self.position.size * 0.50, exectype=bt.Order.Close\n            )\n            self.take_profit_taken = True\n            return\n\n        if (\n            self.entries_completed < 4\n            and self.rsi_70_seen\n            and rsi <= 60\n            and close > self.ema[0]\n        ):\n            self.order = self.buy(\n                size=self.fixed_volume, exectype=bt.Order.Close\n            )\n            self.rsi_70_seen = False",
  "assumptions": [

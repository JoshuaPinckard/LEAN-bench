  "code": "import backtrader as bt\n\n\nclass CombinedMomentumStrategy(bt.Strategy):\n    params = (\n        ('rsi_period', 14),\n        ('macd_fast', 12),\n        ('macd_slow', 26),\n        ('macd_signal', 9),\n        ('momentum_ma_period', 14),\n        ('atr_period', 14),\n        ('stop_loss_pct', 0.01),\n        ('take_profit_pct', 0.02),\n        ('capital_pct', 0.01),\n    )\n\n    def __init__(self):\n        self.order = None\n        self.stop_order = None\n        self.take_profit_order = None\n\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.p.rsi_period)\n        self.macd = bt.indicators.MACD(\n            self.data.close,\n            period_me1=self.p.macd_fast,\n            period_me2=self.p.macd_slow,\n            period_signal=self.p.macd_signal,\n        )\n        self.momentum_ma = bt.indicators.SimpleMovingAverage(\n            self.data.close, period=self.p.momentum_ma_period\n        )\n        self.momentum = self.data.close - self.momentum_ma\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n\n    def _open_position_count(self):\n        return sum(\n            1 for position in self.broker.positions.values()\n            if position.size != 0\n        )\n\n    def _cancel_risk_orders(self):\n        if self.stop_order is not None:\n            self.cancel(self.stop_order)\n        if self.take_profit_order is not None:\n            self.cancel(self.take_profit_order)\n\n    def _place_risk_orders(self, entry_price, is_long):\n        size = abs(self.position.size)\n\n        if is_long:\n            self.stop_order = self.sell(\n                exectype=bt.Order.Stop,\n                price=entry_price * (1.0 - self.p.stop_loss_pct),\n                size=size,\n            )\n            self.take_profit_order = self.sell(\n                exectype=bt.Order.Limit,\n                price=entry_price * (1.0 + self.p.take_profit_pct),\n                size=size,\n                oco=self.stop_order,\n            )\n        else:\n            self.stop_order = self.buy(\n                exectype=bt.Order.Stop,\n                price=entry_price * (1.0 + self.p.stop_loss_pct),\n                size=size,\n            )\n            self.take_profit_order = self.buy(\n                exectype=bt.Order.Limit,\n                price=entry_price * (1.0 - self.p.take_profit_pct),\n                size=size,\n                oco=self.stop_order,\n            )\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            if order == self.order:\n                self.order = None\n                if self.position.size != 0:\n                    self._place_risk_orders(\n                        order.executed.price,\n                        self.position.size > 0,\n                    )\n            elif order == self.stop_order or order == self.take_profit_order:\n                self.stop_order = None\n                self.take_profit_order = None\n\n        elif order.status in (order.Canceled, order.Margin, order.Rejected):\n            if order == self.order:\n                self.order = None\n            elif order == self.stop_order:\n                self.stop_order = None\n            elif order == self.take_profit_order:\n                self.take_profit_order = None\n\n    def next(self):\n        if self.order is not None:\n            return\n\n        macd_cross_up = (\n            self.macd.macd[-1] <= self.macd.signal[-1]\n            and self.macd.macd[0] > self.macd.signal[0]\n        )\n        macd_cross_down = (\n            self.macd.macd[-1] >= self.macd.signal[-1]\n            and self.macd.macd[0] < self.macd.signal[0]\n        )\n\n        if self.position.size > 0:\n            if self.rsi[0] > 70 or macd_cross_down:\n                self._cancel_risk_orders()\n                self.order = self.close()\n            return\n\n        if self.position.size < 0:\n            if self.rsi[0] < 30 or macd_cross_up:\n                self._cancel_risk_orders()\n                self.order = self.close()\n            return\n\n        high_volatility = self.atr[0] > (0.02 * self.data.close[0])\n        neutral_rsi = 40 <= self.rsi[0] <= 60\n        position_size = (\n            self.broker.getvalue() * self.p.capital_pct / self.data.close[0]\n        )\n\n        if (\n            not high_volatility\n            and self._open_position_count() < 3\n            and neutral_rsi\n            and macd_cross_up\n            and self.momentum[0] > 0\n        ):\n            self.order = self.buy(size=position_size)\n\n        elif (\n            not high_volatility\n            and self._open_position_count() < 3\n            and neutral_rsi\n            and macd_cross_down\n            and self.momentum[0] < 0\n        ):\n            self.order = self.sell(size=position_size)",

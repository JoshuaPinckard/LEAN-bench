  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass BollingerATRBreakoutStrategy(bt.Strategy):\n    params = (\n        ('bb_period', 20),\n        ('bb_devfactor', 2.0),\n        ('atr_period', 14),\n        ('atr_sma_period', 20),\n        ('atr_mult', 2.0),\n    )\n\n    def __init__(self):\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close,\n            period=self.p.bb_period,\n            devfactor=self.p.bb_devfactor\n        )\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.atr_sma = bt.indicators.SMA(self.atr, period=self.p.atr_sma_period)\n\n        self.order = None\n        self.entry_price = None\n        self.stop_price = None\n        self.highest_close = None\n        self.lowest_close = None\n\n    def notify_order(self, order):\n        if order.status in [order.Completed]:\n            if self.position.size > 0:\n                if self.stop_price is None:\n                    self.entry_price = order.executed.price\n                    self.stop_price = self.entry_price - self.p.atr_mult * self.atr[0]\n                    self.highest_close = self.data.close[0]\n            elif self.position.size < 0:\n                if self.stop_price is None:\n                    self.entry_price = order.executed.price\n                    self.stop_price = self.entry_price + self.p.atr_mult * self.atr[0]\n                    self.lowest_close = self.data.close[0]\n            else:\n                self.entry_price = None\n                self.stop_price = None\n                self.highest_close = None\n                self.lowest_close = None\n            self.order = None\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        vol_filter = self.atr[0] > self.atr_sma[0]\n\n        close_cross_above_upper = (self.data.close[-1] <= self.bb.lines.top[-1]) and (self.data.close[0] > self.bb.lines.top[0])\n        close_cross_below_lower = (self.data.close[-1] >= self.bb.lines.bot[-1]) and (self.data.close[0] < self.bb.lines.bot[0])\n\n        if not self.position:\n            if close_cross_above_upper and vol_filter:\n                self.order = self.buy()\n            elif close_cross_below_lower and vol_filter:\n                self.order = self.sell()\n        else:\n            if self.position.size > 0:\n                if self.highest_close is None:\n                    self.highest_close = self.data.close[0]\n                else:\n                    self.highest_close = max(self.highest_close, self.data.close[0])\n\n                candidate_stop = self.highest_close - self.p.atr_mult * self.atr[0]\n                if self.stop_price is None:\n                    self.stop_price = candidate_stop\n                else:\n                    self.stop_price = max(self.stop_price, candidate_stop)\n\n                stop_hit = self.data.low[0] <= self.stop_price\n                opposite_signal = close_cross_below_lower and vol_filter\n\n                if stop_hit or opposite_signal:\n                    self.order = self.close()\n\n            elif self.position.size < 0:\n                if self.lowest_close is None:\n                    self.lowest_close = self.data.close[0]\n                else:\n                    self.lowest_close = min(self.lowest_close, self.data.close[0])\n\n                candidate_stop = self.lowest_close + self.p.atr_mult * self.atr[0]\n                if self.stop_price is None:\n                    self.stop_price = candidate_stop\n                else:\n                    self.stop_price = min(self.stop_price, candidate_stop)\n\n                stop_hit = self.data.high[0] >= self.stop_price\n                opposite_signal = close_cross_above_upper and vol_filter\n\n                if stop_hit or opposite_signal:\n                    self.order = self.close()",
  "assumptions": [
    {
      "topic": "trailing_stop_execution",
      "choice": "Evaluate trailing stop hit in next() by comparing bar Low <= stop_price for long positions and bar High >= stop_price for short positions.",
      "reason": "The specification states to close the position when the trailing stop is hit. Intraday extreme prices (Low/High) reaching or breaching the trailing stop level indicate the stop was hit during the bar."
    },
    {
      "topic": "entry_execution_and_initial_stop",
      "choice": "Execute entries via market orders (self.buy() / self.sell()) and initialize the trailing stop in notify_order using the actual execution price (order.executed.price) +/- mult * ATR.",
      "reason": "Market orders execute at the open of the bar following the signal bar. Initializing the stop upon order completion using order.executed.price adheres to standard execution mechanics."
    },
    {
      "topic": "opposite_signal_handling",
      "choice": "Exit existing position via self.close() when an opposite breakout signal occurs, and delay new entry until flat on subsequent bars.",
      "reason": "The specification specifies exit rules as 'close the position when ... an opposite breakout signal occurs'. Following canonical defaults, single position holding is maintained and pending orders are guarded."
    }
  ],

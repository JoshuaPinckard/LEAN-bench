  "model": "claude-sonnet-5",
  "code": "import collections\nimport statistics\n\nimport backtrader as bt\n\n\nclass MeanReversionBollingerStrategy(bt.Strategy):\n    params = dict(\n        bb_period=20,\n        bb_devfactor=1.5,\n        sma_period=200,\n        atr_period=14,\n        atr_lookback=252,\n        atr_percentile_n=5,   # n=5 -> quantile cut points at 20/40/60/80\n        exit_bars=5,\n        position_value=1000.0,\n        max_loss_pct=0.02,\n    )\n\n    def __init__(self):\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close, period=self.p.bb_period, devfactor=self.p.bb_devfactor\n        )\n        self.sma200 = bt.indicators.SMA(self.data.close, period=self.p.sma_period)\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n\n        self.cross_lower = bt.indicators.CrossOver(self.data.close, self.bb.bot)\n        self.cross_upper = bt.indicators.CrossOver(self.data.close, self.bb.top)\n        self.cross_mid = bt.indicators.CrossOver(self.data.close, self.bb.mid)\n\n        self.atr_history = collections.deque(maxlen=self.p.atr_lookback)\n\n        self.order = None\n        self.bar_executed = None\n        self.initial_capital = self.broker.getvalue()\n\n    def notify_order(self, order):\n        if order.status in (order.Submitted, order.Accepted):\n            return\n\n        if order.status == order.Completed:\n            if self.position:\n                self.bar_executed = len(self)\n            else:\n                self.bar_executed = None\n\n        self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        self.atr_history.append(self.atr[0])\n\n        if self.position:\n            floating_pnl = (self.data.close[0] - self.position.price) * self.position.size\n            if floating_pnl < -self.p.max_loss_pct * self.initial_capital:\n                self.order = self.close()\n                return\n\n            bars_in_trade = len(self) - self.bar_executed\n            if self.cross_mid[0] != 0 or bars_in_trade >= self.p.exit_bars:\n                self.order = self.close()\n            return\n\n        if len(self.atr_history) < self.p.atr_lookback:\n            return\n\n        atr_p20 = statistics.quantiles(list(self.atr_history), n=self.p.atr_percentile_n)[0]\n        if self.atr[0] < atr_p20:\n            return\n\n        price = self.data.close[0]\n        size = self.p.position_value / price\n\n        if self.cross_lower[0] < 0 and price <= self.sma200[0]:\n            self.order = self.buy(size=size)\n        elif self.cross_upper[0] > 0 and price >= self.sma200[0]:\n            self.order = self.sell(size=size)",
  "assumptions": [

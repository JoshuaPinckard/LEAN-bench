  "model": "gemini-3.6-flash(vertex)",
  "code": "import statistics\nimport backtrader as bt\n\n\nclass VaROverlappingIntervalsStrategy(bt.Strategy):\n    params = (\n        ('vol_period', 250),\n        ('short_vol_period', 20),\n        ('confidence_level', 0.95),\n        ('high_vol_threshold', 2.0),\n    )\n\n    def __init__(self):\n        self.order = None\n        self.pct_change = bt.indicators.PercentChange(self.data.close, period=1)\n\n        self.exceedances = []\n        self.filtered_bars = 0\n        self.valid_bars = 0\n        self.total_bars = 0\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        self.total_bars += 1\n\n        if len(self.pct_change) < self.p.vol_period + 1:\n            return\n\n        returns_250 = [self.pct_change[-i] for i in range(self.p.vol_period)]\n        returns_250 = [r for r in returns_250 if r is not None]\n\n        if len(returns_250) < self.p.vol_period:\n            return\n\n        vol_250 = statistics.stdev(returns_250)\n\n        returns_20 = returns_250[:self.p.short_vol_period]\n        vol_20 = statistics.stdev(returns_20) if len(returns_20) > 1 else vol_250\n\n        if vol_250 > 0 and (vol_20 / vol_250) > self.p.high_vol_threshold:\n            self.filtered_bars += 1\n            if self.position and not self.order:\n                self.order = self.close()\n            return\n\n        self.valid_bars += 1\n\n        z_score = 1.644853\n        var_pct = z_score * vol_250\n\n        current_return = self.pct_change[0]\n        if current_return is None:\n            return\n\n        actual_loss = -current_return\n        is_exceedance = actual_loss > var_pct\n\n        if is_exceedance:\n            dt = self.data.datetime.date(0)\n            self.exceedances.append((len(self), dt, actual_loss, var_pct))\n\n            if not self.position and not self.order:\n                self.order = self.buy()\n        else:\n            if self.position and not self.order:\n                self.order = self.close()\n\n    def stop(self):\n        num_exceedances = len(self.exceedances)\n        expected_rate = 1.0 - self.p.confidence_level\n        actual_rate = (num_exceedances / self.valid_bars) if self.valid_bars > 0 else 0.0\n\n        clustering_counts = 0\n        if num_exceedances > 1:\n            for i in range(1, num_exceedances):\n                gap = self.exceedances[i][0] - self.exceedances[i - 1][0]\n                if gap <= 5:\n                    clustering_counts += 1\n\n        print(\"=== VaR Model Adequacy & Overlapping Intervals Report ===\")\n        print(f\"Total Bars Evaluated: {self.total_bars}\")\n        print(f\"Filtered High Volatility/Black Swan Bars: {self.filtered_bars}\")\n        print(f\"Valid Analysis Bars: {self.valid_bars}\")\n        print(f\"Total VaR Exceedances: {num_exceedances}\")\n        print(f\"Expected Exceedance Rate: {expected_rate:.2%}\")\n        print(f\"Actual Exceedance Rate: {actual_rate:.2%}\")\n        print(f\"Clustered Exceedances (gap <= 5 bars): {clustering_counts}\")\n\n        if actual_rate > expected_rate * 1.5:\n            conclusion = \"Model UNDERESTIMATES risk (too many exceedances, likely due to data dependence/overlap).\"\n        elif actual_rate < expected_rate * 0.5:\n            conclusion = \"Model OVERESTIMATES risk (too few exceedances).\"\n        else:\n            conclusion = \"Model VaR estimation is ADEQUATE for the specified confidence level.\"\n\n        if clustering_counts > 0:\n            conclusion += \" Significant clustering observed, indicating dependence in overlapping intervals.\"\n        else:\n            conclusion += \" No significant temporal clustering detected.\"\n\n        print(f\"Conclusion: {conclusion}\")",

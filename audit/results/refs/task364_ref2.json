  "code": "import backtrader as bt\n\n\nclass MeanReversionBBStoch(bt.Strategy):\n    params = (\n        ('bband_period', 20),\n        ('bband_dev', 2.0),\n        ('stoch_period', 14),\n        ('stoch_dfast', 3),\n        ('stoch_dslow', 3),\n        ('stoch_oversold', 20.0),\n        ('stoch_overbought', 80.0),\n        ('stop_loss_pct', 0.02),\n    )\n\n    def __init__(self):\n        self.bband = bt.indicators.BollingerBands(\n            self.data,\n            period=self.params.bband_period,\n            devfactor=self.params.bband_dev\n        )\n        self.stoch = bt.indicators.Stochastic(\n            self.data,\n            period=self.params.stoch_period,\n            period_dfast=self.params.stoch_dfast,\n            period_dslow=self.params.stoch_dslow\n        )\n        self.order = None\n        self.entry_price = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if self.position.size != 0:\n                self.entry_price = order.executed.price\n            else:\n                self.entry_price = None\n            self.order = None\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        long_signal = (self.data.low[0] <= self.bband.lines.bot[0]) and (\n            self.stoch.lines.percK[0] < self.params.stoch_oversold\n        )\n        short_signal = (self.data.high[0] >= self.bband.lines.top[0]) and (\n            self.stoch.lines.percK[0] > self.params.stoch_overbought\n        )\n\n        if self.position.size > 0:\n            stop_loss = self.data.low[0] <= self.entry_price * (1.0 - self.params.stop_loss_pct)\n            if stop_loss or short_signal:\n                self.order = self.close()\n        elif self.position.size < 0:\n            stop_loss = self.data.high[0] >= self.entry_price * (1.0 + self.params.stop_loss_pct)\n            if stop_loss or long_signal:\n                self.order = self.close()\n        else:\n            if long_signal:\n                self.order = self.buy()\n            elif short_signal:\n                self.order = self.sell()",
  "assumptions": [

  "code": "import backtrader as bt\n\n\nclass TimeSeriesMomentum(bt.Strategy):\n    params = (\n        ('period', 252),\n    )\n\n    def __init__(self):\n        self.roc = bt.indicators.RateOfChange(\n            self.data.close,\n            period=self.p.period,\n        )\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in (\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ):\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        momentum = self.roc[0]\n\n        if not self.position:\n            if momentum > 0:\n                self.order = self.order_target_percent(target=1.0)\n            elif momentum < 0:\n                self.order = self.order_target_percent(target=-1.0)\n        elif self.position.size > 0 and momentum < 0:\n            self.order = self.close()\n        elif self.position.size < 0 and momentum > 0:\n            self.order = self.close()",

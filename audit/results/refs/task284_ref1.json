  "code": "import backtrader as bt\n\n\nclass MomentumTrailingStrategy(bt.Strategy):\n    params = (\n        ('bb_period', 20),\n        ('bb_devfactor', 2),\n        ('rsi_period', 14),\n    )\n\n    def __init__(self):\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close,\n            period=self.p.bb_period,\n            devfactor=self.p.bb_devfactor,\n        )\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.p.rsi_period)\n\n        self.order = None\n        self.highest_price = None\n        self.trailing_stop_loss = None\n        self.entry_pending = False\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            if order.isbuy():\n                self.highest_price = order.executed.price\n                self.trailing_stop_loss = order.executed.price * (1 - 1 / 100)\n                self.entry_pending = True\n            elif order.issell():\n                self.highest_price = None\n                self.trailing_stop_loss = None\n\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if self.position:\n            if self.entry_pending:\n                self.entry_pending = False\n                return\n\n            self.highest_price = max(self.highest_price, self.data.high[0])\n            self.trailing_stop_loss = max(\n                self.trailing_stop_loss,\n                self.highest_price * (1 - 1 / 100),\n            )\n\n            if self.data.close[0] <= self.trailing_stop_loss:\n                self.order = self.close()\n            return\n\n        crossed_above_upper_band = (\n            self.data.close[-1] <= self.bb.top[-1]\n            and self.data.close[0] > self.bb.top[0]\n        )\n\n        if crossed_above_upper_band and self.rsi[0] > 55:\n            self.order = self.buy(size=1)",

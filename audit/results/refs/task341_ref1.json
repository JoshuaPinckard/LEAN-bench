  "model": "gpt-5.6-terra(medium)",
  "code": "import backtrader as bt\n\n\nclass SMATrendStrategy(bt.Strategy):\n    def __init__(self):\n        self.sma5 = bt.indicators.SimpleMovingAverage(self.data.close, period=5)\n        self.sma20 = bt.indicators.SimpleMovingAverage(self.data.close, period=20)\n        self.sma50 = bt.indicators.SimpleMovingAverage(self.data.close, period=50)\n        self.cross_down = bt.indicators.CrossDown(self.sma5, self.sma20)\n        self.cross_up = bt.indicators.CrossUp(self.sma5, self.sma20)\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        price = self.data.close[0]\n\n        if self.position.size > 0:\n            if self.cross_down[0] or price <= self.position.price * 0.98:\n                self.order = self.close()\n            return\n\n        if self.position.size < 0:\n            if self.cross_up[0] or price >= self.position.price * 1.02:\n                self.order = self.close()\n            return\n\n        size = self.broker.getcash() / (\n            price * (1.0 + self.broker.getcommissioninfo(self.data).p.commission)\n        )\n\n        if self.sma5[0] > self.sma20[0] and self.sma20[0] > self.sma50[0]:\n            self.order = self.buy(size=size)\n        elif self.sma5[0] < self.sma20[0] and self.sma20[0] < self.sma50[0]:\n            self.order = self.sell(size=size)",
  "assumptions": [
    {
      "topic": "position sizing",
      "choice": "Size each market order using available cash divided by the current close adjusted for the configured commission rate.",
      "reason": "The specification requires committing full available capital; the current close is the available reference price when submitting a market order, and commission adjustment avoids exceeding available cash."
    },
    {
      "topic": "price-based exits",
      "choice": "Evaluate the 2% entry-price thresholds using each bar's Close price.",
      "reason": "The specification says price drops or rises but does not specify an OHLC field."
    }
  ],

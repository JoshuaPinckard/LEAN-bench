  "code": "import backtrader as bt\n\n\nclass SlopeIndicator(bt.Indicator):\n    lines = ('slope',)\n    params = (('lag', 20),)\n\n    def __init__(self):\n        self.lines.slope = (self.data - self.data(-self.p.lag)) / self.p.lag\n\n\nclass SmaSlopeReversalStrategy(bt.Strategy):\n    params = (\n        ('sma_period', 20),\n        ('slope_lag', 20),\n        ('std_lookback', 100),\n        ('extreme_mult', 2.0),\n        ('stop_pct', 0.02),\n        ('neutral_mult', 0.2),\n    )\n\n    def __init__(self):\n        self.sma = bt.indicators.SMA(self.data.close, period=self.p.sma_period)\n        self.slope = SlopeIndicator(self.sma, lag=self.p.slope_lag)\n        self.slope_std = bt.indicators.StdDev(self.slope, period=self.p.std_lookback)\n        self.pos_th = self.p.extreme_mult * self.slope_std\n        self.neg_th = -self.p.extreme_mult * self.slope_std\n        self.neutral_band = self.p.neutral_mult * self.slope_std\n\n        self.order = None\n        self.stop_price = None\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            if self.position:\n                if order.isbuy():\n                    self.stop_price = order.executed.price * (1 - self.p.stop_pct)\n                else:\n                    self.stop_price = order.executed.price * (1 + self.p.stop_pct)\n            else:\n                self.stop_price = None\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        slope0 = self.slope[0]\n        slope1 = self.slope[-1]\n        neg_th0 = self.neg_th[0]\n        neg_th1 = self.neg_th[-1]\n        pos_th0 = self.pos_th[0]\n        pos_th1 = self.pos_th[-1]\n        neutral_band0 = self.neutral_band[0]\n\n        if not self.position:\n            if slope1 <= neg_th1 and slope0 > neg_th0:\n                self.order = self.buy()\n            elif slope1 >= pos_th1 and slope0 < pos_th0:\n                self.order = self.sell()\n            return\n\n        cross_zero = (slope1 <= 0 and slope0 > 0) or (slope1 >= 0 and slope0 < 0)\n        neutral = abs(slope0) < neutral_band0\n\n        if self.position.size > 0:\n            if self.data.close[0] <= self.stop_price:\n                self.order = self.close()\n            elif cross_zero or neutral:\n                self.order = self.close()\n        elif self.position.size < 0:\n            if self.data.close[0] >= self.stop_price:\n                self.order = self.close()\n            elif cross_zero or neutral:\n                self.order = self.close()",

  "code": "import backtrader as bt\n\n\nclass ReferenceStrategy(bt.Strategy):\n    params = (\n        ('ema_period', 20),\n        ('volume_sma_period', 20),\n        ('stop_loss', 0.015),\n        ('take_profit', 0.03),\n    )\n\n    def __init__(self):\n        self.ema = bt.indicators.EMA(self.data.close, period=self.p.ema_period)\n        self.volume_sma = bt.indicators.SMA(\n            self.data.volume, period=self.p.volume_sma_period\n        )\n        self.crossover = bt.indicators.CrossOver(self.data.close, self.ema)\n        self.order = None\n        self.entry_price = None\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            if self.position.size:\n                self.entry_price = order.executed.price\n            else:\n                self.entry_price = None\n\n        if order.status in (\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ):\n            self.order = None\n\n    def _size(self):\n        commission = self.broker.getcommissioninfo(self.data).p.commission\n        return self.broker.getcash() / (\n            self.data.close[0] * (1.0 + commission)\n        )\n\n    def next(self):\n        if self.order or len(self.data) < 20:\n            return\n\n        if self.position.size > 0:\n            if (\n                self.crossover[0] < 0\n                or self.data.close[0] <= self.entry_price * (1.0 - self.p.stop_loss)\n                or self.data.close[0] >= self.entry_price * (1.0 + self.p.take_profit)\n            ):\n                self.order = self.close()\n\n        elif self.position.size < 0:\n            if (\n                self.crossover[0] > 0\n                or self.data.close[0] >= self.entry_price * (1.0 + self.p.stop_loss)\n                or self.data.close[0] <= self.entry_price * (1.0 - self.p.take_profit)\n            ):\n                self.order = self.close()\n\n        elif self.data.volume[0] > self.volume_sma[0]:\n            size = self._size()\n\n            if self.crossover[0] > 0:\n                self.order = self.buy(size=size)\n            elif self.crossover[0] < 0:\n                self.order = self.sell(size=size)",
  "assumptions": [

  "code": "import backtrader as bt\nimport math\n\n\nclass MSTRSignalConflict(bt.Strategy):\n    def __init__(self):\n        self.sma365 = bt.indicators.SimpleMovingAverage(self.data.close, period=365)\n        self.sma200 = bt.indicators.SimpleMovingAverage(self.data.close, period=200)\n        self.sma10 = bt.indicators.SimpleMovingAverage(self.data.close, period=10)\n        self.pending_order = None\n        self.sma365_history = []\n\n    @staticmethod\n    def _percentile(values, percentile):\n        ordered = sorted(values)\n        index = (len(ordered) - 1) * percentile\n        lower = int(math.floor(index))\n        upper = int(math.ceil(index))\n        if lower == upper:\n            return ordered[lower]\n        return ordered[lower] + (ordered[upper] - ordered[lower]) * (index - lower)\n\n    def next(self):\n        current_sma365 = self.sma365[0]\n        if math.isfinite(current_sma365):\n            self.sma365_history.append(current_sma365)\n\n        if self.pending_order is not None:\n            return\n\n        bullish_cross = (\n            self.data.close[-1] < self.sma365[-1]\n            and self.data.close[0] > self.sma365[0]\n        )\n        bearish_cross = (\n            self.data.close[-1] > self.sma365[-1]\n            and self.data.close[0] < self.sma365[0]\n        )\n        sma365_above_percentile = (\n            self.sma365[0] > self._percentile(self.sma365_history, 0.44)\n        )\n        sma200_sell_signal = self.data.close[0] < self.sma200[0]\n\n        if not self.position:\n            if bullish_cross and sma365_above_percentile:\n                self.pending_order = self.buy()\n        elif bearish_cross or sma200_sell_signal:\n            self.pending_order = self.close()\n\n    def notify_order(self, order):\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.pending_order = None",

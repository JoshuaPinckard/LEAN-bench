  "code": "import backtrader as bt\n\n\nclass TrendDayMACrossover(bt.Strategy):\n    \"\"\"\n    Reference implementation of the 'Trend Day MA Crossover' Strategy.\n    \"\"\"\n\n    def __init__(self):\n        self.order = None\n        self.seq_state = 0\n\n        # Moving Averages\n        self.ma20 = bt.ind.SMA(self.data.close, period=20)\n        self.ma30 = bt.ind.SMA(self.data.close, period=30)\n        self.ma60 = bt.ind.SMA(self.data.close, period=60)\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            cross_ma20 = self.data.close[0] > self.ma20[0] and self.data.close[-1] <= self.ma20[-1]\n            cross_ma30 = self.data.close[0] > self.ma30[0] and self.data.close[-1] <= self.ma30[-1]\n\n            # Sequence Step 1: Price crosses and closes above MA20\n            if self.seq_state == 0:\n                if cross_ma20:\n                    self.seq_state = 1\n\n            # Sequence Step 2: After that, price crosses and closes above MA30\n            if self.seq_state == 1:\n                if cross_ma30:\n                    self.seq_state = 2\n                elif self.data.close[0] < self.ma20[0]:\n                    self.seq_state = 0\n\n            # Sequence Step 3 & 4: Price above MA60 with increasing volume and growing bar size\n            if self.seq_state == 2:\n                above_ma60 = self.data.close[0] > self.ma60[0]\n                vol_increasing = self.data.volume[0] > self.data.volume[-1]\n                bar_growing = (self.data.high[0] - self.data.low[0]) > (self.data.high[-1] - self.data.low[-1])\n\n                if above_ma60 and vol_increasing and bar_growing:\n                    self.order = self.buy()\n                    self.seq_state = 0\n                elif self.data.close[0] < self.ma30[0]:\n                    self.seq_state = 0\n        else:\n            self.seq_state = 0\n\n            # Take-profit: Price reaches level 0.278 or 0.28\n            tp_hit = self.data.high[0] >= 0.278\n\n            # Stop-loss: Price closes below level 0.265 on increasing volume (red bar)\n            is_red_bar = self.data.close[0] < self.data.open[0]\n            vol_inc = self.data.volume[0] > self.data.volume[-1]\n            sl_hit = (self.data.close[0] < 0.265) and is_red_bar and vol_inc\n\n            if tp_hit or sl_hit:\n                self.order = self.close()",

  "code": "import backtrader as bt\n\n\nclass TrendlineBreakoutStrategy(bt.Strategy):\n    params = (\n        ('N', 5),             # Pivot window size\n        ('M', 10),            # Active trendline unbroken window\n        ('cushion', 10.0),    # SL cushion distance in points\n        ('risk_pct', 0.01),   # 1% capital risk per position\n        ('vol_atr_short', 10),\n        ('vol_atr_long', 50),\n        ('vol_mult', 1.5),\n        ('vol_sma_len', 10),\n    )\n\n    def __init__(self):\n        self.order = None\n        self.local_lows = []   # List of (bar_index, price)\n        self.local_highs = []  # List of (bar_index, price)\n\n        # Indicators\n        self.atr_short = bt.indicators.ATR(self.data, period=self.p.vol_atr_short)\n        self.atr_long = bt.indicators.ATR(self.data, period=self.p.vol_atr_long)\n        self.vol_sma = bt.indicators.SMA(self.data.volume, period=self.p.vol_sma_len)\n\n        self.sl_price = None\n        self.tp_price = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n        self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        current_bar = len(self) - 1\n        N = self.p.N\n\n        # Detect local extremums at bar -N\n        if len(self) >= 2 * N + 1:\n            low_val = self.data.low[-N]\n            window_lows = [self.data.low[-N + j] for j in range(-N, N + 1)]\n            if low_val == min(window_lows):\n                idx = current_bar - N\n                if not self.local_lows or self.local_lows[-1][0] != idx:\n                    self.local_lows.append((idx, low_val))\n\n            high_val = self.data.high[-N]\n            window_highs = [self.data.high[-N + j] for j in range(-N, N + 1)]\n            if high_val == max(window_highs):\n                idx = current_bar - N\n                if not self.local_highs or self.local_highs[-1][0] != idx:\n                    self.local_highs.append((idx, high_val))\n\n        # Manage existing position (Trailing Stop & SL/TP exits)\n        if self.position:\n            if self.position.size > 0:  # Long\n                if self.local_lows:\n                    latest_low_idx, latest_low_val = self.local_lows[-1]\n                    new_sl = latest_low_val - self.p.cushion\n                    if new_sl > self.sl_price:\n                        self.sl_price = new_sl\n\n                if self.data.low[0] <= self.sl_price or self.data.high[0] >= self.tp_price:\n                    self.close()\n                    return\n            else:  # Short\n                if self.local_highs:\n                    latest_high_idx, latest_high_val = self.local_highs[-1]\n                    new_sl = latest_high_val + self.p.cushion\n                    if new_sl < self.sl_price:\n                        self.sl_price = new_sl\n\n                if self.data.high[0] >= self.sl_price or self.data.low[0] <= self.tp_price:\n                    self.close()\n                    return\n\n            return\n\n        # Volatility Filter\n        if self.atr_short[0] > self.p.vol_mult * self.atr_long[0]:\n            return\n\n        # Volume Filter\n        if self.data.volume[0] <= self.vol_sma[0]:\n            return\n\n        # Check Long Entry Condition (Ascending trendline through last two local lows)\n        if len(self.local_lows) >= 2:\n            t1, y1 = self.local_lows[-2]\n            t2, y2 = self.local_lows[-1]\n            if y2 > y1 and (current_bar - t2) >= 1:\n                slope = (y2 - y1) / (t2 - t1)\n                M = min(self.p.M, current_bar - t2)\n                active = True\n                for i in range(1, M + 1):\n                    bar_i = current_bar - i\n                    line_y = y1 + slope * (bar_i - t1)\n                    if self.data.low[-i] < line_y:\n                        active = False\n                        break\n\n                line_curr = y1 + slope * (current_bar - t1)\n                if active and self.data.close[0] > line_curr:\n                    sl_dist = max(self.p.cushion, self.data.close[0] - (y2 - self.p.cushion))\n                    capital = self.broker.getvalue()\n                    risk_amt = capital * self.p.risk_pct\n                    size = max(1, int(risk_amt / sl_dist))\n\n                    self.sl_price = y2 - self.p.cushion\n                    self.tp_price = self.data.close[0] + 2.0 * sl_dist\n                    self.order = self.buy(size=size)\n                    return\n\n        # Check Short Entry Condition (Descending trendline through last two local highs)\n        if len(self.local_highs) >= 2:\n            t1, y1 = self.local_highs[-2]\n            t2, y2 = self.local_highs[-1]\n            if y2 < y1 and (current_bar - t2) >= 1:\n                slope = (y2 - y1) / (t2 - t1)\n                M = min(self.p.M, current_bar - t2)\n                active = True\n                for i in range(1, M + 1):\n                    bar_i = current_bar - i\n                    line_y = y1 + slope * (bar_i - t1)\n                    if self.data.high[-i] > line_y:\n                        active = False\n                        break\n\n                line_curr = y1 + slope * (current_bar - t1)\n                if active and self.data.close[0] < line_curr:\n                    sl_dist = max(self.p.cushion, (y2 + self.p.cushion) - self.data.close[0])\n                    capital = self.broker.getvalue()\n                    risk_amt = capital * self.p.risk_pct\n                    size = max(1, int(risk_amt / sl_dist))\n\n                    self.sl_price = y2 + self.p.cushion\n                    self.tp_price = self.data.close[0] - 2.0 * sl_dist\n                    self.order = self.sell(size=size)\n                    return",

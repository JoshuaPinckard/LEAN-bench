  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass DonchianBreakout(bt.Strategy):\n    params = (\n        (\"channel_period\", 20),\n        (\"vol_sma_period\", 20),\n        (\"stop_pct\", 0.02),\n    )\n\n    def __init__(self):\n        self.donchian_high = bt.ind.Highest(\n            self.data.high(-1), period=self.p.channel_period\n        )\n        self.donchian_low = bt.ind.Lowest(\n            self.data.low(-1), period=self.p.channel_period\n        )\n\n        self.crossover_high = bt.ind.CrossOver(self.data.close, self.donchian_high)\n        self.crossover_low = bt.ind.CrossOver(self.data.close, self.donchian_low)\n\n        self.vol_sma = bt.ind.SMA(self.data.volume, period=self.p.vol_sma_period)\n\n        self.order = None\n        self.stop_order = None\n        self.stop_price = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order == self.order:\n                self.order = None\n                if self.position.size > 0:\n                    self.stop_order = self.sell(\n                        exectype=bt.Order.Stop, price=self.stop_price\n                    )\n                elif self.position.size < 0:\n                    self.stop_order = self.buy(\n                        exectype=bt.Order.Stop, price=self.stop_price\n                    )\n            elif order == self.stop_order:\n                self.stop_order = None\n\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order == self.order:\n                self.order = None\n            if order == self.stop_order:\n                self.stop_order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            vol_confirm = (self.data.volume[0] > self.data.volume[-1]) and (\n                self.data.volume[0] > self.vol_sma[0]\n            )\n            if self.crossover_high[0] > 0 and vol_confirm:\n                self.stop_price = self.donchian_high[0] * (1.0 - self.p.stop_pct)\n                self.order = self.buy()\n            elif self.crossover_low[0] < 0 and vol_confirm:\n                self.stop_price = self.donchian_low[0] * (1.0 + self.p.stop_pct)\n                self.order = self.sell()\n        else:\n            if self.position.size > 0:\n                if (\n                    self.data.close[0] < self.donchian_high[0]\n                    or self.data.volume[0] < self.vol_sma[0]\n                ):\n                    if self.stop_order:\n                        self.cancel(self.stop_order)\n                    self.order = self.close()\n            elif self.position.size < 0:\n                if (\n                    self.data.close[0] > self.donchian_low[0]\n                    or self.data.volume[0] < self.vol_sma[0]\n                ):\n                    if self.stop_order:\n                        self.cancel(self.stop_order)\n                    self.order = self.close()",
  "assumptions": [
    {
      "topic": "donchian_channel_definition",
      "choice": "Calculated using the previous channel_period bars (shifted by 1 bar).",
      "reason": "Including the current bar's High/Low in the Donchian channel would make close > upper band impossible since Close <= High <= Highest(High)."
    },
    {
      "topic": "stop_loss_band_reference",
      "choice": "Use the Donchian channel upper/lower band value at the signal bar when entry order is placed.",
      "reason": "Spec states 'Donchian upper/lower band at entry'; evaluating at signal time fixes the stop price deterministically upon placing the order."
    },
    {
      "topic": "stop_loss_execution",
      "choice": "Submit a pending bt.Order.Stop upon completion of the entry order.",
      "reason": "Spec requires placing a stop-loss on entry; issuing a stop order when position opens implements proper broker risk management."
    }
  ],

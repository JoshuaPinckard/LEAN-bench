  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass MacdCrossoverStrategy(bt.Strategy):\n    def __init__(self):\n        self.macd = bt.indicators.MACD(\n            self.data,\n            period_me1=12,\n            period_me2=26,\n            period_signal=9,\n        )\n        self.crossover = bt.indicators.CrossOver(self.macd.macd, self.macd.signal)\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in (order.Completed, order.Canceled, order.Margin, order.Rejected):\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            if self.crossover[0] > 0:\n                self.order = self.buy()\n        else:\n            if self.crossover[0] < 0:\n                self.order = self.close()",
  "assumptions": [
    {
      "topic": "position sizing",
      "choice": "default sizer via plain self.buy() with no size argument",
      "reason": "Spec says fixed position size for the entire backtest but states no explicit sizing method; canonical default applies."
    },
    {
      "topic": "pending order guard",
      "choice": "single order-tracking attribute reset in notify_order on Completed/Canceled/Margin/Rejected, blocking new signals while an order is pending",
      "reason": "Canonical default; spec requires no repeated entries/exits while a position transition is in flight, and this also satisfies 'exit signals ignored when there is no position' and 'entries ignored until position closed' via the self.position check."
    }
  ],

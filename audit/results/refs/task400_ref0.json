  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass AdaptiveChannelBreakoutStrategy(bt.Strategy):\n    params = dict(\n        lookback=10,     # channel lookback period (adjustable)\n        stop_mult=2,     # ATR stop multiplier (adjustable)\n        atr_period=14,\n        fast_period=2,\n        slow_period=30,\n    )\n\n    def __init__(self):\n        self.fast_ema = bt.indicators.EMA(self.data.close, period=self.p.fast_period)\n        self.slow_ema = bt.indicators.EMA(self.data.close, period=self.p.slow_period)\n        self.highest_high = bt.indicators.Highest(self.data.high, period=self.p.lookback)\n        self.lowest_low = bt.indicators.Lowest(self.data.low, period=self.p.lookback)\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n\n        self.order = None\n        self.stop_price = None\n        self.entry_atr = None\n\n    def notify_order(self, order):\n        if order.status in (order.Submitted, order.Accepted):\n            return\n\n        if order.status == order.Completed:\n            if order.isbuy() and self.position.size > 0:\n                self.stop_price = order.executed.price - self.p.stop_mult * self.entry_atr\n            elif order.issell() and self.position.size < 0:\n                self.stop_price = order.executed.price + self.p.stop_mult * self.entry_atr\n            else:\n                self.stop_price = None\n\n        if order.status in (order.Canceled, order.Margin, order.Rejected):\n            self.stop_price = None\n\n        self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        # channel measured on the prior `lookback` bars (excludes current bar,\n        # since a window including the current bar's own high/low could never\n        # be broken by that same bar's close)\n        upper_band = self.highest_high[-1]\n        lower_band = self.lowest_low[-1]\n\n        long_signal = self.data.close[0] > upper_band and self.fast_ema[0] > self.slow_ema[0]\n        short_signal = self.data.close[0] < lower_band and self.fast_ema[0] < self.slow_ema[0]\n\n        if self.position:\n            if self.position.size > 0:\n                stop_hit = self.data.low[0] <= self.stop_price\n                if stop_hit or short_signal:\n                    self.order = self.close()\n            elif self.position.size < 0:\n                stop_hit = self.data.high[0] >= self.stop_price\n                if stop_hit or long_signal:\n                    self.order = self.close()\n        else:\n            if long_signal:\n                self.entry_atr = self.atr[0]\n                self.order = self.buy()\n            elif short_signal:\n                self.entry_atr = self.atr[0]\n                self.order = self.sell()",
  "assumptions": [
    {
      "topic": "channel window alignment",
      "choice": "Highest high / lowest low of the last 10 bars is computed over the 10 bars prior to the current bar (accessed via index -1 on the Highest/Lowest indicators), excluding the current bar",
      "reason": "spec is silent on inclusion of the current bar; including it would make the breakout condition logically impossible since a bar's close can never exceed the high of a window containing its own high"
    },
    {
      "topic": "ATR value used for stop",
      "choice": "the ATR value at the bar the entry order is submitted (signal bar) is stored and used to compute the stop level once the order fills",
      "reason": "spec says stop is '2x ATR from entry' but doesn't specify whether ATR is sampled at signal time or fill time; signal-bar ATR is the most direct reading of 'from entry'"
    },
    {
      "topic": "stop and opposite-signal exit mechanism",
      "choice": "implemented as a manual check each bar (low/high vs. stored stop_price, or opposite breakout condition) that submits a self.close() market order, rather than a native backtrader Stop order",
      "reason": "keeps a single pending order at a time per the canonical order-tracking guard; spec does not require intrabar-exact stop execution mechanics"
    },
    {
      "topic": "opposite breakout signal on exit bar",
      "choice": "an opposite breakout signal while in a position only closes the current position; it does not simultaneously open the opposite position on the same bar",
      "reason": "canonical default: hold at most one position at a time, no pyramiding/re-entry while an order is pending; a fresh entry in the new direction requires the condition to still hold once flat with no order pending"
    },
    {
      "topic": "ATR period parameterization",
      "choice": "atr_period exposed as a strategy parameter defaulting to 14",
      "reason": "spec phrase 'period 14 default' implies ATR period is adjustable like lookback and stop_mult"
    }
  ],

  "code": "import backtrader as bt\n\n\nclass MACDBollingerStrategy(bt.Strategy):\n    params = (\n        ('bb_period', 20),\n        ('bb_dev', 2.0),\n        ('sma_period', 50),\n        ('macd_fast', 12),\n        ('macd_slow', 26),\n        ('macd_signal', 9),\n    )\n\n    def __init__(self):\n        self.order = None\n\n        # Bollinger Bands (20, 2)\n        self.bb = bt.indicators.BollingerBands(\n            self.data,\n            period=self.params.bb_period,\n            devfactor=self.params.bb_dev,\n        )\n\n        # Band width: upper - lower\n        self.width = self.bb.top - self.bb.bot\n\n        # SMA(50) of the band width\n        self.sma_width = bt.indicators.SMA(\n            self.width, period=self.params.sma_period\n        )\n\n        # MACD(12, 26, 9)\n        self.macd = bt.indicators.MACD(\n            self.data,\n            period_me1=self.params.macd_fast,\n            period_me2=self.params.macd_slow,\n            period_signal=self.params.macd_signal,\n        )\n\n        # CrossOver of MACD line and Signal line\n        self.crossover = bt.indicators.CrossOver(\n            self.macd.macd, self.macd.signal\n        )\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        filter_active = self.width[0] > self.sma_width[0]\n\n        if not self.position:\n            if filter_active:\n                if self.crossover[0] > 0:\n                    size = int(self.broker.getcash() / self.data.close[0])\n                    if size > 0:\n                        self.order = self.buy(size=size)\n                elif self.crossover[0] < 0:\n                    size = int(self.broker.getcash() / self.data.close[0])\n                    if size > 0:\n                        self.order = self.sell(size=size)\n        else:\n            if self.position.size > 0:\n                if self.crossover[0] < 0:\n                    self.order = self.close()\n            elif self.position.size < 0:\n                if self.crossover[0] > 0:\n                    self.order = self.close()",

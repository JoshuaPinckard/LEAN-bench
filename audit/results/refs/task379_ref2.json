  "code": "import backtrader as bt\n\n\nclass SlopeReversalStrategy(bt.Strategy):\n    params = (\n        ('sma_period', 20),\n        ('slope_lag', 20),\n        ('std_lookback', 100),\n        ('extreme_mult', 2.0),\n        ('stop_pct', 0.02),\n        ('neutral_mult', 0.2),\n    )\n\n    def __init__(self):\n        self.sma = bt.ind.SMA(self.data.close, period=self.p.sma_period)\n        self.slope = (self.sma - self.sma(-self.p.slope_lag)) / self.p.slope_lag\n        self.slope_std = bt.ind.StdDev(self.slope, period=self.p.std_lookback)\n        self.pos_th = self.p.extreme_mult * self.slope_std\n        self.neg_th = -self.p.extreme_mult * self.slope_std\n        self.neutral_band = self.p.neutral_mult * self.slope_std\n\n        self.order = None\n        self.entry_price = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if self.position:\n                self.entry_price = self.position.price\n            else:\n                self.entry_price = None\n\n        self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            long_condition = (self.slope[-1] <= self.neg_th[-1]) and (self.slope[0] > self.neg_th[0])\n            short_condition = (self.slope[-1] >= self.pos_th[-1]) and (self.slope[0] < self.pos_th[0])\n\n            if long_condition:\n                self.order = self.buy()\n            elif short_condition:\n                self.order = self.sell()\n        else:\n            entry = self.entry_price if self.entry_price is not None else self.position.price\n            if self.position.size > 0:\n                stop_price = entry * (1.0 - self.p.stop_pct)\n                if self.data.low[0] <= stop_price:\n                    self.order = self.close()\n                    return\n            elif self.position.size < 0:\n                stop_price = entry * (1.0 + self.p.stop_pct)\n                if self.data.high[0] >= stop_price:\n                    self.order = self.close()\n                    return\n\n            cross_zero = (self.slope[-1] <= 0 and self.slope[0] >= 0) or (self.slope[-1] >= 0 and self.slope[0] <= 0)\n            below_neutral = abs(self.slope[0]) < self.neutral_band[0]\n\n            if cross_zero or below_neutral:\n                self.order = self.close()",
  "assumptions": [
    {
      "topic": "stop_loss_execution",
      "choice": "Manual intraday price check in next() comparing bar Low for long positions and High for short positions against entry * (1 +- stop_pct)",

  "code": "import backtrader as bt\n\n\nclass ScalpingStrategy(bt.Strategy):\n    params = (\n        (\"stake\", 100),\n        (\"move_threshold\", 0.002),\n        (\"vol_threshold\", 0.003),\n        (\"tp_pct\", 0.003),\n        (\"sl_pct\", 0.003),\n    )\n\n    def __init__(self):\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            if self.data.close[0] == 0 or self.data.close[-1] == 0:\n                return\n\n            bar_range = (\n                self.data.high[0] - self.data.low[0]\n            ) / self.data.close[0]\n            if bar_range < self.p.vol_threshold:\n                return\n\n            price_change = (\n                self.data.close[0] - self.data.close[-1]\n            ) / self.data.close[-1]\n\n            if price_change >= self.p.move_threshold:\n                self.order = self.buy(size=self.p.stake)\n            elif price_change <= -self.p.move_threshold:\n                self.order = self.sell(size=self.p.stake)\n        else:\n            entry_price = self.position.price\n            if self.position.size > 0:\n                tp_price = entry_price * (1.0 + self.p.tp_pct)\n                sl_price = entry_price * (1.0 - self.p.sl_pct)\n\n                if (\n                    self.data.low[0] <= sl_price\n                    or self.data.high[0] >= tp_price\n                ):\n                    self.order = self.close()\n            elif self.position.size < 0:\n                tp_price = entry_price * (1.0 - self.p.tp_pct)\n                sl_price = entry_price * (1.0 + self.p.sl_pct)\n\n                if (\n                    self.data.high[0] >= sl_price\n                    or self.data.low[0] <= tp_price\n                ):\n                    self.order = self.close()",
  "assumptions": [

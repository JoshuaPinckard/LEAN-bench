  "code": "import backtrader as bt\nimport math\n\n\nclass RSITradingSessionsStrategy(bt.Strategy):\n    def __init__(self):\n        self.rsi = bt.indicators.RSI(self.data.close, period=14)\n        self.order = None\n\n    def _active_session(self):\n        dt = self.data.datetime.datetime(0)\n        minutes = dt.hour * 60 + dt.minute\n        return dt.weekday() < 5 and 570 <= minutes < 960\n\n    def _size(self):\n        commission = self.broker.getcommissioninfo(self.data).p.commission\n        return math.floor(self.broker.getcash() / (self.data.close[0] * (1.0 + commission)))\n\n    def next(self):\n        if not self._active_session() or self.order:\n            return\n\n        if self.position.size > 0:\n            if self.rsi[0] > 70:\n                self.order = self.close()\n            return\n\n        if self.position.size < 0:\n            if self.rsi[0] < 30:\n                self.order = self.close()\n            return\n\n        size = self._size()\n        if size <= 0:\n            return\n\n        if self.rsi[-1] < 30 and self.rsi[0] > 30:\n            self.order = self.buy(size=size)\n        elif self.rsi[-1] > 70 and self.rsi[0] < 70:\n            self.order = self.sell(size=size)\n\n    def notify_order(self, order):\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None",

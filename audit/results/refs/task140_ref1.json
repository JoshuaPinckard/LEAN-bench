  "code": "import backtrader as bt\nimport math\n\n\nclass MonthlyFirstDayStrategy(bt.Strategy):\n    def __init__(self):\n        self.order = None\n        self.initial_portfolio_value = None\n        self.final_portfolio_value = None\n\n    def start(self):\n        self.broker.setcash(1000.0)\n        self.initial_portfolio_value = self.broker.getvalue()\n\n    def next(self):\n        if self.order:\n            return\n\n        current_date = self.data.datetime.date(0)\n        previous_date = self.data.datetime.date(-1) if len(self) > 1 else None\n\n        is_first_trading_day = (\n            previous_date is None\n            or current_date.month != previous_date.month\n            or current_date.year != previous_date.year\n        )\n\n        is_last_trading_day = False\n        try:\n            next_date = self.data.datetime.date(1)\n            is_last_trading_day = (\n                current_date.month != next_date.month\n                or current_date.year != next_date.year\n            )\n        except IndexError:\n            is_last_trading_day = True\n\n        if self.position and is_last_trading_day:\n            self.order = self.close()\n        elif not self.position and is_first_trading_day:\n            commission = self.broker.getcommissioninfo(self.data).p.commission\n            size = math.floor(\n                self.broker.getcash() / (self.data.close[0] * (1.0 + commission))\n            )\n            if size > 0:\n                self.order = self.buy(size=size)\n\n    def notify_order(self, order):\n        if order.status in (\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ):\n            self.order = None\n\n    def stop(self):\n        self.final_portfolio_value = self.broker.getvalue()",
  "assumptions": [
    {
      "topic": "initial capital",
      "choice": "The strategy resets broker cash to $1000 in start().",
      "reason": "The specification explicitly requires fixed initial capital of $1000, which conflicts with the harness-provided $10,000 starting cash."

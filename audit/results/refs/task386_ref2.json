  "code": "import backtrader as bt\n\n\nclass AAPLDailyBreakout(bt.Strategy):\n    params = (\n        ('period', 20),\n        ('stop_pct', 0.02),\n    )\n\n    def __init__(self):\n        self.sma = bt.indicators.SimpleMovingAverage(self.data.close, period=self.p.period)\n        self.highest = bt.indicators.Highest(self.data.high, period=self.p.period)\n        self.lowest = bt.indicators.Lowest(self.data.low, period=self.p.period)\n\n        self.order = None\n        self.stop_order = None\n        self.entry_price = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order == self.order:\n                self.order = None\n                if self.position:\n                    self.entry_price = order.executed.price\n                    if self.position.size > 0:\n                        stop_price = self.entry_price * (1.0 - self.p.stop_pct)\n                        self.stop_order = self.sell(\n                            exectype=bt.Order.Stop,\n                            price=stop_price,\n                            size=abs(self.position.size)\n                        )\n                    elif self.position.size < 0:\n                        stop_price = self.entry_price * (1.0 + self.p.stop_pct)\n                        self.stop_order = self.buy(\n                            exectype=bt.Order.Stop,\n                            price=stop_price,\n                            size=abs(self.position.size)\n                        )\n                else:\n                    self.entry_price = None\n                    if self.stop_order:\n                        self.cancel(self.stop_order)\n                        self.stop_order = None\n\n            elif order == self.stop_order:\n                self.stop_order = None\n                self.entry_price = None\n                if self.order:\n                    self.cancel(self.order)\n                    self.order = None\n\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order == self.order:\n                self.order = None\n            if order == self.stop_order:\n                self.stop_order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        long_signal = (self.data.close[0] > self.highest[-1]) and (self.data.close[0] > self.sma[0])\n        short_signal = (self.data.close[0] < self.lowest[-1]) and (self.data.close[0] < self.sma[0])\n\n        if not self.position:\n            if long_signal:\n                self.order = self.buy()\n            elif short_signal:\n                self.order = self.sell()\n        else:\n            if self.position.size > 0 and short_signal:\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                    self.stop_order = None\n                self.order = self.close()\n            elif self.position.size < 0 and long_signal:\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                    self.stop_order = None\n                self.order = self.close()",
  "assumptions": [
    {
      "topic": "20-day high/low reference",
      "choice": "The 20-day high and low thresholds are evaluated using highest[-1] and lowest[-1], representing the 20 bars prior to the current bar.",
      "reason": "A breakout on the current bar's close must be measured relative to the historical range established before the current bar."
    },
    {
      "topic": "Stop loss order type",
      "choice": "Implemented as an automatic stop order (bt.Order.Stop) placed upon entry completion at 2% from the actual executed entry price.",
      "reason": "Standard intrabar stop-loss execution mechanism in Backtrader for percentage-based stop loss rules."
    },
    {
      "topic": "Opposite breakout exit",
      "choice": "When an opposite breakout signal triggers while in a position, the pending stop loss order is canceled and self.close() is called to exit the position before new entries are submitted.",
      "reason": "Adheres to canonical default 2 (using self.close() for exits) and default 3 (one position at a time)."
    }

  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass BreakoutBollingerStrategy(bt.Strategy):\n    def __init__(self):\n        self.boll = bt.indicators.BollingerBands(\n            self.data.close, period=20, devfactor=2.0\n        )\n        self.order = None\n        self.tp_order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order.isbuy():\n                entry_price = order.executed.price\n                tp_price = entry_price * 1.02\n                self.tp_order = self.sell(\n                    exectype=bt.Order.Limit,\n                    price=tp_price,\n                    size=order.executed.size,\n                )\n            elif order.issell():\n                if self.tp_order and order.ref == self.tp_order.ref:\n                    self.tp_order = None\n\n        if self.order and order.ref == self.order.ref:\n            if order.status in [\n                order.Completed,\n                order.Canceled,\n                order.Margin,\n                order.Rejected,\n            ]:\n                self.order = None\n\n        if self.tp_order and order.ref == self.tp_order.ref:\n            if order.status in [order.Canceled, order.Margin, order.Rejected]:\n                self.tp_order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            breakout = self.data.close[0] > self.boll.lines.top[0]\n            last_3_below = (\n                self.data.close[-1] <= self.boll.lines.top[-1]\n                and self.data.close[-2] <= self.boll.lines.top[-2]\n                and self.data.close[-3] <= self.boll.lines.top[-3]\n            )\n            sma_rising = self.boll.lines.mid[0] > self.boll.lines.mid[-1]\n\n            if breakout and last_3_below and sma_rising:\n                entry_price = self.data.close[0]\n                upper_band = self.boll.lines.top[0]\n                risk_per_share = entry_price - upper_band\n\n                if risk_per_share > 0:\n                    capital = self.broker.getvalue()\n                    max_risk = capital * 0.01\n                    size = int(max_risk / risk_per_share)\n\n                    cash = self.broker.getcash()\n                    max_cash_size = int(cash / entry_price)\n                    size = min(size, max_cash_size)\n\n                    if size > 0:\n                        self.order = self.buy(size=size)\n        else:\n            if self.data.close[0] < self.boll.lines.top[0]:\n                if self.tp_order:\n                    self.cancel(self.tp_order)\n                    self.tp_order = None\n                self.order = self.close()",
  "assumptions": [
    {
      "topic": "take_profit_execution",
      "choice": "Limit sell order at 1.02 * entry_price submitted upon buy order completion",
      "reason": "Locking in +2% from entry price is most accurately executed via a limit sell order placed at entry_price * 1.02 upon entry fill."
    },
    {
      "topic": "position_sizing_entry_price",
      "choice": "Use signal bar close[0] as estimated entry price for risk per share calculation",
      "reason": "At signal generation time in next(), the actual execution price is not yet known, so close[0] serves as the proxy for entry price."
    },
    {
      "topic": "capital_definition",
      "choice": "Use total portfolio value (self.broker.getvalue()) for calculating 1% risk capital",
      "reason": "Capital standard definition in risk management refers to total portfolio equity."
    },
    {
      "topic": "cash_cap_on_position_size",
      "choice": "Cap position size by available cash (getcash() / close[0])",
      "reason": "Prevents order rejection by broker due to insufficient funds when 1% risk calculation yields a size exceeding cash."
    }
  ],

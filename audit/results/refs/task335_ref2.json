  "code": "import backtrader as bt\n\n\nclass IntradayVWAP(bt.Indicator):\n    lines = ('vwap',)\n\n    def __init__(self):\n        self.addminperiod(1)\n\n    def next(self):\n        tp = (self.data.high[0] + self.data.low[0] + self.data.close[0]) / 3.0\n        v = self.data.volume[0]\n\n        if len(self) == 1 or self.data.datetime.date(0) != self.data.datetime.date(-1):\n            self.cum_pv = tp * v\n            self.cum_v = v\n        else:\n            self.cum_pv += tp * v\n            self.cum_v += v\n\n        self.lines.vwap[0] = self.cum_pv / self.cum_v if self.cum_v != 0 else tp\n\n\nclass VWAPMeanReversion(bt.Strategy):\n    params = (\n        ('threshold_multiplier', 2.0),\n        ('stop_loss_pct', 0.02),\n        ('period', 20),\n    )\n\n    def __init__(self):\n        self.vwap = IntradayVWAP(self.data)\n        self.slope = self.vwap - self.vwap(-self.p.period)\n        self.slope_std = bt.ind.StdDev(self.slope, period=self.p.period)\n        self.threshold = self.p.threshold_multiplier * self.slope_std\n        self.vwap_base = bt.ind.SMA(self.vwap, period=self.p.period)\n        self.crossover = bt.ind.CrossOver(self.vwap, self.vwap_base)\n\n        self.order = None\n        self.entry_price = None\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n        if order.status == order.Completed:\n            self.entry_price = order.executed.price\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            if self.slope[-1] < -self.threshold[-1] and self.slope[0] > self.slope[-1]:\n                self.order = self.buy()\n            elif self.slope[-1] > self.threshold[-1] and self.slope[0] < self.slope[-1]:\n                self.order = self.sell()\n        else:\n            if self.position.size > 0:\n                if self.entry_price and self.data.low[0] <= self.entry_price * (1.0 - self.p.stop_loss_pct):\n                    self.order = self.close()\n                elif self.crossover[0] > 0:\n                    self.order = self.close()\n            elif self.position.size < 0:\n                if self.entry_price and self.data.high[0] >= self.entry_price * (1.0 + self.p.stop_loss_pct):\n                    self.order = self.close()\n                elif self.crossover[0] < 0:\n                    self.order = self.close()",
  "assumptions": [
    {
      "topic": "vwap_price_source",
      "choice": "Used typical price (High + Low + Close) / 3 for VWAP calculation.",
      "reason": "Standard industry definition for intraday VWAP calculation when price source is unstated."
    },
    {
      "topic": "stop_loss_mechanism",
      "choice": "Implemented manual stop-loss check in next() using bar Low/High against the 2% threshold from the executed entry price.",
      "reason": "The specification explicitly permits manual stop logic or stop orders, and checking bar extremes avoids managing extra order tracking logic."
    },
    {
      "topic": "session_reset",
      "choice": "Reset cumulative price-volume and volume totals when self.data.datetime.date(0) differs from self.data.datetime.date(-1).",
      "reason": "Implements the specified intraday session VWAP reset at the start of each new calendar trading day."
    }
  ],

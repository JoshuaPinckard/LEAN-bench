  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass RSIStrategy(bt.Strategy):\n    params = dict(\n        rsi_period=14,\n        rsi_oversold=30,\n        rsi_overbought=70,\n        stop_loss_pct=0.02,\n        take_profit_pct=0.04,\n    )\n\n    def __init__(self):\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.p.rsi_period)\n        self.order = None\n        self.entering = False\n        self.stop_price = None\n        self.target_price = None\n\n    def notify_order(self, order):\n        if order.status == order.Completed and self.entering:\n            entry_price = order.executed.price\n            if order.isbuy():\n                self.stop_price = entry_price * (1 - self.p.stop_loss_pct)\n                self.target_price = entry_price * (1 + self.p.take_profit_pct)\n            else:\n                self.stop_price = entry_price * (1 + self.p.stop_loss_pct)\n                self.target_price = entry_price * (1 - self.p.take_profit_pct)\n\n        if order.status in (order.Completed, order.Canceled, order.Margin, order.Rejected):\n            self.entering = False\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            if self.rsi[-1] < self.p.rsi_oversold and self.rsi[0] >= self.p.rsi_oversold:\n                self.entering = True\n                self.order = self.buy()\n            elif self.rsi[-1] > self.p.rsi_overbought and self.rsi[0] <= self.p.rsi_overbought:\n                self.entering = True\n                self.order = self.sell()\n        else:\n            if self.position.size > 0:\n                if (self.rsi[0] > self.p.rsi_overbought\n                        or self.data.low[0] <= self.stop_price\n                        or self.data.high[0] >= self.target_price):\n                    self.order = self.close()\n            elif self.position.size < 0:\n                if (self.rsi[0] < self.p.rsi_oversold\n                        or self.data.high[0] >= self.stop_price\n                        or self.data.low[0] <= self.target_price):\n                    self.order = self.close()",
  "assumptions": [

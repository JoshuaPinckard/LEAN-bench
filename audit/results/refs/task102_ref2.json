  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass FVGTradingStrategy(bt.Strategy):\n    params = (\n        ('wick_ratio', 0.35),\n        ('sl_offset', 0.05),\n    )\n\n    def __init__(self):\n        self.order = None\n        self.bullish_fvgs = []\n        self.bearish_fvgs = []\n\n        self.curr_date = None\n        self.curr_session_high = None\n        self.curr_session_low = None\n        self.prev_session_high = None\n        self.prev_session_low = None\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        # Update session tracking for NY Session high/low\n        dt = self.data.datetime.date(0)\n        if dt != self.curr_date:\n            self.prev_session_high = self.curr_session_high\n            self.prev_session_low = self.curr_session_low\n            self.curr_date = dt\n            self.curr_session_high = self.data.high[0]\n            self.curr_session_low = self.data.low[0]\n        else:\n            if self.curr_session_high is None or self.data.high[0] > self.curr_session_high:\n                self.curr_session_high = self.data.high[0]\n            if self.curr_session_low is None or self.data.low[0] < self.curr_session_low:\n                self.curr_session_low = self.data.low[0]\n\n        # 1. Detect new FVGs on 30m chart (3-candle sequence)\n        if len(self) >= 3:\n            # Bullish FVG: Low of candle 3 > High of candle 1\n            if self.data.low[0] > self.data.high[-2]:\n                self.bullish_fvgs.append({\n                    'lower': self.data.high[-2],\n                    'upper': self.data.low[0]\n                })\n\n            # Bearish FVG: High of candle 3 < Low of candle 1\n            if self.data.high[0] < self.data.low[-2]:\n                self.bearish_fvgs.append({\n                    'lower': self.data.high[0],\n                    'upper': self.data.low[-2]\n                })\n\n        # Guard pending orders\n        if self.order:\n            return\n\n        # 2. Check Entry conditions if flat\n        if not self.position:\n            total_range = self.data.high[0] - self.data.low[0]\n            if total_range > 0:\n                open_p = self.data.open[0]\n                close_p = self.data.close[0]\n                high_p = self.data.high[0]\n                low_p = self.data.low[0]\n\n                lower_wick = min(open_p, close_p) - low_p\n                upper_wick = high_p - max(open_p, close_p)\n\n                # Bullish Entry Check\n                for fvg in self.bullish_fvgs:\n                    if low_p <= fvg['upper'] and high_p >= fvg['lower']:\n                        if (lower_wick / total_range) >= self.p.wick_ratio:\n                            sl = fvg['lower'] - self.p.sl_offset\n                            if self.prev_session_high and self.prev_session_high > close_p:\n                                tp = self.prev_session_high\n                            else:\n                                tp = close_p + 2.0 * (close_p - sl)\n\n                            orders = self.buy_bracket(\n                                exectype=bt.Order.Market,\n                                stopprice=sl,\n                                limitprice=tp\n                            )\n                            self.order = orders[0]\n                            break\n\n                # Bearish Entry Check\n                if not self.order:\n                    for fvg in self.bearish_fvgs:\n                        if high_p >= fvg['lower'] and low_p <= fvg['upper']:\n                            if (upper_wick / total_range) >= self.p.wick_ratio:\n                                sl = fvg['upper'] + self.p.sl_offset\n                                if self.prev_session_low and self.prev_session_low < close_p:\n                                    tp = self.prev_session_low\n                                else:\n                                    tp = close_p - 2.0 * (sl - close_p)\n\n                                orders = self.sell_bracket(\n                                    exectype=bt.Order.Market,\n                                    stopprice=sl,\n                                    limitprice=tp\n                                )\n                                self.order = orders[0]\n                                break\n\n        # 3. Mitigate/Close active FVGs (\"By Close\" criterion)\n        # Price must close inside or beyond the FVG area to consider it filled/closed\n        self.bullish_fvgs = [f for f in self.bullish_fvgs if not (self.data.close[0] <= f['upper'])]\n        self.bearish_fvgs = [f for f in self.bearish_fvgs if not (self.data.close[0] >= f['lower'])]",
  "assumptions": [
    {
      "topic": "reversal_signal",
      "choice": "Reversal signal defined as lower wick >= 35% of total bar range for bullish entries and upper wick >= 35% of total bar range for bearish entries.",
      "reason": "Spec mentions confirmation signals such as hammer/shooting star or long wicks without specifying a hard numerical threshold; wick-to-range ratio is a standard quantifiable definition."
    },
    {
      "topic": "sl_offset",
      "choice": "Placed stop loss $0.05 below the lower boundary of bullish FVG for long trades, and $0.05 above the upper boundary of bearish FVG for short trades.",
      "reason": "Spec specifies placing stop loss 'a few points' beyond the FVG boundary."
    },
    {
      "topic": "tp_fallback",
      "choice": "Target profit uses previous session high for long trades and previous session low for short trades. If previous session high/low is not yet available, fallback is a 2:1 risk-reward ratio based on SL distance.",
      "reason": "Spec states TP level is set at the previous session high/low, with fallback handling the initial trading session before historical session boundaries exist."

  "code": "import backtrader as bt\n\n\nclass BollingerBandsMeanReversion(bt.Strategy):\n    params = dict(period=20, devfactor=2.0)\n\n    def __init__(self):\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close, period=self.p.period, devfactor=self.p.devfactor\n        )\n        self.middle_bb = self.bb.lines.mid\n        self.upper_bb = self.bb.lines.top\n        self.lower_bb = self.bb.lines.bot\n\n        self.cross_lower = bt.indicators.CrossOver(self.data.close, self.lower_bb)\n        self.cross_upper = bt.indicators.CrossOver(self.data.close, self.upper_bb)\n        self.cross_middle = bt.indicators.CrossOver(self.data.close, self.middle_bb)\n\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in (order.Completed, order.Canceled, order.Margin, order.Rejected):\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        position_size = self.position.size\n\n        if position_size == 0:\n            if self.cross_lower[0] > 0:\n                size = int(self.broker.getcash() / self.data.close[0])\n                if size > 0:\n                    self.order = self.buy(size=size)\n            elif self.cross_upper[0] < 0:\n                size = int(self.broker.getcash() / self.data.close[0])\n                if size > 0:\n                    self.order = self.sell(size=size)\n        elif position_size > 0:\n            if self.cross_middle[0] < 0:\n                self.order = self.close()\n        elif position_size < 0:\n            if self.cross_middle[0] > 0:\n                self.order = self.close()",

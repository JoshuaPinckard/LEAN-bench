  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass TrendPullbackScalingStrategy(bt.Strategy):\n    params = (\n        ('atr_period', 14),\n        ('ema_period', 50),\n        ('pullback_atr_mult', 1.5),\n        ('stop_atr_mult', 1.5),\n        ('target_atr_mult', 2.5),\n        ('max_entries', 4),\n        ('position_pct', 0.01),\n    )\n\n    def __init__(self):\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.ema = bt.indicators.EMA(self.data, period=self.p.ema_period)\n        self.entries = []\n        self.swing_high = None\n        self.order = None\n        self.pending_action = None\n        self.pending_leg = None\n\n    def notify_order(self, order):\n        if order.status in (order.Submitted, order.Accepted):\n            return\n\n        if order.status == order.Completed:\n            if self.pending_action == 'entry':\n                leg = dict(\n                    price=order.executed.price,\n                    atr=self.atr[0],\n                    size=order.executed.size,\n                )\n                leg['stop'] = leg['price'] - self.p.stop_atr_mult * leg['atr']\n                self.entries.append(leg)\n            elif self.pending_action == 'leg_stop':\n                self.entries = [e for e in self.entries if e is not self.pending_leg]\n            elif self.pending_action == 'close_all':\n                self.entries = []\n\n        self.order = None\n        self.pending_action = None\n        self.pending_leg = None\n\n    def _enter_leg(self):\n        value = self.broker.getvalue()\n        size = (self.p.position_pct * value) / self.data.close[0]\n        self.pending_action = 'entry'\n        self.order = self.buy(size=size)\n\n    def _exit_leg(self, leg):\n        self.pending_action = 'leg_stop'\n        self.pending_leg = leg\n        self.order = self.sell(size=leg['size'])\n\n    def _close_all(self):\n        self.pending_action = 'close_all'\n        self.order = self.close()\n\n    def next(self):\n        if self.order:\n            return\n\n        close = self.data.close[0]\n        high = self.data.high[0]\n        low = self.data.low[0]\n        ema = self.ema[0]\n        atr = self.atr[0]\n\n        if self.swing_high is None:\n            self.swing_high = high\n\n        if self.entries:\n            first_entry = self.entries[0]\n\n            if close < ema:\n                self._close_all()\n                self.swing_high = high\n                return\n\n            if high >= first_entry['price'] + self.p.target_atr_mult * first_entry['atr']:\n                self._close_all()\n                self.swing_high = high\n                return\n\n            for leg in self.entries:\n                if low <= leg['stop']:\n                    self._exit_leg(leg)\n                    self.swing_high = high\n                    return\n\n            if len(self.entries) < self.p.max_entries and close > ema:\n                self.swing_high = max(self.swing_high, high)\n                if self.swing_high - close >= self.p.pullback_atr_mult * atr:\n                    self._enter_leg()\n                    self.swing_high = high\n            else:\n                self.swing_high = max(self.swing_high, high)\n        else:\n            if close > ema:\n                self.swing_high = max(self.swing_high, high)\n                if self.swing_high - close >= self.p.pullback_atr_mult * atr:\n                    self._enter_leg()\n                    self.swing_high = high\n            else:\n                self.swing_high = high",
  "assumptions": [
    {
      "topic": "recent_high_definition",
      "choice": "Track a running peak of bar highs as the 'recent high'; it accumulates only while price stays above EMA(50), resets to the current bar's high whenever price closes below EMA(50), and resets again to the current bar's high immediately after any entry (so scale-ins require a genuinely new post-entry high).",
      "reason": "The spec never defines the lookback or reset rule for 'recent high' / 'next high'; this gives a self-consistent, literal reading of 'recent' tied to the bullish regime and to post-entry price action."
    },
    {
      "topic": "take_profit_anchor",
      "choice": "The 2.5 ATR take-profit that closes the entire position is measured from the FIRST entry's price and ATR (fixed at that entry's fill), not from each leg or an average.",
      "reason": "The spec says 'the entry point' (singular) for the whole-position take-profit, distinct from the per-position stop-loss language; the first entry is the natural anchor for the overall trend move."
    },
    {
      "topic": "trigger_price_basis",
      "choice": "Pullback-entry and EMA-break checks use the daily close (signal-based, evaluated once per bar); the per-leg stop-loss uses the bar low and the whole-position take-profit uses the bar high (intrabar, order-like triggers).",
      "reason": "The spec explicitly says the EMA exit uses a 'close below EMA', while stop-loss/take-profit read as literal price levels that would be 'reached' or 'triggered' intrabar; entries are treated as a daily signal check consistent with the EMA condition."
    },
    {
      "topic": "stop_loss_scope",
      "choice": "Each leg's 1.5 ATR stop-loss, when hit, closes only that leg's size, not the whole position.",
      "reason": "Risk-management rule 3 says 'for each position' / 'the position is forcibly closed', read as referring to that individual entry, in contrast to the exit rules which explicitly say 'close the entire position'."
    },
    {
      "topic": "atr_freeze_at_entry",
      "choice": "Each leg's stop level (and the first leg's take-profit level) is computed once, using the ATR value on the bar the entry order fills, and held fixed thereafter (not recomputed with the daily-updating ATR).",
      "reason": "The spec describes stop/target as a fixed distance 'from the entry point', implying a level set at entry time rather than a trailing/rolling ATR band."
    },
    {
      "topic": "position_sizing_shares",
      "choice": "Each entry's size is computed as 1% of current portfolio value (broker.getvalue()) divided by the current close price, passed as a (possibly fractional) size to buy(); no explicit share rounding is applied.",
      "reason": "The spec states position size as a percentage of capital without specifying rounding/lot conventions, and backtrader accepts fractional sizes by default."
    },
    {
      "topic": "order_guard_single_pending",
      "choice": "A single order-tracking attribute (self.order) guards all order types (entries, per-leg stops, full closes), so at most one order is pending at a time and at most one leg-stop is resolved per bar even if multiple legs breach their stop the same bar; remaining breached legs are handled on the next bar.",
      "reason": "Canonical default 5 calls for an order-tracking guard reset in notify_order; extending it uniformly to all order types keeps state management simple and unambiguous given the spec does not address same-bar multi-leg stop conflicts."

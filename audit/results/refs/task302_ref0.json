  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass Supertrend(bt.Indicator):\n    lines = ('supertrend', 'final_upper', 'final_lower')\n    params = (\n        ('period', 10),\n        ('multiplier', 3.0),\n    )\n\n    def __init__(self):\n        self.atr = bt.indicators.ATR(self.data, period=self.p.period)\n        self.hl2 = (self.data.high + self.data.low) / 2.0\n        self._initialized = False\n\n    def next(self):\n        basic_upper = self.hl2[0] + self.p.multiplier * self.atr[0]\n        basic_lower = self.hl2[0] - self.p.multiplier * self.atr[0]\n\n        if not self._initialized:\n            self.lines.final_upper[0] = basic_upper\n            self.lines.final_lower[0] = basic_lower\n            self.lines.supertrend[0] = basic_upper\n            self._initialized = True\n            return\n\n        prev_final_upper = self.lines.final_upper[-1]\n        prev_final_lower = self.lines.final_lower[-1]\n        prev_close = self.data.close[-1]\n\n        if basic_upper < prev_final_upper or prev_close > prev_final_upper:\n            final_upper = basic_upper\n        else:\n            final_upper = prev_final_upper\n\n        if basic_lower > prev_final_lower or prev_close < prev_final_lower:\n            final_lower = basic_lower\n        else:\n            final_lower = prev_final_lower\n\n        self.lines.final_upper[0] = final_upper\n        self.lines.final_lower[0] = final_lower\n\n        prev_supertrend = self.lines.supertrend[-1]\n        close = self.data.close[0]\n\n        if prev_supertrend == prev_final_upper:\n            if close <= final_upper:\n                st = final_upper\n            else:\n                st = final_lower\n        else:\n            if close >= final_lower:\n                st = final_lower\n            else:\n                st = final_upper\n\n        self.lines.supertrend[0] = st\n\n\nclass SupertrendReversalStrategy(bt.Strategy):\n    def __init__(self):\n        self.supertrend = Supertrend(self.data, period=10, multiplier=3.0)\n        self.pending_orders = []\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            if order in self.pending_orders:\n                self.pending_orders.remove(order)\n\n    def next(self):\n        if self.pending_orders:\n            return\n\n        if len(self.supertrend.supertrend) < 2:\n            return\n\n        prev_bearish = self.supertrend.supertrend[-1] > self.data.close[-1]\n        prev_bullish = self.supertrend.supertrend[-1] < self.data.close[-1]\n        curr_bearish = self.supertrend.supertrend[0] > self.data.close[0]\n        curr_bullish = self.supertrend.supertrend[0] < self.data.close[0]\n\n        if prev_bearish and curr_bullish:\n            if self.position.size < 0:\n                self.pending_orders.append(self.close())\n            self.pending_orders.append(self.buy())\n        elif prev_bullish and curr_bearish:\n            if self.position.size > 0:\n                self.pending_orders.append(self.close())\n            self.pending_orders.append(self.sell())",
  "assumptions": [

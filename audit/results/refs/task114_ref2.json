  "model": "gemini-3.6-flash(vertex)",
  "code": "import math\nimport backtrader as bt\n\n\nclass EmaBreakoutRetest(bt.Strategy):\n    \"\"\"\n    Swing strategy on breakout and retest of the 200-period EMA.\n    Main idea: Detect top-to-bottom breakout of 200 EMA, then open a long position\n    upon retest of the 200 EMA level confirmed by a bullish bounce.\n    \"\"\"\n\n    def __init__(self):\n        self.ema200 = bt.indicators.EMA(self.data.close, period=200)\n        self.sma60 = bt.indicators.SMA(self.data.close, period=60)\n\n        self.order = None\n        self.entry_price = None\n        self.breakout_occurred = False\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order.isbuy():\n                self.entry_price = order.executed.price\n            elif order.issell():\n                self.entry_price = None\n\n        # Reset order tracking attribute for Completed, Canceled, Margin, Rejected\n        self.order = None\n\n    def next(self):\n        # Guard pending orders\n        if self.order:\n            return\n\n        # Condition 1: Asset price breaks 200-period EMA from top to bottom\n        if self.data.close[-1] > self.ema200[-1] and self.data.close[0] < self.ema200[0]:\n            self.breakout_occurred = True\n\n        if self.position:\n            if self.entry_price is None:\n                return\n\n            # Exit Condition 2: Stop-loss at -30% from entry point\n            if self.data.low[0] <= self.entry_price * 0.70:\n                self.order = self.close()\n                return\n\n            # Exit Condition 1: Take-profit at 60-period SMA level, or 5% if SMA60 is unavailable\n            if not math.isnan(self.sma60[0]):\n                tp_target = self.sma60[0]\n            else:\n                tp_target = self.entry_price * 1.05\n\n            if self.data.high[0] >= tp_target:\n                self.order = self.close()\n                return\n\n        else:\n            # Condition 2 & 3: Retest and confirmation of support\n            if self.breakout_occurred:\n                retest = self.data.high[0] >= self.ema200[0]\n                confirmation = self.data.close[0] > self.data.open[0]\n\n                if retest and confirmation:\n                    # Position sizing: 2% of total trading capital\n                    target_value = self.broker.getvalue() * 0.02\n                    size = int(target_value / self.data.close[0])\n\n                    max_cash_shares = int(self.broker.getcash() / self.data.close[0])\n                    size = min(size, max_cash_shares)\n\n                    if size < 1 and max_cash_shares >= 1:\n                        size = 1\n\n                    if size > 0:\n                        self.order = self.buy(size=size)\n                        self.breakout_occurred = False",

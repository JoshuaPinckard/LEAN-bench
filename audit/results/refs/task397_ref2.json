  "code": "import backtrader as bt\n\n\nclass WilliamsRBandStrategy(bt.Strategy):\n    params = (\n        (\"period_willr\", 14),\n        (\"period_band\", 20),\n        (\"devfactor\", 2.0),\n        (\"stop_loss\", 1.0),\n    )\n\n    def __init__(self):\n        self.order = None\n\n        self.willr = bt.indicators.WilliamsR(self.data, period=self.p.period_willr)\n        self.wr_mean = bt.indicators.SMA(self.willr, period=self.p.period_band)\n        self.wr_std = bt.indicators.StdDev(self.willr, period=self.p.period_band)\n\n        self.upper_band = self.wr_mean + self.p.devfactor * self.wr_std\n        self.lower_band = self.wr_mean - self.p.devfactor * self.wr_std\n\n    def notify_order(self, order):\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        cross_up_upper = (\n            self.willr[0] > self.upper_band[0]\n            and self.willr[-1] <= self.upper_band[-1]\n        )\n        cross_down_mean = (\n            self.willr[0] < self.wr_mean[0]\n            and self.willr[-1] >= self.wr_mean[-1]\n        )\n        cross_down_lower = (\n            self.willr[0] < self.lower_band[0]\n            and self.willr[-1] >= self.lower_band[-1]\n        )\n        cross_up_mean = (\n            self.willr[0] > self.wr_mean[0]\n            and self.willr[-1] <= self.wr_mean[-1]\n        )\n\n        if not self.position:\n            if cross_up_upper:\n                self.order = self.buy()\n            elif cross_down_lower:\n                self.order = self.sell()\n        else:\n            if self.position.size > 0:\n                stop_price = self.position.price * (\n                    1.0 - self.p.stop_loss / 100.0\n                )\n                if self.data.low[0] <= stop_price or cross_down_mean:\n                    self.order = self.close()\n            elif self.position.size < 0:\n                stop_price = self.position.price * (\n                    1.0 + self.p.stop_loss / 100.0\n                )\n                if self.data.high[0] >= stop_price or cross_up_mean:\n                    self.order = self.close()",
  "assumptions": [
    {
      "topic": "stop_loss_evaluation",
      "choice": "Evaluated at bar level in next() comparing bar low/high against percentage threshold relative to position.price.",
      "reason": "The specification states exit when a fixed stop-loss of X% from average entry price is hit; checking intrabar high/low in next() triggers exit via self.close()."
    },

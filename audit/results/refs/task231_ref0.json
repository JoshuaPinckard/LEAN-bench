  "code": "import math\nimport statistics\nfrom collections import deque\n\nimport backtrader as bt\n\n\nclass ImpliedVolatilityETFStrategy(bt.Strategy):\n    params = dict(\n        iv_window=12,\n        calc_iv_ma_period=10,\n        entry_threshold_pct=15.0,\n        stability_threshold_pct=5.0,\n        exit_threshold_pct=5.0,\n        max_hold_bars=6,\n        volume_avg_period=78,\n        position_pct=0.10,\n        stop_loss_pct=0.02,\n        take_profit_pct=0.01,\n    )\n\n    def __init__(self):\n        self.returns = deque(maxlen=self.p.iv_window)\n        self.raw_iv_history = deque(maxlen=self.p.calc_iv_ma_period)\n        self.calc_iv_history = deque(maxlen=2)\n        self.vol_avg = bt.indicators.SimpleMovingAverage(\n            self.data.volume, period=self.p.volume_avg_period\n        )\n        self.order = None\n        self.is_entry_order = False\n        self.entry_price = None\n        self.entry_bar = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n        if order.status == order.Completed and self.is_entry_order:\n            self.entry_price = order.executed.price\n            self.entry_bar = len(self)\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n            self.is_entry_order = False\n\n    def next(self):\n        if len(self.data) < 2:\n            return\n\n        ret = math.log(self.data.close[0] / self.data.close[-1])\n        self.returns.append(ret)\n        if len(self.returns) < self.p.iv_window:\n            return\n\n        raw_iv = statistics.pstdev(self.returns)\n        self.raw_iv_history.append(raw_iv)\n        if len(self.raw_iv_history) < self.p.calc_iv_ma_period:\n            return\n\n        calculated_iv = sum(self.raw_iv_history) / len(self.raw_iv_history)\n        current_iv = raw_iv\n        self.calc_iv_history.append(calculated_iv)\n        if len(self.calc_iv_history) < 2:\n            return\n        if calculated_iv == 0:\n            return\n\n        prev_calc_iv = self.calc_iv_history[-2]\n        if prev_calc_iv == 0:\n            return\n\n        deviation_pct = (current_iv - calculated_iv) / calculated_iv * 100.0\n        stability_pct = abs(calculated_iv - prev_calc_iv) / prev_calc_iv * 100.0\n\n        price = self.data.close[0]\n\n        if self.order is not None:\n            return\n\n        if not self.position:\n            high_liquidity = self.data.volume[0] > self.vol_avg[0]\n            stable = stability_pct <= self.p.stability_threshold_pct\n            if high_liquidity and stable:\n                size = math.floor(\n                    (self.broker.getvalue() * self.p.position_pct) / price\n                )\n                if size > 0:\n                    if deviation_pct <= -self.p.entry_threshold_pct:\n                        self.is_entry_order = True\n                        self.order = self.buy(size=size)\n                    elif deviation_pct >= self.p.entry_threshold_pct:\n                        self.is_entry_order = True\n                        self.order = self.sell(size=size)\n        else:\n            bars_held = len(self) - self.entry_bar\n            close_position = False\n\n            if abs(deviation_pct) < self.p.exit_threshold_pct:\n                close_position = True\n            elif bars_held >= self.p.max_hold_bars:\n                close_position = True\n\n            if self.position.size > 0:\n                if price <= self.entry_price * (1 - self.p.stop_loss_pct):\n                    close_position = True\n                elif price >= self.entry_price * (1 + self.p.take_profit_pct):\n                    close_position = True\n            else:\n                if price >= self.entry_price * (1 + self.p.stop_loss_pct):\n                    close_position = True\n                elif price <= self.entry_price * (1 - self.p.take_profit_pct):\n                    close_position = True\n\n            if close_position:\n                self.order = self.close()",

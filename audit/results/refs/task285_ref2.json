  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass ATRTrailingStopSAR(bt.Strategy):\n    params = (\n        (\"atr_period\", 14),\n        (\"k\", 2.5),\n    )\n\n    def __init__(self):\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.order = None\n        self.stop_order = None\n\n        self.sar_history = []\n        self.up_stop_history = []\n        self.down_stop_history = []\n        self.entry_sar = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order == self.order:\n                self.order = None\n                if self.position and self.entry_sar is not None:\n                    if self.position.size > 0:\n                        self.stop_order = self.sell(\n                            exectype=bt.Order.Stop, price=self.entry_sar\n                        )\n                    elif self.position.size < 0:\n                        self.stop_order = self.buy(\n                            exectype=bt.Order.Stop, price=self.entry_sar\n                        )\n            elif order == self.stop_order:\n                self.stop_order = None\n\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order == self.order:\n                self.order = None\n            if order == self.stop_order:\n                self.stop_order = None\n\n    def next(self):\n        c = self.data.close[0]\n        a = self.atr[0]\n        k = self.p.k\n\n        candidate_up = c - k * a\n        candidate_down = c + k * a\n\n        if len(self.sar_history) == 0:\n            if c >= self.data.close[-1]:\n                sar_curr = candidate_up\n            else:\n                sar_curr = candidate_down\n            up_stop = candidate_up\n            down_stop = candidate_down\n        else:\n            prev_sar = self.sar_history[-1]\n            prev_up = self.up_stop_history[-1]\n            prev_down = self.down_stop_history[-1]\n\n            if self.data.close[-1] > prev_sar:\n                up_stop = max(prev_up, candidate_up)\n                down_stop = candidate_down\n            else:\n                up_stop = candidate_up\n                down_stop = min(prev_down, candidate_down)\n\n            if c > prev_sar:\n                sar_curr = up_stop\n            else:\n                sar_curr = down_stop\n\n        self.sar_history.append(sar_curr)\n        self.up_stop_history.append(up_stop)\n        self.down_stop_history.append(down_stop)\n\n        if len(self.sar_history) < 2:\n            return\n\n        if self.order:\n            return\n\n        prev_c = self.data.close[-1]\n        prev_s = self.sar_history[-2]\n        curr_c = c\n        curr_s = sar_curr\n\n        crossover = 0\n        if prev_c <= prev_s and curr_c > curr_s:\n            crossover = 1\n        elif prev_c >= prev_s and curr_c < curr_s:\n            crossover = -1\n\n        if crossover > 0:\n            if self.stop_order:\n                self.cancel(self.stop_order)\n                self.stop_order = None\n            self.entry_sar = curr_s\n            if self.position.size < 0:\n                self.close()\n                self.order = self.buy()\n            elif self.position.size == 0:\n                self.order = self.buy()\n\n        elif crossover < 0:\n            if self.stop_order:\n                self.cancel(self.stop_order)\n                self.stop_order = None\n            self.entry_sar = curr_s\n            if self.position.size > 0:\n                self.close()\n                self.order = self.sell()\n            elif self.position.size == 0:\n                self.order = self.sell()",
  "assumptions": [
    {
      "topic": "SAR_ATR Initialization",
      "choice": "Initialize SAR_ATR on the first valid ATR bar using close - k*ATR if close >= close[-1] else close + k*ATR.",
      "reason": "The recursive SAR_ATR calculation requires prior SAR_ATR and up/down stop values which are unstated for the initial bar."
    },

  "code": "import backtrader as bt\n\n\nclass PreMarketGapRiskStrategy(bt.Strategy):\n    params = dict(\n        atr_period=14,\n        sma_period=20,\n        atr_filter_short=5,\n        atr_filter_long=20,\n        atr_filter_mult=1.5,\n        gap_pct=0.02,\n        stop_atr_mult=1.5,\n        trail_trigger_atr_mult=1.0,\n        trail_atr_mult=1.0,\n        risk_pct=0.015,\n    )\n\n    def __init__(self):\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.sma = bt.indicators.SMA(self.data.close, period=self.p.sma_period)\n        self.atr_avg_short = bt.indicators.SMA(self.atr, period=self.p.atr_filter_short)\n        self.atr_avg_long = bt.indicators.SMA(self.atr, period=self.p.atr_filter_long)\n        self.crossover = bt.indicators.CrossOver(self.data.close, self.sma)\n\n        self.order = None\n        self.entry_order_pending = False\n        self.pending_atr = None\n\n        self.entry_price = None\n        self.atr_at_entry = None\n        self.stop_price = None\n        self.trail_active = False\n        self.trail_extreme = None\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            if self.entry_order_pending:\n                self.entry_price = order.executed.price\n                self.atr_at_entry = self.pending_atr\n                if order.isbuy():\n                    self.stop_price = self.entry_price - self.p.stop_atr_mult * self.atr_at_entry\n                else:\n                    self.stop_price = self.entry_price + self.p.stop_atr_mult * self.atr_at_entry\n                self.trail_active = False\n                self.trail_extreme = self.entry_price\n                self.entry_order_pending = False\n            if not self.position:\n                self.entry_price = None\n                self.atr_at_entry = None\n                self.stop_price = None\n                self.trail_active = False\n                self.trail_extreme = None\n            self.order = None\n        elif order.status in (order.Canceled, order.Margin, order.Rejected):\n            self.entry_order_pending = False\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if self.position:\n            self._manage_open_position()\n            return\n\n        vol_ok = self.atr_avg_short[0] <= self.p.atr_filter_mult * self.atr_avg_long[0]\n        gap_down = self.data.open[0] <= self.data.close[-1] * (1.0 - self.p.gap_pct)\n        gap_up = self.data.open[0] >= self.data.close[-1] * (1.0 + self.p.gap_pct)\n\n        if self.crossover[0] > 0:\n            trend_ok = self.data.close[0] > self.sma[0]\n            if vol_ok and not gap_down and trend_ok:\n                self._enter(is_long=True)\n        elif self.crossover[0] < 0:\n            trend_ok = self.data.close[0] < self.sma[0]\n            if vol_ok and not gap_up and trend_ok:\n                self._enter(is_long=False)\n\n    def _enter(self, is_long):\n        stop_distance = self.p.stop_atr_mult * self.atr[0]\n        if stop_distance <= 0:\n            return\n        risk_amount = self.p.risk_pct * self.broker.getvalue()\n        size = int(risk_amount / stop_distance)\n        if size < 1:\n            return\n        self.pending_atr = self.atr[0]\n        self.entry_order_pending = True\n        if is_long:\n            self.order = self.buy(size=size)\n        else:\n            self.order = self.sell(size=size)\n\n    def _manage_open_position(self):\n        atr = self.atr_at_entry\n        is_long = self.position.size > 0\n\n        if is_long:\n            profit = self.data.close[0] - self.entry_price\n            if not self.trail_active and profit >= self.p.trail_trigger_atr_mult * atr:\n                self.trail_active = True\n                self.trail_extreme = self.data.high[0]\n                self.stop_price = self.trail_extreme - self.p.trail_atr_mult * atr\n            elif self.trail_active and self.data.high[0] > self.trail_extreme:\n                self.trail_extreme = self.data.high[0]\n                self.stop_price = self.trail_extreme - self.p.trail_atr_mult * atr\n\n            if self.data.low[0] <= self.stop_price:\n                self.order = self.close()\n        else:\n            profit = self.entry_price - self.data.close[0]\n            if not self.trail_active and profit >= self.p.trail_trigger_atr_mult * atr:\n                self.trail_active = True\n                self.trail_extreme = self.data.low[0]\n                self.stop_price = self.trail_extreme + self.p.trail_atr_mult * atr\n            elif self.trail_active and self.data.low[0] < self.trail_extreme:\n                self.trail_extreme = self.data.low[0]\n                self.stop_price = self.trail_extreme + self.p.trail_atr_mult * atr\n\n            if self.data.high[0] >= self.stop_price:\n                self.order = self.close()",

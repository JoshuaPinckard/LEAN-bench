  "code": "import backtrader as bt\n\n\nclass WilliamsMomentumATRStrategy(bt.Strategy):\n    params = (\n        ('wr_period', 14),\n        ('mom_period', 14),\n        ('atr_period', 14),\n        ('atr_mult', 2.0),\n        ('trailing_stop', False),\n    )\n\n    def __init__(self):\n        self.williams = bt.indicators.WilliamsR(self.data, period=self.p.wr_period)\n        self.momentum = bt.indicators.Momentum(self.data, period=self.p.mom_period)\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.order = None\n        self.stop_price = None\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            if order.isbuy():\n                self.stop_price = order.executed.price - self.p.atr_mult * self.atr[0]\n            elif order.issell():\n                self.stop_price = order.executed.price + self.p.atr_mult * self.atr[0]\n\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        long_signal = self.williams[-1] <= -80 and self.williams[0] > -80 and self.momentum[0] > 0\n        short_signal = self.williams[-1] >= -20 and self.williams[0] < -20 and self.momentum[0] < 0\n\n        if not self.position:\n            if long_signal:\n                self.order = self.buy()\n            elif short_signal:\n                self.order = self.sell()\n            return\n\n        if self.position.size > 0:\n            if short_signal:\n                self.order = self.close()\n                return\n            if self.data.close[0] <= self.stop_price:\n                self.order = self.close()\n                return\n            if self.p.trailing_stop:\n                new_stop = self.data.close[0] - self.p.atr_mult * self.atr[0]\n                if new_stop > self.stop_price:\n                    self.stop_price = new_stop\n\n        elif self.position.size < 0:\n            if long_signal:\n                self.order = self.close()\n                return\n            if self.data.close[0] >= self.stop_price:\n                self.order = self.close()\n                return\n            if self.p.trailing_stop:\n                new_stop = self.data.close[0] + self.p.atr_mult * self.atr[0]\n                if new_stop < self.stop_price:\n                    self.stop_price = new_stop",

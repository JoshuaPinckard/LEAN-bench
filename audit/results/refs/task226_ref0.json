{
  "task_id": 226,
  "ref_idx": 0,
  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass Impulse121Strategy(bt.Strategy):\n    params = dict(\n        sma_period=252,\n        atr_period=14,\n        atr_sma_period=252,\n        atr_pct_threshold=0.05,\n        position_pct=0.10,\n        stop_loss_pct=0.02,\n        take_profit_pct=0.05,\n    )\n\n    def __init__(self):\n        self.sma = bt.indicators.SimpleMovingAverage(\n            self.data.close, period=self.p.sma_period\n        )\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.atr_sma = bt.indicators.SimpleMovingAverage(\n            self.atr, period=self.p.atr_sma_period\n        )\n        self.atr_pct = self.atr_sma / self.data.close\n\n        self.order = None\n        self.stop_order = None\n        self.limit_order = None\n\n    def notify_order(self, order):\n        if order.status in (order.Submitted, order.Accepted):\n            return\n\n        if order.status == order.Completed:\n            if order.isbuy():\n                entry_price = order.executed.price\n                stop_price = entry_price * (1 - self.p.stop_loss_pct)\n                limit_price = entry_price * (1 + self.p.take_profit_pct)\n                self.stop_order = self.sell(\n                    exectype=bt.Order.Stop, price=stop_price, size=self.position.size\n                )\n                self.limit_order = self.sell(\n                    exectype=bt.Order.Limit,\n                    price=limit_price,\n                    size=self.position.size,\n                    oco=self.stop_order,\n                )\n            else:\n                self.stop_order = None\n                self.limit_order = None\n            self.order = None\n        elif order.status in (order.Canceled, order.Margin, order.Rejected):\n            if order is self.order:\n                self.order = None\n            if order is self.stop_order:\n                self.stop_order = None\n            if order is self.limit_order:\n                self.limit_order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            if (\n                self.data.close[0] > self.sma[0]\n                and self.atr_pct[0] <= self.p.atr_pct_threshold\n            ):\n                size = (self.p.position_pct * self.broker.getvalue()) / self.data.close[0]\n                self.order = self.buy(size=size)\n        else:\n            if self.data.close[0] < self.sma[0]:\n                if self.stop_order is not None and self.stop_order.alive():\n                    self.cancel(self.stop_order)\n                if self.limit_order is not None and self.limit_order.alive():\n                    self.cancel(self.limit_order)\n                self.order = self.close()",
  "assumptions": [
    {
      "topic": "position_sizing_basis",
      "choice": "Size each entry as 10% of self.broker.getvalue() (total portfolio value, cash+positions) divided by current Close, passed as a fractional share count to self.buy(size=...)",
      "reason": "Spec states 'position fixed at 10% of capital' but does not define capital (cash vs. equity) or lot rounding; portfolio value is the standard reading of 'capital' and is recomputed at each entry since no position is open at signal time."
    },
    {
      "topic": "stop_take_profit_mechanism",
      "choice": "Once the entry buy fills, submit two OCO-linked protective sell orders sized to the full position: exectype=bt.Order.Stop at entry_price*0.98 and exectype=bt.Order.Limit at entry_price*1.05. If Close < SMA(252) fires first, cancel both protective orders and exit via a market self.close().",
      "reason": "The spec calls these 'triggered' conditions, implying genuine intrabar price-level execution rather than a bar-close comparison; backtrader's native Stop/Limit order types model this without adding extra filters. Only one exit path can execute at a time, so the SMA-based exit cancels the protective legs before closing."
    },
    {
      "topic": "fractional_share_sizing",
      "choice": "Order size is left as a float (10% of capital / Close), not rounded to whole shares.",
      "reason": "Spec is silent on lot-size constraints; backtrader's default broker/sizer model accepts fractional sizes, so no rounding is imposed."
    }
  ],

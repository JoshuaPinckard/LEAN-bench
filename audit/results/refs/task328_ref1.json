  "code": "import backtrader as bt\n\n\nclass ReferenceStrategy(bt.Strategy):\n    def __init__(self):\n        self.sma = bt.indicators.SimpleMovingAverage(self.data.close, period=20)\n        self.swing_high = bt.indicators.Highest(self.data.high(-1), period=5)\n        self.swing_low = bt.indicators.Lowest(self.data.low(-1), period=5)\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        crossed_above_high = (\n            self.data.close[-1] <= self.swing_high[-1]\n            and self.data.close[0] > self.swing_high[0]\n        )\n        crossed_below_low = (\n            self.data.close[-1] >= self.swing_low[-1]\n            and self.data.close[0] < self.swing_low[0]\n        )\n\n        if not self.position:\n            if self.data.close[0] > self.sma[0] and crossed_above_high:\n                self.order = self.buy()\n            elif self.data.close[0] < self.sma[0] and crossed_below_low:\n                self.order = self.sell()\n        elif self.position.size > 0:\n            if crossed_below_low:\n                self.order = self.close()\n        elif self.position.size < 0:\n            if crossed_above_high:\n                self.order = self.close()",
  "assumptions": [
    {
      "topic": "cross definition",
      "choice": "A cross above requires prior close <= prior swing level and current close > current swing level; a cross below requires prior close >= prior swing level and current close < current swing level.",
      "reason": "The specification uses 'crosses' without defining equality handling."
    }
  ],

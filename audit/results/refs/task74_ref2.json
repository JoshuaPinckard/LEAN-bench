  "code": "import backtrader as bt\n\n\nclass DynamicStopStrategy(bt.Strategy):\n    params = (\n        (\"size\", 0.1),\n        (\"sl_points\", 10.0),\n        (\"tp_points\", 50.0),\n        (\"step_points\", 10.0),\n    )\n\n    def __init__(self):\n        self.order = None\n        self.entry_price = None\n        self.sl_price = None\n        self.tp_price = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if not self.position:\n                self.entry_price = None\n                self.sl_price = None\n                self.tp_price = None\n            else:\n                self.entry_price = order.executed.price\n                if self.position.size > 0:\n                    self.sl_price = self.entry_price - self.p.sl_points\n                    self.tp_price = self.entry_price + self.p.tp_points\n                elif self.position.size < 0:\n                    self.sl_price = self.entry_price + self.p.sl_points\n                    self.tp_price = self.entry_price - self.p.tp_points\n\n        self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            if self.data.close[0] > self.data.open[0]:\n                self.order = self.buy(size=self.p.size)\n            elif self.data.close[0] < self.data.open[0]:\n                self.order = self.sell(size=self.p.size)\n        else:\n            if self.position.size > 0:\n                high_p = self.data.high[0]\n                low_p = self.data.low[0]\n\n                profit = round(high_p - self.entry_price, 6)\n                if profit >= self.p.step_points:\n                    step = int(profit // self.p.step_points)\n                    new_sl = self.entry_price + (step - 1) * self.p.step_points\n                    self.sl_price = max(self.sl_price, new_sl)\n\n                if high_p >= self.tp_price:\n                    self.order = self.close()\n                elif low_p <= self.sl_price:\n                    self.order = self.close()\n\n            elif self.position.size < 0:\n                high_p = self.data.high[0]\n                low_p = self.data.low[0]\n\n                profit = round(self.entry_price - low_p, 6)\n                if profit >= self.p.step_points:\n                    step = int(profit // self.p.step_points)\n                    new_sl = self.entry_price - (step - 1) * self.p.step_points\n                    self.sl_price = min(self.sl_price, new_sl)\n\n                if low_p <= self.tp_price:\n                    self.order = self.close()\n                elif high_p >= self.sl_price:\n                    self.order = self.close()",
  "assumptions": [

  "code": "import backtrader as bt\nfrom collections import deque\n\n\nclass DynamicSequenceStrategy(bt.Strategy):\n    params = (\n        (\"record_window\", 100),\n        (\"min_sequence_length\", 2),\n    )\n\n    def __init__(self):\n        self.sma10 = bt.indicators.SMA(self.data.close, period=10)\n        self.order = None\n        self.sequence_length = 0\n        self._prior_sequence_lengths = deque(maxlen=self.p.record_window)\n\n    def notify_order(self, order):\n        if order.status in (\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ):\n            self.order = None\n\n    def next(self):\n        sequence_condition = (\n            self.data.close[0] >= self.data.close[-1]\n            and self.sma10[0] >= self.sma10[-1]\n        )\n\n        if sequence_condition:\n            self.sequence_length += 1\n        else:\n            self.sequence_length = 0\n\n        is_record = (\n            not self._prior_sequence_lengths\n            or self.sequence_length > max(self._prior_sequence_lengths)\n        )\n\n        if not self.order:\n            if self.position:\n                if not sequence_condition:\n                    self.order = self.close()\n            elif (\n                sequence_condition\n                and self.sequence_length >= self.p.min_sequence_length\n                and is_record\n            ):\n                self.order = self.buy()\n\n        self._prior_sequence_lengths.append(self.sequence_length)",

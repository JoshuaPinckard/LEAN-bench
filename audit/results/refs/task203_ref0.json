{
  "task_id": 203,
  "ref_idx": 0,
  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass MeanReversionZScoreStrategy(bt.Strategy):\n    params = (\n        ('lookback', 20),\n        ('half_life', 5),\n        ('entry_threshold', 1.0),\n        ('stoploss_factor', 1.5),\n        ('narrow_band_rel_eps', 1e-4),\n    )\n\n    def __init__(self):\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close, period=self.p.lookback, devfactor=2.0)\n        self.alpha = 2.0 / (self.p.half_life + 1.0)\n        self.ema_z = None\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in (order.Completed, order.Canceled, order.Margin, order.Rejected):\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        mid = self.bb.mid[0]\n        top = self.bb.top[0]\n        band_width = top - mid\n\n        if abs(band_width) < self.p.narrow_band_rel_eps * self.data.close[0]:\n            return\n\n        z = 2.0 * (self.data.close[0] - mid) / band_width\n\n        prev_ema = self.ema_z\n        if prev_ema is None:\n            self.ema_z = z\n        else:\n            self.ema_z = self.alpha * z + (1.0 - self.alpha) * prev_ema\n\n        cross_up = prev_ema is not None and prev_ema < 0.0 and self.ema_z >= 0.0\n        cross_down = prev_ema is not None and prev_ema > 0.0 and self.ema_z <= 0.0\n\n        stoploss_threshold = self.p.entry_threshold * self.p.stoploss_factor\n\n        if self.position:\n            if self.position.size > 0:\n                if z >= stoploss_threshold:\n                    self.order = self.close()\n                elif cross_up:\n                    self.order = self.close()\n            elif self.position.size < 0:\n                if z <= -stoploss_threshold:\n                    self.order = self.close()\n                elif cross_down:\n                    self.order = self.close()\n        else:\n            if z < -self.p.entry_threshold:\n                size = int(self.broker.getcash() / self.data.close[0])\n                if size > 0:\n                    self.order = self.buy(size=size)\n            elif z > self.p.entry_threshold:\n                size = int(self.broker.getcash() / self.data.close[0])\n                if size > 0:\n                    self.order = self.sell(size=size)",
  "assumptions": [
    {
      "topic": "parameter defaults",
      "choice": "lookback=20, half_life=5, entry_threshold=1.0, stoploss_factor=1.5, exposed as strategy params",
      "reason": "spec lists these as the parameters to optimize but states no concrete default values for a single run"
    },
    {
      "topic": "infeasible",
      "choice": "no grid-search/optstrategy loop or Sharpe-based selection is implemented in this file",
      "reason": "the harness requires exactly one bt.Strategy class with no other top-level executing code (no cerebro setup); parameter optimization over lookback/half_life/entry_threshold/stoploss_factor must be driven externally (e.g., cerebro.optstrategy) against the exposed params, which cannot live inside the strategy class itself"
    },
    {
      "topic": "narrow-band threshold",
      "choice": "treat bands as 'almost zero width' when abs(top-mid) < 1e-4 * close, exposed as narrow_band_rel_eps param",
      "reason": "spec requires ignoring signals on near-zero band width but gives no numeric definition; used a price-relative epsilon so it scales sensibly as AAPL's price level changes over the 2020-2025 window"
    },
    {
      "topic": "narrow-band bar handling",
      "choice": "on a narrow-band bar, skip z/EMA update and skip entry/exit/stoploss checks entirely for that bar",
      "reason": "computing z with a near-zero denominator is numerically unstable; 'ignore signals' is read literally as taking no trading action and not corrupting the smoothed EMA(z) with an explosive value that bar"
    },
    {
      "topic": "EMA(z) implementation",
      "choice": "EMA(z, half_life) computed manually in next() via the standard recursive formula (alpha=2/(half_life+1)) fed by a manually computed z, rather than bt.indicators.EMA on an auto-built line",
      "reason": "the harness restricts output to a single bt.Strategy class, so there is no room for an auxiliary Indicator class to properly wire a BB-derived line into bt.indicators.EMA; manual computation also lets the narrow-band skip (above) prevent a division-by-near-zero from ever entering the smoothed series"
    },
    {
      "topic": "position sizing",
      "choice": "size = floor(available cash / current close) for both long and short entries",
      "reason": "spec states fixed sizing of '100% of available capital'; ATR volatility scaling is explicitly marked optional in the spec and is omitted"
    },
    {
      "topic": "exit priority",
      "choice": "when the stop-loss condition and the EMA-zero-cross exit condition are both true on the same bar, stop-loss takes priority",
      "reason": "spec states both exit rules independently but does not specify precedence between them"
    },
    {
      "topic": "devfactor",
      "choice": "hardcoded literal 2.0, not exposed as a tunable parameter",
      "reason": "spec fixes 'BollingerBands(period=lookback, devfactor=2)' explicitly, unlike lookback/half_life/entry_threshold/stoploss_factor which are named as the parameters to optimize"
    }
  ],

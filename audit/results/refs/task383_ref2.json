  "code": "import backtrader as bt\nimport math\nimport statistics\n\n\nclass MeanReversionAutocorrelation(bt.Strategy):\n    params = (\n        ('lookback', 20),\n        ('stop_loss_pct', 0.02),\n        ('z_thresh', 2.0),\n    )\n\n    def __init__(self):\n        self.order = None\n        self.stop_order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            if self.order == order:\n                self.order = None\n            if self.stop_order == order:\n                self.stop_order = None\n\n        if order.status == order.Completed:\n            if self.position.size > 0 and self.stop_order is None:\n                stop_price = order.executed.price * (1.0 - self.p.stop_loss_pct)\n                self.stop_order = self.sell(exectype=bt.Order.Stop, price=stop_price)\n            elif self.position.size < 0 and self.stop_order is None:\n                stop_price = order.executed.price * (1.0 + self.p.stop_loss_pct)\n                self.stop_order = self.buy(exectype=bt.Order.Stop, price=stop_price)\n\n    def _pearson(self, x, y):\n        n = len(x)\n        mean_x = sum(x) / float(n)\n        mean_y = sum(y) / float(n)\n        cov = sum((x[i] - mean_x) * (y[i] - mean_y) for i in range(n))\n        var_x = sum((x[i] - mean_x) ** 2 for i in range(n))\n        var_y = sum((y[i] - mean_y) ** 2 for i in range(n))\n        denom = math.sqrt(var_x * var_y)\n        return cov / denom if denom > 1e-12 else 0.0\n\n    def next(self):\n        p = self.p.lookback\n        min_bars = p * 2 + 1\n        if len(self.data) < min_bars:\n            return\n\n        corrs = []\n        for k in range(p + 1):\n            x = [self.data.close[-k - i] for i in range(p)]\n            y = [self.data.close[-k - i - 1] for i in range(p)]\n            corrs.append(self._pearson(x, y))\n\n        corrs_curr = corrs[0:p]\n        mean_0 = sum(corrs_curr) / float(p)\n        std_0 = statistics.stdev(corrs_curr)\n        z_0 = (corrs_curr[0] - mean_0) / std_0 if std_0 > 1e-12 else 0.0\n\n        corrs_prev = corrs[1:p + 1]\n        mean_1 = sum(corrs_prev) / float(p)\n        std_1 = statistics.stdev(corrs_prev)\n        z_1 = (corrs_prev[0] - mean_1) / std_1 if std_1 > 1e-12 else 0.0\n\n        if self.order:\n            return\n\n        if not self.position:\n            if z_1 < -self.p.z_thresh and z_0 > z_1:\n                self.order = self.buy()\n            elif z_1 > self.p.z_thresh and z_0 < z_1:\n                self.order = self.sell()\n        else:\n            if self.position.size > 0:\n                if z_0 >= 0.0:\n                    if self.stop_order:\n                        self.cancel(self.stop_order)\n                        self.stop_order = None\n                    self.order = self.close()\n            elif self.position.size < 0:\n                if z_0 <= 0.0:\n                    if self.stop_order:\n                        self.cancel(self.stop_order)\n                        self.stop_order = None\n                    self.order = self.close()",
  "assumptions": [

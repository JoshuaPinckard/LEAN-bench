  "code": "import backtrader as bt\n\n\nclass TrendDayMACrossover(bt.Strategy):\n    params = (\n        ('ma20_period', 20),\n        ('ma30_period', 30),\n        ('ma60_period', 60),\n    )\n\n    def __init__(self):\n        self.ma20 = bt.indicators.SMA(self.data.close, period=self.p.ma20_period)\n        self.ma30 = bt.indicators.SMA(self.data.close, period=self.p.ma30_period)\n        self.ma60 = bt.indicators.SMA(self.data.close, period=self.p.ma60_period)\n\n        self.order = None\n        self.sequence_stage = 0\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled,\n                            order.Margin, order.Rejected]:\n            self.order = None\n\n            if order.status == order.Completed and order.isbuy():\n                self.sequence_stage = 0\n\n    def next(self):\n        if self.order:\n            return\n\n        if self.position:\n            if self.data.high[0] >= 0.278:\n                self.order = self.close()\n            elif (self.data.close[0] < 0.265 and\n                  self.data.close[0] < self.data.open[0] and\n                  self.data.volume[0] > self.data.volume[-1]):\n                self.order = self.close()\n            return\n\n        crossed_ma20 = (\n            self.data.close[-1] <= self.ma20[-1] and\n            self.data.close[0] > self.ma20[0]\n        )\n        crossed_ma30 = (\n            self.data.close[-1] <= self.ma30[-1] and\n            self.data.close[0] > self.ma30[0]\n        )\n\n        if self.sequence_stage == 0 and crossed_ma20:\n            self.sequence_stage = 1\n        elif self.sequence_stage == 1 and crossed_ma30:\n            self.sequence_stage = 2\n\n        hourly_volume_increasing = (\n            sum(self.data.volume.get(size=12)) >\n            sum(self.data.volume.get(ago=-12, size=12))\n        )\n\n        if (self.sequence_stage == 2 and\n                self.data.close[0] > self.ma60[0] and\n                hourly_volume_increasing):\n            self.order = self.buy()",

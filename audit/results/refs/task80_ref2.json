  "code": "import math\nimport collections\nimport statistics\nimport backtrader as bt\n\n\nclass FVGOrderBlockStrategy(bt.Strategy):\n    \"\"\"\n    Reference implementation of Fair Value Gap (FVG) and Order Block Trading Strategy.\n    \n    1-Hour Timeframe: Aggregated from 1-minute bars to identify 1-hour FVGs.\n    1-Minute Timeframe: Used for Order Block detection, ADX trend filtering, entry triggers, and stop loss calculation.\n    \"\"\"\n    params = (\n        ('ob_body_ratio', 0.70),      # Order Block candle body to total range ratio (>= 70%)\n        ('adx_period', 14),           # Period for ADX trend filter\n        ('adx_threshold', 20.0),       # ADX threshold to filter out strong sideways movement\n        ('risk_pct', 0.01),           # Fixed risk per trade (1% of portfolio capital)\n        ('fallback_rr', 2.0),         # Fallback Risk:Reward ratio if no 1h FVG above entry\n    )\n\n    def __init__(self):\n        self.order = None\n        self.sl_price = None\n        self.tp_price = None\n\n        # Indicators on 1-minute data\n        self.adx = bt.indicators.ADX(self.data, period=self.p.adx_period)\n\n        # 1-hour Candle Aggregation Tracking\n        self.h1_candles = []\n        self.current_h1 = None\n        self.last_hour = None\n\n        # 1-hour FVG Storage\n        self.h1_fvgs = []\n\n        # Order Block Tracking on 1-minute timeframe\n        self.last_ob_high = None\n        self.last_ob_low = None\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def _update_h1_candles(self):\n        dt = self.data.datetime.datetime(0)\n        current_hour = dt.hour\n\n        if self.last_hour is None:\n            self.last_hour = current_hour\n            self.current_h1 = {\n                'open': self.data.open[0],\n                'high': self.data.high[0],\n                'low': self.data.low[0],\n                'close': self.data.close[0],\n                'time': dt\n            }\n            return\n\n        if current_hour != self.last_hour:\n            # Finalize previous 1-hour candle\n            self.h1_candles.append(self.current_h1)\n            self._check_new_h1_fvg()\n\n            # Initialize new 1-hour candle\n            self.last_hour = current_hour\n            self.current_h1 = {\n                'open': self.data.open[0],\n                'high': self.data.high[0],\n                'low': self.data.low[0],\n                'close': self.data.close[0],\n                'time': dt\n            }\n        else:\n            # Update running 1-hour candle\n            self.current_h1['high'] = max(self.current_h1['high'], self.data.high[0])\n            self.current_h1['low'] = min(self.current_h1['low'], self.data.low[0])\n            self.current_h1['close'] = self.data.close[0]\n\n    def _check_new_h1_fvg(self):\n        if len(self.h1_candles) < 3:\n            return\n\n        c1 = self.h1_candles[-3]\n        c2 = self.h1_candles[-2]\n        c3 = self.h1_candles[-1]\n\n        # Bullish FVG: Low of candle 3 is greater than High of candle 1\n        if c3['low'] > c1['high']:\n            fvg = {\n                'type': 'bullish',\n                'bottom': c1['high'],\n                'top': c3['low'],\n                'time': c3['time']\n            }\n            self.h1_fvgs.append(fvg)\n\n        # Bearish FVG: High of candle 3 is less than Low of candle 1\n        elif c3['high'] < c1['low']:\n            fvg = {\n                'type': 'bearish',\n                'bottom': c3['high'],\n                'top': c1['low'],\n                'time': c3['time']\n            }\n            self.h1_fvgs.append(fvg)\n\n    def next(self):\n        self._update_h1_candles()\n\n        # Manage existing open position\n        if self.position:\n            if self.sl_price is not None and self.data.low[0] <= self.sl_price:\n                self.close()\n                self.sl_price = None\n                self.tp_price = None\n                return\n            if self.tp_price is not None and self.data.high[0] >= self.tp_price:\n                self.close()\n                self.sl_price = None\n                self.tp_price = None\n                return\n            return\n\n        # Guard pending order\n        if self.order:\n            return\n\n        # Identify 1-minute Order Block (candle body >= 70% of candle range)\n        candle_height = self.data.high[0] - self.data.low[0]\n        if candle_height > 0:\n            body = abs(self.data.close[0] - self.data.open[0])\n            if (body / candle_height) >= self.p.ob_body_ratio:\n                self.last_ob_high = self.data.high[0]\n                self.last_ob_low = self.data.low[0]\n\n        if self.last_ob_high is None:\n            return\n\n        # Trend Filter: Do not trade if market is in strong sideways movement\n        if self.adx[0] < self.p.adx_threshold:\n            return\n\n        # Condition 1: Price retraces to touch/enter a 1-hour Bullish FVG zone\n        in_fvg = False\n        current_price = self.data.close[0]\n        for fvg in reversed(self.h1_fvgs):\n            if fvg['type'] == 'bullish':\n                if self.data.low[0] <= fvg['top'] and self.data.high[0] >= fvg['bottom']:\n                    in_fvg = True\n                    break\n\n        if not in_fvg:\n            return\n\n        # Condition 2 & 3: Price breaks upward the last significant Order Block high and confirms strength\n        if self.data.close[0] > self.last_ob_high and self.data.close[0] > self.data.open[0]:\n            sl = self.data.low[0]\n            if sl >= current_price:\n                return\n\n            # Take profit: Level of the next 1-hour FVG above entry point\n            tp = None\n            for fvg in reversed(self.h1_fvgs):\n                if fvg['bottom'] > current_price:\n                    tp = fvg['bottom']\n                    break\n\n            if tp is None or tp <= current_price:\n                risk = current_price - sl\n                tp = current_price + risk * self.p.fallback_rr\n\n            # Position Sizing: Risk limited to fixed percentage of capital by stop loss\n            account_value = self.broker.getvalue()\n            risk_amount = account_value * self.p.risk_pct\n            risk_per_unit = current_price - sl\n\n            if risk_per_unit <= 0:\n                return\n\n            size = risk_amount / risk_per_unit\n\n            # Cash availability cap\n            cash = self.broker.getcash()\n            max_size = (cash * 0.95) / current_price\n            size = min(size, max_size)\n\n            if size > 0:\n                self.sl_price = sl\n                self.tp_price = tp\n                self.order = self.buy(size=size)",

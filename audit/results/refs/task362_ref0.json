  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass ChandelierStops(bt.Indicator):\n    lines = ('longstop', 'shortstop')\n    params = dict(lookback_n=22, atr_mult=3.0, atr_period=14)\n\n    def __init__(self):\n        atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        highest = bt.indicators.Highest(self.data.high, period=self.p.lookback_n)\n        lowest = bt.indicators.Lowest(self.data.low, period=self.p.lookback_n)\n        self.long_stop_raw = highest - self.p.atr_mult * atr\n        self.short_stop_raw = lowest + self.p.atr_mult * atr\n        self._initialized = False\n\n    def next(self):\n        lraw = self.long_stop_raw[0]\n        sraw = self.short_stop_raw[0]\n\n        if not self._initialized:\n            self.lines.longstop[0] = lraw\n            self.lines.shortstop[0] = sraw\n            self._initialized = True\n            return\n\n        close_prev = self.data.close[-1]\n        prev_long = self.lines.longstop[-1]\n        prev_short = self.lines.shortstop[-1]\n\n        if close_prev > prev_long:\n            self.lines.longstop[0] = max(prev_long, lraw)\n        else:\n            self.lines.longstop[0] = lraw\n\n        if close_prev < prev_short:\n            self.lines.shortstop[0] = min(prev_short, sraw)\n        else:\n            self.lines.shortstop[0] = sraw\n\n\nclass ChandelierAdxStrategy(bt.Strategy):\n    params = dict(\n        lookback_n=22,\n        atr_mult=3.0,\n        adx_threshold=25,\n        atr_period=14,\n        adx_period=14,\n    )\n\n    def __init__(self):\n        self.adx = bt.indicators.ADX(self.data, period=self.p.adx_period)\n        self.stops = ChandelierStops(\n            self.data,\n            lookback_n=self.p.lookback_n,\n            atr_mult=self.p.atr_mult,\n            atr_period=self.p.atr_period,\n        )\n        self.long_stop = self.stops.lines.longstop\n        self.short_stop = self.stops.lines.shortstop\n\n        self.long_cross = bt.indicators.CrossOver(self.data.close, self.long_stop)\n        self.short_cross = bt.indicators.CrossOver(self.data.close, self.short_stop)\n\n        self.orders = []\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            if order in self.orders:\n                self.orders.remove(order)\n\n    def next(self):\n        if self.orders:\n            return\n\n        adx_ok = self.adx[0] > self.p.adx_threshold\n        long_entry_signal = self.long_cross[0] > 0\n        long_exit_signal = self.long_cross[0] < 0\n        short_entry_signal = self.short_cross[0] < 0\n        short_exit_signal = self.short_cross[0] > 0\n\n        long_entry = adx_ok and long_entry_signal\n        short_entry = adx_ok and short_entry_signal\n\n        if not self.position:\n            if long_entry:\n                self.orders.append(self.buy())\n            elif short_entry:\n                self.orders.append(self.sell())\n        elif self.position.size > 0:\n            if short_entry:\n                self.orders.append(self.close())\n                self.orders.append(self.sell())\n            elif long_exit_signal:\n                self.orders.append(self.close())\n        elif self.position.size < 0:\n            if long_entry:\n                self.orders.append(self.close())\n                self.orders.append(self.buy())\n            elif short_exit_signal:\n                self.orders.append(self.close())",
  "assumptions": [
    {
      "topic": "trailing_stop_eligibility",
      "choice": "Interpreted 'in/eligible for long' as: previous bar's close was above the previous bar's LongStop (uptrend regime intact) -> ratchet LongStop = max(LongStop[1], LongStopRaw); otherwise reset LongStop = LongStopRaw. Symmetric rule for ShortStop using previous close vs previous ShortStop. This is the standard published Chandelier Exit ratchet convention and keeps the trailing-stop lines self-contained (price/ATR-based only), matching the instruction to implement them as custom lines independent of strategy position state.",
      "reason": "The spec's phrase 'in/eligible for long' does not define eligibility explicitly; tying it to position state would require the indicator to reach into the strategy, which conflicts with implementing the stops as standalone custom lines."
    },
    {
      "topic": "exit_mechanism",
      "choice": "Implemented exits via close-crossing-the-stop-line signals (CrossOver) rather than a continuously replaced stop order.",
      "reason": "The spec explicitly offers this as an equivalent alternative ('or place a stop order ... updated each bar'); the crossover approach is simpler and composes cleanly with the required reversal logic."
    },
    {
      "topic": "signal_priority",
      "choice": "When both a reversal (opposite-direction ADX-gated entry) and a plain same-bar exit signal are true, the reversal takes priority (close+flip) over a plain exit. When flat and both long and short entry signals fire on the same bar, long entry takes priority.",
      "reason": "The spec does not specify tie-breaking for simultaneous signals; this is the closest literal reading that preserves both the 'exit on stop cross' and 'reversal on opposite signal' rules without silently dropping one."
    }
  ],

  "model": "gemini-3.6-flash(vertex)",
  "code": "import statistics\nimport backtrader as bt\n\n\nclass PortfolioCostOptimizationStrategy(bt.Strategy):\n    params = (\n        (\"lookback\", 252),\n        (\"risk_aversion\", 1.0),  # lambda\n        (\"impact_coef\", 0.001),  # Theta\n        (\"min_weight\", 0.0),  # l_b\n        (\"max_weight\", 1.0),  # u_b\n    )\n\n    def __init__(self):\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def next(self):\n        if len(self.data) <= self.p.lookback:\n            return\n\n        if self.order:\n            return\n\n        returns = [\n            (self.data.close[-i] - self.data.close[-i - 1])\n            / self.data.close[-i - 1]\n            for i in range(self.p.lookback)\n        ]\n\n        r = statistics.mean(returns)\n        var = statistics.variance(returns) if len(returns) > 1 else 0.0\n\n        total_value = self.broker.getvalue()\n        price = self.data.close[0]\n\n        if total_value <= 0 or price <= 0:\n            return\n\n        current_size = self.position.size\n        w0 = (current_size * price) / total_value\n        w0 = max(self.p.min_weight, min(self.p.max_weight, w0))\n\n        best_w = w0\n        best_utility = -float(\"inf\")\n        steps = 1000\n        step_size = (self.p.max_weight - self.p.min_weight) / steps\n\n        for i in range(steps + 1):\n            w = self.p.min_weight + i * step_size\n            utility = (\n                r * w\n                - self.p.risk_aversion * var * (w**2)\n                - self.p.impact_coef * (abs(w - w0) ** 1.5)\n            )\n            if utility > best_utility:\n                best_utility = utility\n                best_w = w\n\n        target_value = best_w * total_value\n        target_size = int(target_value / price)\n        size_diff = target_size - current_size\n\n        if size_diff > 0:\n            self.order = self.buy(size=size_diff)\n        elif size_diff < 0:\n            self.order = self.sell(size=abs(size_diff))",
  "assumptions": [

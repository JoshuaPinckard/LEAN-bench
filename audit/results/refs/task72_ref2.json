  "code": "import backtrader as bt\n\n\nclass SwingBreakAndRetest(bt.Strategy):\n    params = (\n        (\"bb_period\", 20),\n        (\"bb_dev\", 2.0),\n        (\"vol_period\", 20),\n        (\"sma_market_period\", 200),\n        (\"atr_period\", 14),\n        (\"risk_pct\", 0.01),\n        (\"max_hold_bars\", 70),  # 10 trading days * 7 trading hours/day\n    )\n\n    def __init__(self):\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close,\n            period=self.p.bb_period,\n            devfactor=self.p.bb_dev,\n        )\n        self.vol_sma = bt.indicators.SMA(\n            self.data.volume, period=self.p.vol_period\n        )\n        self.sma_market = bt.indicators.SMA(\n            self.data.close, period=self.p.sma_market_period\n        )\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n\n        self.order = None\n        self.breakout_vol = None\n        self.stop_loss = None\n        self.has_retested = False\n        self.bars_held = 0\n        self.initial_entry_price = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if not self.position:\n                self.breakout_vol = None\n                self.stop_loss = None\n                self.has_retested = False\n                self.bars_held = 0\n                self.initial_entry_price = None\n            else:\n                if self.initial_entry_price is None:\n                    self.initial_entry_price = order.executed.price\n\n        self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if self.position:\n            self.bars_held += 1\n\n            # 1. Maximum Holding Period Check\n            if self.bars_held >= self.p.max_hold_bars:\n                self.order = self.close()\n                return\n\n            # 2. Position Exits & Retest Logic\n            if self.position.size > 0:  # Long Position\n                # Take Profit: price reaches middle Bollinger Band (SMA 20)\n                if (\n                    self.data.low[0] <= self.bb.mid[0]\n                    or self.data.close[0] <= self.bb.mid[0]\n                ):\n                    self.order = self.close()\n                    return\n\n                # Stop Loss\n                if self.stop_loss and self.data.low[0] <= self.stop_loss:\n                    self.order = self.close()\n                    return\n\n                # Trailing Stop: once in profit, move SL to break-even + 1 ATR\n                if (\n                    self.initial_entry_price\n                    and self.data.close[0] > self.initial_entry_price\n                ):\n                    new_sl = self.initial_entry_price + self.atr[0]\n                    if self.stop_loss is None or new_sl > self.stop_loss:\n                        self.stop_loss = new_sl\n\n                # Retest Entry (Long)\n                if not self.has_retested:\n                    touched_band = (\n                        self.data.low[0] <= self.bb.top[0]\n                        or self.data.close[0] <= self.bb.top[0]\n                    )\n                    lower_vol = (\n                        self.breakout_vol is not None\n                        and self.data.volume[0] < self.breakout_vol\n                    )\n                    if touched_band and lower_vol:\n                        risk_per_share = abs(\n                            self.data.close[0] - self.stop_loss\n                        )\n                        if risk_per_share > 0:\n                            capital = self.broker.getvalue()\n                            size = int(\n                                (capital * self.p.risk_pct) / risk_per_share\n                            )\n                            if size > 0:\n                                self.order = self.buy(size=size)\n                                self.has_retested = True\n\n            elif self.position.size < 0:  # Short Position\n                # Take Profit: price reaches middle Bollinger Band (SMA 20)\n                if (\n                    self.data.high[0] >= self.bb.mid[0]\n                    or self.data.close[0] >= self.bb.mid[0]\n                ):\n                    self.order = self.close()\n                    return\n\n                # Stop Loss\n                if self.stop_loss and self.data.high[0] >= self.stop_loss:\n                    self.order = self.close()\n                    return\n\n                # Trailing Stop: once in profit, move SL to break-even - 1 ATR\n                if (\n                    self.initial_entry_price\n                    and self.data.close[0] < self.initial_entry_price\n                ):\n                    new_sl = self.initial_entry_price - self.atr[0]\n                    if self.stop_loss is None or new_sl < self.stop_loss:\n                        self.stop_loss = new_sl\n\n                # Retest Entry (Short)\n                if not self.has_retested:\n                    touched_band = (\n                        self.data.high[0] >= self.bb.bot[0]\n                        or self.data.close[0] >= self.bb.bot[0]\n                    )\n                    lower_vol = (\n                        self.breakout_vol is not None\n                        and self.data.volume[0] < self.breakout_vol\n                    )\n                    if touched_band and lower_vol:\n                        risk_per_share = abs(\n                            self.stop_loss - self.data.close[0]\n                        )\n                        if risk_per_share > 0:\n                            capital = self.broker.getvalue()\n                            size = int(\n                                (capital * self.p.risk_pct) / risk_per_share\n                            )\n                            if size > 0:\n                                self.order = self.sell(size=size)\n                                self.has_retested = True\n\n        else:\n            # Position Flat: Initial Breakout Entry Search\n            vol_ok = self.data.volume[0] >= 1.20 * self.vol_sma[0]\n\n            # Long Breakout\n            if (\n                self.data.close[0] > self.bb.top[0]\n                and vol_ok\n                and self.data.close[0] > self.sma_market[0]\n            ):\n                sl = self.data.low[0]\n                risk_per_share = self.data.close[0] - sl\n                if risk_per_share > 0:\n                    capital = self.broker.getvalue()\n                    size = int((capital * self.p.risk_pct) / risk_per_share)\n                    if size > 0:\n                        self.order = self.buy(size=size)\n                        self.breakout_vol = self.data.volume[0]\n                        self.stop_loss = sl\n                        self.has_retested = False\n                        self.bars_held = 0\n\n            # Short Breakout\n            elif (\n                self.data.close[0] < self.bb.bot[0]\n                and vol_ok\n                and self.data.close[0] < self.sma_market[0]\n            ):\n                sl = self.data.high[0]\n                risk_per_share = sl - self.data.close[0]\n                if risk_per_share > 0:\n                    capital = self.broker.getvalue()\n                    size = int((capital * self.p.risk_pct) / risk_per_share)\n                    if size > 0:\n                        self.order = self.sell(size=size)\n                        self.breakout_vol = self.data.volume[0]\n                        self.stop_loss = sl\n                        self.has_retested = False\n                        self.bars_held = 0",
  "assumptions": [

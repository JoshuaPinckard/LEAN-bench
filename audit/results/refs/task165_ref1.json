  "code": "import backtrader as bt\n\n\nclass Fibo114XBBATRProxy(bt.Strategy):\n    params = (\n        (\"risk_fraction\", 0.01),\n    )\n\n    def __init__(self):\n        self.sma200 = bt.indicators.SMA(self.data.close, period=200)\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close, period=20, devfactor=2\n        )\n        self.ema9 = bt.indicators.EMA(self.data.close, period=9)\n        self.atr14 = bt.indicators.ATR(self.data, period=14)\n\n        self.long_cross = bt.indicators.CrossOver(self.data.close, self.ema9)\n        self.short_cross = bt.indicators.CrossOver(self.ema9, self.data.close)\n\n        self.order = None\n        self.long_armed = False\n        self.short_armed = False\n        self.long_stop = None\n        self.short_stop = None\n        self.long_peak = None\n        self.short_trough = None\n\n    def notify_order(self, order):\n        if order.status in (\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ):\n            self.order = None\n\n        if order.status == order.Completed:\n            if order.isbuy() and self.position.size > 0:\n                self.long_peak = order.executed.price\n            elif order.issell() and self.position.size < 0:\n                self.short_trough = order.executed.price\n\n    def next(self):\n        if self.order:\n            return\n\n        width = self.bb.top[0] - self.bb.bot[0]\n        atr = self.atr14[0]\n\n        long_signal = self.long_armed and self.long_cross[0] > 0\n        short_signal = self.short_armed and self.short_cross[0] > 0\n\n        if not self.position:\n            if long_signal and self.data.close[0] > self.sma200[0]:\n                stop = self.long_stop\n                distance = self.data.close[0] - stop\n                if distance > 0:\n                    size = (self.broker.getvalue() * self.p.risk_fraction) / distance\n                    self.order = self.buy(size=size)\n                    self.long_armed = False\n                    self.short_armed = False\n\n            elif short_signal and self.data.close[0] < self.sma200[0]:\n                stop = self.short_stop\n                distance = stop - self.data.close[0]\n                if distance > 0:\n                    size = (self.broker.getvalue() * self.p.risk_fraction) / distance\n                    self.order = self.sell(size=size)\n                    self.long_armed = False\n                    self.short_armed = False\n\n        elif self.position.size > 0:\n            self.long_peak = max(self.long_peak, self.data.high[0])\n            trailing_stop = self.long_peak - (atr * 1.5)\n            effective_stop = max(self.long_stop, trailing_stop)\n\n            if (\n                self.data.low[0] <= effective_stop\n                or self.data.high[0] >= self.bb.mid[0]\n                or short_signal\n            ):\n                self.order = self.close()\n\n        else:\n            self.short_trough = min(self.short_trough, self.data.low[0])\n            trailing_stop = self.short_trough + (atr * 1.5)\n            effective_stop = min(self.short_stop, trailing_stop)\n\n            if (\n                self.data.high[0] >= effective_stop\n                or self.data.low[0] <= self.bb.mid[0]\n                or long_signal\n            ):\n                self.order = self.close()\n\n        if (\n            self.data.close[0] < self.bb.bot[0]\n            and (self.bb.bot[0] - self.data.close[0]) >= 0.114 * width\n        ):\n            self.long_armed = True\n            self.long_stop = (self.bb.bot[0] - 0.114 * width) - (0.5 * atr)\n\n        if (\n            self.data.close[0] > self.bb.top[0]\n            and (self.data.close[0] - self.bb.top[0]) >= 0.114 * width\n        ):\n            self.short_armed = True\n            self.short_stop = (self.bb.top[0] + 0.114 * width) + (0.5 * atr)",

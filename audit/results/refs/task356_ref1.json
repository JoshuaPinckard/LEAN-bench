  "code": "import backtrader as bt\n\n\nclass BollingerEmaReversalStrategy(bt.Strategy):\n    def __init__(self):\n        self.bollinger = bt.indicators.BollingerBands(\n            self.data.close, period=20, devfactor=2\n        )\n        self.ema50 = bt.indicators.EMA(self.data.close, period=50)\n\n        self.cross_upper = bt.indicators.CrossOver(\n            self.data.close, self.bollinger.top\n        )\n        self.cross_lower = bt.indicators.CrossOver(\n            self.data.close, self.bollinger.bot\n        )\n        self.cross_ema = bt.indicators.CrossOver(self.data.close, self.ema50)\n\n        self.pending_orders = set()\n\n    def notify_order(self, order):\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.pending_orders.discard(order.ref)\n\n    def _track(self, order):\n        self.pending_orders.add(order.ref)\n\n    def next(self):\n        if self.pending_orders:\n            return\n\n        long_entry = self.cross_upper[0] > 0 and self.data.close[0] > self.ema50[0]\n        short_entry = self.cross_lower[0] < 0 and self.data.close[0] < self.ema50[0]\n        long_exit = self.cross_ema[0] < 0\n        short_exit = self.cross_ema[0] > 0\n\n        if self.position.size > 0:\n            if short_entry:\n                self._track(self.close())\n                self._track(self.sell())\n            elif long_exit:\n                self._track(self.close())\n\n        elif self.position.size < 0:\n            if long_entry:\n                self._track(self.close())\n                self._track(self.buy())\n            elif short_exit:\n                self._track(self.close())\n\n        elif long_entry:\n            self._track(self.buy())\n\n        elif short_entry:\n            self._track(self.sell())",
  "assumptions": [

  "code": "import backtrader as bt\n\n\nclass HmaBbwAtrTrendStrategy(bt.Strategy):\n    params = dict(\n        hma_period=9,\n        bb_period=20,\n        bb_devfactor=2.0,\n        bbwidth_sma_period=50,\n        atr_period=14,\n        contraction_factor=0.8,\n        stop_atr_mult=2.0,\n    )\n\n    def __init__(self):\n        self.hma = bt.indicators.HullMovingAverage(\n            self.data.close, period=self.p.hma_period\n        )\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close, period=self.p.bb_period, devfactor=self.p.bb_devfactor\n        )\n        self.bbwidth = (self.bb.top - self.bb.bot) / self.bb.mid\n        self.bbwidth_sma = bt.indicators.SMA(\n            self.bbwidth, period=self.p.bbwidth_sma_period\n        )\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.crossover = bt.indicators.CrossOver(self.data.close, self.hma)\n\n        self.order = None\n        self.stop_price = None\n        self.entering_long = False\n        self.entering_short = False\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            if self.entering_long:\n                self.stop_price = order.executed.price - self.atr[0] * self.p.stop_atr_mult\n            elif self.entering_short:\n                self.stop_price = order.executed.price + self.atr[0] * self.p.stop_atr_mult\n\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n            self.entering_long = False\n            self.entering_short = False\n\n    def next(self):\n        if self.order:\n            return\n\n        contraction = self.bbwidth[0] < self.bbwidth_sma[0] * self.p.contraction_factor\n        long_signal = self.crossover[0] > 0 and self.hma[0] > self.hma[-1] and contraction\n        short_signal = self.crossover[0] < 0 and self.hma[0] < self.hma[-1] and contraction\n\n        if self.position:\n            if self.position.size > 0:\n                if self.data.close[0] <= self.stop_price or short_signal:\n                    self.order = self.close()\n            elif self.position.size < 0:\n                if self.data.close[0] >= self.stop_price or long_signal:\n                    self.order = self.close()\n        else:\n            if long_signal:\n                self.order = self.buy()\n                self.entering_long = True\n            elif short_signal:\n                self.order = self.sell()\n                self.entering_short = True",
  "assumptions": [

  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass BreakoutStrategy(bt.Strategy):\n    params = dict(\n        period=20,\n        stop_pct=0.02,\n    )\n\n    def __init__(self):\n        self.highest_high = bt.indicators.Highest(self.data.high(-1), period=self.p.period)\n        self.lowest_low = bt.indicators.Lowest(self.data.low(-1), period=self.p.period)\n        self.sma = bt.indicators.SimpleMovingAverage(self.data.close, period=self.p.period)\n        self.order = None\n        self.entry_price = None\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            if self.position:\n                self.entry_price = order.executed.price\n            else:\n                self.entry_price = None\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        close = self.data.close[0]\n        long_signal = close > self.highest_high[0] and close > self.sma[0]\n        short_signal = close < self.lowest_low[0] and close < self.sma[0]\n\n        if not self.position:\n            if long_signal:\n                self.order = self.buy()\n            elif short_signal:\n                self.order = self.sell()\n            return\n\n        if self.position.size > 0:\n            stop_hit = close <= self.entry_price * (1 - self.p.stop_pct)\n            if short_signal or stop_hit:\n                self.order = self.close()\n        elif self.position.size < 0:\n            stop_hit = close >= self.entry_price * (1 + self.p.stop_pct)\n            if long_signal or stop_hit:\n                self.order = self.close()",
  "assumptions": [
    {
      "topic": "breakout_window",
      "choice": "The 20-day high/low breakout levels are computed over the prior 20 bars, excluding the current bar (via Highest/Lowest applied to data.high(-1)/data.low(-1)), so today's close is compared to the highest/lowest of the preceding 20 days.",
      "reason": "Spec says price 'breaks' the 20-day high/low of the past 20 days; including today's own bar in its own high/low window would make a breakout tautologically impossible on the extreme day, so the standard Donchian-style reading excludes the current bar."
    },
    {
      "topic": "sma_window",
      "choice": "The 20-day SMA is computed on Close including the current bar (standard SimpleMovingAverage(period=20), no shift).",
      "reason": "Spec states the SMA filter as a plain 20-day simple moving average, not a lagged 'past N days' window like the breakout levels, so the standard inclusive-of-today SMA definition applies."
    },
    {
      "topic": "stop_loss_evaluation",
      "choice": "The 2% stop-loss is checked each bar in next() against the daily closing price (entry_price * 0.98 for longs, entry_price * 1.02 for shorts), rather than submitted as a broker-native stop order checked against intrabar High/Low.",
      "reason": "The spec's breakout conditions are all defined on closing price, so evaluating the stop consistently on Close avoids introducing an unstated intrabar mechanism and the extra order-management (OCO/bracket) complexity that a resting stop order would require alongside the signal-based exit."
    },
    {
      "topic": "opposite_signal_handling",
      "choice": "An opposite breakout signal while in a position triggers self.close() to exit only; it does not immediately reverse into the opposite-direction position within the same bar. A new entry in the opposite direction occurs on a later bar once flat, if the entry condition still holds.",
      "reason": "The spec separately lists exit conditions ('opposite breakout signal or stop loss') from entry conditions, and the canonical default prohibits pyramiding/re-entry while a position is open; treating the opposite signal as an exit (not an instant flip) keeps entries and exits as distinct, order-tracked actions."
    }
  ],

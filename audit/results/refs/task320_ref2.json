  "code": "import datetime\nimport backtrader as bt\n\n\nclass DoubleTopStrategy(bt.Strategy):\n    def __init__(self):\n        self.order = None\n        self.stop_price = None\n        self.peaks = []  # List of tuples: (bar_index, high_value)\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n            if not self.position:\n                self.stop_price = None\n\n    def next(self):\n        if len(self) < 5:\n            return\n\n        is_last_bar = (\n            self.data.datetime.time(0) >= datetime.time(15, 45)\n        ) or (len(self) == self.data.buflen())\n\n        # Position management\n        if self.position:\n            # Stop-loss check\n            if (\n                self.stop_price is not None\n                and self.data.high[0] >= self.stop_price\n            ):\n                if not self.order:\n                    self.order = self.close()\n                return\n\n            # Intraday end-of-day exit check\n            if is_last_bar:\n                if not self.order:\n                    self.order = self.close()\n                return\n\n        # Peak detection for bar at index -2 (N=2 window: -4, -3 vs -2 vs -1, 0)\n        h_i = self.data.high[-2]\n        if (\n            h_i > self.data.high[-3]\n            and h_i > self.data.high[-4]\n            and h_i >= self.data.high[-1]\n            and h_i >= self.data.high[0]\n        ):\n\n            p_idx = len(self) - 3\n            p_high = h_i\n            self.peaks.append((p_idx, p_high))\n\n            # Double Top pattern evaluation\n            if len(self.peaks) >= 2:\n                p1_idx, p1_high = self.peaks[-2]\n                p2_idx, p2_high = self.peaks[-1]\n\n                bars_between = p2_idx - p1_idx\n                diff_pct = abs(p2_high - p1_high) / max(p1_high, p2_high)\n                is_bearish = self.data.close[-1] < self.data.open[-1]\n\n                if (\n                    bars_between >= 5\n                    and diff_pct <= 0.02\n                    and is_bearish\n                    and not self.position\n                    and not self.order\n                    and not is_last_bar\n                ):\n                    higher_high = max(p1_high, p2_high)\n                    self.stop_price = higher_high * 1.01\n                    self.order = self.sell()",

  "code": "import backtrader as bt\n\n\nclass WilliamsRMomentumATRStrategy(bt.Strategy):\n    params = (\n        (\"atr_mult\", 2.0),\n        (\"update_stop\", False),\n    )\n\n    def __init__(self):\n        self.williams_r = bt.indicators.WilliamsR(self.data, period=14)\n        self.momentum = bt.indicators.Momentum(self.data, period=14)\n        self.atr = bt.indicators.ATR(self.data, period=14)\n\n        self.order = None\n        self.stop_order = None\n        self.entry_price = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order == self.stop_order:\n            if order.status == order.Completed:\n                self.stop_order = None\n                self.entry_price = None\n            elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n                self.stop_order = None\n\n        if order == self.order:\n            if order.status == order.Completed:\n                if order.isbuy() and self.position.size > 0:\n                    self.entry_price = order.executed.price\n                    self.stop_order = self.sell(\n                        exectype=bt.Order.Stop,\n                        price=self.entry_price - self.p.atr_mult * self.atr[0],\n                    )\n                elif order.issell() and self.position.size < 0:\n                    self.entry_price = order.executed.price\n                    self.stop_order = self.buy(\n                        exectype=bt.Order.Stop,\n                        price=self.entry_price + self.p.atr_mult * self.atr[0],\n                    )\n                elif self.position.size == 0:\n                    self.entry_price = None\n\n            if order.status in [\n                order.Completed,\n                order.Canceled,\n                order.Margin,\n                order.Rejected,\n            ]:\n                self.order = None\n\n    def next(self):\n        long_signal = (\n            self.williams_r[-1] <= -80\n            and self.williams_r[0] > -80\n            and self.momentum[0] > 0\n        )\n        short_signal = (\n            self.williams_r[-1] >= -20\n            and self.williams_r[0] < -20\n            and self.momentum[0] < 0\n        )\n\n        if self.position.size > 0 and self.p.update_stop and self.stop_order is None:\n            self.stop_order = self.sell(\n                exectype=bt.Order.Stop,\n                price=self.entry_price - self.p.atr_mult * self.atr[0],\n            )\n        elif self.position.size < 0 and self.p.update_stop and self.stop_order is None:\n            self.stop_order = self.buy(\n                exectype=bt.Order.Stop,\n                price=self.entry_price + self.p.atr_mult * self.atr[0],\n            )\n\n        if self.order:\n            return\n\n        if self.position.size > 0:\n            if long_signal is False and short_signal:\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                self.order = self.close()\n            return\n\n        if self.position.size < 0:\n            if short_signal is False and long_signal:\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                self.order = self.close()\n            return\n\n        if long_signal:\n            self.order = self.buy()\n        elif short_signal:\n            self.order = self.sell()",

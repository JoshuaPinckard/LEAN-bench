  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass BBVolatilityZScoreStrategy(bt.Strategy):\n    def __init__(self):\n        # Indicators\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close, period=20, devfactor=2.0\n        )\n        self.bandwidth = (self.bb.top - self.bb.bot) / self.bb.mid\n        self.bw_sma = bt.indicators.SMA(self.bandwidth, period=20)\n        self.bw_std = bt.indicators.StdDev(self.bandwidth, period=20)\n        self.bw_z = (self.bandwidth - self.bw_sma) / self.bw_std\n        self.atr = bt.indicators.ATR(self.data, period=14)\n\n        # Order guards\n        self.order = None\n        self.stop_order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order == self.order:\n                self.order = None\n                if self.position:\n                    entry_price = order.executed.price\n                    atr_val = self.atr[0]\n                    if self.position.size > 0:\n                        stop_price = entry_price - 2.0 * atr_val\n                        self.stop_order = self.sell(\n                            exectype=bt.Order.Stop, price=stop_price\n                        )\n                    elif self.position.size < 0:\n                        stop_price = entry_price + 2.0 * atr_val\n                        self.stop_order = self.buy(\n                            exectype=bt.Order.Stop, price=stop_price\n                        )\n                else:\n                    if self.stop_order:\n                        self.cancel(self.stop_order)\n                        self.stop_order = None\n\n            elif order == self.stop_order:\n                self.stop_order = None\n                if self.order:\n                    self.cancel(self.order)\n                    self.order = None\n\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order == self.order:\n                self.order = None\n            if order == self.stop_order:\n                self.stop_order = None\n\n    def next(self):\n        if self.order is not None:\n            return\n\n        if self.position:\n            cross_zero = (self.bw_z[-1] > 0 and self.bw_z[0] <= 0) or (\n                self.bw_z[-1] < 0 and self.bw_z[0] >= 0\n            )\n            abs_small = abs(self.bw_z[0]) < 0.5\n\n            if cross_zero or abs_small:\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                    self.stop_order = None\n                self.order = self.close()\n        else:\n            long_cond = (\n                self.bw_z[-1] > 2.0\n                and self.bw_z[0] <= 2.0\n                and self.bandwidth[0] < self.bandwidth[-1]\n            )\n            short_cond = (\n                self.bw_z[-1] < -2.0\n                and self.bw_z[0] >= -2.0\n                and self.bandwidth[0] > self.bandwidth[-1]\n            )\n\n            if long_cond:\n                self.order = self.buy()\n            elif short_cond:\n                self.order = self.sell()",
  "assumptions": [
    {
      "topic": "stop_loss_execution",
      "choice": "Submitted as a bt.Order.Stop order upon entry execution in notify_order, calculated using executed entry price and current ATR(14).",
      "reason": "The specification defines ATR stop distance relative to entry price. Submitting a Stop order when the entry completes ensures execution at intraday stop price levels within Backtrader's broker model."
    },
    {
      "topic": "zero_crossing_definition",
      "choice": "Evaluated as (BW_Z[-1] > 0 and BW_Z[0] <= 0) or (BW_Z[-1] < 0 and BW_Z[0] >= 0).",
      "reason": "Accurately captures any bar-to-bar transition of BW_Z across the zero line."
    }
  ],

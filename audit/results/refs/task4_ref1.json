  "code": "import backtrader as bt\n\n\nclass AbsoluteMomentumStrategy(bt.Strategy):\n    def __init__(self):\n        self.momentum = bt.indicators.MomentumOscillator(\n            self.data.close,\n            period=252,\n        )\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position and self.momentum[0] > 100:\n            size = (self.broker.getcash() * 0.95) / self.data.close[0]\n            self.order = self.buy(size=size)\n\n        elif self.position and self.momentum[0] < 100:\n            self.order = self.close()",

  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass BollingerBandwidthReversalStrategy(bt.Strategy):\n    def __init__(self):\n        self.bb = bt.indicators.BollingerBands(self.data.close, period=20, devfactor=2)\n        self.bandwidth = (self.bb.top - self.bb.bot) / self.bb.mid\n        self.bw_sma = bt.indicators.SMA(self.bandwidth, period=20)\n        self.bw_std = bt.indicators.StandardDeviation(self.bandwidth, period=20)\n        self.bwz = (self.bandwidth - self.bw_sma) / self.bw_std\n        self.atr = bt.indicators.ATR(self.data, period=14)\n\n        self.order = None\n        self.order_intent = None\n        self.stop_price = None\n        self.pending_atr = None\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            if self.order_intent == 'entry':\n                entry_price = order.executed.price\n                if order.isbuy():\n                    self.stop_price = entry_price - 2 * self.pending_atr\n                else:\n                    self.stop_price = entry_price + 2 * self.pending_atr\n            self.order = None\n            self.order_intent = None\n        elif order.status in (order.Canceled, order.Margin, order.Rejected):\n            self.order = None\n            self.order_intent = None\n\n    def next(self):\n        if self.order:\n            return\n\n        bwz0 = self.bwz[0]\n        bwz1 = self.bwz[-1]\n        bw0 = self.bandwidth[0]\n        bw1 = self.bandwidth[-1]\n\n        if self.position:\n            cross_zero = (bwz1 > 0 and bwz0 <= 0) or (bwz1 < 0 and bwz0 >= 0)\n            mean_revert = abs(bwz0) < 0.5\n\n            stop_hit = False\n            if self.position.size > 0 and self.data.close[0] <= self.stop_price:\n                stop_hit = True\n            elif self.position.size < 0 and self.data.close[0] >= self.stop_price:\n                stop_hit = True\n\n            if cross_zero or mean_revert or stop_hit:\n                self.order = self.close()\n                self.order_intent = 'exit'\n            return\n\n        if bwz1 > 2 and bwz0 <= 2 and bw0 < bw1:\n            self.pending_atr = self.atr[0]\n            self.order = self.buy()\n            self.order_intent = 'entry'\n        elif bwz1 < -2 and bwz0 >= -2 and bw0 > bw1:\n            self.pending_atr = self.atr[0]\n            self.order = self.sell()\n            self.order_intent = 'entry'",
  "assumptions": [
    {
      "topic": "stop distance ATR sample time",
      "choice": "ATR value used to compute the 2*ATR stop distance is sampled on the bar the entry signal fires (self.atr[0] at order submission); the stop price is then computed from the order's actual executed fill price in notify_order.",
      "reason": "Spec states stop distance is '2*ATR from entry price' but does not specify whether ATR should be re-sampled at fill time or whether entry price means the signal-bar close vs. the actual executed price; using the last available ATR at decision time and the true fill price is the most literal reading of 'entry price'."
    },
    {
      "topic": "stop-loss trigger price",
      "choice": "Stop-loss breach is evaluated against the bar's close price (self.data.close[0]) rather than intrabar high/low.",
      "reason": "Spec gives no guidance on which price to compare against the stop level, and all other entry/exit conditions in the spec are defined purely on close-derived indicators, so close is the consistent choice."
    },
    {
      "topic": "order/position bookkeeping",
      "choice": "Added an internal order_intent flag (entry vs exit) alongside the order-tracking guard to correctly compute the stop price only on entry fills.",
      "reason": "Not stated in the spec, but required to distinguish entry-order completions from exit-order completions in notify_order without adding any extra trading logic or filters."

  "code": "import backtrader as bt\n\n\nclass MeanReversionStrategy(bt.Strategy):\n    params = (\n        (\"hma_period\", 9),\n        (\"band_period\", 20),\n        (\"atr_period\", 14),\n    )\n\n    def __init__(self):\n        self.hma = bt.indicators.HullMovingAverage(\n            self.data.close, period=self.p.hma_period\n        )\n        self.sma_hma = bt.indicators.SimpleMovingAverage(\n            self.hma, period=self.p.band_period\n        )\n        self.std_hma = bt.indicators.StdDev(\n            self.hma, period=self.p.band_period\n        )\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n\n        self.upper_band = self.sma_hma + 2.0 * self.std_hma\n        self.lower_band = self.sma_hma - 2.0 * self.std_hma\n\n        self.order = None\n        self.stop_order = None\n        self.pending_exit = False\n\n    def notify_order(self, order):\n        if order.status in (order.Completed, order.Canceled,\n                            order.Margin, order.Rejected):\n            if order == self.order:\n                self.order = None\n\n            if order == self.stop_order:\n                self.stop_order = None\n\n            if order.status == order.Completed and order.isbuy() and order == self.order:\n                pass\n\n        if order.status == order.Completed:\n            if order == self.order:\n                if order.isbuy():\n                    self.stop_order = self.sell(\n                        exectype=bt.Order.Stop,\n                        price=order.executed.price - 2.0 * self.atr[0],\n                    )\n                else:\n                    self.stop_order = self.buy(\n                        exectype=bt.Order.Stop,\n                        price=order.executed.price + 2.0 * self.atr[0],\n                    )\n\n            if self.pending_exit and order == self.stop_order:\n                self.pending_exit = False\n                if self.position:\n                    self.order = self.close()\n\n        if (order.status in (order.Canceled, order.Margin, order.Rejected)\n                and self.pending_exit and order == self.stop_order):\n            self.pending_exit = False\n            if self.position:\n                self.order = self.close()\n\n    def next(self):\n        if self.order or self.pending_exit:\n            return\n\n        if not self.position:\n            if self.hma[-1] < self.lower_band[-1] and self.hma[0] > self.lower_band[0]:\n                self.order = self.buy()\n            elif self.hma[-1] > self.upper_band[-1] and self.hma[0] < self.upper_band[0]:\n                self.order = self.sell()\n            return\n\n        if self.position.size > 0:\n            if self.hma[-1] <= self.sma_hma[-1] and self.hma[0] > self.sma_hma[0]:\n                if self.stop_order:\n                    self.pending_exit = True\n                    self.cancel(self.stop_order)\n                else:\n                    self.order = self.close()\n\n        elif self.position.size < 0:\n            if self.hma[-1] >= self.sma_hma[-1] and self.hma[0] < self.sma_hma[0]:\n                if self.stop_order:\n                    self.pending_exit = True\n                    self.cancel(self.stop_order)\n                else:\n                    self.order = self.close()",
  "assumptions": [
    {
      "topic": "stop-loss ATR value",
      "choice": "ATR is read on the bar where the market entry order completes, and the stop price is fixed thereafter.",
      "reason": "The specification requires a fixed stop at entry but does not specify intrabar or order-submission timing for ATR."
    },
    {
      "topic": "mean-cross equality",
      "choice": "A cross above uses prior HMA less than or equal to prior SMA_HMA and current HMA greater than current SMA_HMA; a cross below uses the inverse.",
      "reason": "This is the conventional discrete-bar interpretation of crossing."
    },
    {
      "topic": "protective stop cancellation",
      "choice": "The protective stop is canceled before submitting a mean-reversion close order.",
      "reason": "Prevents an uncanceled stop from executing after the position has been closed and creating an unintended reversal."
    }
  ],

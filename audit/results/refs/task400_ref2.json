  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass AdaptiveChannelStrategy(bt.Strategy):\n    params = (\n        ('lookback', 10),\n        ('stop_mult', 2.0),\n        ('fast_ema', 2),\n        ('slow_ema', 30),\n        ('atr_period', 14),\n    )\n\n    def __init__(self):\n        self.fast_ema = bt.indicators.EMA(self.data.close, period=self.p.fast_ema)\n        self.slow_ema = bt.indicators.EMA(self.data.close, period=self.p.slow_ema)\n\n        highest = bt.indicators.Highest(self.data.high, period=self.p.lookback)\n        lowest = bt.indicators.Lowest(self.data.low, period=self.p.lookback)\n        self.upper_band = highest(-1)\n        self.lower_band = lowest(-1)\n\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n\n        self.order = None\n        self.stop_order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order == self.stop_order:\n            if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n                self.stop_order = None\n\n        if order == self.order:\n            if order.status == order.Completed:\n                if self.position.size > 0 and not self.stop_order:\n                    stop_price = order.executed.price - self.p.stop_mult * self.atr[0]\n                    self.stop_order = self.sell(exectype=bt.Order.Stop, price=stop_price)\n                elif self.position.size < 0 and not self.stop_order:\n                    stop_price = order.executed.price + self.p.stop_mult * self.atr[0]\n                    self.stop_order = self.buy(exectype=bt.Order.Stop, price=stop_price)\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        long_cond = (self.data.close[0] > self.upper_band[0]) and (self.fast_ema[0] > self.slow_ema[0])\n        short_cond = (self.data.close[0] < self.lower_band[0]) and (self.fast_ema[0] < self.slow_ema[0])\n\n        if self.position.size > 0:\n            if short_cond:\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                self.order = self.close()\n        elif self.position.size < 0:\n            if long_cond:\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                self.order = self.close()\n        else:\n            if long_cond:\n                self.order = self.buy()\n            elif short_cond:\n                self.order = self.sell()",
  "assumptions": [
    {
      "topic": "channel_lookback_lag",
      "choice": "Lag channel highest/lowest by 1 bar",
      "reason": "Including current bar high/low would prevent close from ever exceeding the upper band or falling below the lower band."

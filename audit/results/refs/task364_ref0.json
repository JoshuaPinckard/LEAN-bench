  "code": "import backtrader as bt\n\n\nclass BBStochMeanReversion(bt.Strategy):\n    params = dict(\n        bb_period=20,\n        bb_devfactor=2.0,\n        stoch_period=14,\n        stoch_period_dfast=3,\n        stoch_period_dslow=3,\n        oversold=20,\n        overbought=80,\n        stop_loss_pct=0.02,\n    )\n\n    def __init__(self):\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close,\n            period=self.p.bb_period,\n            devfactor=self.p.bb_devfactor,\n        )\n        self.stoch = bt.indicators.Stochastic(\n            self.data,\n            period=self.p.stoch_period,\n            period_dfast=self.p.stoch_period_dfast,\n            period_dslow=self.p.stoch_period_dslow,\n        )\n        self.order = None\n        self.entry_price = None\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            if self.position.size == 0:\n                self.entry_price = None\n            else:\n                self.entry_price = order.executed.price\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        price = self.data.close[0]\n        stoch_k = self.stoch.percK[0]\n\n        long_signal = price <= self.bb.bot[0] and stoch_k < self.p.oversold\n        short_signal = price >= self.bb.top[0] and stoch_k > self.p.overbought\n\n        if not self.position:\n            if long_signal:\n                self.order = self.buy()\n            elif short_signal:\n                self.order = self.sell()\n            return\n\n        if self.position.size > 0:\n            stop_price = self.entry_price * (1 - self.p.stop_loss_pct)\n            if short_signal or price <= stop_price:\n                self.order = self.close()\n        elif self.position.size < 0:\n            stop_price = self.entry_price * (1 + self.p.stop_loss_pct)\n            if long_signal or price >= stop_price:\n                self.order = self.close()",

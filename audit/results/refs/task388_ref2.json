  "code": "import backtrader as bt\n\n\nclass WilliamsRMomentumATR(bt.Strategy):\n    params = (\n        (\"williams_period\", 14),\n        (\"momentum_period\", 14),\n        (\"atr_period\", 14),\n        (\"atr_mult\", 2.0),\n        (\"trailing_stop\", False),\n    )\n\n    def __init__(self):\n        self.willr = bt.indicators.WilliamsR(\n            self.data, period=self.p.williams_period\n        )\n        self.mom = bt.indicators.Momentum(\n            self.data.close, period=self.p.momentum_period\n        )\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n\n        self.order = None\n        self.entry_price = None\n        self.entry_atr = None\n        self.stop_price = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order.isbuy():\n                if self.position.size > 0:\n                    self.entry_price = order.executed.price\n                    self.entry_atr = self.atr[0]\n            elif order.issell():\n                if self.position.size < 0:\n                    self.entry_price = order.executed.price\n                    self.entry_atr = self.atr[0]\n\n            if not self.position:\n                self.entry_price = None\n                self.entry_atr = None\n                self.stop_price = None\n\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            pass\n\n        self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        long_signal = (\n            self.willr[-1] <= -80.0 and self.willr[0] > -80.0\n        ) and (self.mom[0] > 0)\n        short_signal = (\n            self.willr[-1] >= -20.0 and self.willr[0] < -20.0\n        ) and (self.mom[0] < 0)\n\n        if self.position.size > 0:\n            if self.p.trailing_stop:\n                current_stop = (\n                    self.data.close[0] - self.p.atr_mult * self.atr[0]\n                )\n                if self.stop_price is None:\n                    self.stop_price = current_stop\n                else:\n                    self.stop_price = max(self.stop_price, current_stop)\n            else:\n                if self.entry_price is not None and self.entry_atr is not None:\n                    self.stop_price = (\n                        self.entry_price - self.p.atr_mult * self.entry_atr\n                    )\n                else:\n                    self.stop_price = (\n                        self.data.close[0] - self.p.atr_mult * self.atr[0]\n                    )\n\n            if self.data.low[0] <= self.stop_price:\n                self.order = self.close()\n                self.stop_price = None\n            elif short_signal:\n                self.order = self.close()\n                self.stop_price = None\n\n        elif self.position.size < 0:\n            if self.p.trailing_stop:\n                current_stop = (\n                    self.data.close[0] + self.p.atr_mult * self.atr[0]\n                )\n                if self.stop_price is None:\n                    self.stop_price = current_stop\n                else:\n                    self.stop_price = min(self.stop_price, current_stop)\n            else:\n                if self.entry_price is not None and self.entry_atr is not None:\n                    self.stop_price = (\n                        self.entry_price + self.p.atr_mult * self.entry_atr\n                    )\n                else:\n                    self.stop_price = (\n                        self.data.close[0] + self.p.atr_mult * self.atr[0]\n                    )\n\n            if self.data.high[0] >= self.stop_price:\n                self.order = self.close()\n                self.stop_price = None\n            elif long_signal:\n                self.order = self.close()\n                self.stop_price = None\n\n        else:\n            self.stop_price = None\n            if long_signal:\n                self.order = self.buy()\n            elif short_signal:\n                self.order = self.sell()",

  "model": "sonnet",
  "code": "import backtrader as bt\n\n\nclass WilliamsRMomentumStrategy(bt.Strategy):\n    params = (\n        ('wr_period', 14),\n        ('mom_period', 14),\n        ('atr_period', 14),\n        ('atr_mult', 2.0),\n        ('trailing_stop', False),\n    )\n\n    def __init__(self):\n        self.wr = bt.indicators.WilliamsR(period=self.p.wr_period)\n        self.mom = bt.indicators.Momentum(period=self.p.mom_period)\n        self.atr = bt.indicators.ATR(period=self.p.atr_period)\n        self.order = None\n        self.stop_price = None\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        wr_prev = self.wr[-1]\n        wr_curr = self.wr[0]\n        mom_curr = self.mom[0]\n\n        long_signal = (wr_prev <= -80.0) and (wr_curr > -80.0) and (mom_curr > 0.0)\n        short_signal = (wr_prev >= -20.0) and (wr_curr < -20.0) and (mom_curr < 0.0)\n\n        if self.position.size > 0:\n            if self.stop_price is None:\n                self.stop_price = self.position.price - self.p.atr_mult * self.atr[0]\n            if self.p.trailing_stop:\n                candidate = self.data.close[0] - self.p.atr_mult * self.atr[0]\n                self.stop_price = max(self.stop_price, candidate)\n            if self.data.low[0] <= self.stop_price or short_signal:\n                self.order = self.close()\n                self.stop_price = None\n                return\n\n        elif self.position.size < 0:\n            if self.stop_price is None:\n                self.stop_price = self.position.price + self.p.atr_mult * self.atr[0]\n            if self.p.trailing_stop:\n                candidate = self.data.close[0] + self.p.atr_mult * self.atr[0]\n                self.stop_price = min(self.stop_price, candidate)\n            if self.data.high[0] >= self.stop_price or long_signal:\n                self.order = self.close()\n                self.stop_price = None\n                return\n\n        else:\n            self.stop_price = None\n            if long_signal:\n                self.order = self.buy()\n            elif short_signal:\n                self.order = self.sell()",
  "assumptions": [
    {
      "topic": "atr_mult default value",
      "choice": "2.0",
      "reason": "Spec describes atr_mult as an adjustable multiple but states no default. 2.0 is the widely-used conventional default for ATR-based protective stops."
    },
    {
      "topic": "trailing_stop parameter default",
      "choice": "False (static from entry)",
      "reason": "Spec explicitly states 'static from entry (default)' with trailing as an optional behaviour enabled via a parameter named trailing_stop."
    },
    {
      "topic": "stop trigger price within bar",
      "choice": "Long stop fires when bar low <= stop_price; short stop fires when bar high >= stop_price",
      "reason": "Spec does not specify which OHLC price to compare against the stop level. Using the bar's extreme (low/high) is the standard intrabar stop-trigger convention and reflects the most conservative assumption about intrabar movement."
    },
    {
      "topic": "stop initialisation timing",
      "choice": "stop_price is computed on the first next() call while in-position using self.position.price (actual fill price) and the ATR value of that same bar",
      "reason": "Spec states 'stop = entry_price - atr_mult * ATR'. In backtrader, orders fill at the open of the bar following the signal bar. The first next() call while position.size != 0 provides the actual execution price via self.position.price and the concurrent ATR value, giving the earliest accurate simultaneous read of both quantities."
    },
    {
      "topic": "Momentum indicator sign convention",
      "choice": "bt.indicators.Momentum computes close[0] - close[-period], a signed difference that can be positive or negative",
      "reason": "The spec conditions 'Momentum > 0' and 'Momentum < 0' require a signed indicator. bt.indicators.Momentum is the difference-based version, consistent with both conditions being meaningful."
    },
    {
      "topic": "trailing stop ratchet direction",
      "choice": "Long: stop only moves upward (max of old and new); short: stop only moves downward (min of old and new)",
      "reason": "A protective trailing stop must only tighten (move in favour of the trade), never widen. The spec does not override this standard definition of a trailing stop."
    },
    {
      "topic": "same-bar re-entry after stop or signal exit",
      "choice": "No re-entry on the bar that closes the position; early return is taken after self.close()",
      "reason": "Canonical default: no re-entry while a position is open. The close order pends until the next bar's open, so the position is still technically open for the remainder of the current bar's processing."
    },
    {
      "topic": "position sizing",
      "choice": "Plain self.buy() / self.sell() with no size argument",
      "reason": "Spec does not state a position size. Canonical default applies: default sizer, no explicit size argument."
    }
  ],

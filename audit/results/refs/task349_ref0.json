  "task_id": 349,
  "ref_idx": 0,
  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass DonchianVolumeBreakoutStrategy(bt.Strategy):\n    params = (\n        ('period', 20),\n        ('vol_sma_period', 20),\n        ('stop_percent', 0.02),\n    )\n\n    def __init__(self):\n        self.donchian_high = bt.indicators.Highest(self.data.high(-1), period=self.p.period)\n        self.donchian_low = bt.indicators.Lowest(self.data.low(-1), period=self.p.period)\n        self.vol_sma = bt.indicators.SMA(self.data.volume, period=self.p.vol_sma_period)\n\n        self.cross_up = bt.indicators.CrossOver(self.data.close, self.donchian_high)\n        self.cross_down = bt.indicators.CrossOver(self.data.close, self.donchian_low)\n\n        self.order = None\n        self.stop_order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order == self.stop_order:\n            self.stop_order = None\n\n        if order == self.order:\n            self.order = None\n            if order.status != order.Completed and self.stop_order is not None:\n                self.cancel(self.stop_order)\n                self.stop_order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        vol_confirmed = (self.data.volume[0] > self.data.volume[-1]\n                          and self.data.volume[0] > self.vol_sma[0])\n\n        if not self.position:\n            if self.cross_up[0] > 0 and vol_confirmed:\n                entry = self.buy()\n                self.order = entry\n                stop_price = self.donchian_high[0] * (1 - self.p.stop_percent)\n                self.stop_order = self.sell(exectype=bt.Order.Stop, price=stop_price, size=abs(entry.size))\n            elif self.cross_down[0] < 0 and vol_confirmed:\n                entry = self.sell()\n                self.order = entry\n                stop_price = self.donchian_low[0] * (1 + self.p.stop_percent)\n                self.stop_order = self.buy(exectype=bt.Order.Stop, price=stop_price, size=abs(entry.size))\n        elif self.position.size > 0:\n            if self.data.close[0] < self.donchian_high[0] or self.data.volume[0] < self.vol_sma[0]:\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                    self.stop_order = None\n                self.order = self.close()\n        elif self.position.size < 0:\n            if self.data.close[0] > self.donchian_low[0] or self.data.volume[0] < self.vol_sma[0]:\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                    self.stop_order = None\n                self.order = self.close()",
  "assumptions": [
    {
      "topic": "donchian_calculation",
      "choice": "Donchian upper/lower band at bar t is computed from the highest high / lowest low of the period bars strictly PRIOR to t (data.high(-1)/data.low(-1) fed into Highest/Lowest), excluding the current bar.",
      "reason": "The spec is silent on whether the current bar contributes to the band. Including the current bar makes 'close crosses above upper band' nearly unsatisfiable, since High>=Close on the same bar means the band would rise to meet or exceed the close on any bar that sets a new period high, exactly the bars where a genuine breakout is expected. Excluding the current bar (the standard Turtle/Donchian breakout convention) is the only reading that lets the crossover trigger as intended by the spec."
    },
    {
      "topic": "stop_loss_mechanism",
      "choice": "Stop-loss is placed as an actual bt.Order.Stop order at entry time (size matched to the entry order's assigned size via abs(entry.size)), submitted alongside the entry order and canceled if the entry fails or if a rule-based exit fires first.",
      "reason": "The spec says to 'place a stop-loss on entry', which literally describes submitting a stop order rather than a per-bar manual price check; using a real Stop order also lets the broker trigger it intrabar against High/Low as a genuine stop would."
    },
    {
      "topic": "band_reference_for_exit",
      "choice": "The exit condition ('close falls back below the Donchian upper band' / 'rises back above the lower band') uses the live, currently-updating Donchian band value each bar, not a value frozen at entry.",
      "reason": "The spec explicitly qualifies only the stop-loss price with 'at entry'; it gives no such qualifier for the exit-condition band, so the exit check is read as referencing the band's current value, while only the stop-loss price is a fixed snapshot taken at entry."
    }
  ],

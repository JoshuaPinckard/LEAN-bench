  "code": "import backtrader as bt\n\n\nclass EmaVolumeStrategy(bt.Strategy):\n    def __init__(self):\n        self.ema = bt.indicators.EMA(self.data.close, period=20)\n        self.sma_vol = bt.indicators.SMA(self.data.volume, period=20)\n        self.crossover = bt.indicators.CrossOver(self.data.close, self.ema)\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n        self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if len(self) < 20:\n            return\n\n        if not self.position:\n            if self.crossover[0] > 0 and self.data.volume[0] > self.sma_vol[0]:\n                cash = self.broker.getcash()\n                size = int((cash * 0.99) / self.data.close[0])\n                if size > 0:\n                    self.order = self.buy(size=size)\n            elif (\n                self.crossover[0] < 0 and self.data.volume[0] > self.sma_vol[0]\n            ):\n                cash = self.broker.getcash()\n                size = int((cash * 0.99) / self.data.close[0])\n                if size > 0:\n                    self.order = self.sell(size=size)\n        else:\n            entry_price = self.position.price\n            if self.position.size > 0:\n                stop_loss = entry_price * (1.0 - 0.015)\n                take_profit = entry_price * (1.0 + 0.03)\n                if (\n                    self.crossover[0] < 0\n                    or self.data.close[0] <= stop_loss\n                    or self.data.close[0] >= take_profit\n                ):\n                    self.order = self.close()\n            elif self.position.size < 0:\n                stop_loss = entry_price * (1.0 + 0.015)\n                take_profit = entry_price * (1.0 - 0.03)\n                if (\n                    self.crossover[0] > 0\n                    or self.data.close[0] >= stop_loss\n                    or self.data.close[0] <= take_profit\n                ):\n                    self.order = self.close()",
  "assumptions": [
    {
      "topic": "position_sizing",
      "choice": "Calculate position size as int(0.99 * getcash() / close[0])",
      "reason": "100% capital allocation requires a small cash buffer (1%) to prevent order rejection due to 0.1% commission fees."
    },
    {
      "topic": "stop_loss_take_profit_evaluation",
      "choice": "Evaluate stop-loss and take-profit conditions against bar Close price in next()",
      "reason": "The specification does not state intrabar execution; evaluating at bar Close in next() maintains consistency with signal processing and triggers self.close() for market order execution at next open."
    }
  ],

  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass GapTradingStrategy(bt.Strategy):\n    params = (\n        (\"gap_avg_period\", 20),\n        (\"h4_sma_period\", 20),\n        (\"small_gap_pct\", 0.70),\n        (\"big_gap_pct\", 1.50),\n    )\n\n    def __init__(self):\n        self.order = None\n        self.prev_date = None\n        self.session_gaps = []\n        self.h4_closes = []\n        self.h1_bar_count = 0\n        self.target_tp = None\n        self.active_scenario = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n            if not self.position:\n                self.target_tp = None\n                self.active_scenario = None\n\n    def next(self):\n        self.h1_bar_count += 1\n\n        current_date = self.data.datetime.date(0)\n        is_new_session = False\n        if self.prev_date is not None and current_date != self.prev_date:\n            is_new_session = True\n\n        h4_sma = None\n        if len(self.h4_closes) >= self.p.h4_sma_period:\n            h4_sma = (\n                sum(self.h4_closes[-self.p.h4_sma_period :])\n                / self.p.h4_sma_period\n            )\n\n        if self.position:\n            if self.order is None:\n                if self.active_scenario == 1 and self.target_tp is not None:\n                    if self.position.size > 0:\n                        if self.data.low[0] <= self.target_tp:\n                            self.order = self.close()\n                    elif self.position.size < 0:\n                        if self.data.high[0] >= self.target_tp:\n                            self.order = self.close()\n\n                if self.position and self.order is None and h4_sma is not None:\n                    if (\n                        self.position.size > 0\n                        and self.data.close[0] < h4_sma\n                    ):\n                        self.order = self.close()\n                    elif (\n                        self.position.size < 0\n                        and self.data.close[0] > h4_sma\n                    ):\n                        self.order = self.close()\n\n        if is_new_session:\n            prev_close = self.data.close[-1]\n            current_open = self.data.open[0]\n            gap = current_open - prev_close\n            gap_size = abs(gap)\n\n            if (\n                not self.position\n                and self.order is None\n                and len(self.session_gaps) >= self.p.gap_avg_period\n                and h4_sma is not None\n            ):\n                avg_gap = (\n                    sum(self.session_gaps[-self.p.gap_avg_period :])\n                    / self.p.gap_avg_period\n                )\n\n                if gap_size <= self.p.small_gap_pct * avg_gap:\n                    if gap > 0 and current_open > h4_sma:\n                        self.order = self.buy()\n                        self.active_scenario = 1\n                        self.target_tp = prev_close\n                    elif gap < 0 and current_open < h4_sma:\n                        self.order = self.sell()\n                        self.active_scenario = 1\n                        self.target_tp = prev_close\n\n                elif gap_size > self.p.big_gap_pct * avg_gap:\n                    if gap > 0 and current_open > h4_sma:\n                        self.order = self.buy()\n                        self.active_scenario = 2\n                        self.target_tp = None\n                    elif gap < 0 and current_open < h4_sma:\n                        self.order = self.sell()\n                        self.active_scenario = 2\n                        self.target_tp = None\n\n            self.session_gaps.append(gap_size)\n\n        if self.h1_bar_count % 4 == 0:\n            self.h4_closes.append(self.data.close[0])\n\n        self.prev_date = current_date",
  "assumptions": [

      "choice": "intraday_high_low_range",
      "reason": "Calculated volatility as (daily_high - daily_low) / daily_low based on accumulated intraday bars of the current trading day."
    },
    {
      "topic": "last_hour_definition",
      "choice": "hour_15_and_later",
      "reason": "Defined the last hour of trading as bars with timestamp hour >= 15 (15:00 to 16:00 EST)."
    },
    {
      "topic": "end_of_session_exit",
      "choice": "exit_at_1530_or_last_bar_of_day",
      "reason": "Triggers market exit for open positions on or after 15:30 bar or the last bar of the trading session."
    }
  ],

  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass PowerHourReversal(bt.Strategy):\n    params = (\n        ('rsi_period', 14),\n        ('ema_period', 20),\n        ('rsi_oversold', 30.0),\n        ('rsi_overbought', 70.0),\n        ('tp_pct', 0.015),\n        ('sl_pct', 0.008),\n        ('position_pct', 0.02),\n        ('volatility_threshold', 0.015),\n    )\n\n    def __init__(self):\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.p.rsi_period)\n        self.ema = bt.indicators.EMA(self.data.close, period=self.p.ema_period)\n        self.order = None\n        self.daily_date = None\n        self.daily_high = 0.0\n        self.daily_low = 0.0\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def _is_end_of_session(self):\n        t = self.data.datetime.time(0)\n        if t.hour > 15 or (t.hour == 15 and t.minute >= 30):\n            return True\n        try:\n            if self.data.datetime.date(1) != self.data.datetime.date(0):\n                return True\n        except IndexError:\n            return True\n        return False\n\n    def next(self):\n        # Update daily high / low tracking for volatility filter\n        current_date = self.data.datetime.date(0)\n        if self.daily_date != current_date:\n            self.daily_date = current_date\n            self.daily_high = self.data.high[0]\n            self.daily_low = self.data.low[0]\n        else:\n            self.daily_high = max(self.daily_high, self.data.high[0])\n            self.daily_low = min(self.daily_low, self.data.low[0])\n\n        if self.order:\n            return\n\n        # Position exit management\n        if self.position:\n            entry_price = self.position.price\n            if self.position.size > 0:\n                tp_price = entry_price * (1.0 + self.p.tp_pct)\n                sl_price = entry_price * (1.0 - self.p.sl_pct)\n                if self.data.high[0] >= tp_price or self.data.low[0] <= sl_price or self._is_end_of_session():\n                    self.order = self.close()\n            elif self.position.size < 0:\n                tp_price = entry_price * (1.0 - self.p.tp_pct)\n                sl_price = entry_price * (1.0 + self.p.sl_pct)\n                if self.data.low[0] <= tp_price or self.data.high[0] >= sl_price or self._is_end_of_session():\n                    self.order = self.close()\n            return\n\n        # Entry rules check: last hour of session\n        t = self.data.datetime.time(0)\n        in_last_hour = (t.hour >= 15)\n        if not in_last_hour:\n            return\n\n        # Volatility check: daily range exceeds 1.5%\n        if self.daily_low <= 0:\n            return\n        volatility = (self.daily_high - self.daily_low) / self.daily_low\n        if volatility <= self.p.volatility_threshold:\n            return\n\n        # Position sizing: 2% of total capital\n        capital = self.broker.getvalue()\n        size = int((capital * self.p.position_pct) / self.data.close[0])\n        if size <= 0:\n            size = 1\n\n        # Long entry logic: Price < EMA(20) and RSI crosses above 30 from below\n        long_cond = (self.data.close[0] < self.ema[0]) and (self.rsi[-1] < self.p.rsi_oversold) and (self.rsi[0] > self.p.rsi_oversold)\n\n        # Short entry logic: Price > EMA(20) and RSI crosses below 70 from above\n        short_cond = (self.data.close[0] > self.ema[0]) and (self.rsi[-1] > self.p.rsi_overbought) and (self.rsi[0] < self.p.rsi_overbought)\n\n        if long_cond:\n            self.order = self.buy(size=size)\n        elif short_cond:\n            self.order = self.sell(size=size)",
  "assumptions": [
    {
      "topic": "earnings_and_news_filter",

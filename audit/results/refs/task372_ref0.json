  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass KeltnerMeanReversionStrategy(bt.Strategy):\n    params = dict(\n        ema_period=20,\n        atr_period=14,\n        atr_mult=2.0,\n    )\n\n    def __init__(self):\n        self.ema = bt.indicators.EMA(self.data.close, period=self.p.ema_period)\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.upper = self.ema + self.p.atr_mult * self.atr\n        self.lower = self.ema - self.p.atr_mult * self.atr\n        self.crossover = bt.indicators.CrossOver(self.data.close, self.ema)\n\n        self.order = None\n        self.pending_entry_atr = None\n        self.stop_price = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n        if order.status == order.Completed:\n            if self.position:\n                if self.position.size > 0:\n                    self.stop_price = order.executed.price - self.p.atr_mult * self.pending_entry_atr\n                else:\n                    self.stop_price = order.executed.price + self.p.atr_mult * self.pending_entry_atr\n            else:\n                self.stop_price = None\n        self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if self.position:\n            if self.position.size > 0:\n                if self.data.low[0] <= self.stop_price:\n                    self.order = self.close()\n                    return\n                if self.crossover[0] > 0:\n                    self.order = self.close()\n                    return\n            else:\n                if self.data.high[0] >= self.stop_price:\n                    self.order = self.close()\n                    return\n                if self.crossover[0] < 0:\n                    self.order = self.close()\n                    return\n            return\n\n        bullish = self.data.close[0] > self.data.open[0]\n        bearish = self.data.close[0] < self.data.open[0]\n\n        if bullish and self.data.close[0] < self.lower[0]:\n            self.pending_entry_atr = self.atr[0]\n            self.order = self.buy()\n        elif bearish and self.data.close[0] > self.upper[0]:\n            self.pending_entry_atr = self.atr[0]\n            self.order = self.sell()",
  "assumptions": [
    {
      "topic": "candle definition",
      "choice": "Bullish candle = close > open; bearish candle = close < open",
      "reason": "Spec references bullish/bearish candles but does not define them; this is the standard candle-body definition."
    },
    {
      "topic": "stop-loss ATR snapshot",
      "choice": "The 2-ATR stop distance uses the ATR value observed at the signal bar (when the entry order is submitted), fixed at entry rather than recalculated each bar",
      "reason": "Spec says stop is 'set at 2 ATR from entry', implying a fixed level determined at entry time, not a trailing stop."
    },
    {
      "topic": "stop-loss anchor price",
      "choice": "Stop level is computed from the actual order.executed.price (the real fill price) once the entry order completes, not the signal bar's close",
      "reason": "Backtrader's default broker fills market orders on the next bar's open, so entry price differs from the signal close; using the executed fill price is the literal 'entry' price."
    },
    {
      "topic": "same-bar exit priority",
      "choice": "When both the stop-loss (checked against intrabar High/Low) and the middle-line cross (checked against Close) could trigger on the same bar, the stop-loss is evaluated first",
      "reason": "infeasible: OHLCV bars have no intrabar order-of-events data, so true simultaneity cannot be resolved; treating the risk-control stop as taking precedence is the closest literal, conservative reading."
    },
    {
      "topic": "middle-line cross detection",
      "choice": "Implemented via bt.indicators.CrossOver(close, EMA), exiting long on an upward cross and short on a downward cross",
      "reason": "Spec says 'exit when price crosses the middle line'; CrossOver directly encodes a directional cross rather than a simple threshold touch."
    },
    {
      "topic": "position sizing",
      "choice": "Default sizer via plain self.buy()/self.sell() with no size argument",
      "reason": "Spec is silent on position sizing (canonical default)."
    },
    {
      "topic": "one position at a time",
      "choice": "No new entries while a position is open; pending orders are guarded",
      "reason": "Spec does not mention pyramiding or re-entry (canonical default)."
    }
  ],

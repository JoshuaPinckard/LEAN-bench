  "code": "import backtrader as bt\n\n\nclass AdxStochStrategy(bt.Strategy):\n    params = (\n        (\"adx_period\", 14),\n        (\"adx_threshold\", 25.0),\n        (\"stoch_period\", 14),\n        (\"stoch_dfast\", 3),\n        (\"stoch_dslow\", 3),\n        (\"stoch_low\", 20.0),\n        (\"stoch_high\", 80.0),\n        (\"stop_loss_pct\", 0.02),\n    )\n\n    def __init__(self):\n        self.adx = bt.indicators.ADX(self.data, period=self.p.adx_period)\n        self.plus_di = bt.indicators.PlusDI(self.data, period=self.p.adx_period)\n        self.minus_di = bt.indicators.MinusDI(\n            self.data, period=self.p.adx_period\n        )\n\n        self.stoch = bt.indicators.StochasticFull(\n            self.data,\n            period=self.p.stoch_period,\n            period_dfast=self.p.stoch_dfast,\n            period_dslow=self.p.stoch_dslow,\n        )\n\n        self.k_cross_down = bt.indicators.CrossDown(\n            self.stoch.percK, self.p.stoch_low\n        )\n        self.k_cross_up = bt.indicators.CrossUp(\n            self.stoch.percK, self.p.stoch_high\n        )\n        self.adx_cross_down = bt.indicators.CrossDown(\n            self.adx, self.p.adx_threshold\n        )\n\n        self.order = None\n        self.stop_order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order == self.order:\n                self.order = None\n                if self.position.size > 0:\n                    stop_price = self.position.price * (1.0 - self.p.stop_loss_pct)\n                    self.stop_order = self.close(\n                        exectype=bt.Order.Stop, price=stop_price\n                    )\n                elif self.position.size < 0:\n                    stop_price = self.position.price * (1.0 + self.p.stop_loss_pct)\n                    self.stop_order = self.close(\n                        exectype=bt.Order.Stop, price=stop_price\n                    )\n            elif order == self.stop_order:\n                self.stop_order = None\n\n            if not self.position:\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                    self.stop_order = None\n                self.order = None\n\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order == self.order:\n                self.order = None\n            if order == self.stop_order:\n                self.stop_order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if self.position:\n            if self.adx_cross_down[0] > 0:\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                    self.stop_order = None\n                self.order = self.close()\n        else:\n            if self.adx[0] > self.p.adx_threshold:\n                bullish_bias = self.plus_di[0] > self.minus_di[0]\n                bearish_bias = self.minus_di[0] > self.plus_di[0]\n\n                if bullish_bias and self.k_cross_down[0] > 0:\n                    self.order = self.buy()\n                elif bearish_bias and self.k_cross_up[0] > 0:\n                    self.order = self.sell()",
  "assumptions": [
    {
      "topic": "stop_loss_order",
      "choice": "Placed a stop-loss exit order using self.close(exectype=bt.Order.Stop) upon entry execution based on self.position.price",
      "reason": "The specification calls for a fixed stop-loss at 2% from the average entry price; using a stop order at self.position.price * (1 - 0.02) for long and self.position.price * (1 + 0.02) for short reflects exact execution."
    },
    {
      "topic": "adx_exit_cancellation",
      "choice": "Cancelled any active stop-loss order before submitting self.close() when ADX crosses below 25",
      "reason": "To prevent duplicate exit orders when an ADX cross-below event triggers an immediate exit while a stop order is pending."
    }
  ],

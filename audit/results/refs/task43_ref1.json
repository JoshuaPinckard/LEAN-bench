  "code": "import backtrader as bt\n\n\nclass BollingerBandsStrategy(bt.Strategy):\n    def __init__(self):\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close,\n            period=20,\n            devfactor=2,\n            movav=bt.indicators.SimpleMovingAverage,\n        )\n        self.middle_bb = self.bb.mid\n        self.upper_bb = self.bb.top\n        self.lower_bb = self.bb.bot\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        previous_close = self.data.close[-1]\n        current_close = self.data.close[0]\n\n        if not self.position:\n            if previous_close < self.lower_bb[-1] and current_close > self.lower_bb[0]:\n                self.order = self.buy()\n            elif previous_close > self.upper_bb[-1] and current_close < self.upper_bb[0]:\n                self.order = self.sell()\n        elif self.position.size > 0:\n            if previous_close > self.middle_bb[-1] and current_close < self.middle_bb[0]:\n                self.order = self.close()\n        else:\n            if previous_close < self.middle_bb[-1] and current_close > self.middle_bb[0]:\n                self.order = self.close()",
  "assumptions": [
    {
      "topic": "position sizing",
      "choice": "Use plain self.buy() and self.sell() without a size argument.",

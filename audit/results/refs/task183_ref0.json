{
  "task_id": 183,
  "ref_idx": 0,
  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass BreakoutStrategy(bt.Strategy):\n    params = dict(\n        lookback=10,\n        size_pct=0.01,\n        stop_loss_pct=0.02,\n    )\n\n    def __init__(self):\n        self.highest_close = bt.indicators.Highest(\n            self.data.close(-1), period=self.p.lookback\n        )\n        self.lowest_close = bt.indicators.Lowest(\n            self.data.close(-1), period=self.p.lookback\n        )\n        self.order = None\n        self.stop_order = None\n        self.entry_price = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status == order.Completed:\n            if order.isbuy():\n                self.entry_price = order.executed.price\n                stop_price = self.entry_price * (1 - self.p.stop_loss_pct)\n                self.stop_order = self.sell(\n                    exectype=bt.Order.Stop,\n                    price=stop_price,\n                    size=order.executed.size,\n                )\n            elif order.issell():\n                if order is self.stop_order:\n                    self.stop_order = None\n                self.entry_price = None\n            self.order = None\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order is self.stop_order:\n                self.stop_order = None\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            if self.data.close[0] > self.highest_close[0]:\n                size = (self.broker.getvalue() * self.p.size_pct) / self.data.close[0]\n                self.order = self.buy(size=size)\n        else:\n            if self.data.close[0] < self.lowest_close[0]:\n                if self.stop_order is not None:\n                    self.cancel(self.stop_order)\n                    self.stop_order = None\n                self.order = self.close()",
  "assumptions": [
    {
      "topic": "previous-10-bars window",
      "choice": "Interpreted 'maximum/minimum Close over the previous 10 bars' as strictly excluding the current bar (bars t-1 through t-10). Implemented via bt.indicators.Highest/Lowest applied to self.data.close(-1) with period=10, so the indicator's built-in minperiod (11) handles warm-up automatically per the canonical default.",
      "reason": "Spec says 'over the previous 10 bars', which naturally excludes the bar being evaluated; this also lets backtrader's automatic minperiod machinery do the bar-skipping rather than manual logic."
    },
    {
      "topic": "position sizing basis",
      "choice": "'1% of capital' computed as 1% of current broker portfolio value (self.broker.getvalue()) divided by the current Close to get share size (fractional shares allowed).",
      "reason": "Spec states a percent-of-capital size but does not define 'capital' as starting cash vs. live equity or specify integer-share rounding; current equity is the standard, most literal reading of 'capital' for ongoing position sizing."
    },
    {
      "topic": "stop-loss implementation",
      "choice": "On each filled entry, immediately submit a separate bt.Order.Stop sell order at 2% below the actual fill price, sized to the entry order's executed size; this stop order is canceled if the breakout exit condition (Close below the 10-bar low) fires first.",
      "reason": "Spec states a hard stop-loss level distinct from the breakout exit rule; a live Stop order is the literal, standard backtrader mechanism for a price-triggered protective stop that can fire on any bar's Low, independent of the once-per-bar breakout check."
    }
  ],

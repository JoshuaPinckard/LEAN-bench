  "code": "import backtrader as bt\n\n\nclass MACDStrategyBasedOnSignalLineCrossover(bt.Strategy):\n    def __init__(self):\n        self.order = None\n        self.macd = bt.indicators.MACD(\n            self.data.close,\n            period_me1=12,\n            period_me2=26,\n            period_signal=9,\n        )\n        self.crossover = bt.indicators.CrossOver(\n            self.macd.macd,\n            self.macd.signal,\n        )\n\n    def notify_order(self, order):\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if self.crossover[0] > 0:\n            self.order = self.order_target_percent(target=1.0)\n        elif self.crossover[0] < 0:\n            self.order = self.order_target_percent(target=-1.0)",
  "assumptions": [
    {
      "topic": "position sizing",
      "choice": "Used order_target_percent with targets of 1.0 for long and -1.0 for short.",
      "reason": "The stated fixed sizing example is 100% of available capital; target-percent orders also reverse an existing opposite position when the mandatory opposite crossover occurs."
    }
  ],

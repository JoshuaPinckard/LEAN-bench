  "code": "import backtrader as bt\n\n\nclass ConvertibleBondDropStrategy(bt.Strategy):\n    params = dict(\n        sma_period=50,\n        rsi_period=14,\n        active_month=10,\n        active_day=1,\n        prev_close_threshold=200.0,\n        rsi_threshold=50.0,\n        take_profit=160.0,\n        stop_loss_pct=0.05,\n        max_hold_days=5,\n        capital_pct=0.02,\n        min_entry_price=160.0,\n    )\n\n    def __init__(self):\n        self.sma = bt.indicators.SMA(self.data.close, period=self.p.sma_period)\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.p.rsi_period)\n        self.order = None\n        self.entry_bar = None\n        self.entry_price = None\n        self.stop_price = None\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            if order.issell():\n                self.entry_price = order.executed.price\n                self.stop_price = self.entry_price * (1 + self.p.stop_loss_pct)\n                self.entry_bar = len(self)\n            elif order.isbuy():\n                self.entry_price = None\n                self.stop_price = None\n                self.entry_bar = None\n\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        dt = self.data.datetime.date(0)\n        is_active = (dt.month, dt.day) >= (self.p.active_month, self.p.active_day)\n\n        if self.position:\n            if self.data.high[0] >= self.stop_price:\n                self.close()\n                return\n            if self.data.close[0] <= self.p.take_profit:\n                self.close()\n                return\n            if self.data.close[0] > self.sma[0]:\n                self.close()\n                return\n            if (len(self) - self.entry_bar) >= self.p.max_hold_days:\n                self.close()\n                return\n            return\n\n        if self.order:\n            return\n\n        if not is_active:\n            return\n\n        if len(self.data) < 2:\n            return\n\n        prev_close = self.data.close[-1]\n        prev_rsi = self.rsi[-1]\n        cur_open = self.data.open[0]\n\n        if (prev_close > self.p.prev_close_threshold\n                and prev_rsi > self.p.rsi_threshold\n                and cur_open < prev_close):\n\n            if cur_open < self.p.min_entry_price:\n                return\n\n            capital = self.broker.getvalue() * self.p.capital_pct\n            size = capital / self.data.close[0]\n            if size <= 0:\n                return\n\n            self.order = self.sell(size=size)",
  "assumptions": [

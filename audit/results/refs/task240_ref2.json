  "code": "import math\nimport backtrader as bt\n\n\nclass MeanReversionVolTargeting(bt.Strategy):\n    params = (\n        (\"risk_factor\", 100.0),\n        (\"rsi_long\", 40.0),\n        (\"rsi_short\", 60.0),\n    )\n\n    def __init__(self):\n        self.order = None\n        self.bb2 = bt.indicators.BollingerBands(self.data.close, period=100, devfactor=2.0)\n        self.bb3 = bt.indicators.BollingerBands(self.data.close, period=100, devfactor=3.0)\n        self.atr = bt.indicators.ATR(self.data, period=20)\n        self.rsi = bt.indicators.RSI(self.data.close, period=14)\n        self.crossover = bt.indicators.CrossOver(self.data.close, self.bb2.lines.mid)\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        close = self.data.close[0]\n        bb2_top = self.bb2.lines.top[0]\n        bb2_mid = self.bb2.lines.mid[0]\n        bb2_bot = self.bb2.lines.bot[0]\n        bb3_top = self.bb3.lines.top[0]\n        bb3_bot = self.bb3.lines.bot[0]\n        atr_val = self.atr[0]\n        rsi_val = self.rsi[0]\n\n        if not self.position:\n            # Entry condition for long position\n            if close < bb2_bot and rsi_val < self.p.rsi_long:\n                cash = self.broker.getcash()\n                capital = self.broker.getvalue()\n                if atr_val > 0 and close > 0:\n                    max_cash_shares = cash / close\n                    target_vol_shares = math.floor(capital / (atr_val * self.p.risk_factor))\n                    size = int(min(max_cash_shares, target_vol_shares))\n                    if size > 0:\n                        self.order = self.buy(size=size)\n\n            # Entry condition for short position\n            elif close > bb2_top and rsi_val > self.p.rsi_short:\n                cash = self.broker.getcash()\n                capital = self.broker.getvalue()\n                if atr_val > 0 and close > 0:\n                    max_cash_shares = cash / close\n                    target_vol_shares = math.floor(capital / (atr_val * self.p.risk_factor))\n                    size = int(min(max_cash_shares, target_vol_shares))\n                    if size > 0:\n                        self.order = self.sell(size=size)\n        else:\n            # Exit / Stop condition evaluation\n            half_sigma_dist = 0.25 * (bb2_top - bb2_mid)\n            mean_returned = (self.crossover[0] != 0) or (abs(close - bb2_mid) <= half_sigma_dist)\n\n            if self.position.size > 0:\n                stop_loss = close <= bb3_bot\n                if stop_loss or mean_returned:\n                    self.order = self.close()\n            elif self.position.size < 0:\n                stop_loss = close >= bb3_top\n                if stop_loss or mean_returned:\n                    self.order = self.close()",

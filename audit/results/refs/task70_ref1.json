  "code": "import backtrader as bt\nimport math\n\n\nclass GeneticHeuristicStrategy(bt.Strategy):\n    params = (\n        (\"ma_type\", \"SMA\"),\n        (\"fast_period\", 20),\n        (\"slow_period\", 50),\n        (\"rsi_period\", 14),\n        (\"macd_fast_period\", 12),\n        (\"macd_slow_period\", 26),\n        (\"macd_signal_period\", 9),\n        (\"take_profit\", 0.02),\n        (\"stop_loss\", 0.01),\n        (\"capital_fraction\", 0.02),\n        (\"enable_trend_filter\", False),\n        (\"trend_period\", 200),\n        (\"enable_volatility_filter\", False),\n        (\"atr_period\", 14),\n        (\"volatility_min\", 0.0),\n        (\"volatility_max\", math.inf),\n    )\n\n    def __init__(self):\n        ma_class = bt.ind.EMA if self.p.ma_type.upper() == \"EMA\" else bt.ind.SMA\n\n        self.fast_ma = ma_class(self.data.close, period=self.p.fast_period)\n        self.slow_ma = ma_class(self.data.close, period=self.p.slow_period)\n        self.rsi = bt.ind.RSI(self.data.close, period=self.p.rsi_period)\n\n        self.macd_fast = bt.ind.EMA(\n            self.data.close, period=self.p.macd_fast_period\n        )\n        self.macd_slow = bt.ind.EMA(\n            self.data.close, period=self.p.macd_slow_period\n        )\n        self.macd = self.macd_fast - self.macd_slow\n        self.macd_signal = bt.ind.SMA(\n            self.macd, period=self.p.macd_signal_period\n        )\n\n        self.crossover = bt.ind.CrossOver(self.fast_ma, self.slow_ma)\n        self.trend_ma = bt.ind.SMA(self.data.close, period=self.p.trend_period)\n        self.atr = bt.ind.ATR(self.data, period=self.p.atr_period)\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in (\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ):\n            self.order = None\n\n    def _volatility_allowed(self):\n        if not self.p.enable_volatility_filter:\n            return True\n        return self.p.volatility_min <= self.atr[0] <= self.p.volatility_max\n\n    def _size(self):\n        return (self.broker.getcash() * self.p.capital_fraction) / self.data.close[0]\n\n    def next(self):\n        if self.order:\n            return\n\n        price = self.data.close[0]\n\n        if self.position:\n            if self.position.size > 0:\n                exit_signal = (\n                    self.crossover[0] < 0\n                    or price >= self.position.price * (1.0 + self.p.take_profit)\n                    or price <= self.position.price * (1.0 - self.p.stop_loss)\n                )\n            else:\n                exit_signal = (\n                    self.crossover[0] > 0\n                    or price <= self.position.price * (1.0 - self.p.take_profit)\n                    or price >= self.position.price * (1.0 + self.p.stop_loss)\n                )\n\n            if exit_signal:\n                self.order = self.close()\n            return\n\n        if not self._volatility_allowed():\n            return\n\n        size = self._size()\n        if size <= 0:\n            return\n\n        if self.crossover[0] > 0:\n            if not self.p.enable_trend_filter or price > self.trend_ma[0]:\n                self.order = self.buy(size=size)\n        elif self.crossover[0] < 0:\n            if not self.p.enable_trend_filter or price < self.trend_ma[0]:\n                self.order = self.sell(size=size)",

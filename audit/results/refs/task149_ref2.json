  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass PriceActionVolumeReversal(bt.Strategy):\n    params = (\n        (\"period\", 20),\n        (\"vol_factor\", 1.5),\n        (\"range_factor\", 1.5),\n        (\"risk_pct\", 0.01),\n        (\"rr_ratio\", 2.0),\n    )\n\n    def __init__(self):\n        self.order = None\n        self.vol_sma = bt.indicators.SMA(self.data.volume, period=self.p.period)\n        self.bar_range = self.data.high - self.data.low\n        self.range_sma = bt.indicators.SMA(self.bar_range, period=self.p.period)\n\n        self.key_bar_idx = None\n        self.key_bar_high = None\n        self.key_bar_low = None\n\n        self.min_low_since_key = None\n        self.min_low_idx = None\n\n        self.max_high_since_key = None\n        self.max_high_idx = None\n\n        self.sl_price = None\n        self.tp_price = None\n        self.retest_low = None\n        self.retest_high = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            exec_price = order.executed.price\n            if order.isbuy():\n                sl = (\n                    self.retest_low\n                    if (self.retest_low is not None and self.retest_low < exec_price)\n                    else exec_price * 0.995\n                )\n                risk = exec_price - sl\n                tp = exec_price + self.p.rr_ratio * risk\n                self.sl_price = sl\n                self.tp_price = tp\n            elif order.issell():\n                sl = (\n                    self.retest_high\n                    if (self.retest_high is not None and self.retest_high > exec_price)\n                    else exec_price * 1.005\n                )\n                risk = sl - exec_price\n                tp = exec_price - self.p.rr_ratio * risk\n                self.sl_price = sl\n                self.tp_price = tp\n\n        self.order = None\n\n    def next(self):\n        curr_idx = len(self)\n        curr_vol = self.data.volume[0]\n        curr_range = self.bar_range[0]\n        avg_v = self.vol_sma[0]\n        avg_r = self.range_sma[0]\n\n        is_key = (curr_vol >= self.p.vol_factor * avg_v) and (\n            curr_range >= self.p.range_factor * avg_r\n        )\n\n        if is_key:\n            self.key_bar_idx = curr_idx\n            self.key_bar_high = self.data.high[0]\n            self.key_bar_low = self.data.low[0]\n            self.min_low_since_key = float(\"inf\")\n            self.min_low_idx = None\n            self.max_high_since_key = float(\"-inf\")\n            self.max_high_idx = None\n        elif self.key_bar_idx is not None:\n            prev_low = self.data.low[-1]\n            prev_high = self.data.high[-1]\n            prev_idx = curr_idx - 1\n\n            if prev_idx > self.key_bar_idx:\n                if prev_low < self.min_low_since_key:\n                    self.min_low_since_key = prev_low\n                    self.min_low_idx = prev_idx\n                if prev_high > self.max_high_since_key:\n                    self.max_high_since_key = prev_high\n                    self.max_high_idx = prev_idx\n\n        if self.position:\n            if self.position.size > 0:\n                if self.data.high[0] >= self.tp_price:\n                    self.close()\n                elif self.data.low[0] <= self.sl_price:\n                    self.close()\n            elif self.position.size < 0:\n                if self.data.low[0] <= self.tp_price:\n                    self.close()\n                elif self.data.high[0] >= self.sl_price:\n                    self.close()\n            return\n\n        if self.order is not None or self.key_bar_idx is None:\n            return\n\n        demand_level = self.key_bar_low\n        resistance_level = self.key_bar_high\n\n        mid_range = (self.data.high[0] + self.data.low[0]) / 2.0\n        close_top_half = self.data.close[0] > mid_range\n        close_bottom_half = self.data.close[0] < mid_range\n        vol_spike = curr_vol > avg_v\n\n        # Long Setup (Spring)\n        retest_demand = self.data.low[0] <= demand_level\n        if retest_demand and close_top_half and vol_spike:\n            if self.min_low_idx is not None and self.min_low_idx > self.key_bar_idx:\n                slope_long = (self.min_low_since_key - self.key_bar_high) / (\n                    self.min_low_idx - self.key_bar_idx\n                )\n                if slope_long < 0:\n                    rtl_val = self.key_bar_high + slope_long * (\n                        curr_idx - self.key_bar_idx\n                    )\n                    if self.data.close[0] > rtl_val:\n                        self.retest_low = self.data.low[0]\n                        risk_per_share = max(\n                            0.0001, self.data.close[0] - self.retest_low\n                        )\n                        cash_risk = self.broker.getvalue() * self.p.risk_pct\n                        size = int(cash_risk / risk_per_share)\n                        if size >= 1:\n                            self.order = self.buy(size=size)\n                        return\n\n        # Short Setup (Upthrust)\n        retest_resistance = self.data.high[0] >= resistance_level\n        if retest_resistance and close_bottom_half and vol_spike:\n            if self.max_high_idx is not None and self.max_high_idx > self.key_bar_idx:\n                slope_short = (self.max_high_since_key - self.key_bar_low) / (\n                    self.max_high_idx - self.key_bar_idx\n                )\n                if slope_short > 0:\n                    rtl_val = self.key_bar_low + slope_short * (\n                        curr_idx - self.key_bar_idx\n                    )\n                    if self.data.close[0] < rtl_val:\n                        self.retest_high = self.data.high[0]\n                        risk_per_share = max(\n                            0.0001, self.retest_high - self.data.close[0]\n                        )\n                        cash_risk = self.broker.getvalue() * self.p.risk_pct\n                        size = int(cash_risk / risk_per_share)\n                        if size >= 1:\n                            self.order = self.sell(size=size)\n                        return",
  "assumptions": [
    {
      "topic": "key_bar_identification",
      "choice": "An initial key bar is identified when volume >= 150% of 20-bar volume SMA and range >= 150% of 20-bar range SMA. Its Low is marked as demand level and High as resistance level.",
      "reason": "Specification defines initial demand bar by 150% averages and references key bar high/low for both setups."
    },
    {
      "topic": "rtl_calculation",
      "choice": "RTL for Long connects initial key bar high to the subsequent lowest low before retest. RTL for Short connects initial key bar low to the subsequent highest high before retest.",
      "reason": "Follows the downward-sloping trendline definition for Spring setups and upward-sloping trendline definition for Upthrust setups."
    },
    {
      "topic": "position_sizing_and_exits",
      "choice": "Risks 1% of total portfolio value per trade. Stop loss is set at the retest extreme (retest low for long, retest high for short) and take profit is set at 2:1 reward-to-risk ratio.",
      "reason": "Directly implements the 1% risk default, 1:2 R/R defaults, and retest bar extreme stop loss instructions."
    }
  ],

  "code": "import backtrader as bt\n\n\nclass MovingAverageExitStrategy(bt.Strategy):\n    params = ((\"sma_period\", 200),)\n\n    def __init__(self):\n        self.order = None\n        self.sma = bt.indicators.SimpleMovingAverage(\n            self.data.close, period=self.p.sma_period\n        )\n        self.cross_up = bt.indicators.CrossUp(self.data.close, self.sma)\n        self.cross_down = bt.indicators.CrossDown(self.data.close, self.sma)\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            if self.cross_up[0] > 0:\n                size = (self.broker.getvalue() * 0.01) / self.data.close[0]\n                self.order = self.buy(size=size)\n        elif self.cross_down[0] > 0:\n            self.order = self.close()\n\n    def notify_order(self, order):\n        if order.status in (\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ):\n            self.order = None",

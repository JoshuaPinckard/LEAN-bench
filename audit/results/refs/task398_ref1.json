  "code": "import backtrader as bt\nimport math\n\n\nclass Strategy(bt.Strategy):\n    params = (\n        (\"train_bars\", 200),\n        (\"n_trees\", 100),\n        (\"seed\", 0),\n    )\n\n    def __init__(self):\n        self.rsi2 = bt.indicators.RSI(self.data.close, period=2)\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in (\n            bt.Order.Completed,\n            bt.Order.Canceled,\n            bt.Order.Margin,\n            bt.Order.Rejected,\n        ):\n            self.order = None\n\n    def _next_random(self, state):\n        return (1664525 * state + 1013904223) & 0xFFFFFFFF\n\n    def _majority(self, labels, default=0):\n        if not labels:\n            return default\n        return 1 if sum(labels) > (len(labels) - sum(labels)) else 0\n\n    def _predict_random_forest(self, rows):\n        labels = [row[2] for row in rows]\n        overall = self._majority(labels)\n        votes = 0\n        state = self.p.seed\n\n        for _ in range(self.p.n_trees):\n            sample = []\n            for _ in range(len(rows)):\n                state = self._next_random(state)\n                sample.append(rows[state % len(rows)])\n\n            state = self._next_random(state)\n            feature = state % 2\n            state = self._next_random(state)\n            threshold = sample[state % len(sample)][feature]\n\n            left = [row[2] for row in sample if row[feature] <= threshold]\n            right = [row[2] for row in sample if row[feature] > threshold]\n\n            latest_rsi = float(self.rsi2[0])\n            latest_return = float(self.data.close[0] / self.data.close[-1] - 1.0)\n            latest_value = (latest_rsi, latest_return)[feature]\n\n            if latest_value <= threshold:\n                votes += self._majority(left, overall)\n            else:\n                votes += self._majority(right, overall)\n\n        return 1 if votes > (self.p.n_trees - votes) else 0\n\n    def _set_target(self, target):\n        if self.order is not None:\n            return\n\n        if target == 1.0 and self.position.size == 0:\n            self.order = self.order_target_percent(target=1.0)\n        elif target == 0.0 and self.position.size != 0:\n            self.order = self.order_target_percent(target=0.0)\n\n    def next(self):\n        rsi_value = float(self.rsi2[0])\n\n        if len(self.data) < 50:\n            if rsi_value < 30:\n                self._set_target(1.0)\n            elif rsi_value > 70:\n                self._set_target(0.0)\n            return\n\n        rows = []\n        earliest = max(-(self.p.train_bars), -len(self.data) + 2)\n\n        for offset in range(earliest, 0):\n            rsi = float(self.rsi2[offset])\n            previous_close = float(self.data.close[offset - 1])\n            close = float(self.data.close[offset])\n            next_close = float(self.data.close[offset + 1])\n\n            if (\n                previous_close != 0\n                and math.isfinite(rsi)\n                and math.isfinite(close)\n                and math.isfinite(next_close)\n            ):\n                rows.append((rsi, close / previous_close - 1.0,\n                             1 if next_close > close else 0))\n\n        if rows:\n            prediction = self._predict_random_forest(rows)\n            self._set_target(1.0 if prediction == 1 else 0.0)",

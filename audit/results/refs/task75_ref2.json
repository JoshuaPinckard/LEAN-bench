  "code": "import backtrader as bt\n\n\nclass TimeSeriesMomentum(bt.Strategy):\n    params = ((\"period\", 252),)\n\n    def __init__(self):\n        self.roc = bt.indicators.ROC(self.data.close, period=self.p.period)\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            if self.roc[0] > 0:\n                self.order = self.buy()\n            elif self.roc[0] < 0:\n                self.order = self.sell()\n        else:\n            if self.position.size > 0 and self.roc[0] < 0:\n                self.order = self.close()\n            elif self.position.size < 0 and self.roc[0] > 0:\n                self.order = self.close()",

  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass VolatilityTrendStrategy(bt.Strategy):\n    params = (\n        ('atr_period', 14),\n        ('sma_period', 20),\n        ('rsi_period', 14),\n        ('ema_period', 14),\n        ('vol_sma_period', 20),\n        ('rsi_long_threshold', 55),\n        ('rsi_short_threshold', 45),\n        ('rsi_cross_level', 50),\n        ('sl_atr_mult', 1.5),\n        ('tp_atr_mult', 2.0),\n    )\n\n    def __init__(self):\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.sma = bt.indicators.SMA(self.data.close, period=self.p.sma_period)\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.p.rsi_period)\n        self.atr_ema = bt.indicators.EMA(self.atr, period=self.p.ema_period)\n        self.vol_sma = bt.indicators.SMA(self.data.volume, period=self.p.vol_sma_period)\n\n        self.rsi_cross_below = bt.indicators.CrossDown(self.rsi, self.p.rsi_cross_level)\n        self.rsi_cross_above = bt.indicators.CrossUp(self.rsi, self.p.rsi_cross_level)\n\n        self.order = None\n        self.sl_order = None\n        self.tp_order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order == self.order:\n                if self.position:\n                    if self.position.size > 0:\n                        sl_price = order.executed.price - self.p.sl_atr_mult * self.atr[0]\n                        tp_price = order.executed.price + self.p.tp_atr_mult * self.atr[0]\n                        self.sl_order = self.sell(exectype=bt.Order.Stop, price=sl_price)\n                        self.tp_order = self.sell(exectype=bt.Order.Limit, price=tp_price, oco=self.sl_order)\n                    elif self.position.size < 0:\n                        sl_price = order.executed.price + self.p.sl_atr_mult * self.atr[0]\n                        tp_price = order.executed.price - self.p.tp_atr_mult * self.atr[0]\n                        self.sl_order = self.buy(exectype=bt.Order.Stop, price=sl_price)\n                        self.tp_order = self.buy(exectype=bt.Order.Limit, price=tp_price, oco=self.sl_order)\n                self.order = None\n            elif order in [self.sl_order, self.tp_order]:\n                self.sl_order = None\n                self.tp_order = None\n\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order == self.order:\n                self.order = None\n            if order == self.sl_order:\n                self.sl_order = None\n            if order == self.tp_order:\n                self.tp_order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            long_cond = (\n                self.data.close[0] > self.sma[0] and\n                self.rsi[0] > self.p.rsi_long_threshold and\n                self.atr[0] > self.atr_ema[0] and\n                self.data.volume[0] > self.vol_sma[0]\n            )\n            short_cond = (\n                self.data.close[0] < self.sma[0] and\n                self.rsi[0] < self.p.rsi_short_threshold and\n                self.atr[0] > self.atr_ema[0] and\n                self.data.volume[0] > self.vol_sma[0]\n            )\n\n            if long_cond:\n                self.order = self.buy()\n            elif short_cond:\n                self.order = self.sell()\n\n        else:\n            if self.position.size > 0:\n                long_exit = (\n                    self.data.close[0] < self.sma[0] or\n                    self.rsi_cross_below[0] > 0\n                )\n                if long_exit:\n                    if self.sl_order:\n                        self.cancel(self.sl_order)\n                        self.sl_order = None\n                    if self.tp_order:\n                        self.cancel(self.tp_order)\n                        self.tp_order = None\n                    self.order = self.close()\n\n            elif self.position.size < 0:\n                short_exit = (\n                    self.data.close[0] > self.sma[0] or\n                    self.rsi_cross_above[0] > 0\n                )\n                if short_exit:\n                    if self.sl_order:\n                        self.cancel(self.sl_order)\n                        self.sl_order = None\n                    if self.tp_order:\n                        self.cancel(self.tp_order)\n                        self.tp_order = None\n                    self.order = self.close()",
  "assumptions": [
    {
      "topic": "entry_price",

  "code": "import backtrader as bt\n\n\nclass BBEmaIntradayStrategy(bt.Strategy):\n    params = (\n        (\"bb_period\", 20),\n        (\"bb_devfactor\", 2),\n        (\"ema_period\", 50),\n    )\n\n    def __init__(self):\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close,\n            period=self.p.bb_period,\n            devfactor=self.p.bb_devfactor,\n        )\n        self.ema = bt.indicators.EMA(\n            self.data.close,\n            period=self.p.ema_period,\n        )\n        self.cross_bb_top = bt.indicators.CrossOver(self.data.close, self.bb.top)\n        self.cross_bb_bot = bt.indicators.CrossOver(self.data.close, self.bb.bot)\n        self.cross_ema = bt.indicators.CrossOver(self.data.close, self.ema)\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        long_entry = (self.cross_bb_top[0] > 0) and (self.data.close[0] > self.ema[0])\n        short_entry = (self.cross_bb_bot[0] < 0) and (self.data.close[0] < self.ema[0])\n        exit_long = self.cross_ema[0] < 0\n        exit_short = self.cross_ema[0] > 0\n\n        if self.position.size > 0:\n            if short_entry:\n                self.close()\n                self.order = self.sell()\n            elif exit_long:\n                self.order = self.close()\n        elif self.position.size < 0:\n            if long_entry:\n                self.close()\n                self.order = self.buy()\n            elif exit_short:\n                self.order = self.close()\n        else:\n            if long_entry:\n                self.order = self.buy()\n            elif short_entry:\n                self.order = self.sell()",
  "assumptions": [
    {
      "topic": "position_sizing",
      "choice": "Default Backtrader sizer via self.buy() and self.sell() without explicit size parameter",

  "code": "import math\nimport backtrader as bt\n\n\nclass SmaCrossoverStrategy(bt.Strategy):\n    params = (\n        ('fast_period', 10),\n        ('slow_period', 50),\n    )\n\n    def __init__(self):\n        self.fast_sma = bt.indicators.SMA(self.data.close, period=self.params.fast_period)\n        self.slow_sma = bt.indicators.SMA(self.data.close, period=self.params.slow_period)\n        self.signal = self.fast_sma > self.slow_sma\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if math.isnan(self.signal[0]) or math.isnan(self.signal[-1]):\n            return\n\n        diff = self.signal[0] - self.signal[-1]\n\n        if diff == 1.0:\n            if not self.position:\n                self.order = self.buy()\n        elif diff == -1.0:\n            if self.position:\n                self.order = self.close()",
  "assumptions": [

  "code": "import backtrader as bt\nimport math\n\n\nclass ShortTermEnergyETFStrategy(bt.Strategy):\n    params = (\n        (\"sma_period\", 50),\n        (\"rsi_period\", 14),\n    )\n\n    def __init__(self):\n        self.sma = bt.indicators.SimpleMovingAverage(\n            self.data.close, period=self.p.sma_period\n        )\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.p.rsi_period)\n        self.order = None\n        self.entry_price = None\n        self.entry_date = None\n\n    def next(self):\n        if self.order:\n            return\n\n        current_close = self.data.close[0]\n\n        if self.position:\n            gain = (current_close - self.entry_price) / self.entry_price\n            days_open = (self.data.datetime.date(0) - self.entry_date).days\n\n            if gain >= 0.10 or gain <= -0.05 or days_open > 90:\n                self.order = self.close(exectype=bt.Order.Close)\n            return\n\n        daily_increase = (current_close / self.data.close[-1]) - 1.0\n        upward_trend = self.sma[0] > self.data.close[-50]\n        valid_rsi = 40 <= self.rsi[0] <= 65\n\n        if daily_increase >= 0.02 and upward_trend and valid_rsi:\n            size = math.floor((self.broker.getvalue() * 0.05) / current_close)\n            if size > 0:\n                self.order = self.buy(size=size, exectype=bt.Order.Close)\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            if order.isbuy():\n                self.entry_price = order.executed.price\n                self.entry_date = self.data.datetime.date(0)\n            else:\n                self.entry_price = None\n                self.entry_date = None\n            self.order = None\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            self.order = None",

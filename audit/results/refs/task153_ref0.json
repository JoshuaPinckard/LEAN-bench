  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass ZScoreBollingerMeanReversion(bt.Strategy):\n    params = dict(\n        bb_period=100,\n        bb_devfactor=2,\n        atr_period=14,\n        entry_threshold=2.0,\n        stop_threshold=3.0,\n        half_life_frac=0.5,\n        atr_stop_k=3.0,\n        risk_pct=0.01,\n    )\n\n    def __init__(self):\n        self.sma = bt.indicators.SMA(self.data.close, period=self.p.bb_period)\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close, period=self.p.bb_period, devfactor=self.p.bb_devfactor\n        )\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.crossover = bt.indicators.CrossOver(self.data.close, self.sma)\n\n        self.order = None\n        self.entry_z = None\n        self.stop_price = None\n\n    def _zscore(self):\n        mid = self.sma[0]\n        std = (self.bb.top[0] - mid) / 2.0\n        if std == 0:\n            return 0.0\n        return (self.data.close[0] - mid) / std\n\n    def notify_order(self, order):\n        if order.status in (order.Submitted, order.Accepted):\n            return\n        self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        z = self._zscore()\n\n        if not self.position:\n            if z <= -self.p.entry_threshold:\n                size = (self.p.risk_pct * self.broker.getvalue()) / self.atr[0]\n                self.entry_z = z\n                self.stop_price = self.data.close[0] - self.p.atr_stop_k * self.atr[0]\n                self.order = self.buy(size=size)\n            elif z >= self.p.entry_threshold:\n                size = (self.p.risk_pct * self.broker.getvalue()) / self.atr[0]\n                self.entry_z = z\n                self.stop_price = self.data.close[0] + self.p.atr_stop_k * self.atr[0]\n                self.order = self.sell(size=size)\n            return\n\n        if self.position.size > 0:\n            if self.crossover[0] > 0:\n                self.order = self.close()\n            elif abs(z) <= self.p.half_life_frac * abs(self.entry_z):\n                self.order = self.close()\n            elif z <= -self.p.stop_threshold or self.data.close[0] <= self.stop_price:\n                self.order = self.close()\n        else:\n            if self.crossover[0] < 0:\n                self.order = self.close()\n            elif abs(z) <= self.p.half_life_frac * abs(self.entry_z):\n                self.order = self.close()\n            elif z >= self.p.stop_threshold or self.data.close[0] >= self.stop_price:\n                self.order = self.close()",

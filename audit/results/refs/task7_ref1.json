  "model": "gpt-5.6-terra(medium)",
  "code": "import backtrader as bt\n\n\nclass RSITradingStrategy(bt.Strategy):\n    params = (\n        ('rsi_period', 14),\n        ('oversold', 30),\n        ('overbought', 70),\n        ('stop_loss_pct', 0.02),\n        ('take_profit_pct', 0.04),\n    )\n\n    def __init__(self):\n        self.rsi = bt.indicators.RSI(\n            self.data.close,\n            period=self.p.rsi_period,\n            movav=bt.indicators.SmoothedMovingAverage,\n        )\n        self.entry_order = None\n        self.exit_order = None\n        self.stop_order = None\n        self.take_profit_order = None\n\n    def next(self):\n        if self.entry_order or self.exit_order:\n            return\n\n        if self.position:\n            if self.position.size > 0 and self.rsi[0] > self.p.overbought:\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                if self.take_profit_order:\n                    self.cancel(self.take_profit_order)\n                self.exit_order = self.close()\n            elif self.position.size < 0 and self.rsi[0] < self.p.oversold:\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                if self.take_profit_order:\n                    self.cancel(self.take_profit_order)\n                self.exit_order = self.close()\n            return\n\n        if self.rsi[-1] < self.p.oversold and self.rsi[0] > self.p.oversold:\n            self.entry_order = self.buy()\n        elif self.rsi[-1] > self.p.overbought and self.rsi[0] < self.p.overbought:\n            self.entry_order = self.sell()\n\n    def notify_order(self, order):\n        if order.status in (order.Submitted, order.Accepted):\n            return\n\n        if order.status == order.Completed:\n            if order == self.entry_order:\n                entry_price = order.executed.price\n\n                if order.isbuy():\n                    self.stop_order = self.sell(\n                        exectype=bt.Order.Stop,\n                        price=entry_price * (1.0 - self.p.stop_loss_pct),\n                    )\n                    self.take_profit_order = self.sell(\n                        exectype=bt.Order.Limit,\n                        price=entry_price * (1.0 + self.p.take_profit_pct),\n                        oco=self.stop_order,\n                    )\n                else:\n                    self.stop_order = self.buy(\n                        exectype=bt.Order.Stop,\n                        price=entry_price * (1.0 + self.p.stop_loss_pct),\n                    )\n                    self.take_profit_order = self.buy(\n                        exectype=bt.Order.Limit,\n                        price=entry_price * (1.0 - self.p.take_profit_pct),\n                        oco=self.stop_order,\n                    )\n\n                self.entry_order = None\n            elif order == self.exit_order:\n                self.exit_order = None\n            elif order == self.stop_order:\n                self.stop_order = None\n            elif order == self.take_profit_order:\n                self.take_profit_order = None\n\n        elif order.status in (order.Canceled, order.Margin, order.Rejected):\n            if order == self.entry_order:\n                self.entry_order = None\n            elif order == self.exit_order:\n                self.exit_order = None\n            elif order == self.stop_order:\n                self.stop_order = None\n            elif order == self.take_profit_order:\n                self.take_profit_order = None",
  "assumptions": [

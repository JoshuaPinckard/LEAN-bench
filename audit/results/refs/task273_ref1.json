  "model": "gpt-5.6-terra(medium)",
  "code": "import backtrader as bt\nimport math\n\n\nclass FairValueArbitrage(bt.Strategy):\n    def __init__(self):\n        self.ema50 = bt.indicators.EMA(self.data.close, period=50)\n        self.rsi14 = bt.indicators.RSI(self.data.close, period=14)\n        self.atr14 = bt.indicators.ATR(self.data, period=14)\n        self.bbands = bt.indicators.BollingerBands(\n            self.data.close, period=20, devfactor=2\n        )\n        self.crossover = bt.indicators.CrossOver(self.data.close, self.ema50)\n\n        self.order = None\n        self.entry_price = None\n\n    def notify_order(self, order):\n        if order.status == order.Completed:\n            if order.isbuy() and self.position.size > 0:\n                self.entry_price = order.executed.price\n            elif order.issell() and self.position.size < 0:\n                self.entry_price = order.executed.price\n            elif self.position.size == 0:\n                self.entry_price = None\n\n        if order.status in (\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ):\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        close = self.data.close[0]\n        ema = self.ema50[0]\n        spread = (close - ema) / ema\n        annual_volatility = (self.atr14[0] / close) * math.sqrt(252)\n        bandwidth = (self.bbands.top[0] - self.bbands.bot[0]) / self.bbands.mid[0]\n\n        if self.position:\n            if self.position.size > 0:\n                if (\n                    self.crossover[0] != 0\n                    or close <= self.entry_price * 0.95\n                    or close >= self.entry_price * 1.02\n                ):\n                    self.order = self.close()\n            else:\n                if (\n                    self.crossover[0] != 0\n                    or close >= self.entry_price * 1.05\n                    or close <= self.entry_price * 0.98\n                ):\n                    self.order = self.close()\n            return\n\n        if annual_volatility > 0.80 or bandwidth >= 0.30:\n            return\n\n        multiplier = min(1.5, 1 + abs(spread) / 0.02)\n        size = (self.broker.getvalue() * 0.02 * multiplier) / close\n\n        if spread <= -0.01 and self.rsi14[0] < 45:\n            self.order = self.buy(size=size)\n        elif spread >= 0.01 and self.rsi14[0] > 55:\n            self.order = self.sell(size=size)",
  "assumptions": [
    {
      "topic": "position sizing",
      "choice": "Use 2% of current portfolio value per trade, scaled by min(1.5, 1 + |Spread|/0.02).",

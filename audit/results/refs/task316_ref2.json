  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass VolatilityTrendStrategy(bt.Strategy):\n    params = (\n        (\"atr_period\", 10),\n        (\"ema_period\", 20),\n        (\"signal_period\", 20),\n        (\"band_mult\", 2.0),\n        (\"exp_mult\", 1.0),\n        (\"atr_mult\", 3.0),\n    )\n\n    def __init__(self):\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.ema = bt.indicators.EMA(self.data.close, period=self.p.ema_period)\n        self.signal = self.data.close - self.ema\n        self.signal_mean = bt.indicators.SMA(\n            self.signal, period=self.p.signal_period\n        )\n        self.signal_std = bt.indicators.StdDev(\n            self.signal, period=self.p.signal_period\n        )\n\n        self.upper_band = self.signal_mean + self.p.band_mult * self.signal_std\n        self.lower_band = self.signal_mean - self.p.band_mult * self.signal_std\n\n        self.crossover_upper = bt.indicators.CrossOver(\n            self.signal, self.upper_band\n        )\n        self.crossover_lower = bt.indicators.CrossOver(\n            self.signal, self.lower_band\n        )\n        self.crossover_mean = bt.indicators.CrossOver(\n            self.signal, self.signal_mean\n        )\n\n        self.order = None\n        self.stop_order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order == self.order:\n                self.order = None\n                if self.position.size > 0:\n                    stop_price = (\n                        order.executed.price - self.p.atr_mult * self.atr[0]\n                    )\n                    self.stop_order = self.sell(\n                        exectype=bt.Order.Stop, price=stop_price\n                    )\n                elif self.position.size < 0:\n                    stop_price = (\n                        order.executed.price + self.p.atr_mult * self.atr[0]\n                    )\n                    self.stop_order = self.buy(\n                        exectype=bt.Order.Stop, price=stop_price\n                    )\n            elif order == self.stop_order:\n                self.stop_order = None\n\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order == self.order:\n                self.order = None\n            if order == self.stop_order:\n                self.stop_order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        expansion = (\n            abs(self.signal[0] - self.signal[-1])\n            > self.p.exp_mult * self.signal_std[0]\n        )\n\n        if not self.position:\n            if self.crossover_upper[0] > 0 and expansion:\n                self.order = self.buy()\n            elif self.crossover_lower[0] < 0 and expansion:\n                self.order = self.sell()\n        else:\n            if self.position.size > 0:\n                if self.crossover_mean[0] < 0:\n                    if self.stop_order:\n                        self.cancel(self.stop_order)\n                    self.order = self.close()\n            elif self.position.size < 0:\n                if self.crossover_mean[0] > 0:\n                    if self.stop_order:\n                        self.cancel(self.stop_order)\n                    self.order = self.close()",
  "assumptions": [
    {
      "topic": "stop_loss_placement",
      "choice": "Submit stop order in notify_order upon entry fill using execution price",
      "reason": "The specification states initial stop-loss is placed at entry_price +- 3*ATR. Using order.executed.price when the entry order completes provides the exact fill price."

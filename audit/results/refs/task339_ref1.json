  "code": "import backtrader as bt\n\n\nclass ADXRocBreakoutStrategy(bt.Strategy):\n    params = (\n        (\"adx_period\", 14),\n        (\"roc_period\", 20),\n        (\"band_period\", 20),\n        (\"stop_loss_pct\", 0.02),\n    )\n\n    def __init__(self):\n        self.adx = bt.indicators.ADX(self.data, period=self.p.adx_period)\n        self.adx_roc = bt.indicators.ROC(self.adx, period=self.p.roc_period)\n        self.roc_sma = bt.indicators.SimpleMovingAverage(\n            self.adx_roc, period=self.p.band_period\n        )\n        self.roc_std = bt.indicators.StandardDeviation(\n            self.adx_roc, period=self.p.band_period\n        )\n\n        self.order = None\n        self.stop_order = None\n        self.exit_requested = False\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            if self.adx_roc[0] > self.roc_sma[0] + 2 * self.roc_std[0]:\n                self.order = self.buy()\n            elif self.adx_roc[0] < self.roc_sma[0] - 2 * self.roc_std[0]:\n                self.order = self.sell()\n            return\n\n        crossed_below = self.adx_roc[-1] >= self.roc_sma[-1] and self.adx_roc[0] < self.roc_sma[0]\n        crossed_above = self.adx_roc[-1] <= self.roc_sma[-1] and self.adx_roc[0] > self.roc_sma[0]\n\n        if (\n            (self.position.size > 0 and crossed_below)\n            or (self.position.size < 0 and crossed_above)\n        ):\n            self.exit_requested = True\n            if self.stop_order:\n                self.cancel(self.stop_order)\n            else:\n                self.order = self.close()\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order == self.stop_order:\n            if order.status in [\n                order.Completed,\n                order.Canceled,\n                order.Margin,\n                order.Rejected,\n            ]:\n                self.stop_order = None\n                if self.exit_requested and self.position and not self.order:\n                    self.exit_requested = False\n                    self.order = self.close()\n            return\n\n        if order.status == order.Completed:\n            if order.isbuy() and self.position.size > 0:\n                self.stop_order = self.sell(\n                    exectype=bt.Order.Stop,\n                    price=order.executed.price * (1 - self.p.stop_loss_pct),\n                )\n            elif order.issell() and self.position.size < 0:\n                self.stop_order = self.buy(\n                    exectype=bt.Order.Stop,\n                    price=order.executed.price * (1 + self.p.stop_loss_pct),\n                )\n\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            if order == self.order:\n                self.order = None",
  "assumptions": [

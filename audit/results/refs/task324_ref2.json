  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass IntradayVWAPBreakout(bt.Strategy):\n    params = (\n        (\"N\", 3),\n        (\"stop_loss_pct\", 0.005),\n    )\n\n    def __init__(self):\n        self.order = None\n        self.stop_order = None\n        self.cum_vol = 0.0\n        self.cum_pv = 0.0\n        self.last_date = None\n        self.vwap_vals = []\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order == self.order:\n                self.order = None\n                if self.position.size > 0:\n                    stop_price = order.executed.price * (1.0 - self.p.stop_loss_pct)\n                    self.stop_order = self.sell(\n                        exectype=bt.Order.Stop, price=stop_price\n                    )\n                elif self.position.size < 0:\n                    stop_price = order.executed.price * (1.0 + self.p.stop_loss_pct)\n                    self.stop_order = self.buy(\n                        exectype=bt.Order.Stop, price=stop_price\n                    )\n            elif order == self.stop_order:\n                self.stop_order = None\n\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order == self.order:\n                self.order = None\n            if order == self.stop_order:\n                self.stop_order = None\n\n    def next(self):\n        cur_date = self.data.datetime.date(0)\n        if self.last_date != cur_date:\n            self.cum_vol = 0.0\n            self.cum_pv = 0.0\n            self.last_date = cur_date\n\n        typical_price = (\n            self.data.high[0] + self.data.low[0] + self.data.close[0]\n        ) / 3.0\n        volume = self.data.volume[0]\n\n        self.cum_vol += volume\n        self.cum_pv += typical_price * volume\n\n        vwap = (\n            self.cum_pv / self.cum_vol if self.cum_vol > 0.0 else typical_price\n        )\n        self.vwap_vals.append(vwap)\n\n        if len(self.vwap_vals) < self.p.N + 1:\n            return\n\n        if self.order is not None:\n            return\n\n        if self.position.size > 0:\n            if self.data.close[0] < vwap:\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                    self.stop_order = None\n                self.order = self.close()\n            return\n\n        if self.position.size < 0:\n            if self.data.close[0] > vwap:\n                if self.stop_order:\n                    self.cancel(self.stop_order)\n                    self.stop_order = None\n                self.order = self.close()\n            return\n\n        long_cond = (self.data.close[0] > vwap) and all(\n            self.data.close[-i] < self.vwap_vals[-1 - i]\n            for i in range(1, self.p.N + 1)\n        )\n\n        short_cond = (self.data.close[0] < vwap) and all(\n            self.data.close[-i] > self.vwap_vals[-1 - i]\n            for i in range(1, self.p.N + 1)\n        )\n\n        if long_cond:\n            self.order = self.buy()\n        elif short_cond:\n            self.order = self.sell()",
  "assumptions": [

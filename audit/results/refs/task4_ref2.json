  "code": "import backtrader as bt\n\n\nclass AbsoluteMomentumStrategy(bt.Strategy):\n    params = (\n        (\"period\", 252),\n        (\"threshold\", 100.0),\n        (\"capital_pct\", 0.95),\n    )\n\n    def __init__(self):\n        self.mom = bt.indicators.MomentumOscillator(\n            self.data.close, period=self.p.period\n        )\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            if self.mom[0] > self.p.threshold:\n                available_cash = self.broker.getcash()\n                target_value = available_cash * self.p.capital_pct\n                size = int(target_value / self.data.close[0])\n                if size > 0:\n                    self.order = self.buy(size=size)\n        else:\n            if self.mom[0] < self.p.threshold:\n                self.order = self.close()",

  "model": "gemini-3.6-flash(vertex)",
  "code": "import backtrader as bt\n\n\nclass IntradayBreakoutStrategy(bt.Strategy):\n    def __init__(self):\n        self.bb = bt.indicators.BollingerBands(\n            self.data.close, period=20, devfactor=2.0\n        )\n        self.atr = bt.indicators.ATR(self.data, period=14)\n        self.band_width = self.bb.top - self.bb.bot\n        self.squeeze_threshold = bt.indicators.SMA(self.band_width, period=20)\n\n        self.entry_order = None\n        self.stop_order = None\n        self.exit_order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order == self.entry_order:\n                self.entry_order = None\n                entry_price = order.executed.price\n                atr_val = self.atr[0]\n                if self.position.size > 0:\n                    stop_price = entry_price - 2.0 * atr_val\n                    self.stop_order = self.sell(\n                        exectype=bt.Order.Stop, price=stop_price\n                    )\n                elif self.position.size < 0:\n                    stop_price = entry_price + 2.0 * atr_val\n                    self.stop_order = self.buy(\n                        exectype=bt.Order.Stop, price=stop_price\n                    )\n            elif order == self.stop_order:\n                self.stop_order = None\n            elif order == self.exit_order:\n                self.exit_order = None\n\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order == self.entry_order:\n                self.entry_order = None\n            elif order == self.stop_order:\n                self.stop_order = None\n            elif order == self.exit_order:\n                self.exit_order = None\n\n    def next(self):\n        if not self.position:\n            if self.entry_order is not None:\n                return\n\n            if self.band_width[0] < self.squeeze_threshold[0]:\n                if (\n                    self.data.close[0] > self.bb.top[0]\n                    and self.data.close[-1] <= self.bb.top[-1]\n                ):\n                    self.entry_order = self.buy()\n                elif (\n                    self.data.close[0] < self.bb.bot[0]\n                    and self.data.close[-1] >= self.bb.bot[-1]\n                ):\n                    self.entry_order = self.sell()\n\n        else:\n            if self.exit_order is not None:\n                return\n\n            if self.position.size > 0:\n                if (\n                    self.data.close[0] < self.bb.top[0]\n                    and self.data.close[-1] >= self.bb.top[-1]\n                ):\n                    if self.stop_order:\n                        self.cancel(self.stop_order)\n                        self.stop_order = None\n                    self.exit_order = self.close()\n            elif self.position.size < 0:\n                if (\n                    self.data.close[0] > self.bb.bot[0]\n                    and self.data.close[-1] <= self.bb.bot[-1]\n                ):\n                    if self.stop_order:\n                        self.cancel(self.stop_order)\n                        self.stop_order = None\n                    self.exit_order = self.close()",
  "assumptions": [
    {
      "topic": "atr_calculation",
      "choice": "Stop-loss distance (2 * ATR(14)) is evaluated using ATR value at the time entry order executes in notify_order.",
      "reason": "The specification states 'On entry, set a fixed stop-loss at 2 * ATR(14) from the entry price', which requires knowing the executed entry price."
    },
    {
      "topic": "stop_order_cancellation",
      "choice": "Cancel active stop-loss order upon receiving a signal-based exit signal prior to submitting the close order.",
      "reason": "Prevents redundant or conflicting pending orders when closing the position via signal exit."
    }
  ],

  "code": "import backtrader as bt\n\n\nclass IchimokuSmaStrategy(bt.Strategy):\n    params = ((\"stake\", 10),)\n\n    def __init__(self):\n        self.tenkan = bt.indicators.SMA(self.data.close, period=9)\n        self.kijun = bt.indicators.SMA(self.data.close, period=26)\n        self.span_b = bt.indicators.SMA(self.data.close, period=52)\n        self.cross = bt.indicators.CrossOver(self.tenkan, self.kijun)\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in (\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ):\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        span_a = (self.tenkan[0] + self.kijun[0]) / 2.0\n        cloud_top = max(span_a, self.span_b[0])\n        cloud_bottom = min(span_a, self.span_b[0])\n\n        if self.position.size > 0:\n            if self.cross[0] < 0 or self.data.low[0] <= self.kijun[0]:\n                self.order = self.close()\n\n        elif self.position.size < 0:\n            if self.cross[0] > 0 or self.data.high[0] >= self.kijun[0]:\n                self.order = self.close()\n\n        elif self.cross[0] > 0 and self.data.close[0] > cloud_top:\n            self.order = self.buy(size=self.p.stake)\n\n        elif self.cross[0] < 0 and self.data.close[0] < cloud_bottom:\n            self.order = self.sell(size=self.p.stake)",

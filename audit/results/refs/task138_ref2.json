  "code": "import backtrader as bt\n\n\nclass RSIStrategy(bt.Strategy):\n    params = (\n        ('rsi_period', 14),\n        ('oversold', 30),\n        ('overbought', 70),\n    )\n\n    def __init__(self):\n        self.rsi = bt.indicators.RSI(self.data.close, period=self.p.rsi_period)\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            # Long Entry: RSI drops below 30 and then rises back above 30\n            if self.rsi[-1] < self.p.oversold and self.rsi[0] > self.p.oversold:\n                price = self.data.close[0]\n                cash = self.broker.getcash()\n                size = int(cash / (price * 1.001))\n                if size > 0:\n                    self.order = self.buy(size=size)\n\n            # Short Entry: RSI rises above 70 and then falls back below 70\n            elif self.rsi[-1] > self.p.overbought and self.rsi[0] < self.p.overbought:\n                price = self.data.close[0]\n                value = self.broker.getvalue()\n                size = int(value / (price * 1.001))\n                if size > 0:\n                    self.order = self.sell(size=size)\n        else:\n            # Close Long Position when RSI rises above 70\n            if self.position.size > 0:\n                if self.rsi[0] > self.p.overbought:\n                    self.order = self.close()\n\n            # Close Short Position when RSI drops below 30\n            elif self.position.size < 0:\n                if self.rsi[0] < self.p.oversold:\n                    self.order = self.close()",
  "assumptions": [
    {
      "topic": "session_filtering",
      "choice": "Rely on native data feed timestamps in Backtrader",

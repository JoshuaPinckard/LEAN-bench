  "code": "import backtrader as bt\n\n\nclass VolatilityTrendStrategy(bt.Strategy):\n    def __init__(self):\n        self.atr = bt.indicators.ATR(self.data, period=14)\n        self.atr_ema = bt.indicators.EMA(self.atr, period=14)\n        self.sma = bt.indicators.SMA(self.data.close, period=20)\n        self.rsi = bt.indicators.RSI(self.data.close, period=14)\n        self.volume_sma = bt.indicators.SMA(self.data.volume, period=20)\n        self.rsi_cross_down = bt.indicators.CrossDown(self.rsi, 50.0)\n        self.rsi_cross_up = bt.indicators.CrossUp(self.rsi, 50.0)\n\n        self.order = None\n        self.pending_role = None\n        self.entry_atr = None\n        self.stop_loss = None\n        self.take_profit = None\n\n    def next(self):\n        if self.order:\n            return\n\n        close = self.data.close[0]\n\n        if self.position:\n            if self.position.size > 0:\n                if (close < self.sma[0] or self.rsi_cross_down[0] or\n                        close <= self.stop_loss or close >= self.take_profit):\n                    self.order = self.close()\n                    self.pending_role = 'exit'\n            else:\n                if (close > self.sma[0] or self.rsi_cross_up[0] or\n                        close >= self.stop_loss or close <= self.take_profit):\n                    self.order = self.close()\n                    self.pending_role = 'exit'\n            return\n\n        volatility_expanding = self.atr[0] > self.atr_ema[0]\n        volume_confirmed = self.data.volume[0] > self.volume_sma[0]\n\n        if (close > self.sma[0] and self.rsi[0] > 55 and\n                volatility_expanding and volume_confirmed):\n            self.entry_atr = self.atr[0]\n            self.order = self.buy()\n            self.pending_role = 'long_entry'\n\n        elif (close < self.sma[0] and self.rsi[0] < 45 and\n                volatility_expanding and volume_confirmed):\n            self.entry_atr = self.atr[0]\n            self.order = self.sell()\n            self.pending_role = 'short_entry'\n\n    def notify_order(self, order):\n        if order != self.order:\n            return\n\n        if order.status == order.Completed:\n            if self.pending_role == 'long_entry':\n                self.stop_loss = order.executed.price - 1.5 * self.entry_atr\n                self.take_profit = order.executed.price + 2.0 * self.entry_atr\n            elif self.pending_role == 'short_entry':\n                self.stop_loss = order.executed.price + 1.5 * self.entry_atr\n                self.take_profit = order.executed.price - 2.0 * self.entry_atr\n            elif self.pending_role == 'exit':\n                self.entry_atr = None\n                self.stop_loss = None\n                self.take_profit = None\n\n        if order.status in [order.Completed, order.Canceled,\n                            order.Margin, order.Rejected]:\n            if order.status != order.Completed and self.pending_role in [\n                    'long_entry', 'short_entry']:\n                self.entry_atr = None\n            self.order = None\n            self.pending_role = None",

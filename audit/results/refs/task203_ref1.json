  "code": "import backtrader as bt\n\n\nclass MeanReversionBollingerZScore(bt.Strategy):\n    params = (\n        ('lookback', 20),\n        ('half_life', 10),\n        ('entry_threshold', 2.0),\n        ('stoploss_factor', 1.5),\n        ('narrow_band_epsilon', 1e-12),\n    )\n\n    def __init__(self):\n        self.order = None\n        self.bbands = bt.indicators.BollingerBands(\n            self.data.close, period=self.p.lookback, devfactor=2\n        )\n        self.band_width = self.bbands.top - self.bbands.mid\n        self.z = 2.0 * (self.data.close - self.bbands.mid) / self.band_width\n        self.z_ema = bt.indicators.EMA(self.z, period=self.p.half_life)\n        self.z_cross_up = bt.indicators.CrossUp(self.z_ema, 0.0)\n        self.z_cross_down = bt.indicators.CrossDown(self.z_ema, 0.0)\n        self.stoploss_threshold = (\n            self.p.entry_threshold * self.p.stoploss_factor\n        )\n\n    def next(self):\n        if self.order:\n            return\n\n        if abs(self.band_width[0]) <= self.p.narrow_band_epsilon:\n            return\n\n        if not self.position:\n            if self.z[0] < -self.p.entry_threshold:\n                self.order = self.buy()\n            elif self.z[0] > self.p.entry_threshold:\n                self.order = self.sell()\n            return\n\n        if self.position.size > 0:\n            if self.z_cross_up[0] or self.z[0] >= self.stoploss_threshold:\n                self.order = self.close()\n        elif self.position.size < 0:\n            if self.z_cross_down[0] or self.z[0] <= -self.stoploss_threshold:\n                self.order = self.close()\n\n    def notify_order(self, order):\n        if order.status in (\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ):\n            self.order = None",

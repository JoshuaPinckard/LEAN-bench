  "model": "gemini-3.6-flash(vertex)",
  "code": "import math\nimport backtrader as bt\n\n\nclass MACDATRStrategy(bt.Strategy):\n    params = (\n        (\"macd_fast\", 12),\n        (\"macd_slow\", 26),\n        (\"macd_signal\", 9),\n        (\"atr_period\", 14),\n        (\"risk_pct\", 0.01),\n        (\"sl_atr_mult\", 1.0),\n        (\"tp_atr_mult\", 3.0),\n    )\n\n    def __init__(self):\n        self.macd = bt.ind.MACD(\n            self.data.close,\n            period_me1=self.p.macd_fast,\n            period_me2=self.p.macd_slow,\n            period_signal=self.p.macd_signal,\n        )\n        self.atr = bt.ind.ATR(self.data, period=self.p.atr_period)\n        self.crossover = bt.ind.CrossOver(self.macd.macd, 0.0)\n\n        self.order = None\n        self.sl_order = None\n        self.tp_order = None\n        self.entry_atr = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status == order.Completed:\n            if order == self.order:\n                self.order = None\n                entry_price = order.executed.price\n                atr_val = self.entry_atr\n                size = abs(order.executed.size)\n\n                if order.isbuy():\n                    sl_price = entry_price - self.p.sl_atr_mult * atr_val\n                    tp_price = entry_price + self.p.tp_atr_mult * atr_val\n                    self.sl_order = self.sell(\n                        size=size, price=sl_price, exectype=bt.Order.Stop\n                    )\n                    self.tp_order = self.sell(\n                        size=size,\n                        price=tp_price,\n                        exectype=bt.Order.Limit,\n                        oco=self.sl_order,\n                    )\n                else:\n                    sl_price = entry_price + self.p.sl_atr_mult * atr_val\n                    tp_price = entry_price - self.p.tp_atr_mult * atr_val\n                    self.sl_order = self.buy(\n                        size=size, price=sl_price, exectype=bt.Order.Stop\n                    )\n                    self.tp_order = self.buy(\n                        size=size,\n                        price=tp_price,\n                        exectype=bt.Order.Limit,\n                        oco=self.sl_order,\n                    )\n\n            elif order == self.sl_order or order == self.tp_order:\n                self.sl_order = None\n                self.tp_order = None\n\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order == self.order:\n                self.order = None\n            if order == self.sl_order or order == self.tp_order:\n                self.sl_order = None\n                self.tp_order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            if self.crossover[0] > 0:\n                atr_val = self.atr[0]\n                if atr_val <= 0:\n                    return\n                risk_amount = self.broker.getvalue() * self.p.risk_pct\n                size = int(risk_amount / (self.p.sl_atr_mult * atr_val))\n                max_size = int(self.broker.getcash() / self.data.close[0])\n                size = min(size, max_size)\n                if size > 0:\n                    self.entry_atr = atr_val\n                    self.order = self.buy(size=size)\n\n            elif self.crossover[0] < 0:\n                atr_val = self.atr[0]\n                if atr_val <= 0:\n                    return\n                risk_amount = self.broker.getvalue() * self.p.risk_pct\n                size = int(risk_amount / (self.p.sl_atr_mult * atr_val))\n                max_size = int(self.broker.getcash() / self.data.close[0])\n                size = min(size, max_size)\n                if size > 0:\n                    self.entry_atr = atr_val\n                    self.order = self.sell(size=size)",
  "assumptions": [
    {
      "topic": "risk_percentage",
      "choice": "1% of portfolio equity (0.01)",
      "reason": "Specification states risking 1-2% of capital per trade; selected 1% as standard conservative baseline within the specified range."
    },
    {
      "topic": "capital_basis",
      "choice": "self.broker.getvalue() (total equity)",
      "reason": "Total account equity is the standard basis for percentage risk calculations."
    },
    {
      "topic": "atr_value_reference",
      "choice": "ATR at time of entry signal generation",
      "reason": "The ATR value at signal time is stored to compute both the position size and the distance for SL/TP exit prices once entry executes."
    },
    {
      "topic": "position_size_cap",
      "choice": "Capped by available cash",
      "reason": "Prevents order rejection due to insufficient cash/margin when sizing trades."
    }
  ],

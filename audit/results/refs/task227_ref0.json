  "code": "import backtrader as bt\n\n\nclass UniversalPortfolioStrategy(bt.Strategy):\n    params = dict(\n        window=252,\n        fractions=tuple(round(i * 0.1, 1) for i in range(11)),\n    )\n\n    def __init__(self):\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in (order.Completed, order.Canceled, order.Margin, order.Rejected):\n            self.order = None\n\n    def next(self):\n        if self.order is not None:\n            return\n\n        if len(self.data) < self.p.window + 1:\n            return\n\n        closes = self.data.close.get(size=self.p.window + 1)\n        returns = [closes[i] / closes[i - 1] - 1 for i in range(1, len(closes))]\n\n        numerator = 0.0\n        denominator = 0.0\n        for w in self.p.fractions:\n            wealth = 1.0\n            for r in returns:\n                wealth *= (1 + w * r)\n            numerator += w * wealth\n            denominator += wealth\n\n        w_next = numerator / denominator if denominator else 0.0\n\n        self.order = self.order_target_percent(target=w_next)",

  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass MACDZeroCrossATRStrategy(bt.Strategy):\n    params = dict(\n        macd_fast=12,\n        macd_slow=26,\n        macd_signal=9,\n        atr_period=14,\n        risk_pct=0.01,      # see assumptions: fixed choice within stated 1-2% range\n        sl_atr_mult=1.0,\n        tp_atr_mult=3.0,\n    )\n\n    def __init__(self):\n        self.macd = bt.indicators.MACD(\n            self.data.close,\n            period_me1=self.p.macd_fast,\n            period_me2=self.p.macd_slow,\n            period_signal=self.p.macd_signal,\n        )\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n        if order == self.order:\n            if order.status in [order.Completed, order.Canceled,\n                                 order.Margin, order.Rejected]:\n                self.order = None\n\n    def next(self):\n        if self.order:\n            return\n        if self.position:\n            return\n\n        if len(self) < 2:\n            return\n\n        macd_now = self.macd.macd[0]\n        macd_prev = self.macd.macd[-1]\n\n        cross_up = macd_prev <= 0.0 and macd_now > 0.0\n        cross_down = macd_prev >= 0.0 and macd_now < 0.0\n\n        if not (cross_up or cross_down):\n            return\n\n        atr_val = self.atr[0]\n        if atr_val <= 0:\n            return\n\n        capital = self.broker.getvalue()\n        risk_amount = capital * self.p.risk_pct\n        stop_distance = self.p.sl_atr_mult * atr_val\n        size = int(risk_amount / stop_distance)\n        if size <= 0:\n            return\n\n        entry_price = self.data.close[0]\n\n        if cross_up:\n            sl_price = entry_price - self.p.sl_atr_mult * atr_val\n            tp_price = entry_price + self.p.tp_atr_mult * atr_val\n            orders = self.buy_bracket(\n                size=size,\n                exectype=bt.Order.Market,\n                stopprice=sl_price,\n                limitprice=tp_price,\n            )\n            self.order = orders[0]\n        elif cross_down:\n            sl_price = entry_price + self.p.sl_atr_mult * atr_val\n            tp_price = entry_price - self.p.tp_atr_mult * atr_val\n            orders = self.sell_bracket(\n                size=size,\n                exectype=bt.Order.Market,\n                stopprice=sl_price,\n                limitprice=tp_price,\n            )\n            self.order = orders[0]",
  "assumptions": [
    {
      "topic": "risk percentage",
      "choice": "Fixed risk_pct at 1% of capital per trade (lower bound of the stated 1-2% range)",
      "reason": "Spec gives a range (\"1-2%\") without a rule for selecting within it; a single fixed value is required for a deterministic reference implementation, so the conservative lower bound was chosen."
    },
    {
      "topic": "capital base for risk sizing",
      "choice": "Use self.broker.getvalue() (total portfolio value) as \"capital\" at the moment of each entry signal",
      "reason": "Spec says \"risking X% of capital\" but does not define capital as cash-only vs. mark-to-market equity; portfolio value is the standard interpretation."
    },
    {
      "topic": "share rounding",
      "choice": "Truncate computed size to a whole number of shares via int()",
      "reason": "Backtrader positions must be in whole units and the spec does not specify a rounding convention."
    },
    {
      "topic": "entry order type",
      "choice": "Market order submitted on the signal bar (fills at next bar's open, backtrader's standard execution timing)",
      "reason": "Spec states the crossover condition but not an explicit order type for entry; market execution is the literal reading of an unconditional entry on signal."
    },
    {
      "topic": "infeasible",
      "choice": "SL/TP prices are computed from the signal bar's close price as a proxy for \"entry price\", then submitted immediately as OCO bracket orders (stop for SL, limit for TP) alongside the market entry order",
      "reason": "The true fill price of a market order is only known after execution on the next bar, but backtrader's buy_bracket/sell_bracket API requires SL/TP prices to be fixed at submission time; using the signal-bar close is the closest literal implementation of \"SL/TP placed immediately after entry\" given this execution-timing constraint."
    },
    {
      "topic": "position management during open position",
      "choice": "Ignore new MACD zero-crossings (including opposite-direction signals) while a position or its bracket orders are open; only one position at a time, no reversal handling",
      "reason": "Spec does not describe behavior for a crossover occurring while a trade is already open; canonical default disallows pyramiding/re-entry absent contrary instruction."
    }
  ],

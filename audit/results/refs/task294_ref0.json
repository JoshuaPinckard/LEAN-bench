{
  "task_id": 294,
  "ref_idx": 0,
  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass TimeSeriesMomentumStrategy(bt.Strategy):\n    params = dict(\n        N=90,\n        R=21,\n        w=0.20,\n        max_alloc=0.10,\n        vol_period=21,\n        min_dollar_vol=1_000_000,\n        flat_band=1e-4,\n    )\n\n    def __init__(self):\n        dollar_volume = self.data.close * self.data.volume\n        self.avg_dollar_vol = bt.indicators.SMA(dollar_volume, period=self.p.vol_period)\n        self.crossover = bt.indicators.CrossOver(self.data.close, self.data.close(-self.p.N))\n        self.orders = []\n\n    def notify_order(self, order):\n        if order.status in (order.Completed, order.Canceled, order.Margin, order.Rejected):\n            if order in self.orders:\n                self.orders.remove(order)\n\n    def next(self):\n        if self.orders:\n            return\n\n        is_rebalance_day = len(self) % self.p.R == 0\n\n        if not is_rebalance_day:\n            if self.position and self.crossover[0] != 0:\n                order = self.close()\n                if order:\n                    self.orders.append(order)\n            return\n\n        if self.position:\n            order = self.close()\n            if order:\n                self.orders.append(order)\n\n        has_history = len(self) >= self.p.N + 1\n        liquid = self.avg_dollar_vol[0] >= self.p.min_dollar_vol\n        if not (has_history and liquid):\n            return\n\n        momentum = self.data.close[0] / self.data.close[-self.p.N] - 1.0\n        if abs(momentum) < self.p.flat_band:\n            return\n\n        alloc_fraction = min(self.p.w, self.p.max_alloc)\n        target_value = self.broker.getvalue() * alloc_fraction\n        size = int(target_value / self.data.close[0])\n        if size <= 0:\n            return\n\n        if momentum > 0:\n            order = self.buy(size=size)\n        else:\n            order = self.sell(size=size)\n        if order:\n            self.orders.append(order)",
  "assumptions": [
    {
      "topic": "flat-momentum threshold",
      "choice": "Treat |M| < 1e-4 as 'close to 0' and stay out on the rebalancing date",
      "reason": "Spec requires a distinct stay-out band around zero momentum but never gives a numeric epsilon; a small fixed threshold is needed to make the three-way M>0/M<0/M~0 decision computable."
    },
    {
      "topic": "rebalancing schedule anchor",
      "choice": "Rebalance whenever len(self) % R == 0, i.e. every R-th bar counted from the very first bar of the whole feed (not from the first bar with valid indicators)",
      "reason": "Spec states rebalancing frequency R but not the calendar phase/anchor of the cycle; anchoring to the raw bar index is the simplest deterministic choice."
    },
    {
      "topic": "liquidity filter scope",
      "choice": "Apply the SMA(21) dollar-volume and N-day-history filter only to new entries at rebalancing, not to the zero-crossing exit or to the mandatory close-all-positions step at each rebalance",
      "reason": "The liquidity sentence directly follows the entry-decision description; forcing a position to remain open because volume dried up would contradict normal risk practice and the spec never says exits are liquidity-gated."
    },
    {
      "topic": "share sizing",
      "choice": "size = int(broker.getvalue() * min(w, 10%) / close[0]), truncated to whole shares, no commission buffer",
      "reason": "Spec states the target capital allocation as a percentage but not how to convert it to a discrete share count; whole-share rounding is the standard, simplest interpretation."
    },
    {
      "topic": "rebalance order sequencing",
      "choice": "On a rebalancing bar, submit a self.close() order for any existing position, then separately evaluate the (possibly new) signal and submit a fresh buy()/sell() order in the same call, rather than a single order_target_percent adjustment",
      "reason": "Spec literally describes rebalancing as two discrete steps ('all positions are closed and the signal is re-evaluated'); issuing two sequential orders preserves that structure for the execution-trace comparison instead of collapsing it into one net-position order."
    }
  ],

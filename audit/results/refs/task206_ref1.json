  "code": "import backtrader as bt\n\n\nclass MeanReversionStrategy(bt.Strategy):\n    params = (\n        (\"base_threshold\", 2.0),\n        (\"risk_fraction\", 0.01),\n    )\n\n    def __init__(self):\n        self.bbands = bt.indicators.BollingerBands(\n            self.data.close, period=30, devfactor=2\n        )\n        self.atr = bt.indicators.ATR(self.data, period=14)\n        self.atr_ema = bt.indicators.EMA(self.atr, period=50)\n        self.rsi = bt.indicators.RSI(self.data.close, period=14)\n        self.volume_sma = bt.indicators.SMA(self.data.volume, period=20)\n\n        self.order = None\n        self.entry_price = None\n        self.entry_bar = None\n\n    def notify_order(self, order):\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n            if order.status == order.Completed:\n                if order.isbuy() and self.position.size == order.executed.size:\n                    self.entry_price = order.executed.price\n                    self.entry_bar = len(self)\n                elif order.issell() and self.position.size == order.executed.size:\n                    self.entry_price = order.executed.price\n                    self.entry_bar = len(self)\n\n            if not self.position:\n                self.entry_price = None\n                self.entry_bar = None\n\n    def next(self):\n        if self.order:\n            return\n\n        mid = self.bbands.mid[0]\n        std = (self.bbands.top[0] - mid) / 2.0\n        atr = self.atr[0]\n        atr_ema = self.atr_ema[0]\n\n        if std == 0 or atr <= 0 or atr_ema <= 0:\n            return\n\n        z = (self.data.close[0] - mid) / std\n        previous_std = (self.bbands.top[-1] - self.bbands.mid[-1]) / 2.0\n        previous_z = (\n            (self.data.close[-1] - self.bbands.mid[-1]) / previous_std\n            if previous_std != 0\n            else 0.0\n        )\n\n        vr = atr / atr_ema\n        clipped_vr = max(0.7, min(1.6, vr))\n        threshold = self.p.base_threshold * clipped_vr\n\n        if self.position:\n            time_stop = (\n                self.entry_bar is not None and len(self) - self.entry_bar >= 7\n            )\n\n            if self.position.size > 0:\n                stop_loss = self.data.close[0] <= self.entry_price - (1.5 * atr)\n                zero_cross = previous_z < 0 and z >= 0\n            else:\n                stop_loss = self.data.close[0] >= self.entry_price + (1.5 * atr)\n                zero_cross = previous_z > 0 and z <= 0\n\n            if zero_cross or stop_loss or time_stop:\n                self.order = self.close()\n            return\n\n        risk_amount = self.broker.getvalue() * self.p.risk_fraction\n        quantity = risk_amount / (1.5 * atr)\n\n        if (\n            z < -threshold\n            and self.rsi[0] < 45\n            and self.data.volume[0] > self.volume_sma[0]\n        ):\n            self.order = self.buy(size=quantity)\n        elif (\n            z > threshold\n            and self.rsi[0] > 55\n            and self.data.volume[0] > self.volume_sma[0]\n        ):\n            self.order = self.sell(size=quantity)",
  "assumptions": [

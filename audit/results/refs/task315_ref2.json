  "code": "import backtrader as bt\n\n\nclass ReferenceStrategy(bt.Strategy):\n    params = (\n        (\"sma_period\", 20),\n        (\"commission\", 0.001),\n        (\"stop_loss_pct\", 0.02),\n    )\n\n    def __init__(self):\n        self.sma = bt.indicators.SMA(self.data.close, period=self.p.sma_period)\n        self.order = None\n        self.stop_order = None\n        self.entry_ym = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order.isbuy():\n                self.order = None\n                entry_price = order.executed.price\n                stop_price = entry_price * (1.0 - self.p.stop_loss_pct)\n                self.stop_order = self.sell(\n                    exectype=bt.Order.Stop,\n                    price=stop_price,\n                    size=order.executed.size,\n                )\n                dt = self.data.datetime.date(0)\n                self.entry_ym = (dt.year, dt.month)\n            else:\n                if order == self.stop_order:\n                    self.stop_order = None\n                if order == self.order:\n                    self.order = None\n\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order == self.order:\n                self.order = None\n            if order == self.stop_order:\n                self.stop_order = None\n\n    def next(self):\n        curr_date = self.data.datetime.date(0)\n        prev_date = self.data.datetime.date(-1)\n\n        # Exit rule evaluation\n        if self.position:\n            is_first_on_or_after_5 = (curr_date.day >= 5) and (\n                prev_date.month != curr_date.month or prev_date.day < 5\n            )\n            curr_ym = (curr_date.year, curr_date.month)\n            if (\n                self.entry_ym\n                and curr_ym > self.entry_ym\n                and is_first_on_or_after_5\n            ):\n                if self.order is None:\n                    if self.stop_order:\n                        self.cancel(self.stop_order)\n                        self.stop_order = None\n                    self.order = self.close()\n            return\n\n        # Entry rule evaluation\n        if not self.position and self.order is None:\n            is_first_on_or_after_25 = (curr_date.day >= 25) and (\n                prev_date.month != curr_date.month or prev_date.day < 25\n            )\n            if is_first_on_or_after_25:\n                if self.data.close[0] > self.sma[0]:\n                    cash = self.broker.getcash()\n                    price = self.data.close[0]\n                    size = int(cash / (price * (1.0 + self.p.commission)))\n                    if size > 0:\n                        self.order = self.buy(size=size)",

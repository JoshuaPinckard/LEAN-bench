  "code": "import backtrader as bt\nimport math\n\n\nclass SwingMomentumStrategy(bt.Strategy):\n    params = (\n        ('commission_rate', 0.001),\n    )\n\n    def __init__(self):\n        self.sma200 = bt.indicators.SMA(self.data.close, period=200)\n        self.ema20 = bt.indicators.EMA(self.data.close, period=20)\n        self.ema50 = bt.indicators.EMA(self.data.close, period=50)\n        self.rsi14 = bt.indicators.RSI(self.data.close, period=14)\n        self.atr14 = bt.indicators.ATR(self.data, period=14)\n        self.volume_sma20 = bt.indicators.SMA(self.data.volume, period=20)\n\n        self.order = None\n        self.added_once = False\n        self.initial_stop = None\n        self.highest_close_since_entry = None\n\n    def notify_order(self, order):\n        if order.status in [\n            order.Completed, order.Canceled, order.Margin, order.Rejected\n        ]:\n            if order.status == order.Completed and order.isbuy():\n                if not self.position or order.executed.size >= self.position.size:\n                    self.added_once = False\n                    self.highest_close_since_entry = self.data.close[0]\n                    self.initial_stop = (\n                        order.executed.price\n                        - max(0.08 * order.executed.price, 2 * self.atr14[0])\n                    )\n            self.order = None\n\n    def _buy_size(self, allocation):\n        capital = self.broker.getvalue()\n        price = self.data.close[0]\n        if price <= 0:\n            return 0\n\n        allocation_size = math.floor((capital * allocation) / price)\n        affordable_size = math.floor(\n            self.broker.getcash() / (price * (1 + self.p.commission_rate))\n        )\n        return max(0, min(allocation_size, affordable_size))\n\n    def next(self):\n        if self.order:\n            return\n\n        ema_bull_cross = self.ema20[-1] < self.ema50[-1] and self.ema20[0] > self.ema50[0]\n        ema_bear_cross = self.ema20[-1] > self.ema50[-1] and self.ema20[0] < self.ema50[0]\n        rsi_bull_cross = self.rsi14[-1] < 50 and self.rsi14[0] > 50\n        rsi_bear_cross = self.rsi14[-1] > 50 and self.rsi14[0] < 50\n\n        if not self.position:\n            if self.data.close[0] > self.sma200[0] and (ema_bull_cross or rsi_bull_cross):\n                size = self._buy_size(0.60)\n                if size > 0:\n                    self.order = self.buy(size=size)\n            return\n\n        if self.highest_close_since_entry is None:\n            self.highest_close_since_entry = self.data.close[0]\n            self.initial_stop = (\n                self.position.price\n                - max(0.08 * self.position.price, 2 * self.atr14[0])\n            )\n\n        self.highest_close_since_entry = max(\n            self.highest_close_since_entry, self.data.close[0]\n        )\n        trailing_stop = max(\n            self.initial_stop,\n            self.highest_close_since_entry - 3 * self.atr14[0],\n        )\n\n        if (\n            self.data.close[0] >= self.position.price * 1.18\n            or self.data.close[0] <= trailing_stop\n            or ema_bear_cross\n            or rsi_bear_cross\n        ):\n            self.order = self.close()\n            return\n\n        pullback = (\n            (self.highest_close_since_entry - self.data.close[0])\n            / self.highest_close_since_entry\n        )\n\n        if (\n            not self.added_once\n            and 0.10 <= pullback <= 0.15\n            and self.data.close[0] > self.sma200[0]\n            and self.ema20[0] > self.ema50[0]\n        ):\n            capital = self.broker.getvalue()\n            max_position_size = math.floor((capital * 0.80) / self.data.close[0])\n            add_size = min(\n                self._buy_size(0.20),\n                max(0, max_position_size - self.position.size),\n            )\n            if add_size > 0:\n                self.added_once = True\n                self.order = self.buy(size=add_size)",

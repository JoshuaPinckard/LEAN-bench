  "code": "import backtrader as bt\n\n\nclass PulseWave(bt.Strategy):\n    params = (\n        ('vwap_period', 20),\n    )\n\n    def __init__(self):\n        self.order = None\n\n        self.macd = bt.indicators.MACD(\n            self.data.close,\n            period_me1=12,\n            period_me2=26,\n            period_signal=9\n        )\n        self.rsi = bt.indicators.RSI(self.data.close, period=14)\n\n        typical_price = (self.data.high + self.data.low + self.data.close) / 3.0\n        tp_volume = typical_price * self.data.volume\n        sum_tp_volume = bt.indicators.SumN(tp_volume, period=self.p.vwap_period)\n        sum_volume = bt.indicators.SumN(self.data.volume, period=self.p.vwap_period)\n        self.vwap = sum_tp_volume / sum_volume\n\n        self.crossover = bt.indicators.CrossOver(self.macd.macd, self.macd.signal)\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        if not self.position:\n            if (self.data.close[0] > self.vwap[0] and\n                self.crossover[0] > 0 and\n                self.rsi[0] < 70):\n                self.order = self.buy()\n        else:\n            if (self.data.close[0] < self.vwap[0] and\n                self.crossover[0] < 0 and\n                self.rsi[0] > 30):\n                self.order = self.close()",

  "code": "import backtrader as bt\nimport math\n\n\nclass MeanReversionVolTargetStrategy(bt.Strategy):\n    params = (\n        ('capital', 10000.0),\n        ('risk_factor', 100.0),\n    )\n\n    def __init__(self):\n        self.bb2 = bt.indicators.BollingerBands(\n            self.data.close, period=100, devfactor=2\n        )\n        self.bb3 = bt.indicators.BollingerBands(\n            self.data.close, period=100, devfactor=3\n        )\n        self.atr = bt.indicators.ATR(self.data, period=20)\n        self.mid_cross = bt.indicators.CrossOver(self.data.close, self.bb2.mid)\n\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in (\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ):\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        close = self.data.close[0]\n        mid = self.bb2.mid[0]\n        atr = self.atr[0]\n\n        if self.position:\n            if self.position.size > 0:\n                if (self.data.low[0] <= self.bb3.bot[0] or\n                        self.mid_cross[0] > 0 or\n                        abs(close - mid) <= 0.25 * (self.bb2.top[0] - mid)):\n                    self.order = self.close()\n            else:\n                if (self.data.high[0] >= self.bb3.top[0] or\n                        self.mid_cross[0] < 0 or\n                        abs(close - mid) <= 0.25 * (self.bb2.top[0] - mid)):\n                    self.order = self.close()\n            return\n\n        if atr <= 0:\n            return\n\n        shares = min(\n            self.broker.getcash() / close,\n            math.floor(self.p.capital / (atr * self.p.risk_factor)),\n        )\n\n        if shares <= 0:\n            return\n\n        if close < self.bb2.bot[0]:\n            self.order = self.buy(size=shares)\n        elif close > self.bb2.top[0]:\n            self.order = self.sell(size=shares)",

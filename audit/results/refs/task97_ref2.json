  "code": "import backtrader as bt\n\n\nclass EmaForecastingStrategy(bt.Strategy):\n    params = (\n        (\"ema_period\", 21),\n        (\"trend_period\", 50),\n        (\"threshold\", 0.005),\n        (\"stop_loss\", 0.02),\n        (\"take_profit\", 0.03),\n    )\n\n    def __init__(self):\n        self.k = 2.0 / (self.p.ema_period + 1.0)\n        self.ema21 = bt.indicators.ExponentialMovingAverage(\n            self.data.close, period=self.p.ema_period\n        )\n        self.ema50 = bt.indicators.ExponentialMovingAverage(\n            self.data.close, period=self.p.trend_period\n        )\n\n        # EMA_forecast(N+1) = (Close(N) * k) + (EMA(N) * (1 - k))\n        self.ema_forecast = (\n            self.data.close * self.k + self.ema21 * (1.0 - self.k)\n        )\n\n        # CrossOver indicator: +1 when close crosses forecast from below to above, -1 when above to below\n        self.crossover = bt.indicators.CrossOver(\n            self.data.close, self.ema_forecast\n        )\n\n        self.entry_order = None\n        self.sl_order = None\n        self.tp_order = None\n        self.exit_order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n\n        if order.status in [order.Completed]:\n            if order == self.entry_order:\n                self.entry_order = None\n                exec_price = order.executed.price\n                exec_size = abs(order.executed.size)\n                if order.isbuy():\n                    sl_price = exec_price * (1.0 - self.p.stop_loss)\n                    tp_price = exec_price * (1.0 + self.p.take_profit)\n                    self.sl_order = self.sell(\n                        exectype=bt.Order.Stop, price=sl_price, size=exec_size\n                    )\n                    self.tp_order = self.sell(\n                        exectype=bt.Order.Limit,\n                        price=tp_price,\n                        size=exec_size,\n                        oco=self.sl_order,\n                    )\n                else:\n                    sl_price = exec_price * (1.0 + self.p.stop_loss)\n                    tp_price = exec_price * (1.0 - self.p.take_profit)\n                    self.sl_order = self.buy(\n                        exectype=bt.Order.Stop, price=sl_price, size=exec_size\n                    )\n                    self.tp_order = self.buy(\n                        exectype=bt.Order.Limit,\n                        price=tp_price,\n                        size=exec_size,\n                        oco=self.sl_order,\n                    )\n            elif order in [self.sl_order, self.tp_order]:\n                self.sl_order = None\n                self.tp_order = None\n            elif order == self.exit_order:\n                self.exit_order = None\n\n        elif order.status in [order.Canceled, order.Margin, order.Rejected]:\n            if order == self.entry_order:\n                self.entry_order = None\n            if order == self.sl_order:\n                self.sl_order = None\n            if order == self.tp_order:\n                self.tp_order = None\n            if order == self.exit_order:\n                self.exit_order = None\n\n    def next(self):\n        if self.entry_order or self.exit_order:\n            return\n\n        if self.position:\n            if self.position.size > 0 and self.crossover[0] < 0:\n                if self.sl_order:\n                    self.cancel(self.sl_order)\n                    self.sl_order = None\n                if self.tp_order:\n                    self.cancel(self.tp_order)\n                    self.tp_order = None\n                self.exit_order = self.close()\n            elif self.position.size < 0 and self.crossover[0] > 0:\n                if self.sl_order:\n                    self.cancel(self.sl_order)\n                    self.sl_order = None\n                if self.tp_order:\n                    self.cancel(self.tp_order)\n                    self.tp_order = None\n                self.exit_order = self.close()\n        else:\n            close_val = self.data.close[0]\n            forecast_val = self.ema_forecast[0]\n\n            long_diff = (forecast_val - close_val) / close_val\n            long_signal = (close_val < forecast_val) and (\n                long_diff >= self.p.threshold\n            )\n            if self.ema50[0] <= self.ema50[-1]:\n                long_signal = False\n\n            short_diff = (close_val - forecast_val) / close_val\n            short_signal = (close_val > forecast_val) and (\n                short_diff >= self.p.threshold\n            )\n            if self.ema50[0] >= self.ema50[-1]:\n                short_signal = False\n\n            if long_signal:\n                size = int((self.broker.getcash() * 0.99) / close_val)\n                if size > 0:\n                    self.entry_order = self.buy(size=size)\n            elif short_signal:\n                size = int((self.broker.getcash() * 0.99) / close_val)\n                if size > 0:\n                    self.entry_order = self.sell(size=size)",
  "assumptions": [
    {
      "topic": "threshold_calculation",
      "choice": "Calculated threshold relative to current close price as abs(Close - EMA_forecast) / Close >= 0.005.",
      "reason": "The specification states that the difference between Close(N) and EMA_forecast(N+1) must be at least 0.5%."
    },
    {
      "topic": "trend_filter_ema50",
      "choice": "Implemented EMA(50) trend filter where Long requires EMA50[0] > EMA50[-1] and Short requires EMA50[0] < EMA50[-1].",
      "reason": "Specification states under Additional Rules that trades are allowed only in the direction of the main trend determined by EMA(50)."
    },
    {
      "topic": "position_sizing",
      "choice": "Calculated position size as int(self.broker.getcash() * 0.99 / self.data.close[0]) to utilize ~100% of available capital while leaving buffer for commission.",
      "reason": "Specification dictates fixed position size of 100% of available capital per trade."
    },
    {

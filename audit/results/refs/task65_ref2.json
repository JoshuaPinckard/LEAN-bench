  "code": "import math\nimport backtrader as bt\n\n\nclass SimpleMLP:\n    \"\"\"Multi-Layer Perceptron classifier implemented in pure Python.\"\"\"\n\n    def __init__(self, input_dim=3, hidden_dim=8, output_dim=3):\n        self.input_dim = input_dim\n        self.hidden_dim = hidden_dim\n        self.output_dim = output_dim\n\n        # Deterministic weight initialization\n        self.W1 = [\n            [math.sin(i * input_dim + j + 1) * 0.1 for j in range(input_dim)]\n            for i in range(hidden_dim)\n        ]\n        self.b1 = [0.0 for _ in range(hidden_dim)]\n\n        self.W2 = [\n            [math.cos(k * hidden_dim + i + 1) * 0.1 for i in range(hidden_dim)]\n            for k in range(output_dim)\n        ]\n        self.b2 = [0.0 for _ in range(output_dim)]\n\n    def forward(self, x):\n        # Hidden layer with ReLU\n        z1 = [\n            self.b1[i] + sum(self.W1[i][j] * x[j] for j in range(self.input_dim))\n            for i in range(self.hidden_dim)\n        ]\n        a1 = [max(0.0, val) for val in z1]\n\n        # Output layer\n        z2 = [\n            self.b2[k] + sum(self.W2[k][i] * a1[i] for i in range(self.hidden_dim))\n            for k in range(self.output_dim)\n        ]\n\n        # Softmax\n        max_z2 = max(z2)\n        exps = [math.exp(val - max_z2) for val in z2]\n        sum_exps = sum(exps)\n        probs = [val / sum_exps for val in exps]\n\n        return z1, a1, z2, probs\n\n    def train(self, X, Y, epochs=50, lr=0.01):\n        for _ in range(epochs):\n            for x, y_idx in zip(X, Y):\n                y = [1.0 if k == y_idx else 0.0 for k in range(self.output_dim)]\n\n                z1, a1, z2, probs = self.forward(x)\n\n                dz2 = [probs[k] - y[k] for k in range(self.output_dim)]\n\n                dW2 = [\n                    [dz2[k] * a1[i] for i in range(self.hidden_dim)]\n                    for k in range(self.output_dim)\n                ]\n                db2 = [dz2[k] for k in range(self.output_dim)]\n\n                da1 = [\n                    sum(self.W2[k][i] * dz2[k] for k in range(self.output_dim))\n                    for i in range(self.hidden_dim)\n                ]\n                dz1 = [da1[i] if z1[i] > 0 else 0.0 for i in range(self.hidden_dim)]\n\n                dW1 = [\n                    [dz1[i] * x[j] for j in range(self.input_dim)]\n                    for i in range(self.hidden_dim)\n                ]\n                db1 = [dz1[i] for i in range(self.hidden_dim)]\n\n                for k in range(self.output_dim):\n                    for i in range(self.hidden_dim):\n                        self.W2[k][i] -= lr * dW2[k][i]\n                    self.b2[k] -= lr * db2[k]\n\n                for i in range(self.hidden_dim):\n                    for j in range(self.input_dim):\n                        self.W1[i][j] -= lr * dW1[i][j]\n                    self.b1[i] -= lr * db1[i]\n\n    def predict(self, x):\n        _, _, _, probs = self.forward(x)\n        max_p = -1.0\n        best_class = 2\n        for k in range(self.output_dim):\n            if probs[k] > max_p:\n                max_p = probs[k]\n                best_class = k\n        return best_class\n\n\nclass NeuralNetworkClassifierStrategy(bt.Strategy):\n    \"\"\"\n    Trading Strategy based on a Neural Network Classifier.\n    Uses Open Price, RSI(14), and Williams %R(14) to classify market states into BUY, SELL, or HOLD.\n    Model is trained on the first 2 years (504 daily bars) of historical data.\n    \"\"\"\n\n    def __init__(self):\n        self.order = None\n        self.rsi = bt.indicators.RSI(self.data.close, period=14)\n        self.willr = bt.indicators.WilliamsR(self.data, period=14)\n\n        self.nn = SimpleMLP(input_dim=3, hidden_dim=8, output_dim=3)\n        self.train_data_x = []\n        self.train_data_y = []\n        self.trained = False\n        self.train_period = 504  # ~2 years of trading days\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:\n            self.order = None\n\n    def next(self):\n        if math.isnan(self.rsi[0]) or math.isnan(self.willr[0]):\n            return\n\n        # Feature preparation\n        f1_rsi = self.rsi[0] / 100.0\n        f2_willr = (self.willr[0] + 100.0) / 100.0\n        f3_open_ret = (\n            (self.data.open[0] - self.data.open[-1]) / self.data.open[-1]\n            if len(self) > 1\n            else 0.0\n        )\n        features = [f1_rsi, f2_willr, f3_open_ret]\n\n        # Training data collection during initial 2 years\n        if not self.trained:\n            ret = (self.data.close[0] - self.data.open[0]) / self.data.open[0]\n            label = 0 if ret > 0.001 else (1 if ret < -0.001 else 2)\n            self.train_data_x.append(features)\n            self.train_data_y.append(label)\n\n            if len(self) >= self.train_period:\n                self.nn.train(self.train_data_x, self.train_data_y, epochs=50, lr=0.01)\n                self.trained = True\n            return\n\n        if self.order:\n            return\n\n        pred = self.nn.predict(features)\n        signal = \"BUY\" if pred == 0 else (\"SELL\" if pred == 1 else \"HOLD\")\n\n        pos_size = self.position.size\n\n        if pos_size > 0:  # Currently Long\n            if signal in [\"SELL\", \"HOLD\"]:\n                self.order = self.close()\n        elif pos_size < 0:  # Currently Short\n            if signal in [\"BUY\", \"HOLD\"]:\n                self.order = self.close()\n        else:  # Currently Flat\n            if signal == \"BUY\":\n                cash = self.broker.getcash()\n                size = int(cash / self.data.close[0])\n                if size > 0:\n                    self.order = self.buy(size=size)\n            elif signal == \"SELL\":\n                cash = self.broker.getcash()\n                size = int(cash / self.data.close[0])\n                if size > 0:\n                    self.order = self.sell(size=size)",

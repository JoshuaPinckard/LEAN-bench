  "model": "claude-sonnet-5",
  "code": "import backtrader as bt\n\n\nclass HmaBandMeanReversion(bt.Strategy):\n    params = dict(\n        hma_period=9,\n        band_period=20,\n        band_dev=2.0,\n        atr_period=14,\n        atr_mult=2.0,\n    )\n\n    def __init__(self):\n        self.hma = bt.indicators.HullMovingAverage(\n            self.data.close, period=self.p.hma_period)\n        self.sma_hma = bt.indicators.SMA(self.hma, period=self.p.band_period)\n        self.std_hma = bt.indicators.StdDev(self.hma, period=self.p.band_period)\n        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)\n\n        self.upper_band = self.sma_hma + self.p.band_dev * self.std_hma\n        self.lower_band = self.sma_hma - self.p.band_dev * self.std_hma\n\n        self.cross_lower = bt.indicators.CrossOver(self.hma, self.lower_band)\n        self.cross_upper = bt.indicators.CrossOver(self.hma, self.upper_band)\n        self.cross_mid = bt.indicators.CrossOver(self.hma, self.sma_hma)\n\n        self.order = None\n        self.entry_order = False\n        self.stop_price = None\n\n    def notify_order(self, order):\n        if order.status == order.Completed and self.entry_order:\n            if order.isbuy():\n                self.stop_price = order.executed.price - self.p.atr_mult * self.atr[0]\n            else:\n                self.stop_price = order.executed.price + self.p.atr_mult * self.atr[0]\n\n        if order.status in (order.Completed, order.Canceled, order.Margin, order.Rejected):\n            self.order = None\n            self.entry_order = False\n\n    def next(self):\n        if self.order:\n            return\n\n        if self.position:\n            if self.position.size > 0:\n                if self.data.low[0] <= self.stop_price:\n                    self.order = self.close()\n                elif self.cross_mid[0] > 0:\n                    self.order = self.close()\n            elif self.position.size < 0:\n                if self.data.high[0] >= self.stop_price:\n                    self.order = self.close()\n                elif self.cross_mid[0] < 0:\n                    self.order = self.close()\n        else:\n            if self.cross_lower[0] > 0:\n                self.entry_order = True\n                self.order = self.buy()\n            elif self.cross_upper[0] < 0:\n                self.entry_order = True\n                self.order = self.sell()",
  "assumptions": [
    {

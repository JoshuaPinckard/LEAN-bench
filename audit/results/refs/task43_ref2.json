  "code": "import backtrader as bt\n\n\nclass BollingerBandsStrategy(bt.Strategy):\n    params = (\n        (\"period\", 20),\n        (\"devfactor\", 2.0),\n    )\n\n    def __init__(self):\n        self.boll = bt.indicators.BollingerBands(\n            self.data.close,\n            period=self.params.period,\n            devfactor=self.params.devfactor,\n        )\n        self.order = None\n\n    def notify_order(self, order):\n        if order.status in [order.Submitted, order.Accepted]:\n            return\n        if order.status in [\n            order.Completed,\n            order.Canceled,\n            order.Margin,\n            order.Rejected,\n        ]:\n            self.order = None\n\n    def next(self):\n        if self.order:\n            return\n\n        close_prev = self.data.close[-1]\n        close_curr = self.data.close[0]\n\n        bot_prev = self.boll.lines.bot[-1]\n        bot_curr = self.boll.lines.bot[0]\n\n        top_prev = self.boll.lines.top[-1]\n        top_curr = self.boll.lines.top[0]\n\n        mid_prev = self.boll.lines.mid[-1]\n        mid_curr = self.boll.lines.mid[0]\n\n        if not self.position:\n            # Long entry: close crosses lower_bb from below to above\n            if close_prev < bot_prev and close_curr > bot_curr:\n                cash = self.broker.getcash()\n                size = int(cash / (close_curr * 1.001))\n                if size > 0:\n                    self.order = self.buy(size=size)\n            # Short entry: close crosses upper_bb from above to below\n            elif close_prev > top_prev and close_curr < top_curr:\n                cash = self.broker.getcash()\n                size = int(cash / (close_curr * 1.001))\n                if size > 0:\n                    self.order = self.sell(size=size)\n        else:\n            if self.position.size > 0:\n                # Long exit: close crosses middle_bb from above to below\n                if close_prev > mid_prev and close_curr < mid_curr:\n                    self.order = self.close()\n            elif self.position.size < 0:\n                # Short exit: close crosses middle_bb from below to above\n                if close_prev < mid_prev and close_curr > mid_curr:\n                    self.order = self.close()",
  "assumptions": [
